script dadmod_anims_cat
    if GotParam favs
        title = "starred"
    else
    if GotParam find
        FormatText TextName = title "search: %s" s = <find>
    else
        switch <cat>
        case 0
            title = "standing and people"
        case 1
            title = "skating basics"
        case 2
            title = "flip tricks"
        case 3
            title = "grabs"
        case 4
            title = "grinds and slides"
        case 5
            title = "lips and handplants"
        case 6
            title = "flatland and manuals"
        case 7
            title = "specials"
        case 8
            title = "bails and get-ups"
        case 9
            title = "tantrums"
        case 10
            title = "walking and on foot"
        endswitch
    endif
    endif
    sq = "Star"
    if GotParam favs
        sq = "Unstar"
    endif
    FormatText TextName = sq_pc "\\b5 = %s" s = <sq>
    FormatText TextName = sq_con "\\b5 = %s" s = <sq>
    anim_ht = { helper_text_elements_pc = [ { text = "\\b7/\\b4 = Select" } { text = "\\bn = Back" } { text = "\\bm = Accept" } { text = <sq_pc> } ] helper_text_elements_console = [ { text = "\\b7/\\b4 = Select" } { text = "\\m1 = Back" } { text = "\\m0 = Accept" } { text = <sq_con> } ] }
    dialog_box_exit
    generic_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_anims_list
    scrolling
    num_items_to_show = 13
    menu_title = <title>
    menu_style = MENU_STYLE_LEFT
    pad_back_script = dadmod_anims_menu
    helper_text = <anim_ht>
    show_description_panel
    show_gradient
    boxed
    }
    THUGRECOMP_MenuFavAnim refresh = 1
    matched = 0
    shown = 0
    if GotParam favs
        if THUGRECOMP_MenuFavAnim seq = 0
            make_thugpro_menu_item { id = dadmod_anim_sq0 text = "Idle Sequence Loop" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 0 a = Ped_M_Talk2_RightHere id = dadmod_anim_sq0 t = "Idle Sequence Loop" } }
            SetScreenElementProps id = dadmod_anim_sq0 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 0 id = dadmod_anim_sq0 t = "Idle Sequence Loop" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 1
            make_thugpro_menu_item { id = dadmod_anim_sq1 text = "Pro Ped Idle Sequence Loop 1" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 1 a = Pro_Idle03a id = dadmod_anim_sq1 t = "Pro Ped Idle Sequence Loop 1" } }
            SetScreenElementProps id = dadmod_anim_sq1 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 1 id = dadmod_anim_sq1 t = "Pro Ped Idle Sequence Loop 1" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 2
            make_thugpro_menu_item { id = dadmod_anim_sq2 text = "Pro Ped Idle Sequence Loop 2" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 2 a = Pro_Idle05d id = dadmod_anim_sq2 t = "Pro Ped Idle Sequence Loop 2" } }
            SetScreenElementProps id = dadmod_anim_sq2 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 2 id = dadmod_anim_sq2 t = "Pro Ped Idle Sequence Loop 2" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 3
            make_thugpro_menu_item { id = dadmod_anim_sq3 text = "Skater Ped Idle Sequence Loop 1" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 3 a = Ped_M_SkateIdleA id = dadmod_anim_sq3 t = "Skater Ped Idle Sequence Loop 1" } }
            SetScreenElementProps id = dadmod_anim_sq3 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 3 id = dadmod_anim_sq3 t = "Skater Ped Idle Sequence Loop 1" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 4
            make_thugpro_menu_item { id = dadmod_anim_sq4 text = "Skater Ped Idle Sequence Loop 2" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 4 a = Ped_M_SkateIdle1 id = dadmod_anim_sq4 t = "Skater Ped Idle Sequence Loop 2" } }
            SetScreenElementProps id = dadmod_anim_sq4 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 4 id = dadmod_anim_sq4 t = "Skater Ped Idle Sequence Loop 2" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 5
            make_thugpro_menu_item { id = dadmod_anim_sq5 text = "Kneeling Sequence Loop" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 5 a = Ped_M_Cheer_KneelingIdle id = dadmod_anim_sq5 t = "Kneeling Sequence Loop" } }
            SetScreenElementProps id = dadmod_anim_sq5 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 5 id = dadmod_anim_sq5 t = "Kneeling Sequence Loop" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 6
            make_thugpro_menu_item { id = dadmod_anim_sq6 text = "Sit/Lean Sequence Loop" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 6 a = Ped_SIT_Idle id = dadmod_anim_sq6 t = "Sit/Lean Sequence Loop" } }
            SetScreenElementProps id = dadmod_anim_sq6 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 6 id = dadmod_anim_sq6 t = "Sit/Lean Sequence Loop" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 7
            make_thugpro_menu_item { id = dadmod_anim_sq7 text = "Sit (On Deck) Loop" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 7 a = Ped_M_Cheer_SittingIdle id = dadmod_anim_sq7 t = "Sit (On Deck) Loop" } }
            SetScreenElementProps id = dadmod_anim_sq7 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 7 id = dadmod_anim_sq7 t = "Sit (On Deck) Loop" } } ]
            shown = ( <shown> + 1 )
        endif
    endif
    i = 0
    begin
        e = ( dadmod_anim_list [ <i> ] )
        ok = 0
        star = " "
        if THUGRECOMP_MenuFavAnim anim = ( <e> . a ) single_hide = ( dadmod_anims_single )
            star = "*"
        endif
        if GotParam favs
            if ( <star> = "*" )
                ok = 1
            endif
        else
        if GotParam find
            if THUGRECOMP_TextHas text = ( <e> . t ) find = <find>
                ok = 1
            endif
        else
            if ( ( <e> . c ) = <cat> )
                ok = 1
            endif
        endif
        endif
        if ( <ok> = 1 )
            if ( ( dadmod_anims_main ) = 1 )
                if not GotParam favs
                    if not THUGRECOMP_TextHas text = ( <e> . t ) find = "idle"
                        ok = 0
                    endif
                endif
            endif
        endif
        if ( <ok> = 1 )
            ae_anim = ( <e> . a )
            if ObjectExists id = skater
                if not skater : AnimExists <ae_anim>
                    ok = 0
                endif
            endif
        endif
        if ( <ok> = 1 )
            matched = ( <matched> + 1 )
            FormatText ChecksumName = item_id "dadmod_anim_it%i" i = <i>
            make_thugpro_menu_item { id = <item_id> text = ( <e> . t ) extra_text = <star> description_text = "Plays it on your skater. Right stars it (*)" pad_choose_script = dadmod_anim_choose pad_choose_params = { i = <i> t = ( <e> . t ) id = <item_id> } }
            SetScreenElementProps id = <item_id> event_handlers = [ { pad_right dadmod_anim_square params = { i = <i> id = <item_id> } } ]
            shown = ( <shown> + 1 )
        endif
        i = ( <i> + 1 )
    repeat 675
    if ( <shown> = 0 )
        make_thugpro_menu_item { text = "Nothing here" description_text = "Try another word, or star some animations first" pad_choose_script = dadmod_anims_menu }
    endif
    thugpro_menu_finalize
endscript

script dadmod_anims_find
    text = ""
    if THUGRECOMP_TextLoad key = "anim_find"
        if not ( <value> = "-" )
            text = <value>
        endif
    endif
    thugpro_menu_destroy
    create_onscreen_keyboard {
    allow_cancel
    keyboard_cancel_script = dadmod_anims_find_cancel
    keyboard_done_script = dadmod_anims_find_done
    keyboard_title = "Find an animation"
    min_length = 0
    max_length = 30
    text = <text>
    }
endscript

script dadmod_anims_find_done
    GetTextElementString id = keyboard_current_string
    destroy_onscreen_keyboard
    if ( <String> = "" )
        dadmod_anims_menu
        return
    endif
    THUGRECOMP_TextSave key = "anim_find" value = <String>
    dadmod_anims_cat find = <String>
endscript

script dadmod_anims_find_cancel
    destroy_onscreen_keyboard
    dadmod_anims_menu
endscript

script thugpro_bankdrops_parse
    if ( ( ( <msg> = "!BANKDROPS" ) or ( <msg> = " !BANKDROPS" ) ) or ( ( <msg> = "!BANKDROP" ) or ( <msg> = " !BANKDROP" ) ) )
        return bd = 2
    endif
    if ( ( ( <msg> = "!BANKDROPS ON" ) or ( <msg> = " !BANKDROPS ON" ) ) or ( ( <msg> = "!BANKDROP ON" ) or ( <msg> = " !BANKDROP ON" ) ) )
        return bd = 1
    endif
    if ( ( ( <msg> = "!BANKDROPS OFF" ) or ( <msg> = " !BANKDROPS OFF" ) ) or ( ( <msg> = "!BANKDROP OFF" ) or ( <msg> = " !BANKDROP OFF" ) ) )
        return bd = 0
    endif
endscript

script thugpro_bankdrops_local
    if not GotParam msg
        return
    endif
    if not GotParam name
        return
    endif
    if not InNetGame
        return
    endif
    GetUpperCaseString <msg>
    thugpro_bankdrops_parse msg = <UpperCaseString>
    if not GotParam bd
        return
    endif
    if not THUGRECOMP_IsLocalPlayerName name = <name>
        return
    endif
    if ( <bd> = 2 )
        if THUGRECOMP_BankDropsOn
            bd = 0
        else
            bd = 1
        endif
    endif
    THUGRECOMP_BankDropsSet on = <bd>
    if THUGRECOMP_BankDropsOn
        text = "Bank drops: ON (just in your game)"
    else
        text = "Bank drops: OFF (just in your game)"
    endif
    THUGRECOMP_Log text = <text>
    KillSpawnedScript Name = thugpro_bankdrops_confirm
    SpawnScript thugpro_bankdrops_confirm params = { name = <name> text = <text> } NotSessionSpecific = 1
endscript

script thugpro_bankdrops_confirm
    wait 1.5 seconds
    thugpro_say_to name = <name> text = <text>
endscript

script thugpro_bankdrops_chat
    thugpro_bankdrops_parse msg = <msg>
    if not GotParam bd
        return
    endif
    if not THUGRECOMP_IsLocalPlayerName name = <name>
        thugpro_say_to name = <name> text = "!bankdrops needs the dadmod DLL: bank drops are part of your own game's physics"
    endif
    return handled = 1
endscript

script dadmod_chatkeep_save
    if ObjectExists id = keyboard_anchor
        if keyboard_anchor : GetSingleTag no_buttons
            if ObjectExists id = keyboard_current_string
                GetTextElementString id = keyboard_current_string
                if GotParam String
                    KillSpawnedScript Name = dadmod_chatkeep_restore
                    SpawnScript dadmod_chatkeep_restore params = { text = <String> }
                endif
            endif
        endif
    endif
endscript

script dadmod_chatkeep_restore
    tries = 0
    begin
        wait 5 gameframes
        if ObjectExists id = keyboard_anchor
            return
        endif
        blocked = 0
        if ObjectExists id = ped_speech_dialog
            blocked = 1
        endif
        if ObjectExists id = goal_start_dialog
            blocked = 1
        endif
        if ObjectExists id = goal_description_anchor
            blocked = 1
        endif
        if ObjectExists id = dialog_box_anchor
            blocked = 1
        endif
        if ( <blocked> = 0 )
            break
        endif
        tries = ( <tries> + 1 )
        if ( <tries> > 36 )
            return
        endif
    repeat
    DestroyIfObjectExist id = current_menu_anchor
    DestroyIfObjectExist id = bg_container
    create_onscreen_keyboard {
    allow_cancel no_buttons text_block
    Pos = (3.2e+02,2.6e+02)
    keyboard_cancel_script = cancel_enter_chat_menu
    keyboard_done_script = entered_chat_message
    display_text = "Enter message"
    keyboard_title = "Enter message"
    min_length = 1
    max_length = 75
    display_text_scale = 0.5
    text = <text>
    }
    if ObjectExists id = keyboard_display_string
        FormatText TextName = shown "%s_" s = <text>
        SetScreenElementProps id = keyboard_display_string text = <shown>
    endif
endscript

dadmod_veh_note = "Pause > dadmod > Vehicles (Noah, 2026-10-28), right under Animations. Drive: the stock THUG drivable car path (goal_initialize_skater: MakeSkaterGoto Switch_OnGroundAi NewScript = TransAm, Exitable) with the stock VehicleSetup; the stock game itself shows that car on your skater to every other player, mod or not (BroadcastEnterVehicle + NonLocalClientInVehicle build it from VehicleSetupMapping), so only setups whose model this level's own nodes use are offered (mods/vehicles/gen_vehicles.py), or a player's game could be asked for a model it never loaded. Park: a still copy of one of this level's own cars, made by the host on itself and on every player with the hidden panel block -> generic_menu_pad_choose -> CreateFromStructure route of mods/cars/traffic.q, so players without the mod see it too; removed the same way with RunScriptOnObject KillElement3d. Non-host menus send !car N; anyone can type !car (next car), !car N or !car clear. Players who join later don't get cars parked before they joined. 2026-10-28: parking is switched off (menu items removed, thugpro_vehicle_chat empty so !car is not handled) until it is tested on a test copy against an unmodded game: the same panel block CreateFromStructure route crashed an unmodded client on 2026-10-10. Driving offers the same 7 stock setups on every level (dadmod_veh_drivelist): their models ship loose in every Kali v2 install (User/Data/Models/veh) and load mid-level; tested driving on SF in a test copy. Mini Baja crashed there; TransAm, taxi, police, carts, El Camino, Lada, Taurus, Forklift, RC car have no model file at all."

dadmod_veh_n = 0

dadmod_veh_first = 1

dadmod_veh_next = 0

dadmod_veh_level = none

dadmod_veh_max = 10

dadmod_veh_ids = [ #"0x00000000" #"0x00000001" #"0x00000002" #"0x00000003" #"0x00000004" #"0x00000005" #"0x00000006" #"0x00000007" #"0x00000008" #"0x00000009" #"0x0000000a" #"0x0000000b" #"0x0000000c" #"0x0000000d" #"0x0000000e" #"0x0000000f" ]

script dadmod_veh_drivelist
    return list = [
    { t = "Rally car" d = RallyCar }
    { t = "Impala" d = ImpalaCar }
    { t = "Pickup truck" d = PickupTruck }
    { t = "Sports car" d = SportsCar }
    { t = "Limo" d = LimoCar }
    { t = "Blimp" d = Blimp }
    { t = "Offroad truck" d = OffroadCar }
    ]
endscript

script dadmod_veh_menu
    dialog_box_exit
    generic_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_veh
    scrolling
    num_items_to_show = 13
    menu_title = "vehicles"
    menu_style = MENU_STYLE_LEFT
    pad_back_script = dadmod_menu
    helper_text = generic_helper_text
    show_description_panel
    show_gradient
    boxed
    }
    dadmod_veh_drivelist
    GetArraySize <list>
    n = <array_size>
    dadmod_vdrv = 0
    if ObjectExists id = skater
        if skater : Driving
            dadmod_vdrv = 1
        endif
    endif
    if ( <dadmod_vdrv> = 1 )
        make_thugpro_menu_item {
        text = "Get out of the car"
        description_text = "Stop driving and get back on your board right where the car is"
        pad_choose_script = dadmod_veh_exit
        }
    endif
    if InNetGame
        n = 0
        make_thugpro_menu_item {
        text = "Vehicles are offline only for now"
        description_text = "Vehicles are offline only for now. Players without Kali v2 would crash."
        pad_choose_script = dadmod_menu
        }
    endif
    if ( <n> > 0 )
        make_thugpro_menu_item {
        text = "Online: DadMod players see these"
        not_focusable
        }
        i = 0
        begin
            e = ( <list> [ <i> ] )
            FormatText TextName = t "Drive: %s  (online)" s = ( <e> . t )
            make_thugpro_menu_item {
            text = <t>
            description_text = "Drive it (\\b0 to get out). Stock car: other DadMod players see it"
            pad_choose_script = dadmod_veh_drive
            pad_choose_params = { i = <i> }
            }
            i = ( <i> + 1 )
        repeat <n>
        dadmod_veh_morelist
        GetArraySize <list>
        n = <array_size>
        make_thugpro_menu_item {
        text = "Only you see these"
        not_focusable
        }
        i = 0
        begin
            e = ( <list> [ <i> ] )
            FormatText TextName = t "Drive: %s  (just you)" s = ( <e> . t )
            make_thugpro_menu_item {
            text = <t>
            description_text = "Drive it (\\b0 to get out). Only you see it. Handles like the pickup truck"
            pad_choose_script = dadmod_veh_drive_more
            pad_choose_params = { i = <i> }
            }
            i = ( <i> + 1 )
        repeat <n>
    endif
    thugpro_menu_finalize
endscript

script dadmod_veh_more_menu
    dialog_box_exit
    generic_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_veh_more
    scrolling
    num_items_to_show = 13
    menu_title = "more cars"
    menu_style = MENU_STYLE_LEFT
    pad_back_script = dadmod_veh_menu
    helper_text = generic_helper_text
    show_description_panel
    show_gradient
    boxed
    }
    dadmod_veh_morelist
    GetArraySize <list>
    n = <array_size>
    if InNetGame
        n = 0
        make_thugpro_menu_item {
        text = "Vehicles are offline only for now"
        description_text = "Vehicles are offline only for now. Players without Kali v2 would crash."
        pad_choose_script = dadmod_veh_menu
        }
    endif
    if ( <n> > 0 )
        i = 0
        begin
            e = ( <list> [ <i> ] )
            FormatText TextName = t "Drive: %s" s = ( <e> . t )
            make_thugpro_menu_item {
            text = <t>
            description_text = "Drive it (\\b0 to get out). Handles like the pickup truck"
            pad_choose_script = dadmod_veh_drive_more
            pad_choose_params = { i = <i> }
            }
            i = ( <i> + 1 )
        repeat <n>
    endif
    thugpro_menu_finalize
endscript

script dadmod_veh_drive_more
    dadmod_veh_morelist
    GetArraySize <list>
    if not ( <i> < <array_size> )
        return
    endif
    e = ( <list> [ <i> ] )
    exit_pause_menu
    KillSpawnedScript Name = dadmod_veh_drive_go
    SpawnScript dadmod_veh_drive_go params = { ct = PickupTruck dadmod_vm = ( <e> . m ) } NotSessionSpecific = 1
endscript

script dadmod_veh_can_drive
    if InNetGame
        return no = "Vehicles are offline only for now. Players without Kali v2 would crash."
    endif
    if not ObjectExists id = skater
        return no = "No skater"
    endif
    if InNetGame
        if not GameModeEquals is_lobby
            return no = "Cars are for free skate, not during a game"
        endif
    endif
    if ChangeLevelPending
        return no = "The level is changing"
    endif
    return ok = 1
endscript

script dadmod_veh_drive
    dadmod_veh_drivelist
    GetArraySize <list>
    if not ( <i> < <array_size> )
        return
    endif
    e = ( <list> [ <i> ] )
    if not StructureContains structure = <e> d
        return
    endif
    exit_pause_menu
    KillSpawnedScript Name = dadmod_veh_drive_go
    SpawnScript dadmod_veh_drive_go params = { ct = ( <e> . d ) } NotSessionSpecific = 1
endscript

script dadmod_veh_drive_go
    wait 5 gameframes
    dadmod_veh_can_drive
    if GotParam no
        create_panel_message id = dadmod_veh_msg text = <no> time = 2500
        return
    endif
    if skater : Driving
        dadmod_veh_exit_now
        wait 10 gameframes
        if not ObjectExists id = skater
            return
        endif
    endif
    if skater : InAir
        create_panel_message id = dadmod_veh_msg text = "Land first, then pick the car" time = 2500
        return
    endif
    GetVehicleSetup control_type = <ct>
    skater : Obj_GetPosition
    VehicleSetup = { <VehicleSetup> Pos = ( <Pos> + (0.0,20.0,0.0) ) }
    if GotParam dadmod_vm
        VehicleSetup = { <VehicleSetup> model = <dadmod_vm> }
    endif
    THUGRECOMP_Log text = "vehicles: drive"
    MakeSkaterGoto Switch_OnGroundAi params = { NewScript = TransAm VehicleSetup = <VehicleSetup> Exitable }
    k = 0
    begin
        if ObjectExists id = PlayerVehicleCamera
            break
        endif
        if ( <k> > 30 )
            THUGRECOMP_Log text = "vehicles: no PlayerVehicleCamera after 30 frames"
            create_panel_message id = dadmod_veh_msg text = "The car didn't start" time = 2500
            return
        endif
        k = ( <k> + 1 )
        wait 1 gameframe
    repeat
    PlayerVehicleCamera : VehicleCamera_Reset
    SetActiveCamera id = PlayerVehicleCamera
    create_panel_block id = current_goal text = "\\b3 = Accelerate\\n\\b1 = Brake/Reverse\\n\\b0 = Get out" style = panel_message_goal
    KillSpawnedScript Name = dadmod_veh_wait_exit
    SpawnScript dadmod_veh_wait_exit NotSessionSpecific = 1
    KillSpawnedScript Name = dadmod_veh_watch
    SpawnScript dadmod_veh_watch NotSessionSpecific = 1
endscript

script dadmod_veh_wait_exit
    wait 0.5 seconds
    WaitForEvent Type = ExitVehicleRequest
    KillSpawnedScript Name = dadmod_veh_watch
    dadmod_veh_exit_now
endscript

script dadmod_veh_watch
    wait 0.5 seconds
    begin
        wait 5 gameframes
        if not ObjectExists id = skater
            break
        endif
        if not skater : Driving
            break
        endif
        dadmod_veh_can_drive
        if GotParam no
            KillSpawnedScript Name = dadmod_veh_wait_exit
            dadmod_veh_exit_now
            break
        endif
    repeat
endscript

script dadmod_veh_exit
    exit_pause_menu
    KillSpawnedScript Name = dadmod_veh_exit_go
    SpawnScript dadmod_veh_exit_go NotSessionSpecific = 1
endscript

script dadmod_veh_exit_go
    wait 3 gameframes
    KillSpawnedScript Name = dadmod_veh_wait_exit
    KillSpawnedScript Name = dadmod_veh_watch
    dadmod_veh_exit_now
endscript

script dadmod_veh_exit_now
    if ObjectExists id = current_goal
        DestroyScreenElement id = current_goal
    endif
    if not ObjectExists id = skater
        return
    endif
    if not skater : Driving
        return
    endif
    THUGRECOMP_Log text = "vehicles: get out"
    ToggleUserControlledVehicleMode
    Skater : UnpausePhysics
    MakeSkaterGoto OnGroundAi
endscript

script dadmod_veh_park
    if InNetGame
        if not IsHost
            FormatText TextName = cmd "!car %i" i = <i>
            SendChatMessage String = <cmd>
            create_panel_message id = dadmod_veh_msg text = "Asked the server to park it" time = 2000
            return
        endif
    endif
    dadmod_veh_park_for i = <i> local = 1
endscript

script dadmod_veh_clear
    if InNetGame
        if not IsHost
            SendChatMessage String = "!car clear"
            create_panel_message id = dadmod_veh_msg text = "Asked the server to remove the parked cars" time = 2000
            return
        endif
    endif
    dadmod_veh_clear_all
    create_panel_message id = dadmod_veh_msg text = "Parked cars removed" time = 2000
endscript

script dadmod_veh_park_for
    if ChangeLevelPending
        return
    endif
    if InNetGame
        if NetworkGamePending
            return
        endif
    endif
    dadmod_veh_get
    if not GotParam list
        return
    endif
    GetArraySize <list>
    if ( <array_size> = 0 )
        return
    endif
    if GotParam next
        i = ( dadmod_veh_next )
        if not ( <i> < <array_size> )
            i = 0
        endif
        Change dadmod_veh_next = ( <i> + 1 )
    endif
    if not ( <i> < <array_size> )
        return
    endif
    if GotParam local
        if not ObjectExists id = skater
            return
        endif
        skater : Obj_GetPosition
        skater : Obj_GetOrientation
    else
        if not THUGRECOMP_PlayerSkaterId name = <name>
            return
        endif
        if ( <local> = 1 )
            if not ObjectExists id = skater
                return
            endif
            skater : Obj_GetPosition
            skater : Obj_GetOrientation
        else
            if not ( <id> < 16 )
                return
            endif
            cid = ( dadmod_veh_ids [ <id> ] )
            if not ObjectExists id = <cid>
                return
            endif
            <cid> : Obj_GetPosition
            <cid> : Obj_GetOrientation
        endif
    endif
    dir = ( <x> * (1.0,0.0,0.0) + <z> * (0.0,0.0,1.0) )
    dadmod_veh_park_at e = ( <list> [ <i> ] ) Pos = ( <Pos> + <dir> * 250.0 )
endscript

script dadmod_veh_park_at
    GetLevelStructureName
    if not ( <level_structure_name> = ( dadmod_veh_level ) )
        Change dadmod_veh_level = <level_structure_name>
        Change dadmod_veh_first = ( dadmod_veh_n + 1 )
    endif
    k = ( dadmod_veh_n + 1 )
    Change dadmod_veh_n = <k>
    FormatText ChecksumName = car_id "dadmod_vcar_%k" k = <k>
    cs = { Pos = <Pos> Angles = (0.0,0.0,0.0) Name = <car_id> Class = Vehicle model = ( <e> . m ) CollisionMode = Geometry NeverSuspend }
    if StructureContains structure = <e> sk
        cs = { <cs> skeletonName = ( <e> . sk ) }
    endif
    if StructureContains structure = <e> ty
        cs = { <cs> Type = ( <e> . ty ) }
    endif
    if not ObjectExists id = <car_id>
        CreateFromStructure <cs>
    endif
    if InNetGame
        FormatText ChecksumName = block_id "dadmod_vcar_b%k" k = <k>
        p = { id = <block_id> text = " " Pos = (-1000.0,-1000.0) style = generic_menu_pad_choose params = { callback = CreateFromStructure <cs> } }
        THUGRECOMP_AllPlayersScript run = create_panel_block params = <p> ready_only
    endif
    FormatText TextName = dbg "vehicles: parked %k (%m)" k = <k> m = ( <e> . t )
    THUGRECOMP_Log text = <dbg>
    if ( ( <k> - ( dadmod_veh_first ) ) > ( ( dadmod_veh_max ) - 1 ) )
        dadmod_veh_remove k = ( dadmod_veh_first )
        Change dadmod_veh_first = ( ( dadmod_veh_first ) + 1 )
    endif
endscript

script dadmod_veh_remove
    FormatText ChecksumName = car_id "dadmod_vcar_%k" k = <k>
    if ObjectExists id = <car_id>
        <car_id> : Die
    endif
    if InNetGame
        FormatText ChecksumName = block_id "dadmod_vcar_r%k" k = <k>
        p = { id = <block_id> text = " " Pos = (-1000.0,-1000.0) style = generic_menu_pad_choose params = { callback = RunScriptOnObject id = <car_id> KillElement3d } }
        THUGRECOMP_AllPlayersScript run = create_panel_block params = <p> ready_only
    endif
endscript

script dadmod_veh_clear_all
    GetLevelStructureName
    if not ( <level_structure_name> = ( dadmod_veh_level ) )
        return
    endif
    k = ( dadmod_veh_first )
    begin
        if ( <k> > ( dadmod_veh_n ) )
            break
        endif
        dadmod_veh_remove k = <k>
        k = ( <k> + 1 )
    repeat
    Change dadmod_veh_first = ( ( dadmod_veh_n ) + 1 )
    THUGRECOMP_Log text = "vehicles: parked cars removed"
endscript

