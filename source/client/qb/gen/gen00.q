script dadmod_anims_loops
    sq_ht = { helper_text_elements_pc = [ { text = "\\b7/\\b4 = Select" } { text = "\\bn = Back" } { text = "\\bm = Accept" } { text = "\\b5 = Star" } ] helper_text_elements_console = [ { text = "\\b7/\\b4 = Select" } { text = "\\m1 = Back" } { text = "\\m0 = Accept" } { text = "\\b5 = Star" } ] }
    dialog_box_exit
    generic_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_anims_loops
    scrolling
    num_items_to_show = 13
    menu_title = "idle loops"
    menu_style = MENU_STYLE_LEFT
    pad_back_script = dadmod_anims_menu
    helper_text = <sq_ht>
    show_description_panel
    show_gradient
    boxed
    }
    THUGRECOMP_MenuFavAnim refresh = 1
    if ObjectExists id = skater
        if skater : AnimExists Ped_M_Talk2_RightHere
    star = " "
    if THUGRECOMP_MenuFavAnim seq = 0 single_hide = ( dadmod_anims_single )
        star = "*"
    endif
    make_thugpro_menu_item {
    id = dadmod_anim_sq0
    text = "Idle Loop"
    extra_text = <star>
    description_text = "Loops on your skater until you push the stick, ollie or pick Stop. Right stars it (*). Loop by Kali (Kalimod v2)"
    pad_choose_script = dadmod_anim_seq_choose
    pad_choose_params = { n = 0 a = Ped_M_Talk2_RightHere id = dadmod_anim_sq0 t = "Idle Sequence Loop" }
    }
    SetScreenElementProps id = dadmod_anim_sq0 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 0 id = dadmod_anim_sq0 t = "Idle Sequence Loop" } } ]
        endif
    endif
    if ObjectExists id = skater
        if skater : AnimExists Pro_Idle03a
    star = " "
    if THUGRECOMP_MenuFavAnim seq = 1 single_hide = ( dadmod_anims_single )
        star = "*"
    endif
