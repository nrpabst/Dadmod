"\r\n"
"; ---- Edit Skater screens: the camera moves in close while these are open (orbit values, start counts\r\n"
";      from the skater's front). on = 0 leaves that screen on the normal menu camera.\r\n"
"[context cas]\r\n"
"radius = 135\r\nheight = 42\r\nlook = 42\r\nstart = 20\r\n"
"[context edit]\r\n"
"radius = 120\r\nheight = 40\r\nlook = 40\r\nstart = 15\r\n"
"[context head]\r\n"
