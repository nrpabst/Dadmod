script dadmod_anim_seq_pick
    SpawnScript dadmod_anim_seq_go params = { n = <n> a = <a> } NotSessionSpecific = 1
endscript

script dadmod_anim_seq_go
    wait 2 gameframes
    dadmod_anim_kali_kill
    if not ObjectExists id = skater
        return
    endif
    if not skater : AnimExists <a>
        create_panel_message id = dadmod_anim_msg text = "Your skater cannot play that one here" time = 2500
        return
    endif
    dadmod_noclip_is_on
    if ( <dadmod_nc_on> = 1 )
        create_panel_message id = dadmod_anim_msg text = "Turn noclip off first for the loops" time = 2500
        return
    endif
    dadmod_anim_seq_pieces n = <n>
    if skater : walking
        if skater : Walk_Air
            create_panel_message id = dadmod_anim_msg text = "Land first, then pick the animation" time = 2500
            return
        endif
        MakeSkaterGoto dadmod_anim_seq_walk params = { pieces = <pieces> }
        return
    endif
    if skater : InAir
        create_panel_message id = dadmod_anim_msg text = "Land first, then pick the animation" time = 2500
        return
    endif
    MakeSkaterGoto dadmod_anim_seq_skate params = { pieces = <pieces> }
endscript

