    pad_choose_params = { n = 1 a = Pro_Idle03a id = dadmod_anim_sq1 t = "Pro Ped Idle Sequence Loop 1" }
    }
    SetScreenElementProps id = dadmod_anim_sq1 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 1 id = dadmod_anim_sq1 t = "Pro Ped Idle Sequence Loop 1" } } ]
        endif
    endif
    if ObjectExists id = skater
        if skater : AnimExists Pro_Idle05d
    star = " "
    if THUGRECOMP_MenuFavAnim seq = 2 single_hide = ( dadmod_anims_single )
        star = "*"
    endif
    make_thugpro_menu_item {
    id = dadmod_anim_sq2
    text = "Pro Ped Idle Loop 2"
    extra_text = <star>
    description_text = "Loops on your skater until you push the stick, ollie or pick Stop. Right stars it (*). Loop by Kali (Kalimod v2)"
    pad_choose_script = dadmod_anim_seq_choose
    pad_choose_params = { n = 2 a = Pro_Idle05d id = dadmod_anim_sq2 t = "Pro Ped Idle Sequence Loop 2" }
    }
    SetScreenElementProps id = dadmod_anim_sq2 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 2 id = dadmod_anim_sq2 t = "Pro Ped Idle Sequence Loop 2" } } ]
        endif
    endif
    if ObjectExists id = skater
        if skater : AnimExists Ped_M_SkateIdleA
    star = " "
    if THUGRECOMP_MenuFavAnim seq = 3 single_hide = ( dadmod_anims_single )
        star = "*"
    endif
    make_thugpro_menu_item {
    id = dadmod_anim_sq3
    text = "Skater Ped Idle Loop 1"
    extra_text = <star>
    description_text = "Loops on your skater until you push the stick, ollie or pick Stop. Right stars it (*). Loop by Kali (Kalimod v2)"
    pad_choose_script = dadmod_anim_seq_choose
