    pad_choose_params = { favs = 1 }
    }
    dadmod_anim_loop_text
    make_thugpro_menu_item {
    id = dadmod_anim_loop_item
    text = "Loop"
    extra_text = <loop_text>
    description_text = "On: repeats until you push the stick, ollie or pick Stop"
    option_arrows
    option_arrows_callback = dadmod_anim_loop
    pad_choose_script = dadmod_anim_loop
    }
    dadmod_anim_move_text
    make_thugpro_menu_item {
    id = dadmod_anim_move_item
    text = "Move while looping"
    extra_text = <move_text>
    description_text = "On: steer and walk while a looped animation keeps playing"
    option_arrows
    option_arrows_callback = dadmod_anim_move
    pad_choose_script = dadmod_anim_move
    }
    make_thugpro_menu_item {
    text = "Stop animation"
    description_text = "Back to normal skating"
    pad_choose_script = dadmod_anim_stop
    }
    if THUGRECOMP_TextLoad key = "anim_last"
        last_t = <value>
        if THUGRECOMP_SettingLoad key = "anim_last_i"
            if ( <value> < 675 )
                FormatText TextName = again "Again: %s" s = <last_t>
                make_thugpro_menu_item {
                text = <again>
                description_text = "Plays the last animation you picked"
                pad_choose_script = dadmod_anim_pick
                pad_choose_params = { i = <value> t = <last_t> }
                }
            endif
        endif
