#ifdef DADMOD_CLIENT_HAS_MAINMENU
// Client build: a player's install only has the menu levels the client DLL could put together from their own game
// files (data\pre\mainmenu_<key>_scripts.prx, client/native/menulevels.inc). Any other choice shows the stock
// skate shop instead, and the Menu level list leaves it out (THUGRECOMP_MenuLevelHas).
static bool ClientHasMenuArchive(std::string key) {
    if (key == "east_la") key = "el";
    std::string prx = ExeDirFile("x");
    prx = prx.substr(0, prx.size() - strlen("dadmod\\x")) + "data\\pre\\mainmenu_" + key + "_scripts.prx";
    return GetFileAttributesA(prx.c_str()) != INVALID_FILE_ATTRIBUTES;
}
static int ClientMenuLevel(int i, bool log = true) {
    if (i <= 0 || i >= kMenuLevelCount) return 0;
    if (ClientHasMenuArchive(kMenuLevels[i].key)) return i;
    if (log) Log("menu level %s: its files aren't installed, using the skate shop", kMenuLevels[i].key);
    return 0;
}
#else
static int ClientMenuLevel(int i, bool = true) { return i; }
#endif
