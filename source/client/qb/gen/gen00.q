{ name = "mui_c_barfx" b = 1 p = { id = mui_c_barfx key = "ui_bar_fx" label = "Bar FX" kind = barfx min = 0 max = 10 def = 0 desc = "Effect on the highlight bar. Glitch is the stock jitter, Still turns it off. Breathe, Pulse, Rainbow, Two-tone (to the Highlight color), Strobe, Neon flicker, Heartbeat, Police lights, or Slide (the bar slides in each time you move). Speed follows FX speed" } }
{ name = "mui_c_title" b = 1 p = { id = mui_c_title key = "ui_title" label = "Title color" kind = color min = 0 max = 13 def = 0 desc = "Color of menu titles" } }
