dadmod_gfx_from_pause = 0

script dadmod_pause_graphics
    if GotParam from
        if (<from> = pause)
            Change dadmod_gfx_from_pause = 1
        else
            Change dadmod_gfx_from_pause = 0
        endif
    endif
    back = dadmod_menu
    if IsTrue dadmod_gfx_from_pause
        back = create_pause_menu
    endif
    dialog_box_exit
    generic_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_gfx
    menu_title = "graphics"
    menu_style = MENU_STYLE_LEFT
    pad_back_script = <back>
    helper_text = generic_helper_text
    show_description_panel
    show_gradient
    boxed
    }
    dadmod_layout_item name = "gfx_postfx" label = "" grey = 0 dadmod_pause = 1
    GetArraySize dadmod_pause_gfx_groups
    i = 0
    begin
        if (<i> = <array_size>)
            break
        endif
        g = ( dadmod_pause_gfx_groups [ <i> ] )
        FormatText TextName = t "%s  >" s = ( <g> . title )
        FormatText ChecksumName = gid "dadmod_pause_gfx_%i" i = <i>
        make_thugpro_menu_item {
        text = <t>
        id = <gid>
        description_text = ( <g> . desc )
        pad_choose_script = dadmod_pause_gfx_group
        pad_choose_params = { group = <i> }
        }
        i = ( <i> + 1 )
    repeat
    dadmod_layout_item name = "gfx_reset" label = "" grey = 0 dadmod_pause = 1
    thugpro_menu_finalize
endscript

script dadmod_pause_gfx_group
    Change dadmod_pause_group_last = <group>
    g = ( dadmod_pause_gfx_groups [ <group> ] )
    dialog_box_exit
    generic_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_gfx_group
    menu_title = ( <g> . title )
    menu_style = MENU_STYLE_LEFT
    pad_back_script = dadmod_pause_graphics
    helper_text = generic_helper_text
    show_description_panel
    show_gradient
    boxed
    }
    names = ( <g> . items )
    GetArraySize <names>
    i = 0
    begin
        if (<i> = <array_size>)
            break
        endif
        dadmod_layout_item name = ( <names> [ <i> ] ) label = "" grey = 0 dadmod_pause = 1
        i = ( <i> + 1 )
    repeat
    thugpro_menu_finalize
endscript

