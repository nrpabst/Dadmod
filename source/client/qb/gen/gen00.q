script dadmod_anim_seq_pick
    SpawnScript dadmod_anim_seq_go params = { n = <n> a = <a> } NotSessionSpecific = 1
endscript

script dadmod_anim_seq_go
    wait 2 gameframes
    dadmod_anim_kali_kill
    if not ObjectExists id = skater
        return
    endif
    if not skater : AnimExists <a>
        create_panel_message id = dadmod_anim_msg text = "Your skater cannot play that one here" time = 2500
        return
    endif
    dadmod_noclip_is_on
    if ( <dadmod_nc_on> = 1 )
        create_panel_message id = dadmod_anim_msg text = "Turn noclip off first for the loops" time = 2500
        return
    endif
    dadmod_anim_seq_pieces n = <n>
    if skater : walking
        if skater : Walk_Air
            create_panel_message id = dadmod_anim_msg text = "Land first, then pick the animation" time = 2500
            return
        endif
        MakeSkaterGoto dadmod_anim_seq_walk params = { pieces = <pieces> }
        return
    endif
    if skater : InAir
        create_panel_message id = dadmod_anim_msg text = "Land first, then pick the animation" time = 2500
        return
    endif
    MakeSkaterGoto dadmod_anim_seq_skate params = { pieces = <pieces> }
endscript

script dadmod_anims_menu
    dialog_box_exit
    generic_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_anims
    scrolling
    num_items_to_show = 13
    menu_title = "animations"
    menu_style = MENU_STYLE_LEFT
    pad_back_script = dadmod_anims_back
    helper_text = generic_helper_text
    show_description_panel
    show_gradient
    boxed
    }
    THUGRECOMP_MenuFavAnim refresh = 1
    if ( ( dadmod_anims_main ) = 1 )
        if ( ( dadmod_anims_single ) = 0 )
            FormatText TextName = favs "Picked (%n)  >" n = <count>
    make_thugpro_menu_item {
    text = <favs>
    description_text = "The ones you starred. Right unstars one"
    pad_choose_script = dadmod_anims_cat
    pad_choose_params = { favs = 1 }
    }
        endif
    make_thugpro_menu_item {
    text = "Idle loops  >"
    extra_text = "Kali"
    description_text = "Idle sequences that keep looping (by Kali, from Kalimod v2)"
    pad_choose_script = dadmod_anims_loops
    }
    make_thugpro_menu_item {
    text = "Standing and people  >"
    description_text = "53 idle animations (ones your skater can't play are hidden)"
    pad_choose_script = dadmod_anims_cat
    pad_choose_params = { cat = 0 }
    }
    make_thugpro_menu_item {
    text = "Skating basics  >"
    description_text = "31 idle animations (ones your skater can't play are hidden)"
    pad_choose_script = dadmod_anims_cat
    pad_choose_params = { cat = 1 }
    }
    make_thugpro_menu_item {
    text = "Grabs  >"
    description_text = "30 idle animations (ones your skater can't play are hidden)"
    pad_choose_script = dadmod_anims_cat
    pad_choose_params = { cat = 3 }
    }
    make_thugpro_menu_item {
    text = "Specials  >"
    description_text = "35 idle animations (ones your skater can't play are hidden)"
    pad_choose_script = dadmod_anims_cat
    pad_choose_params = { cat = 7 }
    }
    make_thugpro_menu_item {
    text = "Walking and on foot  >"
    description_text = "11 idle animations (ones your skater can't play are hidden)"
    pad_choose_script = dadmod_anims_cat
    pad_choose_params = { cat = 10 }
    }
        thugpro_menu_finalize
        return
    endif
    FormatText TextName = favs "Starred (%n)  >" n = <count>
