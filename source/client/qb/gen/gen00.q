        Change Rail_Speed_Boost = 270
        Change Point_Rail_Speed_Boost = 225
    case 10
        Change skater_physics = ( skater_physics + { Skater_Max_Standing_Kick_Speed_Stat = { (788.0,992.0) STATS_SPEED #"switch" = (0.8,1.0) limit = 1800 } Skater_Max_Crouched_Kick_Speed_Stat = { (1064.0,1350.0) STATS_SPEED #"switch" = (0.8,1.0) limit = 1800 } Physics_Standing_Acceleration_Stat = { (786.0,875.0) STATS_SPEED #"switch" = standard_switch } Physics_Crouching_Acceleration_stat = { (1321.0,1500.0) STATS_SPEED #"switch" = standard_switch } Skater_Max_Speed_Stat = { (2271.0,2700.0) STATS_SPEED #"switch" = no_switch } Skater_Max_Max_Speed_Stat = { (2871.0,3300.0) STATS_SPEED #"switch" = no_switch } } )
        Change Rail_Speed_Boost = 300
        Change Point_Rail_Speed_Boost = 250
    endswitch
endscript

script dadmod_speed_cycle
    if ScreenElementExists id = dadmod_speed_item
        if dadmod_speed_item : GetSingleTag speed_lock
            if ( <speed_lock> = 1 )
                return
            endif
        endif
        dadmod_speed_item : SetTags speed_lock = 1
        SpawnScript dadmod_speed_unlock
    endif
    dadmod_speed_get
    if ScreenElementExists id = dadmod_speed_item
        if dadmod_speed_item : GetSingleTag speed_lvl
            lvl = <speed_lvl>
        endif
    endif
    if GotParam left
        lvl = ( <lvl> - 1 )
    else
        lvl = ( <lvl> + 1 )
    endif
    if ( <lvl> < 1 )
        lvl = 1
    endif
    if ( <lvl> > 10 )
        lvl = 10
    endif
    if ScreenElementExists id = dadmod_speed_item
        dadmod_speed_item : SetTags speed_lvl = <lvl>
    endif
    THUGRECOMP_SettingSave key = "player_speed" value = <lvl>
    dadmod_speed_apply
    dadmod_speed_text
    thugpro_menu_item_update_extra_text id = dadmod_speed_item text = <speed_text>
endscript

script dadmod_speed_unlock
    wait 6 gameframes
    if ScreenElementExists id = dadmod_speed_item
        dadmod_speed_item : SetTags speed_lock = 0
    endif
endscript

script dadmod_speed_tick
    dadmod_speed_get
    if ( <lvl> = 5 )
        return
    endif
    if ( <lvl> > 5 )
        if GotParam phys
            if not StructureContains structure = skater_physics dadmod_sonic
                dadmod_speed_phys
            endif
        endif
        return
    endif
    if LevelIs Load_MainMenu
        SetSlomo 1
        return
    endif
    if not ScreenElementExists id = root_window
        return
    endif
    if root_window : GetSingleTag menu_state
        if ( <menu_state> = on )
            return
        endif
    endif
    if ScreenElementExists id = current_menu_anchor
        return
    endif
    GetSkaterId
    if not ObjectExists id = <objID>
        return
    endif
    if <objID> : IsSkaterFocused
        return
    endif
    SetSlomo <mult>
endscript

script dadmod_anim_play
    LandSkaterTricks
    if GotParam loop
        PlayAnim anim = <anim> BlendPeriod = 0.3 cycle
    else
        PlayAnim anim = <anim> BlendPeriod = 0.3
    endif
    wait 10 game frame
    OnGroundExceptions
    if GotParam loop
        begin
            wait 1 gameframe
            if not GotParam move
                if Held up
                    break
                endif
                if Held down
                    break
                endif
                if Held left
                    break
                endif
                if Held right
                    break
                endif
            endif
        repeat
        goto OnGroundAi
    endif
    if SpeedLessThan 1
        SetRollingFriction 100
        WaitAnimWhilstChecking AndManuals
        goto HandBrake
    else
        WaitAnimWhilstChecking AndManuals
        goto OnGroundAi
    endif
endscript

script dadmod_anim_walk
    ResetEventHandlersFromTable GroundPunchState_ExceptionTable Group = WalkingStateExceptions
    SetEventHandler ex = JumpRequested scr = JumpRequestedEvent Group = WalkingEvents
    SetWalkingTrickState NewWalkingTrickState = GROUND
    Walk_ScaleAnimSpeed off
    if GotParam loop
        PlayWalkAnim anim = <anim> BlendPeriod = 0.2 cycle
        wait 10 gameframes
        begin
            wait 1 gameframe
            if not GotParam move
                if Held up
                    break
                endif
                if Held down
                    break
                endif
                if Held left
                    break
                endif
                if Held right
                    break
                endif
            endif
        repeat
    else
        PlayWalkAnim anim = <anim> BlendPeriod = 0.2
        WaitAnimWalking
    endif
    goto GroundOrAirWaitState
endscript

script dadmod_anim_pick
    THUGRECOMP_TextSave key = "anim_last" value = <t>
    THUGRECOMP_SettingSave key = "anim_last_i" value = <i>
    SpawnScript dadmod_anim_go params = { i = <i> } NotSessionSpecific = 1
endscript

script dadmod_anim_tri
    if THUGRECOMP_SettingLoad key = "anim_last_i"
        if ( <value> < 675 )
            SpawnScript dadmod_anim_go params = { i = <value> } NotSessionSpecific = 1
        endif
    endif
endscript

script dadmod_anim_go
    wait 2 gameframes
    dadmod_anim_kali_kill
    if not ObjectExists id = skater
        create_panel_message id = dadmod_anim_msg text = "You have no skater right now" time = 2500
        return
    endif
    if skater : GetSingleTag dadmod_tagging
        if ( <dadmod_tagging> = 1 )
            return
        endif
    endif
    e = ( dadmod_anim_list [ <i> ] )
    ae_anim = ( <e> . a )
    if not skater : AnimExists <ae_anim>
        create_panel_message id = dadmod_anim_msg text = "Your skater cannot play that one here" time = 2500
        return
    endif
    loop = 0
    if THUGRECOMP_SettingLoad key = "anim_loop"
        loop = <value>
    endif
    p = { anim = ( <e> . a ) }
    if ( <loop> = 1 )
        p = { <p> loop }
    endif
    dadmod_noclip_is_on
    if ( <dadmod_nc_on> = 1 )
        if ( <loop> = 1 )
            MakeSkaterGoto dadmod_noclip_state params = { play_anim = ( <e> . a ) play_loop }
        else
            MakeSkaterGoto dadmod_noclip_state params = { play_anim = ( <e> . a ) }
        endif
        return
    endif
    if THUGRECOMP_SettingLoad key = "anim_move"
        if ( <value> = 1 )
            p = { <p> move }
        endif
    endif
    if skater : walking
        if skater : Walk_Air
            create_panel_message id = dadmod_anim_msg text = "Land first, then pick the animation" time = 2500
            return
        endif
        MakeSkaterGoto dadmod_anim_walk params = <p>
        return
    endif
    if skater : InAir
        create_panel_message id = dadmod_anim_msg text = "Land first, then pick the animation" time = 2500
        return
    endif
    MakeSkaterGoto dadmod_anim_play params = <p>
endscript

script dadmod_anim_stop
    SpawnScript dadmod_anim_stop_go NotSessionSpecific = 1
endscript

script dadmod_anim_stop_go
    wait 2 gameframes
    dadmod_anim_kali_kill
    dadmod_anim_seq_kill
    dadmod_noclip_is_on
    if ( <dadmod_nc_on> = 1 )
        if ObjectExists id = skater
            MakeSkaterGoto dadmod_noclip_state
        endif
        return
    endif
    if ObjectExists id = skater
        if skater : walking
            if not skater : Walk_Air
                MakeSkaterGoto GroundOrAirWaitState
            endif
        else
            if not skater : InAir
                MakeSkaterGoto OnGroundAi
            endif
        endif
    endif
endscript

script dadmod_anim_loop_text
    loop = 0
    if THUGRECOMP_SettingLoad key = "anim_loop"
        loop = <value>
    endif
    if ( <loop> = 1 )
        return loop_text = "On" loop = 1
    endif
    return loop_text = "Off" loop = 0
endscript

script dadmod_anim_move_text
    mv = 0
    if THUGRECOMP_SettingLoad key = "anim_move"
        mv = <value>
    endif
    if ( <mv> = 1 )
        return move_text = "On" mv = 1
    endif
    return move_text = "Off" mv = 0
endscript

script dadmod_anim_move
    dadmod_anim_move_text
    THUGRECOMP_SettingSave key = "anim_move" value = ( 1 - <mv> )
    dadmod_anim_move_text
    thugpro_menu_item_update_extra_text id = dadmod_anim_move_item text = <move_text>
endscript

script dadmod_anim_loop
    dadmod_anim_loop_text
    THUGRECOMP_SettingSave key = "anim_loop" value = ( 1 - <loop> )
    dadmod_anim_loop_text
    thugpro_menu_item_update_extra_text id = dadmod_anim_loop_item text = <loop_text>
endscript

script dadmod_anim_star_text
    star = 0
    if THUGRECOMP_SettingLoad key = "anim_star"
        star = <value>
    endif
    if ( <star> = 1 )
        return star_text = "Star it" star = 1
    endif
    return star_text = "Play it" star = 0
endscript

script dadmod_anim_star
    dadmod_anim_star_text
    THUGRECOMP_SettingSave key = "anim_star" value = ( 1 - <star> )
    dadmod_anim_star_text
    thugpro_menu_item_update_extra_text id = dadmod_anim_star_item text = <star_text>
endscript

script dadmod_anim_square
    e = ( dadmod_anim_list [ <i> ] )
    if ( ( dadmod_anims_main ) = 1 )
        if ( ( dadmod_anims_single ) = 1 )
            THUGRECOMP_MenuFavAnim anim = ( <e> . a ) single = 1 label = ( <e> . t )
            dadmod_anims_back
            return
        endif
    endif
    if THUGRECOMP_MenuFavAnim anim = ( <e> . a ) toggle = 1
        thugpro_menu_item_update_extra_text id = <id> text = "*"
    else
        thugpro_menu_item_update_extra_text id = <id> text = " "
    endif
endscript

dadmod_anims_main = 0

dadmod_anims_single = 0

dadmod_anims_from_node = 0

script dadmod_anim_choose
    if ( ( dadmod_anims_main ) = 1 )
        dadmod_anim_square i = <i> id = <id>
    else
        dadmod_anim_pick i = <i> t = <t>
    endif
endscript

script dadmod_anim_seq_square
    if ( ( dadmod_anims_main ) = 1 )
        if ( ( dadmod_anims_single ) = 1 )
            THUGRECOMP_MenuFavAnim seq = <n> single = 1 label = <t>
            dadmod_anims_back
            return
        endif
    endif
    if THUGRECOMP_MenuFavAnim seq = <n> toggle = 1
        thugpro_menu_item_update_extra_text id = <id> text = "*"
    else
        thugpro_menu_item_update_extra_text id = <id> text = " "
    endif
endscript

script dadmod_anim_seq_choose
    if ( ( dadmod_anims_main ) = 1 )
        dadmod_anim_seq_square n = <n> id = <id> t = <t>
    else
        dadmod_anim_seq_pick n = <n> a = <a>
    endif
endscript

script dadmod_anims_menu_main single = 0
    Change dadmod_anims_main = 1
    Change dadmod_anims_single = <single>
    Change dadmod_anims_from_node = ( dadmod_layout_node )
    dadmod_anims_menu
endscript

script dadmod_anims_back
    if ( ( dadmod_anims_main ) = 1 )
        Change dadmod_anims_main = 0
        Change dadmod_anims_single = 0
        dadmod_layout_open node = ( dadmod_anims_from_node ) focus_id = mmopt_anims
    else
        dadmod_menu
    endif
endscript

script dadmod_idle_seq
    GetArraySize <pieces>
    n = <array_size>
    begin
        i = 0
        begin
            e = ( <pieces> [ <i> ] )
            if ( ( <e> . c ) = 1 )
                PlayAnim anim = ( <e> . a ) Cycle BlendPeriod = 0.2
            else
                PlayAnim anim = ( <e> . a ) BlendPeriod = 0.2
            endif
            wait ( <e> . t ) seconds
            if not AnimEquals ( <e> . a )
                return
            endif
            i = ( <i> + 1 )
        repeat <n>
    repeat
endscript

script dadmod_anim_seq_kill
    KillSpawnedScript Name = dadmod_idle_seq
endscript

script dadmod_anim_kali_kill
    KillSpawnedScript Name = aksequence1
    KillSpawnedScript Name = aksequence2
    KillSpawnedScript Name = aksequence3
    KillSpawnedScript Name = aksequence4
    KillSpawnedScript Name = aksequence5
    KillSpawnedScript Name = aksequence6
    KillSpawnedScript Name = aksequence7
    KillSpawnedScript Name = aksequence8
    KillSpawnedScript Name = anim78wrapper
    KillSpawnedScript Name = anim79wrapper
    KillSpawnedScript Name = anim80wrapper
    KillSpawnedScript Name = anim81wrapper
    KillSpawnedScript Name = anim82wrapper
    KillSpawnedScript Name = anim83wrapper
    KillSpawnedScript Name = anim84wrapper
    KillSpawnedScript Name = anim85wrapper
endscript

script dadmod_anim_seq_hold
    wait 10 gameframes
    begin
        wait 1 gameframe
        if Held up
            break
        endif
        if Held down
            break
        endif
        if Held left
            break
        endif
        if Held right
            break
        endif
    repeat
endscript

script dadmod_anim_seq_walk
    ResetEventHandlersFromTable GroundPunchState_ExceptionTable Group = WalkingStateExceptions
    SetEventHandler ex = JumpRequested scr = JumpRequestedEvent Group = WalkingEvents
    SetWalkingTrickState NewWalkingTrickState = GROUND
    Walk_ScaleAnimSpeed off
    OnExitRun dadmod_anim_seq_kill
    dadmod_anim_seq_kill
    SpawnSkaterScript dadmod_idle_seq params = { pieces = <pieces> }
    dadmod_anim_seq_hold
    dadmod_anim_seq_kill
    goto GroundOrAirWaitState
endscript

script dadmod_anim_seq_skate
    LandSkaterTricks
    OnGroundExceptions
    OnExitRun dadmod_anim_seq_kill
    dadmod_anim_seq_kill
    SetRollingFriction 100
    SpawnSkaterScript dadmod_idle_seq params = { pieces = <pieces> }
    dadmod_anim_seq_hold
    dadmod_anim_seq_kill
    goto OnGroundAi
endscript

script dadmod_anim_seq_pieces
