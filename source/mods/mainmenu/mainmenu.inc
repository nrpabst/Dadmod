}

// ---- camera shapes. Orbit angles count from the skater's front (g_face): 0 = in front, looking at their face.
static void LatchFace(void* params) {
    Vec f = V(0, 0, 0);
    if (g_spot >= 0 && g_spot < (int)g_cfg.spotList.size() && g_cfg.spotList[g_spot].hasDir) f = g_cfg.spotList[g_spot].dir;
    else f = V(FloatParam(params, "fx", 0), 0, FloatParam(params, "fz", 0));
    f.y = 0;
    if (sqrtf(f.x * f.x + f.z * f.z) > 1e-3f) g_face = Norm(f);
    else if (!g_faceValid) g_face = V(0, 0, 1);
    g_faceValid = true;
}
static Vec OrbitPos(Vec skater, float radius, float height, float angleDeg) {
    float a = atan2f(g_face.x, g_face.z) + angleDeg * 3.14159265f / 180.0f;
    return Add(skater, V(sinf(a) * radius, height, cosf(a) * radius));
}
static float OrbitAngle(const Cam& k, float t) {
    if (k.swing > 0.5f) return k.start + k.swing * sinf(k.speed * t / k.swing);  // starts moving at `speed`, turns back at +-swing
    return k.start + k.speed * t;
}
// framing = left/right: aim beside the skater so they sit in that half of the screen
static Vec Framed(Vec pos, Vec target, Vec dir) {
    if (!g_cfg.framing) return dir;
    Vec f = Norm(Sub(target, pos));
    Vec right = Norm(V(f.z, 0, -f.x));               // up x forward, y up
    float dist = sqrtf((target.x - pos.x) * (target.x - pos.x) + (target.y - pos.y) * (target.y - pos.y) + (target.z - pos.z) * (target.z - pos.z));
    Vec aim = Add(target, Mul(right, (float)g_cfg.framing * dist * 0.36f));  // ~quarter screen at 72 deg FOV
    return Norm(Sub(pos, aim));
}
static void CamPose(const Cam& k, Vec skater, float t, Vec* outPos, Vec* outDir) {
    Vec target = Add(skater, V(0, k.look, 0));
    Vec pos, dir;
    if (k.style == "orbit") {
        pos = OrbitPos(skater, k.radius, k.height, OrbitAngle(k, t));
        dir = Norm(Sub(pos, target));  // cameras look down -dir
    } else if (k.style == "look") {
        pos = k.pos; dir = Norm(Sub(pos, target));
    } else if (k.style == "pan") {
        float ph = fmodf(t / k.seconds, 2.0f);
        float u = ph < 1 ? ph : 2 - ph;
        u = u * u * (3 - 2 * u);
        pos = Lerp(k.pos, k.pos2, u); dir = Norm(Sub(pos, target));
    } else if (k.style == "sway") {
        pos = Add(k.pos, V(sinf(t * 0.5f) * k.amount, sinf(t * 0.37f) * k.amount * 0.5f, cosf(t * 0.43f) * k.amount));
        dir = Norm(Add(k.dir, V(sinf(t * 0.3f) * k.amount * 0.002f, 0, cosf(t * 0.27f) * k.amount * 0.002f)));
    } else {
        pos = k.pos; dir = k.dir;
    }
    if (k.style != "fixed" && k.style != "sway") dir = Framed(pos, target, dir);
    *outPos = pos; *outDir = dir;
}
// glides from where the camera was to the new shot (smoothstep), and remembers what was shown
static void ApplyBlend(Vec* pos, Vec* dir, DWORD now) {
    if (g_bDur > 0) {
        float u = (now - g_bAt) / (g_bDur * 1000.0f);
        if (u >= 1) g_bDur = 0;
        else {
            u = u * u * (3 - 2 * u);
            *pos = Lerp(g_bFromPos, *pos, u);
            *dir = Norm(Lerp(g_bFromDir, *dir, u));
        }
    }
    g_outPos = *pos; g_outDir = *dir; g_outValid = true;
}
// QB ctx: 1 main list, 2 ss_menu, 3 Dadmod pages, 4 Edit Skater start, 5 edit list / pre-made / info, 6 part options,
// 7 the screen of one option (pieces, colors, position, scale)
static int MenuCtx(int qb) {
    switch (qb) {
    case 4: return CTX_CAS;
    case 5: return CTX_EDIT;
    case 6: case 7: return g_optCtx;
    case 8: return CTX_SELECT;
    case 11: return CTX_LEVELSEL;  // 7 = an item's own screen (Pants A, B...), opened from the part list
    default: return CTX_MAIN;
    }
}
static DWORD g_ctxAt;

// THUGRECOMP_MenuFocus text="Shoes" -> the highlighted option in an Edit Skater part list (the menu driver sends it):
// when that option is chosen and its screen opens, the camera glides to that item ([item <text>] in mainmenu.ini, else the built-in guess from its name)
static bool __cdecl CF_MenuFocus(void* params, void*) {
    const char* text = nullptr;
    GetStringParam(params, "text", &text);
    if (!text) return false;
    std::string t;
    for (const char* p = text; *p; ++p) {
        if (p[0] == '\\' && (p[1] == 'c' || p[1] == 'C') && p[2]) { p += 2; continue; }
        t += (char)tolower((unsigned char)*p);
    }
    t = Trim(t);
    {   // "back" as a whole word (Tattoo Back, Shirt Back Logo), not inside another word
        g_itemBack = false;
        for (size_t at = t.find("back"); at != std::string::npos; at = t.find("back", at + 1)) {
            bool l = at == 0 || !isalpha((unsigned char)t[at - 1]), r = at + 4 >= t.size() || !isalpha((unsigned char)t[at + 4]);
            if (l && r) g_itemBack = true;
        }
    }
    auto it = g_cfg.items.find(t);
    if (it != g_cfg.items.end()) { g_item = it->second; g_itemOn = true; return true; }
    struct Rule { const char* word; ItemCam cam; };
    static const Rule kRules[] = {   // checked in order; look = height on the skater, dist = distance, tilt = degrees
        { "shoe", { 6, 55, 8 } },  { "sock", { 10, 55, 10 } }, { "knee", { 22, 55, 10 } }, { "shin", { 18, 55, 10 } },
        { "pant", { 26, 80, 10 } }, { "short", { 30, 70, 10 } }, { "leg", { 26, 80, 10 } },
        { "hat", { 72, 42, 18 } },  { "helmet", { 72, 42, 18 } }, { "hair", { 70, 42, 15 } },
        { "glass", { 64, 34, 5 } }, { "eye", { 64, 32, 5 } }, { "face", { 63, 36, 5 } }, { "beard", { 61, 36, 3 } },
        { "mustache", { 61, 36, 3 } }, { "facial", { 61, 36, 3 } }, { "head", { 64, 40, 8 } }, { "skin", { 60, 45, 8 } },
        { "glove", { 40, 55, 15 } }, { "hand", { 40, 55, 15 } }, { "wrist", { 42, 50, 12 } }, { "elbow", { 46, 55, 12 } },
        { "arm", { 46, 60, 12 } },  { "sleeve", { 48, 60, 12 } }, { "jacket", { 46, 70, 10 } }, { "shirt", { 48, 65, 10 } },
        { "torso", { 48, 65, 10 } }, { "chest", { 50, 60, 10 } }, { "back", { 48, 65, 10 } }, { "tattoo", { 48, 65, 10 } },
        { "grip", { 24, 55, 35 } }, { "wheel", { 12, 50, 10 } }, { "truck", { 14, 50, 10 } }, { "graphic", { 26, 60, 10 } },
        { "deck", { 26, 60, 10 } }, { "board", { 26, 65, 12 } },
    };
    for (auto& r : kRules) if (t.find(r.word) != std::string::npos) { g_item = r.cam; g_itemOn = true; return true; }
    g_itemOn = false;  // colors, sizes...: stay on the part's own shot
    return false;
}

// Called every frame while the main menu is up. `restart` = the driver just started (menu entered).
// ctx = which screen is open (see MenuCtx); fx fy fz = the skater's facing.

// ---- Edit Skater camera from keyboard and mouse (Noah 2026-11-20: every control needs a keyboard way)
// number pad + / - zoom like RT / LT; Page Up / Page Down tilt like the right stick; holding the
// left mouse button and dragging turns (left / right) and tilts (up / down), when the drag starts on the left
// 55% of the window, away from the menu list on the right; the scroll wheel zooms. Only while the game window is
// in front. The wheel is read from the game window's messages (its window procedure is chained, everything is
// passed on unchanged).
// ---- one shared hook of the game's main window (Noah 2026-11-20, clickable menus): counts wheel notches and
// left / right button presses, split by where the pointer was (the left 55% of the window = the skater side in
// Edit Skater). Everything is passed on unchanged. Re-hooks if the game window changes; never calls a null prev.
static const DWORD kGameWnd = 0x7D6A28;     // HWND of the game window (the one thugpro.dll compares)
static WNDPROC g_mPrev;
static HWND g_mWnd;
static bool g_mUni;   // chained the same way the window was made (Unicode or not), so typing isn't changed
static volatile LONG g_wheelL, g_wheelR, g_lClickL, g_lClickR, g_rClick, g_lClickCorner, g_mClick;
static volatile LONG g_rClickPlay;   // right clicks for pause during play (Noah 2026-11-21), taken by CF_MouseRightPause
static const int kCornerPx = 40;   // the Back button square (34 px) and a little room: never the camera's
static volatile DWORD g_mouseEvAt;           // last wheel / button message
static HWND GameWnd() { HWND h = *(HWND*)kGameWnd; return (h && IsWindow(h)) ? h : nullptr; }
static bool LeftSide(HWND h, int cx) {
    RECT r; if (!GetClientRect(h, &r) || r.right <= 0) return false;
    return cx < r.right * 55 / 100;
}
// The click that brings the game window back to the front must not press anything (Noah 2026-11-20): when the
// window is activated, the next button press (and anything within 250 ms) is ignored by all our mouse handling.
static volatile DWORD g_activateAt;
static volatile LONG g_swallowClick;
static bool ActivationClick() {
    DWORD now = GetTickCount();
    bool recent = g_activateAt && now - g_activateAt < 1000;   // the activating click arrives within a few ms
    if ((InterlockedExchange(&g_swallowClick, 0) && recent) || (g_activateAt && now - g_activateAt < 250)) {
        Log("mouse: activation click ignored");
        return true;
    }
    return false;
}
// The dadmod wheel cursor (Noah 2026-11-20): while the mouse menus are active, the real Windows cursor over the game's
// client area is our animated wheel (24 frames, about one turn a second, hotspot = the blue tip). Title bar, borders and
// everything outside the window keep the normal cursor; nothing system-wide changes. Frames: cursor_frames.inc, made by
// work/tools/make_cursor_frames.py + make_cursor_inc.py.
#include "cursor_frames.inc"
static volatile LONG g_hideCursor;          // 1 = our cursor is active (mouse menus in use)
static HCURSOR g_curFrames[24];
static volatile LONG g_curFrame;
static int g_curShowCalls;                   // ShowCursor(TRUE) calls we made, undone when the menus go idle
static const UINT_PTR kCurTimer = 0xDAD1;
static HCURSOR MakeWheelCursor(const unsigned int* px, int s) {
    BITMAPV5HEADER bi = {};
    bi.bV5Size = sizeof bi; bi.bV5Width = s; bi.bV5Height = -s; bi.bV5Planes = 1; bi.bV5BitCount = 32;
    bi.bV5Compression = BI_BITFIELDS;
    bi.bV5RedMask = 0x00FF0000; bi.bV5GreenMask = 0x0000FF00; bi.bV5BlueMask = 0x000000FF; bi.bV5AlphaMask = 0xFF000000;
    void* bits = nullptr;
    HDC dc = GetDC(nullptr);
    HBITMAP col = CreateDIBSection(dc, (BITMAPINFO*)&bi, DIB_RGB_COLORS, &bits, nullptr, 0);
    ReleaseDC(nullptr, dc);
    if (!col || !bits) return nullptr;
    memcpy(bits, px, (size_t)s * s * 4);
    HBITMAP mask = CreateBitmap(s, s, 1, 1, nullptr);
    ICONINFO ii = {};
    ii.fIcon = FALSE; ii.xHotspot = 0; ii.yHotspot = 0; ii.hbmMask = mask; ii.hbmColor = col;
    HCURSOR c = (HCURSOR)CreateIconIndirect(&ii);
    DeleteObject(col);
    if (mask) DeleteObject(mask);
    return c;
}
static void EnsureWheelCursors(HWND h) {
    if (g_curFrames[0]) return;
    UINT dpi = 96;
    typedef UINT (WINAPI* DpiFn)(HWND);
    DpiFn fn = (DpiFn)GetProcAddress(GetModuleHandleA("user32.dll"), "GetDpiForWindow");
    if (fn && h) dpi = fn(h);
    if (!dpi) dpi = 96;
    int sys = GetSystemMetrics(SM_CXCURSOR);           // 32 at 100% (larger when the user enlarged the cursor)
    int want = sys > 32 ? sys : 32;
    if (dpi >= 120 && want < 40) want = 40;
    if (dpi >= 144 && want < 48) want = 48;
    if (dpi >= 192 && want < 64) want = 64;
    int s = want >= 64 ? 64 : want >= 48 ? 48 : want >= 40 ? 40 : 32;
    const unsigned int* base = s == 64 ? &curframes::kCur64[0][0] : s == 48 ? &curframes::kCur48[0][0]
                             : s == 40 ? &curframes::kCur40[0][0] : &curframes::kCur32[0][0];
    for (int i = 0; i < 24; ++i) g_curFrames[i] = MakeWheelCursor(base + (size_t)i * s * s, s);
    Log("mouse: wheel cursor ready, %d px frames (dpi %u, system cursor %d)", s, dpi, sys);
}
static bool CursorInClient(HWND h) {
    POINT p; RECT r;
    if (!h || !GetCursorPos(&p) || WindowFromPoint(p) != h) return false;
    ScreenToClient(h, &p);
    return GetClientRect(h, &r) && p.x >= 0 && p.y >= 0 && p.x < r.right && p.y < r.bottom;
}
static void SetWheelCursorActive(HWND h, bool on) {
    if (on) {
        EnsureWheelCursors(h);
        if (h) SetTimer(h, kCurTimer, 40, nullptr);
        int n = 0;
        while (ShowCursor(TRUE) < 0 && n < 64) ++n;   // the game may have hidden the cursor (fullscreen)
        g_curShowCalls = n + 1;
        if (CursorInClient(h) && g_curFrames[g_curFrame % 24]) SetCursor(g_curFrames[g_curFrame % 24]);
    } else {
        if (h) KillTimer(h, kCurTimer);
        for (; g_curShowCalls > 0; --g_curShowCalls) ShowCursor(FALSE);   // back to the game's own hide state
        if (h) SendMessageA(h, WM_SETCURSOR, (WPARAM)h, MAKELPARAM(HTCLIENT, WM_MOUSEMOVE));   // the game's cursor again
    }
}
static LRESULT CALLBACK MouseWndProc(HWND h, UINT m, WPARAM w, LPARAM l) {
    if (m == WM_SETCURSOR && LOWORD(l) == HTCLIENT && g_hideCursor) {
        HCURSOR c = g_curFrames[g_curFrame % 24];
        SetCursor(c);
        return TRUE;
    }
    if (m == WM_TIMER && w == kCurTimer) {
        if (g_hideCursor) {
            LONG f = (g_curFrame + 1) % 24;
            g_curFrame = f;
            if (CursorInClient(h) && g_curFrames[f]) SetCursor(g_curFrames[f]);
        }
        return 0;
    }
    if (m == WM_DESTROY) {
        KillTimer(h, kCurTimer);
        for (int i = 0; i < 24; ++i) if (g_curFrames[i]) { DestroyCursor(g_curFrames[i]); g_curFrames[i] = nullptr; }
    }
    if ((m == WM_ACTIVATE && LOWORD(w) != WA_INACTIVE) || (m == WM_ACTIVATEAPP && w) || m == WM_MOUSEACTIVATE) {
        if (GetForegroundWindow() != h || m != WM_MOUSEACTIVATE) { g_activateAt = GetTickCount(); InterlockedExchange(&g_swallowClick, 1); }
    }
    if ((m == WM_LBUTTONDOWN || m == WM_LBUTTONDBLCLK || m == WM_RBUTTONDOWN || m == WM_RBUTTONDBLCLK) && ActivationClick()) {
        // swallowed: falls through to the game unchanged, our counters stay as they are
    } else if (m == WM_MOUSEWHEEL) {
        POINT p = { (short)LOWORD(l), (short)HIWORD(l) };
        ScreenToClient(h, &p);
        InterlockedExchangeAdd(LeftSide(h, p.x) ? &g_wheelL : &g_wheelR, (LONG)GET_WHEEL_DELTA_WPARAM(w));
        g_mouseEvAt = GetTickCount();
    } else if (m == WM_LBUTTONDOWN || m == WM_LBUTTONDBLCLK) {
        int cx = (short)LOWORD(l), cy = (short)HIWORD(l);
        // the Back button sits in the top-left corner, inside the Edit Skater camera's side: count it on its own so
        // the camera never swallows it (Noah 2026-11-20: Back "worked the first time ... then it stopped working")
        if (cx >= 0 && cy >= 0 && cx < kCornerPx && cy < kCornerPx) InterlockedIncrement(&g_lClickCorner);
        else InterlockedIncrement(LeftSide(h, cx) ? &g_lClickL : &g_lClickR);
        g_mouseEvAt = GetTickCount();
    } else if (m == WM_RBUTTONDOWN || m == WM_RBUTTONDBLCLK) {
        InterlockedIncrement(&g_rClick);
        InterlockedIncrement(&g_rClickPlay);
        g_mouseEvAt = GetTickCount();
    } else if (m == WM_MBUTTONDOWN) {
        InterlockedIncrement(&g_mClick);   // the walk camera's reset
    }
    WNDPROC prev = (h == g_mWnd) ? g_mPrev : (WNDPROC)GetPropA(h, "dadmod_mprev");   // each hooked window keeps its own
    bool uni = IsWindowUnicode(h) != 0;
    if (!prev) return uni ? DefWindowProcW(h, m, w, l) : DefWindowProcA(h, m, w, l);
    return uni ? CallWindowProcW(prev, h, m, w, l) : CallWindowProcA(prev, h, m, w, l);
}
static HWND MouseHookEnsure() {
    HWND h = GameWnd();
    if (!h) return nullptr;
    if (h == g_mWnd) return h;
    bool uni = IsWindowUnicode(h) != 0;
    LONG_PTR cur = uni ? GetWindowLongPtrW(h, GWLP_WNDPROC) : GetWindowLongPtrA(h, GWLP_WNDPROC);
    if (!cur || cur == (LONG_PTR)MouseWndProc) return nullptr;
    g_mUni = uni;
    g_mPrev = (WNDPROC)cur;
    g_mWnd = h;
    LONG_PTR old = uni ? SetWindowLongPtrW(h, GWLP_WNDPROC, (LONG_PTR)MouseWndProc)
                       : SetWindowLongPtrA(h, GWLP_WNDPROC, (LONG_PTR)MouseWndProc);
    if (!old) { g_mWnd = nullptr; g_mPrev = nullptr; return nullptr; }
    g_mPrev = (WNDPROC)old;
    SetPropA(h, "dadmod_mprev", (HANDLE)old);
    Log("mouse: game window hooked (wheel and clicks)");
    return h;
}
static bool GameInFront(HWND h) { return h && GetForegroundWindow() == h && IsWindowVisible(h) && !IsIconic(h); }
static volatile DWORD g_camMouseAt;
static volatile bool g_pointerOnUi;          // the pointer is on a menu row / Back / Next (the camera must not drag)          // Edit Skater camera read the mouse (the skater side belongs to it)

static volatile bool g_camDragReset;          // set while a screen without the skater camera is up (MenuTick)
static void CamKeysMouse(float* zin, float* zout, float* tilt, float* yaw, float* el) {
    static bool s_drag, s_btnWas = true; static POINT s_last; static DWORD s_wheelAt; static float s_wheelZ;
    HWND fw = MouseHookEnsure();
    DWORD nowCam = GetTickCount();
    if (nowCam - g_camMouseAt > 2500) InterlockedExchange(&g_wheelL, 0);   // nothing left over from before
    // back on a camera screen after another screen (2026-11-21, Noah: skater select camera swung round behind the
    // skater after Select -> next screen -> Back): the release of the click that left this screen happened where
    // nobody was listening, so drop any drag and treat the button as already held (only a fresh press drags)
    if (g_camDragReset || nowCam - g_camMouseAt > 1500) { g_camDragReset = false; s_drag = false; s_btnWas = true; }
    g_camMouseAt = nowCam;
    if (!GameInFront(fw)) { s_drag = false; s_btnWas = true; InterlockedExchange(&g_wheelL, 0); return; }
    auto key = [](int vk) { return (GetAsyncKeyState(vk) & 0x8000) != 0; };
    // zoom is on the number pad + / - only (Noah 2026-11-20: the main-row - and = are often rotate keys);
    // Page Up / Page Down tilt unless a game action is bound to them
    bool pgUpBound = false, pgDnBound = false;
    const int* kb = (const int*)padhub::kKb0Binds;   // DirectInput scan codes of the 24 keyboard actions
    for (int i = 0; i < 24; ++i) { if (kb[i] == 0xC9) pgUpBound = true; if (kb[i] == 0xD1) pgDnBound = true; }
    if (key(VK_ADD)) *zin = 1;
    if (key(VK_SUBTRACT)) *zout = 1;
    *tilt = (!pgUpBound && key(VK_PRIOR) ? 1.f : 0.f) - (!pgDnBound && key(VK_NEXT) ? 1.f : 0.f);
    // wheel: each notch zooms for a short moment (one notch = about a quarter second of a full trigger pull)
    LONG wd = InterlockedExchange(&g_wheelL, 0);   // the wheel over the skater zooms; over the menu it scrolls
    DWORD now = GetTickCount();
    if (wd) { s_wheelZ = wd > 0 ? 1.f : -1.f; s_wheelAt = now + 80 * (DWORD)(wd > 0 ? wd : -wd) / WHEEL_DELTA + 170; }
    if (s_wheelAt && (LONG)(s_wheelAt - now) > 0) { if (s_wheelZ > 0) *zin = 1; else *zout = 1; }
    else s_wheelAt = 0;
    POINT cp;
    bool btn = key(VK_LBUTTON), freshPress = btn && !s_btnWas;
    s_btnWas = btn;
    if (btn && GetCursorPos(&cp)) {
        if (!s_drag) {
            if (!freshPress) return;   // a button already down when this screen opened never starts a drag
            POINT c = cp; RECT r;
            bool focusClick = g_activateAt && GetTickCount() - g_activateAt < 1000;   // not the click that focused the window
            if (!focusClick && !g_pointerOnUi && ScreenToClient(fw, &c) && GetClientRect(fw, &r) && r.right > 0 && c.x >= 0 && c.y >= 0 && c.x < r.right * 55 / 100 && c.y < r.bottom
                && !(c.x < kCornerPx && c.y < kCornerPx)) {   // not on the Back button
                s_drag = true; s_last = cp;
            }
        } else {
            LONG dx = cp.x - s_last.x, dy = cp.y - s_last.y;
            if (dx > 300 || dx < -300 || dy > 300 || dy < -300) { s_drag = false; return; }   // no real drag jumps that far in one frame
            *yaw = dx * 0.4f;     // degrees per pixel
            *el = dy * 0.3f;      // drag down raises the camera (look from above)
            s_last = cp;
        }
    } else s_drag = false;
}

// ---- walk-mode mouse camera (Noah 2026-11-21). THUGRECOMP_WalkCam on sx sy sz hx hz cpx cpy cpz cdx cdy cdz
// (QB: dadmod_walkcam_tick, mouse.q). on = 1 while the skater is on foot with nothing else owning the camera,
// s = skater position, h = his heading (Obj_GetOrientation x/z), cp/cd = the normal skater camera's position and
// orientation dir. Nothing changes until the left button is held and dragged over the game (or the wheel turns):
// then the camera sits on a sphere around his chest like Edit Skater (drag = yaw all the way round, pitch -10..70
// degrees, wheel = zoom), kept relative to his heading, and follows him while he walks. Middle click or on = 0
// eases back to the normal camera. Returns wc_state 0 = normal camera, 1 = ours (cam_pos / cam_dir), 2 = just
// finished easing back (QB gives the skater camera back).
static bool __cdecl CF_WalkCam(void* params, void* script) {
    static bool s_engaged, s_out, s_drag, s_btnWas = true, s_wasOn, s_restSet;
    static Vec s_rest;
    static float s_yaw, s_yawTo, s_el, s_elTo, s_dist, s_distTo, s_w;
    static POINT s_last;
    static DWORD s_at;
    const float kLook = 50.0f, kMinD = 45.0f, kMaxD = 650.0f, kRad = 3.14159265f / 180.0f;
    DWORD now = GetTickCount();
    float dt = s_at ? (now - s_at) / 1000.0f : 0.016f;
    if (dt > 0.1f) dt = 0.1f;
    if (dt < 0) dt = 0;
    s_at = now;
    if (IntParam(params, "quit", 0)) {   // the skater or his camera is gone (level change): no easing, just stop
        if (s_engaged) { s_engaged = false; s_out = false; s_w = 0; s_drag = false; s_btnWas = true; s_wasOn = false; RetInt(script, "wc_state", 2); Log("walkcam: off (no skater)"); }
        return true;
    }
    bool on = IntParam(params, "on", 0) != 0;
    bool nc = IntParam(params, "nc", 0) != 0;
    Vec sk = V(FloatParam(params, "sx", 0), FloatParam(params, "sy", 0), FloatParam(params, "sz", 0));
    float hx = FloatParam(params, "hx", 0), hz = FloatParam(params, "hz", 1);
    Vec cp = V(FloatParam(params, "cpx", 0), FloatParam(params, "cpy", 0), FloatParam(params, "cpz", 0));
    Vec cd = V(FloatParam(params, "cdx", 0), FloatParam(params, "cdy", 0), FloatParam(params, "cdz", 1));
    float head = (hx * hx + hz * hz > 1e-6f) ? atan2f(hx, hz) / kRad : 0.0f;
    Vec target = Add(sk, V(0, kLook, 0));
    HWND fw = MouseHookEnsure();
    if (!on || !s_wasOn) {   // nothing left over from before (menus, the board) starts a zoom or a reset
        InterlockedExchange(&g_mClick, 0);
        if (!on) { s_drag = false; s_btnWas = true; }
        else { InterlockedExchange(&g_wheelL, 0); InterlockedExchange(&g_wheelR, 0); }
    }
    s_wasOn = on;
    if (!s_engaged) {
        if (!on || !GameInFront(fw)) { s_btnWas = true; return true; }
        bool btn = (GetAsyncKeyState(VK_LBUTTON) & 0x8000) != 0, fresh = btn && !s_btnWas;
        s_btnWas = btn;
        LONG wd = InterlockedExchange(&g_wheelL, 0) + InterlockedExchange(&g_wheelR, 0);
        InterlockedExchange(&g_mClick, 0);
        bool start = wd != 0;
        POINT cpos;
        if (fresh && GetCursorPos(&cpos)) {
            POINT c = cpos; RECT r;
            bool focusClick = g_activateAt && now - g_activateAt < 1000;
            if (!focusClick && ScreenToClient(fw, &c) && GetClientRect(fw, &r) && c.x >= 0 && c.y >= 0 && c.x < r.right && c.y < r.bottom
                && !(c.x < kCornerPx && c.y < kCornerPx)) { s_drag = true; s_last = cpos; }
        }
        if (s_drag && btn && GetCursorPos(&cpos) && (cpos.x != s_last.x || cpos.y != s_last.y)) start = true;
        if (!btn) s_drag = false;
        if (padhub::g_padActive) start = false;   // a pad in use keeps the normal camera (Noah 2026-11-22)
        if (!start) return true;
        // take over from exactly where the normal camera is
        Vec off = Sub(cp, target);
        float flat = sqrtf(off.x * off.x + off.z * off.z), d = sqrtf(flat * flat + off.y * off.y);
        if (d < 1.0f) { off = V(-hx, 0.3f, -hz); flat = 1; d = 150; }
        s_dist = s_distTo = d < kMinD ? kMinD : d > kMaxD ? kMaxD : d;
        s_el = s_elTo = atan2f(off.y, flat > 1e-3f ? flat : 1e-3f) / kRad;
        if (s_elTo < -10) s_elTo = -10;
        if (s_elTo > 70) s_elTo = 70;
        s_yaw = s_yawTo = atan2f(off.x, off.z) / kRad - head;
        if (wd) { s_distTo *= powf(0.85f, (float)wd / WHEEL_DELTA); }
        s_engaged = true; s_out = false; s_w = 0;
        Log("walkcam: on (dist %.0f, tilt %.0f)", s_dist, s_el);
    }
    if (!on || InterlockedExchange(&g_mClick, 0)) {
        if (!s_out) Log("walkcam: back to the skater camera%s", on ? " (middle click)" : "");
        s_out = true; s_drag = false;
    }
    // the controller picked up again (Noah 2026-11-22: after a drag the pad was "bugged until you get back on the board":
    // our camera follows his heading, so camera-relative stick steering kept turning him and the right stick did
    // nothing): any pad button or stick past drift eases back to the normal skater camera.
    if (!s_out && padhub::g_padActive) { Log("walkcam: back to the skater camera (controller)"); s_out = true; s_drag = false; }
    // let go once he walks (Noah 2026-11-22: "it gets stuck behind the skater and you can't turn properly, it's like
    // it doesn't let go"): with the button up, moving more than 20 units from where the drag ended eases back to the
    // normal camera, which turns with him again. Noclip keeps it (flying follows the camera there).
    if (s_drag || s_out || nc) s_restSet = false;
    else if (!s_restSet) { s_rest = sk; s_restSet = true; }
    else { Vec mv = Sub(sk, s_rest); if (mv.x * mv.x + mv.y * mv.y + mv.z * mv.z > 400.0f) { Log("walkcam: back to the skater camera (walked)"); s_out = true; s_restSet = false; } }
    if (!s_out && GameInFront(fw)) {
        bool btn = (GetAsyncKeyState(VK_LBUTTON) & 0x8000) != 0, fresh = btn && !s_btnWas;
        s_btnWas = btn;
        POINT cpos;
        if (btn && GetCursorPos(&cpos)) {
            if (!s_drag) {
                POINT c = cpos; RECT r;
                bool focusClick = g_activateAt && now - g_activateAt < 1000;
                if (fresh && !focusClick && ScreenToClient(fw, &c) && GetClientRect(fw, &r) && c.x >= 0 && c.y >= 0 && c.x < r.right && c.y < r.bottom
                    && !(c.x < kCornerPx && c.y < kCornerPx)) { s_drag = true; s_last = cpos; }
            } else {
                LONG dx = cpos.x - s_last.x, dy = cpos.y - s_last.y;
                if (dx > 300 || dx < -300 || dy > 300 || dy < -300) s_drag = false;
                else { s_yawTo -= dx * 0.4f; s_elTo += dy * 0.3f; }
                s_last = cpos;
            }
        } else s_drag = false;
        LONG wd = InterlockedExchange(&g_wheelL, 0) + InterlockedExchange(&g_wheelR, 0);
        if (wd) s_distTo *= powf(0.85f, (float)wd / WHEEL_DELTA);   // wheel up zooms in
        if (s_elTo < -10) s_elTo = -10;
        if (s_elTo > 70) s_elTo = 70;
        s_distTo = s_distTo < kMinD ? kMinD : s_distTo > kMaxD ? kMaxD : s_distTo;
    } else if (!GameInFront(fw)) { s_drag = false; s_btnWas = true; }
    float k = 14.0f * dt; k = k > 1 ? 1 : k;
    s_yaw += (s_yawTo - s_yaw) * k;
    s_el += (s_elTo - s_el) * k;
    s_dist += (s_distTo - s_dist) * k;
    s_w += (s_out ? -dt / 0.3f : dt / 0.2f);   // eases in over 0.2 s, back out over 0.3 s
    if (s_w > 1) s_w = 1;
    if (s_out && s_w <= 0) {
        s_engaged = false; s_out = false; s_w = 0; s_btnWas = true;
        RetInt(script, "wc_state", 2);
        return true;
    }
    float a = (head + s_yaw) * kRad, el = s_el * kRad;
    Vec pos = Add(target, V(sinf(a) * cosf(el) * s_dist, sinf(el) * s_dist, cosf(a) * cosf(el) * s_dist));
    Vec dir = Norm(Sub(pos, target));
    float w = s_w < 0 ? 0 : s_w;
    w = w * w * (3 - 2 * w);
    if (w < 1) {
        pos = Add(Mul(cp, 1 - w), Mul(pos, w));
        Vec cdn = Norm(cd);
        dir = Norm(Add(Mul(cdn, 1 - w), Mul(dir, w)));
    }
    RetInt(script, "wc_state", 1);
    RetVec(script, "cam_pos", pos);
    RetVec(script, "cam_dir", dir);
    return true;
}

// ---- clickable menus (Noah 2026-11-20). THUGRECOMP_MouseMenu id = <menu> (QB: dadmod_mouse_tick, menuitem.q) returns
//   hit (child index, -1 none), hit_id (that child's id), side (0 left third, 1 middle, 2 right third), x y (pointer in
//   640x480 menu space), click, rclick, wheel (notches, + = up; all taken by this call), moved, active (the mouse is
//   in use: moved / clicked in the last 3 s and no key or pad press since), syscursor (Windows draws its own pointer),
//   corner_x corner_y (the window's top-left corner in menu space), px_unit px_unit_y (menu units per screen pixel),
//   over_back (pointer on the 34 px Back button in that corner).
// Rows are found from the engine's own on-screen (summed) transform of each child, so parents, scrolling and
// animations are all included. Engine screen element fields (THUGPro.exe, from the transform update 0x4A9D30):
//   +0x14 id, +0x18 type, +0x4C parent, +0x58 first child, +0x64 next sibling, +0x114 summed alpha,
//   +0x134/+0x138 summed upper-left, +0x13C/+0x140 summed scale, +0x160/+0x164 base width/height.
// Elements are looked up by id on every call (0x4AD1E0, like ScreenElementExists) and never kept.
static const DWORD kElemMgr      = 0x701440;   // screen element manager
static const DWORD kElemResolve  = 0x4AD1E0;   // thiscall(mgr, ref*, params, key, assert) -> ref*
static const DWORD kElemRelease  = 0x4637E0;   // thiscall(elem, ref*)
static const DWORD kWindowType   = 0xA13ADBB7; // "WindowElement" (clips its children)
static const float kBackPx = 34.0f;            // Back button size in screen pixels

// Where the 640x480 menu space lands in the backbuffer: the engine's screen struct at 0x786B90 (thugpro.dll keeps a
// pointer to it at +0x8CC98 and changes it in THUGPRO_ToggeScreenElementScaling, 0x10010600). +0x1DC width, +0x1E0
// height, +0x1F0 x scale, +0x1F4 y scale, +0x1F8 x offset, +0x1FC y offset (pixels): the element draw code
// (0x5Cxxxx, "x * [+0x1F0] + [+0x1F8]") uses exactly these. Noah's 1760x990 window: 2.2 / 2.0625 / 176 / 33, so
// menus sit 33 px lower than a plain y * H / 480 (the first build missed the y offset: pointer and Back button 33 px low).
struct MenuSpace { float xs, ys, xo, yo; int w, h; bool ok; };
static MenuSpace GetMenuSpace() {
    MenuSpace s = { 1, 1, 0, 0, 0, 0, false };
    char* p = (char*)0x786B90;
    if (IsBadReadPtr(p + 0x1DC, 0x24)) return s;
    int w = *(int*)(p + 0x1DC), h = *(int*)(p + 0x1E0);
    float xs = *(float*)(p + 0x1F0), ys = *(float*)(p + 0x1F4);
    int xo = *(int*)(p + 0x1F8), yo = *(int*)(p + 0x1FC);
    if (w < 200 || w > 20000 || h < 150 || h > 20000) return s;
    if (!(xs > 0.05f && xs < 50.0f) || !(ys > 0.05f && ys < 50.0f)) return s;
    if (xo < -w || xo > w || yo < -h || yo > h) return s;
    s.xs = xs; s.ys = ys; s.xo = (float)xo; s.yo = (float)yo; s.w = w; s.h = h; s.ok = true;
    static int g_msLastW, g_msLastH, g_msLastXo, g_msLastYo;
    if (w != g_msLastW || h != g_msLastH || xo != g_msLastXo || yo != g_msLastYo) {
        g_msLastW = w; g_msLastH = h; g_msLastXo = xo; g_msLastYo = yo;
        Log("mouse: menu space backbuffer %dx%d, scale %.4f x %.4f, offset %d,%d", w, h, xs, ys, xo, yo);
    }
    return s;
}
struct ElemRef { char* elem; void* prev; void* next; };
static char* ResolveElem(void* params, ElemRef* ref, const char* key = "id") {
    ref->elem = nullptr; ref->prev = ref->next = nullptr;
    void* mgr = *(void**)kElemMgr;
    if (!mgr) return nullptr;
    typedef void* (__thiscall* ResolveFn)(void*, ElemRef*, void*, DWORD, int);
    ((ResolveFn)kElemResolve)(mgr, ref, params, QbKey(key), 0);
    return ref->elem;
}
static void ReleaseElem(ElemRef* ref) {
    if (!ref->elem) return;
    typedef void (__thiscall* ReleaseFn)(void*, ElemRef*);
    ((ReleaseFn)kElemRelease)(ref->elem, ref);
    ref->elem = nullptr;
}
static void MouseRetFloat(void* script, const char* key, float v) {
    void* params = script ? *(void**)((char*)script + 0x14) : nullptr;
    typedef void (__thiscall* Fn)(void*, DWORD, float);
    if (params) ((Fn)kAddFloat)(params, QbKey(key), v);
}
static void MouseRetChecksum(void* script, const char* key, DWORD v) {
    void* params = script ? *(void**)((char*)script + 0x14) : nullptr;
    typedef void (__thiscall* Fn)(void*, DWORD, DWORD);
    if (params) ((Fn)kAddChecksum)(params, QbKey(key), v);
}
struct FRect { float x0, y0, x1, y1; };
static FRect ElemRect(const char* e) {
    FRect r;
    r.x0 = *(const float*)(e + 0x134);
    r.y0 = *(const float*)(e + 0x138);
    r.x1 = r.x0 + *(const float*)(e + 0x160) * *(const float*)(e + 0x13C);
    r.y1 = r.y0 + *(const float*)(e + 0x164) * *(const float*)(e + 0x140);
    if (r.x1 < r.x0) { float t = r.x0; r.x0 = r.x1; r.x1 = t; }
    if (r.y1 < r.y0) { float t = r.y0; r.y0 = r.y1; r.y1 = t; }
    return r;
}

// Back for the mouse (right click / the Back button): a real Esc press, sent with SendInput as a scan code so the
// engine's DirectInput keyboard sees it exactly like the key (FireEvent pad_back on current_menu did not reach the
// menus' back handlers, Noah 2026-11-20). Held ~80 ms so the engine's per-frame read can't miss it, then released
// from a short thread; one press at a time, only with the game window in front.
static volatile DWORD g_backUntil;
static volatile LONG g_backBusy;
static volatile WORD g_sendScan = 0x01;
static void SendEsc(bool up) {
    INPUT in = {};
    in.type = INPUT_KEYBOARD;
    in.ki.wScan = g_sendScan;   // DIK_ESCAPE (Back) or DIK_RETURN (Next)
    in.ki.dwFlags = KEYEVENTF_SCANCODE | (up ? KEYEVENTF_KEYUP : 0);
    SendInput(1, &in, sizeof in);
}
// The key is held until the engine's own keyboard state (0x7D6670, refreshed by its DirectInput read every frame)
// shows it down, then released at once (one engine read sees it, so no menu auto-repeat): a fixed 80 ms hold missed the read whenever a frame took
// longer than that (the main menu often has 125-900 ms frames), so Back "only worked sometimes" (Noah 2026-11-20).
// Safety release after 1.5 s.
static volatile DWORD g_keyDownAt;
static volatile int g_keyStage;   // 0 idle, 1 held (waiting for the engine to see it), 2 seen (release next tick)
static void MenuKeyTick() {     // every mouse tick (game thread)
    if (!g_keyStage) return;
    DWORD now = GetTickCount();
    const BYTE* ks = (const BYTE*)0x7D6670;
    bool seen = (ks[g_sendScan & 0xFF] & 0x80) != 0;
    if (g_keyStage == 1 && seen) { g_keyStage = 2; Log("mouse: %s press seen by the game after %u ms", g_sendScan == 0x01 ? "Back (Esc)" : "Next (Enter)", now - g_keyDownAt); }
    if (g_keyStage == 2 || now - g_keyDownAt > 1500) {
        if (g_keyStage == 1) Log("mouse: %s press not seen by the game in 1.5 s, released", g_sendScan == 0x01 ? "Back (Esc)" : "Next (Enter)");
        SendEsc(true);
        g_keyStage = 0;
        g_backUntil = now + 300;
        InterlockedExchange(&g_backBusy, 0);
    }
}
static volatile LONG g_keySeq;
static DWORD WINAPI KeyWatchdog(LPVOID p) {   // releases the key even if the mouse tick stops (screen change, load)
    LONG seq = (LONG)(INT_PTR)p;
    Sleep(1600);
    if (g_keySeq == seq && g_keyStage) {
        Log("mouse: %s released by the watchdog", g_sendScan == 0x01 ? "Back (Esc)" : "Next (Enter)");
        SendEsc(true);
        g_keyStage = 0;
        g_backUntil = GetTickCount() + 300;
        InterlockedExchange(&g_backBusy, 0);
    }
    return 0;
}
static bool SendMenuKey(WORD scan) {
    HWND h = GameWnd();
    const char* what = scan == 0x01 ? "Back (Esc)" : "Next (Enter)";
    if (!h || GetForegroundWindow() != h) { Log("mouse: %s skipped, game window not in front", what); return false; }
    if (InterlockedCompareExchange(&g_backBusy, 1, 0) != 0) { Log("mouse: %s skipped, a press is still going", what); return false; }
    g_sendScan = scan;
    g_keyDownAt = GetTickCount();
    g_backUntil = g_keyDownAt + 2000;
    SendEsc(false);
    g_keyStage = 1;
    LONG seq = InterlockedIncrement(&g_keySeq);
    HANDLE wd = CreateThread(nullptr, 0, KeyWatchdog, (LPVOID)(INT_PTR)seq, 0, nullptr);
    if (wd) CloseHandle(wd);
    Log("mouse: %s pressed", what);
    return true;
}
static bool __cdecl CF_MouseBack(void*, void*) { return SendMenuKey(0x01); }    // Esc
// Next button (Noah 2026-11-20): screens with nothing to click that wait for Accept (freeskate and the like)
static bool __cdecl CF_MouseNext(void*, void*) { return SendMenuKey(0x1C); }    // Enter
// Right click pauses (Noah 2026-11-21: "when in a game can you make right click pause the game"). THUGRECOMP_MouseRightPause
// ok = 1 every frame while the skater is in play with no menu, dialog, keyboard (chat), Free Cam or noclip up (QB decides,
// dadmod_mouse_tick); ok = 0 otherwise, which throws away clicks made then (a right click in a menu is Back, so the one
// that closes the pause menu never pauses again). A click that only focused the window never counts (WndProc swallows
// it). The pause is a real Esc press, so the game does exactly what it does for Esc.
static bool __cdecl CF_MouseRightPause(void* params, void*) {
    MenuKeyTick();
    LONG n = InterlockedExchange(&g_rClickPlay, 0);
    if (!IntParam(params, "ok", 0) || n <= 0) return false;
    DWORD now = GetTickCount();
    if (g_backUntil && (LONG)(g_backUntil - now) > 0) return false;   // our own Esc / Enter press is still going or just ended
    HWND h = GameWnd();
    if (!GameInFront(h) || !CursorInClient(h)) return false;
    Log("mouse: right click in play -> pause");
    return SendMenuKey(0x01);
}

// THUGRECOMP_MouseArrows row = <row id> left = { <row> child = left_arrow } right = { <row> child = right_arrow } x y
// (Noah 2026-11-20: "options have arrows around them but we can't click them ... make their hitboxes generous").
// ms_arrow = 0 the pointer is on the left arrow, 1 on the right arrow, -1 neither. Each arrow's on-screen rect is
// widened by 12 menu units each way and covers the row's full height. Returns false when the row has no arrows.
static bool __cdecl CF_MouseArrows(void* params, void* script) {
    float x = FloatParam(params, "x", -1e9f), y = FloatParam(params, "y", -1e9f);
    ElemRef rr, lr, rgr, t1r, t1ar, t2r, t2ar;
    char* row = ResolveElem(params, &rr, "row");
    char* la = row ? ResolveElem(params, &lr, "left") : nullptr;
    char* ra = row ? ResolveElem(params, &rgr, "right") : nullptr;
    // Edit Skater part rows (casmod qol.q): "color" / extra labels on the right (dadmod_tag, dadmod_tag2) with their
    // small arrows (dadmod_tag_arrow, dadmod_tag2_arrow); clicking one opens it (Noah: "i cant click the color button")
    char* t1 = row ? ResolveElem(params, &t1r, "tag1") : nullptr;
    char* t1a = row ? ResolveElem(params, &t1ar, "tag1a") : nullptr;
    char* t2 = row ? ResolveElem(params, &t2r, "tag2") : nullptr;
    char* t2a = row ? ResolveElem(params, &t2ar, "tag2a") : nullptr;
    int arrow = -1, tag = 0;
    bool any = la || ra || t1 || t2;
    if (row && any) {
        FRect r = ElemRect(row);
        const float pad = 12.0f;   // a little extra room (Noah: "not TOO big")
        auto in = [&](char* e, float p) {
            if (!e) return false;
            FRect a = ElemRect(e);
            return x >= a.x0 - p && x < a.x1 + p && y >= r.y0 && y < r.y1;
        };
        if (in(t1, 8.0f) || in(t1a, 8.0f)) tag = 1;
        else if (in(t2, 8.0f) || in(t2a, 8.0f)) tag = 2;
        else if (in(la, pad)) arrow = 0;
        else if (in(ra, pad)) arrow = 1;
    }
    ReleaseElem(&t2ar); ReleaseElem(&t2r); ReleaseElem(&t1ar); ReleaseElem(&t1r);
    ReleaseElem(&rgr); ReleaseElem(&lr); ReleaseElem(&rr);
    RetInt(script, "ms_arrow", arrow);
    RetInt(script, "ms_tag", tag);
    return any;
}

// THUGRECOMP_FitText row text left right base min (Noah 2026-11-21: option values ran out of their box): returns
// ms_fit = the scale that makes the value text fit between the row's arrows (or inside the row when it has none),
// at most base, at least min * base; ms_base = the text's current scale (for the first call, to remember the base).
static bool __cdecl CF_FitText(void* params, void* script) {
    ElemRef rr, tr, lr, rgr;
    char* row = ResolveElem(params, &rr, "row");
    char* tx = row ? ResolveElem(params, &tr, "text") : nullptr;
    char* la = row ? ResolveElem(params, &lr, "left") : nullptr;
    char* ra = row ? ResolveElem(params, &rgr, "right") : nullptr;
    bool ok = false;
    float fit = 1.0f, cur = 1.0f;
    if (tx) {
        cur = *(const float*)(tx + 0xA4);
        float base = FloatParam(params, "base", 0.0f), mn = FloatParam(params, "min", 0.6f);
        if (!(base > 0.0f)) base = cur;
        FRect t = ElemRect(tx), r = ElemRect(row);
        float tw = t.x1 - t.x0;
        float wAtBase = (cur > 0.001f) ? tw * base / cur : tw;
        float avail;
        if (la && ra) {
            FRect a = ElemRect(la), b = ElemRect(ra);
            float aw = a.x1 - a.x0, bw = b.x1 - b.x0;
            float lEdge = aw > 0.5f ? a.x1 : (a.x0 + 4.0f);   // a hidden arrow (scale 0) is a point: allow for its width
            float rEdge = bw > 0.5f ? b.x0 : (b.x0 - 4.0f);
            avail = rEdge - lEdge - 4.0f;
        } else {
            avail = r.x1 - t.x0 - 4.0f;
        }
        fit = base;
        if (wAtBase > 1.0f && avail > 1.0f && wAtBase > avail) fit = base * avail / wAtBase;
        if (fit < base * mn) fit = base * mn;
        ok = true;
    }
    ReleaseElem(&rgr); ReleaseElem(&lr); ReleaseElem(&tr); ReleaseElem(&rr);
    MouseRetFloat(script, "ms_fit", fit);
    MouseRetFloat(script, "ms_base", cur);
    return ok;
}

// THUGRECOMP_MouseOver id = <element> x y pad -> true when the point is on the element (padded by pad menu units)
static bool __cdecl CF_MouseOver(void* params, void*) {
    float x = FloatParam(params, "x", -1e9f), y = FloatParam(params, "y", -1e9f), p = FloatParam(params, "pad", 0);
    ElemRef er;
    char* e = ResolveElem(params, &er);
    bool in = false;
    if (e) { FRect r = ElemRect(e); in = x >= r.x0 - p && x < r.x1 + p && y >= r.y0 - p && y < r.y1 + p; }
    ReleaseElem(&er);
    return in;
}

// After a hover moved the focus (which may scroll the list under a still pointer), hover is paused for 250 ms
// so the pointer can't chase rows that slide under it. Clicks still use the row under the pointer at click time.
// The pause is skipped as soon as the pointer has really moved (more than 8 px since that focus), so sweeping over
// rows highlights each one at once; only small jitter while a list scrolls waits (Noah 2026-11-21: "theres a delay").
static volatile DWORD g_hoverCoolUntil;
static POINT g_hoverAt;
static bool __cdecl CF_MouseHoverDone(void*, void*) {
    g_hoverCoolUntil = GetTickCount() + 250;
    GetCursorPos(&g_hoverAt);
    return true;
}

static bool __cdecl CF_MouseMenu(void* params, void* script) {
    MenuKeyTick();
    static DWORD s_lastCall, s_mouseAt, s_otherAt;
    static POINT s_lastPos;
    static LONG s_lastDev = -1;
    static bool s_keyWas;
    DWORD now = GetTickCount();
    // the menu wasn't being read for a while: drop what piled up. 250 ms was too short: menu frames often take
    // 125-900 ms, so clicks and pointer moves were thrown away on slow frames (keyboard keys and Back "sometimes")
    bool stale = now - s_lastCall > 2500;
    s_lastCall = now;
    HWND h = MouseHookEnsure();
    bool camSide = now - g_camMouseAt < 1500 && !IntParam(params, "nocam", 0);   // Edit Skater: the left side belongs to the camera
    // (nocam = 1: a screen with our own buttons on the left, the skater select, where clicks there must count)
    LONG wheel = InterlockedExchange(&g_wheelR, 0);
    LONG click = InterlockedExchange(&g_lClickR, 0);
    LONG rclick = InterlockedExchange(&g_rClick, 0);
    click += InterlockedExchange(&g_lClickCorner, 0);
    // left-side clicks are kept apart: on the skater screens they belong to the camera unless they land on a menu
    // row or button (decided below, once the hit test ran: Noah 2026-11-21, level select rows sit on that side)
    LONG clickL = InterlockedExchange(&g_lClickL, 0);
    if (!camSide) { wheel += InterlockedExchange(&g_wheelL, 0); click += clickL; clickL = 0; }
    if (stale) { wheel = 0; click = 0; rclick = 0; clickL = 0; }
    bool front = GameInFront(h);
    POINT cp = { 0, 0 };
    bool havePos = front && GetCursorPos(&cp);
    bool moved = havePos && (cp.x != s_lastPos.x || cp.y != s_lastPos.y);
    if (havePos) s_lastPos = cp;
    if (stale) moved = false;
    // key or pad use hides the pointer until the mouse is used again
    bool keyNow = padhub::KeyAny();
    bool ownBack = g_backUntil && (LONG)(g_backUntil - now) > 0;
    if (keyNow && !s_keyWas && !ownBack) s_otherAt = now;   // our own Back press is not "keyboard use"
    s_keyWas = keyNow;
    LONG dev = padhub::g_lastDevice;
    if (dev == 1 && s_lastDev != 1) s_otherAt = now;
    s_lastDev = dev;
    if (moved || click || rclick || wheel) s_mouseAt = now;
    static DWORD s_wheelUsedAt;
    if (wheel) s_wheelUsedAt = now;
    bool active = front && havePos && s_mouseAt && (LONG)(s_mouseAt - s_otherAt) >= 0 && true;   // stays until a key or pad press (Noah 2026-11-20)
    if (padhub::g_capPhase != 0) active = false;              // a key / button is being bound
    if (!front) { click = rclick = wheel = 0; moved = false; }

    RECT cr = { 0, 0, 0, 0 };
    float fx = 0, fy = 0;
    if (h && GetClientRect(h, &cr) && cr.right > 0 && cr.bottom > 0) {
        POINT c = cp; ScreenToClient(h, &c);
        fx = (float)c.x / cr.right; fy = (float)c.y / cr.bottom;
    }
    MenuSpace ms = GetMenuSpace();
    float bw = ms.ok ? (float)ms.w : (cr.right > 0 ? (float)cr.right : 640.0f);    // backbuffer size (the client
    float bh = ms.ok ? (float)ms.h : (cr.bottom > 0 ? (float)cr.bottom : 480.0f);  // window is stretched to it)
    float xs = ms.ok ? ms.xs : bw / 640.0f, ys = ms.ok ? ms.ys : bh / 480.0f;
    float vx = (fx * bw - ms.xo) / xs, vy = (fy * bh - ms.yo) / ys;
    float cornerX = -ms.xo / xs, cornerY = -ms.yo / ys;      // the client's top-left corner in menu space
    float pxu = cr.right > 0 ? (bw / cr.right) / xs : 1.0f, pyu = cr.bottom > 0 ? (bh / cr.bottom) / ys : 1.0f;
    bool overBack = vx >= cornerX && vx < cornerX + kBackPx * pxu && vy >= cornerY && vy < cornerY + kBackPx * pyu;
    float rightX = (bw - ms.xo) / xs;                         // the client's right edge in menu space
    float nextX = rightX - kBackPx * pxu;
    bool overNext = vx >= nextX && vx < rightX && vy >= cornerY && vy < cornerY + kBackPx * pyu;
    int rows = 0;

    int hit = -1, side = 1; DWORD hitId = 0, hitRow = 0;
    bool settling = false;
    bool hoverEdge = false;
    FRect hitRect = { 0, 0, 0, 0 };
    bool hitPartial = false;
    FRect box = { 0, 0, 0, 0 };
    bool haveBox = false;
    ElemRef ref;
    char* menu = havePos ? ResolveElem(params, &ref) : nullptr;
    if (menu) {
        FRect clip = { -1e9f, -1e9f, 1e9f, 1e9f };
        int depth = 0;
        char* root = menu;
        for (char* a = menu; a && depth < 64; a = *(char**)(a + 0x4C), ++depth) {    // scrolling windows clip what they hold
            root = a;
            DWORD ty = *(DWORD*)(a + 0x18);
            // WindowElement and HScrollingMenu clip. Not VScrollingMenu (Noah 2026-11-21, bottom Edit Skater options not
            // clickable): its dims (20 per row) are shorter than the rows it shows (23 apart), and it hides rows out of
            // its window by alpha, which the row loop already treats as hidden
            if (ty != kWindowType && ty != 0x2900E3D0) continue;
            FRect w = ElemRect(a);
            if (w.x0 > clip.x0) clip.x0 = w.x0; if (w.y0 > clip.y0) clip.y0 = w.y0;
            if (w.x1 < clip.x1) clip.x1 = w.x1; if (w.y1 < clip.y1) clip.y1 = w.y1;
        }
        float best = 1e30f;
        int i = 0;
        // hover must never scroll a list (Noah 2026-11-21): in a list that has rows out of view, the first and last rows
        // in view would scroll it when focused, so they are click-only (ms_hover_edge = 1)
        int firstVis = -1, lastVis = -1, minHidden = 1 << 30, maxHidden = -1;
        // which lists recenter on focus (Noah 2026-11-21, level select "should work like every other menu"): a list
        // with rows out of view still focuses on hover, like the main menu; only when hovering a fully visible row
        // made the list itself move (Load Skater keeps the focus centered) is that list learned as click-only
        static DWORD s_refMenu, s_refAt, s_refHitId; static int s_refIdx = -1, s_refFirst = -1; static float s_refMid, s_refH;
        static DWORD s_recenter[32]; static int s_nRecenter;
        DWORD curMenuId = *(DWORD*)(menu + 0x14);
        bool refFound = false; float refMidNow = 0;
        // grid = 1 (the on-screen keyboard, Noah 2026-11-20): the menu holds rows (hmenus) and the keys are their
        // children, so the keys are tested and ms_hit_row gives the key's row
        bool grid = IntParam(params, "grid", 0) != 0;
        char* rowIt = grid ? *(char**)(menu + 0x58) : nullptr;
        char* c = grid ? (rowIt ? *(char**)(rowIt + 0x58) : nullptr) : *(char**)(menu + 0x58);
        for (int guard = 0; guard < 2048; ++guard) {
            if (!c) {
                if (!grid || !rowIt) break;
                rowIt = *(char**)(rowIt + 0x64);
                if (!rowIt) break;
                c = *(char**)(rowIt + 0x58);
                continue;
            }
            char* cur = c;
            c = *(char**)(c + 0x64);
            int idx = i++;
            if (*(const float*)(cur + 0x114) <= 0.01f) {   // hidden (a scrolling list hides rows out of view)
                if (idx < minHidden) minHidden = idx;
                if (idx > maxHidden) maxHidden = idx;
                continue;
            }
            FRect r = ElemRect(cur);
            if (r.x1 - r.x0 < 1 || r.y1 - r.y0 < 1) {   // a row with no size of its own: use what it holds
                bool got = false; int n = 0;
                for (char* k = *(char**)(cur + 0x58); k && n < 64; k = *(char**)(k + 0x64), ++n) {
                    FRect kr = ElemRect(k);
                    if (kr.x1 - kr.x0 < 1 || kr.y1 - kr.y0 < 1) continue;
                    if (!got) { r = kr; got = true; }
                    else { if (kr.x0 < r.x0) r.x0 = kr.x0; if (kr.y0 < r.y0) r.y0 = kr.y0; if (kr.x1 > r.x1) r.x1 = kr.x1; if (kr.y1 > r.y1) r.y1 = kr.y1; }
                }
                if (!got) continue;
            } else {
                // what a row holds can reach past its own box (the option arrows sit outside it, and rows grow / shrink
                // when they gain or lose focus): widen it sideways to its children so arrow clicks always land on the row
                int n = 0;
                for (char* k = *(char**)(cur + 0x58); k && n < 64; k = *(char**)(k + 0x64), ++n) {
                    FRect kr = ElemRect(k);
                    if (kr.x1 - kr.x0 < 1 || kr.y1 - kr.y0 < 1) continue;
                    if (kr.y1 < r.y0 || kr.y0 > r.y1) continue;       // only things beside the row, not above / below
                    if (kr.x0 < r.x0) r.x0 = kr.x0;
                    if (kr.x1 > r.x1) r.x1 = kr.x1;
                }
            }
            ++rows;
            if (idx == s_refIdx && curMenuId == s_refMenu) { refFound = true; refMidNow = (r.y0 + r.y1) * 0.5f; }
            {
                bool inView = clip.y0 < -1e8f || (r.y0 >= clip.y0 - 0.5f && r.y1 <= clip.y1 + 0.5f);
                if (inView) {
                    if (firstVis < 0) firstVis = idx;
                    lastVis = idx;
                    if (!haveBox) { box = r; haveBox = true; }      // the list's on-screen box (rows in view)
                    else { if (r.x0 < box.x0) box.x0 = r.x0; if (r.y0 < box.y0) box.y0 = r.y0; if (r.x1 > box.x1) box.x1 = r.x1; if (r.y1 > box.y1) box.y1 = r.y1; }
                }
                else { if (idx < minHidden) minHidden = idx; if (idx > maxHidden) maxHidden = idx; }
            }
            // rows get 4 menu units of extra height above and below (Noah 2026-11-21 "sometimes my clicks dont register":
            // clicks on the gap between rows or right on a row's top edge hit nothing); the nearest row still wins
            const float kPadY = 4.0f;
            if (vx < r.x0 || vx >= r.x1 || vy < r.y0 - kPadY || vy >= r.y1 + kPadY) continue;
            if (vx < clip.x0 || vx >= clip.x1 || vy < clip.y0 - kPadY || vy >= clip.y1 + kPadY) continue;
            // a row partly cut off by a scrolling window can be clicked on its visible part but never takes hover focus
            // (Noah 2026-11-21: "i cant click the bottom" options of Edit Skater lists); where rows overlap, the one whose
            // middle is nearest the pointer wins
            bool partial = clip.y0 > -1e8f && (r.y0 < clip.y0 - 0.5f || r.y1 > clip.y1 + 0.5f);
            float midY = (r.y0 + r.y1) * 0.5f;
            float area = fabsf(vy - midY) * 1000.0f + (r.x1 - r.x0) * (r.y1 - r.y0) * 0.001f;
            if (area < best) {
                best = area; hit = idx; hitId = *(DWORD*)(cur + 0x14);
                hitRow = grid && rowIt ? *(DWORD*)(rowIt + 0x14) : 0;
                hitRect = r;
                hitPartial = partial;
                float t = (vx - r.x0) / (r.x1 - r.x0);
                side = t < 1.0f / 3 ? 0 : t > 2.0f / 3 ? 2 : 1;
            }
        }
        if (!grid) {
            // per row (Noah 2026-11-21, "every menu like the main menu"): in a list with rows out of view, the first
            // row in view (when rows are hidden above it) and the last (when rows are hidden below it) would scroll the
            // list when focused, so hover leaves them alone; a click still picks them. Every other row in view focuses.
            static DWORD s_openMenu, s_openAt;
            if (s_openMenu != curMenuId) { s_openMenu = curMenuId; s_openAt = now; }
            bool edgeRow = hit >= 0 && (hitPartial || (hit == firstVis && minHidden < firstVis) || (hit == lastVis && maxHidden > lastVis));
            bool learned = false;
            for (int k = 0; k < s_nRecenter; ++k) if (s_recenter[k] == curMenuId) learned = true;
            // the list scrolled = a different first row in view (Noah 2026-11-21: Edit Skater rows grow when focused and
            // push their neighbours, which the old "row moved" check took for a scroll)
            if (!learned && s_refIdx >= 0 && s_refMenu == curMenuId && now - s_refAt < 700 && s_refFirst >= 0 && firstVis >= 0
                && firstVis != s_refFirst && (LONG)(s_otherAt - s_refAt) < 0 && (LONG)(s_wheelUsedAt - s_refAt) < 0) {
                if (s_nRecenter < 32) s_recenter[s_nRecenter++] = curMenuId;
                learned = true;
                Log("mouse: menu %08X scrolled (first row in view %d -> %d) when row %d was focused: hover is click only there", curMenuId, s_refFirst, firstVis, s_refIdx);
            }
            if (learned) { hoverEdge = maxHidden >= 0; s_refIdx = -1; }
            else {
                hoverEdge = edgeRow;
                // a list that moves although a row well inside the view was focused recenters on every focus
                // (Load Skater): learned as click-only. Not while the menu is still sliding in after opening.
                if (edgeRow || now - s_openAt < 1500) s_refIdx = -1;
                else if (hit >= 0 && moved && hitId != s_refHitId) {
                s_refIdx = hit; s_refMenu = curMenuId; s_refAt = now; s_refHitId = hitId; s_refFirst = firstVis;
                s_refMid = (hitRect.y0 + hitRect.y1) * 0.5f; s_refH = hitRect.y1 - hitRect.y0;
                }
            }
        }
        {
            static DWORD s_logMenu; static int s_logScroll = -1;
            DWORD mid = *(DWORD*)(menu + 0x14);
            if (mid != s_logMenu) {   // once per menu (hover now changes per row)
                s_logMenu = mid; s_logScroll = hoverEdge;
                Log("mouse: menu %08X type %08X: %d rows, in view %d-%d, hidden %d..%d -> hover %s", mid, *(DWORD*)(menu + 0x18),
                    rows, firstVis, lastVis, minHidden == (1 << 30) ? -1 : minHidden, maxHidden, hoverEdge ? "click only (scrolling list)" : "focuses");
            }
        }
        static DWORD s_loggedMenu;
        DWORD menuId = *(DWORD*)(menu + 0x14);
        // a new menu is only clickable once it has stayed the same menu for a few frames (it may still be building)
        static DWORD s_stableMenu; static int s_stableN;
        if (s_stableMenu != menuId) { s_stableMenu = menuId; s_stableN = 0; }
        else if (s_stableN < 1000) ++s_stableN;
        if (s_stableN < 6) { hit = -1; settling = true; }
        if (s_loggedMenu != menuId && *(char**)(menu + 0x58)) {   // one line per new menu, to check the rects
            s_loggedMenu = menuId;
            char* c0 = *(char**)(menu + 0x58);
            FRect r = ElemRect(c0), m = ElemRect(menu);
            Log("mouse: menu %08X at %.0f,%.0f-%.0f,%.0f, first row %08X at %.0f,%.0f-%.0f,%.0f alpha %.2f; pointer %.0f,%.0f",
                menuId, m.x0, m.y0, m.x1, m.y1, *(DWORD*)(c0 + 0x14), r.x0, r.y0, r.x1, r.y1, *(const float*)(c0 + 0x114), vx, vy);
            Log("mouse: window client %dx%d (menu space %s); root %08X origin %.1f,%.1f scale %.3f,%.3f; back button at %.1f,%.1f size %.1fx%.1f menu units",
                (int)cr.right, (int)cr.bottom, ms.ok ? "from the engine" : "fallback 640x480", *(DWORD*)(root + 0x14), *(const float*)(root + 0x134), *(const float*)(root + 0x138),
                *(const float*)(root + 0x13C), *(const float*)(root + 0x140), cornerX, cornerY, kBackPx * pxu, kBackPx * pyu);
        }
        ReleaseElem(&ref);
    }
    // no menu: clicks still count (Next / click-anywhere screens decide in QB)
    if (overBack || overNext) hit = -1;
    if (clickL && (hit >= 0 || overBack || overNext)) click += clickL;   // on our UI: a click, not a camera drag
    g_pointerOnUi = hit >= 0 || overBack || overNext || IntParam(params, "nodrag", 0) != 0;
    if (settling && !overBack && !overNext) { click = 0; wheel = 0; }      // nothing to click yet: drop clicks and scrolls
    {   // hide / show the Windows arrow over the game while our pointer is up (hidecur from QB = a mouse screen)
        int hc = IntParam(params, "hidecur", 0);   // 2 = in game on foot (walk / noclip mouse camera): wheel cursor even while keys are pressed (Noah 2026-11-22)
        LONG want = (hc == 2 ? front : (active && hc)) ? 1 : 0;
        if (InterlockedExchange(&g_hideCursor, want) != want) SetWheelCursorActive(h, want != 0);
    }
    CURSORINFO ci = { sizeof(ci) };
    bool sys = GetCursorInfo(&ci) && (ci.flags & CURSOR_SHOWING) && ci.hCursor;   // Windows draws its own arrow
    if (sys && h) { POINT c = ci.ptScreenPos; ScreenToClient(h, &c); sys = c.x >= 0 && c.y >= 0 && c.x < cr.right && c.y < cr.bottom; }
    if (click && hit < 0 && !overBack && !overNext) {   // a click on nothing: list what the screen holds, to tune detection
        ElemRef rootRef;
        char* rootEl = ResolveElem(params, &rootRef, "root");
        if (rootEl) {
            int n = 0;
            for (char* k = *(char**)(rootEl + 0x58); k && n < 40; k = *(char**)(k + 0x64), ++n) {
                FRect kr = ElemRect(k);
                Log("mouse:   screen part %08X type %08X at %.0f,%.0f-%.0f,%.0f alpha %.2f", *(DWORD*)(k + 0x14), *(DWORD*)(k + 0x18),
                    kr.x0, kr.y0, kr.x1, kr.y1, *(const float*)(k + 0x114));
            }
        }
        ReleaseElem(&rootRef);
        ElemRef mr2;
        char* m2 = ResolveElem(params, &mr2);
        if (m2) {
            int n = 0;
            for (char* k = *(char**)(m2 + 0x58); k && n < 16; k = *(char**)(k + 0x64), ++n) {
                FRect kr = ElemRect(k);
                Log("mouse:   menu row %08X type %08X at %.0f,%.0f-%.0f,%.0f alpha %.2f", *(DWORD*)(k + 0x14), *(DWORD*)(k + 0x18),
                    kr.x0, kr.y0, kr.x1, kr.y1, *(const float*)(k + 0x114));
            }
        }
        ReleaseElem(&mr2);
    }
    if (click && !IntParam(params, "grid", 0))
        Log("mouse: click at %.0f,%.0f -> row %d, %d rows, menu %s, back %d next %d%s", vx, vy, hit, rows,
            menu ? "found" : "none", overBack ? 1 : 0, overNext ? 1 : 0, active ? "" : " (mouse not active)");
    if (click && IntParam(params, "grid", 0)) Log("mouse: keyboard click at %.0f,%.0f -> key %d (%08X, row %08X), %d keys", vx, vy, hit, hitId, hitRow, rows);
    RetInt(script, "ms_hit", hit);
    RetInt(script, "ms_hover_edge", hoverEdge ? 1 : 0);
    MouseRetFloat(script, "ms_hx0", hitRect.x0);   // the row under the pointer, for a hover-only highlight
    MouseRetFloat(script, "ms_hy0", hitRect.y0);
    MouseRetFloat(script, "ms_hx1", hitRect.x1);
    MouseRetFloat(script, "ms_hy1", hitRect.y1);
    RetInt(script, "ms_box", haveBox ? 1 : 0);
    MouseRetFloat(script, "ms_bx0", box.x0);
    MouseRetFloat(script, "ms_by0", box.y0);
    MouseRetFloat(script, "ms_bx1", box.x1);
    MouseRetFloat(script, "ms_by1", box.y1);
    if (hit >= 0) MouseRetChecksum(script, "ms_hit_id", hitId);
    if (hit >= 0 && hitRow) MouseRetChecksum(script, "ms_hit_row", hitRow);
    RetInt(script, "ms_side", side);
    MouseRetFloat(script, "ms_x", vx);
    MouseRetFloat(script, "ms_y", vy);
    RetInt(script, "ms_click", active ? (int)click : 0);
    RetInt(script, "ms_rclick", active ? (int)rclick : 0);
    RetInt(script, "ms_wheel", active ? (int)(wheel / WHEEL_DELTA) : 0);
    RetInt(script, "ms_moved", moved ? 1 : 0);
    {
        bool hoverOk = (LONG)(now - g_hoverCoolUntil) >= 0;
        if (!hoverOk && havePos) {
            int dx = cp.x - g_hoverAt.x, dy = cp.y - g_hoverAt.y;
            if (dx * dx + dy * dy > 8 * 8) hoverOk = true;
        }
        RetInt(script, "ms_hover_ok", hoverOk ? 1 : 0);
    }
    RetInt(script, "ms_active", active ? 1 : 0);
    RetInt(script, "ms_syscursor", sys ? 1 : 0);
    MouseRetFloat(script, "ms_corner_x", cornerX);
    MouseRetFloat(script, "ms_corner_y", cornerY);
    MouseRetFloat(script, "ms_px_unit", pxu);
    MouseRetFloat(script, "ms_px_unit_y", pyu);
    RetInt(script, "ms_over_back", overBack ? 1 : 0);
    RetInt(script, "ms_over_next", overNext ? 1 : 0);
    RetInt(script, "ms_rows", rows);
    MouseRetFloat(script, "ms_next_x", nextX);
    return true;
}

static bool __cdecl CF_MenuTick(void* params, void* script) {
    DWORD now = GetTickCount();
    {   // THUGPro Manager (Menu Poses) edits mainmenu.ini while the menu is up: pick the change up within a second
        static DWORD s_lastCheck;
        static FILETIME s_iniTime;
        if (now - s_lastCheck > 1000) {
            s_lastCheck = now;
            WIN32_FILE_ATTRIBUTE_DATA fa;
            if (GetFileAttributesExA(ExeDirFile("mainmenu.ini").c_str(), GetFileExInfoStandard, &fa)) {
                if ((s_iniTime.dwLowDateTime || s_iniTime.dwHighDateTime) && CompareFileTime(&fa.ftLastWriteTime, &s_iniTime)) {
                    Config before = g_cfg;
                    LoadConfig();
                    if (before.animSource != g_cfg.animSource || before.posesFav != g_cfg.posesFav || before.animHold != g_cfg.animHold ||
                        _stricmp(before.anim.c_str(), g_cfg.anim.c_str()) || before.favs.size() != g_cfg.favs.size() ||
                        before.poses.cycle != g_cfg.poses.cycle || before.poses.pick != g_cfg.poses.pick ||
                        before.poseMode != g_cfg.poseMode || _stricmp(before.poseOne.c_str(), g_cfg.poseOne.c_str())) { g_pose = -1; g_poseDue = true; }
                    if (before.cams.cycle != g_cfg.cams.cycle || before.cams.pick != g_cfg.cams.pick || before.framing != g_cfg.framing ||
                        before.camList.size() != g_cfg.camList.size() || before.useHome != g_cfg.useHome) g_cam = -1;
                }
                s_iniTime = fa.ftLastWriteTime;
            }
        }
    }
    EnsureLevel();
    // no tick for a while (2026-11-07: Save Skater's file screens have no menu the driver knows): the stock code
    // reloads the skater there, so the first ticks back count as a screen just opened, not the player turning them
    static DWORD s_lastMenuTick;  // g_lastTick is also kept fresh by the free-cam query, so time the gap here
    if (s_lastMenuTick && now - s_lastMenuTick > 500) g_ctxAt = now;
    s_lastMenuTick = now;
    g_lastTick = now;
    Vec skater = V(FloatParam(params, "sx", 0), FloatParam(params, "sy", 0), FloatParam(params, "sz", 0));
    bool restart = IntParam(params, "restart", 0) != 0;
    int ctx = MenuCtx(IntParam(params, "ctx", 1));
    bool itemScreen = IntParam(params, "ctx", 1) == 7;  // the item focus applies once its screen is open
    {   // a back item's screen: the skater spins round so you see their back, and spins back the opposite way after.
        // The DLL turns them a bit every frame (2026-10-26) so the stock menu moving or re-facing them while you back
        // out can't flip them. On Edit Skater screens the player's own turning (rotate buttons) is left alone and kept
        // between those screens; other menus that turn the skater get the facing put back.
        bool want = itemScreen && g_itemBack;
        static DWORD s_spinAt, s_faceLogAt;
        static float s_spinFrom, s_spinTo, s_spinAng;  // degrees added to the facing: 0 = front, 180 = back
        static bool s_spinDone = true;
        bool cas = ctx >= CTX_CAS && ctx < CTX_SELECT;
        if (restart || !cas) g_userTurned = false;
        Vec home = g_userTurned ? g_userFace : g_face;
        if (want != g_backTurned) {
            g_backTurned = want; s_spinFrom = s_spinAng; s_spinTo = want ? 180.0f : 0.0f; s_spinAt = now; s_spinDone = false;
            Log("skater spins to show their %s", want ? "back" : "front");
        }
        float u = s_spinDone ? 1.0f : (now - s_spinAt) / 500.0f;
        s_spinAng = u >= 1 ? s_spinTo : s_spinFrom + (s_spinTo - s_spinFrom) * u * u * (3 - 2 * u);
        float ra = s_spinAng * 3.14159265f / 180.0f;
        g_faceNow = V(home.x * cosf(ra) + home.z * sinf(ra), 0, home.z * cosf(ra) - home.x * sinf(ra));
        if (!s_spinDone) {
            if (g_faceValid) RetVec(script, "face_dir", g_faceNow);
            if (u >= 1) s_spinDone = true;
        } else if (g_faceValid) {
            Vec f = V(FloatParam(params, "fx", 0), 0, FloatParam(params, "fz", 0));
            float l = sqrtf(f.x * f.x + f.z * f.z);
            bool settling = restart || ctx != g_ctx || now - g_ctxAt < 1500;  // a screen just opened: stock code turns the skater
            {   // moved off the spot in the same frame = the stock code reloaded the skater (Save Skater does): not a player turn
                Vec sp = V(FloatParam(params, "sx", 0), FloatParam(params, "sy", 0), FloatParam(params, "sz", 0));
                Vec dd = Sub(sp, g_mainPos);
                if (g_mainPosValid && dd.x * dd.x + dd.y * dd.y + dd.z * dd.z > 15 * 15) settling = true;
            }
            if (l > 0.5f) {
                f = V(f.x / l, 0, f.z / l);
                if (cas && !settling) {
                    if (f.x * g_faceNow.x + f.z * g_faceNow.z < 0.985f && !g_userTurned) {
                        g_userTurned = true;
                        Log("the player turned the skater (%s); left as is", kCtxNames[ctx]);
                    }
                    if (g_userTurned) {  // their front, with the back spin taken off
                        g_userFace = V(f.x * cosf(ra) - f.z * sinf(ra), 0, f.z * cosf(ra) + f.x * sinf(ra));
                        g_faceNow = f;
                    }
                } else if (f.x * g_faceNow.x + f.z * g_faceNow.z < 0.985f) {
                    RetVec(script, "face_dir", g_faceNow);
                    if (now - s_faceLogAt > 2000) { s_faceLogAt = now; Log("the skater was turned (%s); facing put back", kCtxNames[ctx]); }
                }
            }
        }
    }
    // The skater always stands on the menu's spot: Edit Skater, Free Skate / Play Online and back, and other menus
    // reload them at the level's start point, so put them back (the spot's facing, or the one they had).
    bool haveSpot = g_spot >= 0 && g_spot < (int)g_cfg.spotList.size();
    if (haveSpot) { g_mainPos = g_cfg.spotList[g_spot].pos; g_mainPosValid = true; }
    else if (ctx == CTX_MAIN) { g_mainPos = skater; g_mainPosValid = true; }
    if (g_mainPosValid) {
        Vec d = Sub(skater, g_mainPos);
        // falling through the spot (Skate Heaven, 2026-10-25: the menu map has no floor there): pause the skater's
        // physics so they stay planted; load_level unpauses them in any real level
        bool falling = d.y < -4 && fabsf(d.x) < 15 && fabsf(d.z) < 15;
        // Match slope (Noah 2026-11-18). Off: on a spot the skater is always paused standing straight up, the way
        // the first boot shows them (there the floor isn't ready yet and they drop, so they get paused). On: their
        // physics run so they lean with the ground; after a first-boot drop they're let go again every 2 seconds
        // (5 tries) until the floor is there to land on.
        bool upright = haveSpot && !g_cfg.matchSlope && !g_frozen;
        if (haveSpot && g_cfg.matchSlope && g_frozen && !falling && g_slopeTries < 5 && now - g_frozenAt > 2000) {
            g_frozen = false; ++g_slopeTries;
            RetInt(script, "unfreeze", 1);
            RetVec(script, "keep_pos", g_mainPos);
            Log("match slope: skater let go to land on the spot (try %d)", g_slopeTries);
        }
        if (!g_cfg.matchSlope) g_slopeTries = 0;
        if (falling || upright) {  // every time: a pose change re-inits the skater (SkaterInit), which unpauses them
            RetInt(script, "freeze", 1);
            if (!g_frozen) {
                g_frozen = true; g_frozenAt = now;
                Log(falling ? "the skater fell at the spot: physics paused on the menu" : "match slope off: skater paused standing straight up");
            }
        }
        if (d.x * d.x + d.y * d.y + d.z * d.z > 15 * 15 || falling || upright) {
            Vec f = haveSpot && g_cfg.spotList[g_spot].hasDir ? g_cfg.spotList[g_spot].dir : g_face;
            if (g_backTurned || g_userTurned || g_faceNow.x != g_face.x || g_faceNow.z != g_face.z) f = g_faceNow;  // mid-spin, turned round or turned by the player
            float fl = sqrtf(f.x * f.x + f.z * f.z);  // level facing: Obj_SetOrientation then stands them straight up
            RetVec(script, "keep_pos", g_mainPos);
            if (fl > 0.01f) RetVec(script, "keep_dir", V(f.x / fl, 0, f.z / fl));
            static DWORD s_movedLogAt;
            if ((falling || d.x * d.x + d.y * d.y + d.z * d.z > 15 * 15) && now - s_movedLogAt > 2000) { s_movedLogAt = now; Log("the skater was moved (%s); put back at %.1f %.1f %.1f", kCtxNames[ctx], g_mainPos.x, g_mainPos.y, g_mainPos.z); }
            skater = g_mainPos;
        }
    }
    if (restart || !g_faceValid) LatchFace(params);
    if (ctx != g_ctx) {
        Log("menu screen %s", kCtxNames[ctx]);
        if (g_ctx == CTX_MAIN || ctx == CTX_MAIN) StartBlend(g_cfg.blendSec);  // between Edit Skater screens the orbit eases itself
        if (ctx == CTX_LEVELSEL) StartBlend(2.0f);  // up into the aerial (level select, server list): a long glide, from any screen
        else if (g_ctx == CTX_LEVELSEL) StartBlend(g_cfg.blendSec);
        if (ctx < CTX_HEAD || ctx >= CTX_SELECT) g_itemOn = false;  // out of the part lists: back to the screen's own shot
        g_ctx = ctx; g_ctxAt = now;
    }
    bool shop = ctx != CTX_MAIN;  // Edit Skater screens pose the skater themselves

    if (!shop) {
    // pose (2026-10-23): favorites starred in pause > dadmod > Animations, or any animation at random. The first
    // one sets the skater up (pose_cycle); after that each change blends into the next (pose_next), no reset.
    std::vector<int> favList = FavAnims();
    // Default (pose_mode = default, or no pose_mode line): the four idle sequence loops from pause > dadmod >
    // Animations > Idle loops (Pro Ped 1-2, Skater Ped 1-2), each a QB script that loops its pieces
    static const char* kDefaultSeqs[] = { "dadmod_menu_idleseq1", "dadmod_menu_idleseq2", "dadmod_menu_idleseq3", "dadmod_menu_idleseq4", "dadmod_menu_idleseq0" };  // Noah's favorites 2026-11-17
    const int kDefaultCount = (int)(sizeof(kDefaultSeqs) / sizeof(kDefaultSeqs[0]));
    // the mode actually played: Single Animation with nothing picked, or Cycle with nothing picked, plays Default
    int pm = g_cfg.poseMode, single = -1;
    if (pm == 1) { single = AnimIndex(g_cfg.poseOne); if (single < 0) single = SeqIndex(g_cfg.poseOne); if (single < 0) pm = 3; }
    if (pm == 0 && favList.empty()) pm = 3;
    if (pm == 3) {
        g_poseLive = false;
        float secs = g_cfg.poses.seconds < 30 ? 30 : g_cfg.poses.seconds;  // a whole sequence runs about 30 s
        bool change = g_poseDue || g_pose < 0 || restart || now - g_poseAt >= (DWORD)(secs * 1000);
        static DWORD s_lastSeqApply;
        if (change && s_lastSeqApply && now - s_lastSeqApply < 1500) { change = false; g_poseDue = true; }  // see CF_MenuOpt
        if (change) {
            s_lastSeqApply = now;
            if (!(restart && g_pose >= 0 && g_pose < kDefaultCount)) g_pose = (g_pose < 0 ? 0 : g_pose + 1) % kDefaultCount;
            g_poseAt = now; g_poseDue = false;
            RetName(script, "pose_script", kDefaultSeqs[g_pose]);
            Log("pose default %s", kDefaultSeqs[g_pose]);
        }
    } else if (pm == 2 || pm == 1 || !favList.empty()) {
        bool cyc = pm == 2 || (pm == 0 && favList.size() > 1);
        bool change = g_poseDue || g_pose < 0 || restart || (cyc && now - g_poseAt >= (DWORD)(g_cfg.poses.seconds * 1000));
        bool full = restart || !g_poseLive;
        static DWORD s_lastAnimApply;
        if (change && full && s_lastAnimApply && now - s_lastAnimApply < 1500) { change = false; g_poseDue = true; }  // see CF_MenuOpt
        if (change) {
            int a;
            if (pm == 2) {
                // main menu = idle animations only (Noah 2026-11-17)
                static std::vector<int> s_idle;
                if (s_idle.empty()) for (int i = 0; i < kAnimCount; ++i) { std::string n = Lower(kAnims[i].name); if (n.find("idle") != std::string::npos) s_idle.push_back(i); }
                if (s_idle.empty()) do a = rand() % kAnimCount; while (kAnimCount > 1 && a == g_pose);
                else do a = s_idle[rand() % s_idle.size()]; while (s_idle.size() > 1 && a == g_pose);
            } else if (pm == 1) {
                a = single;
            } else {
                if (!(restart && g_pose >= 0)) g_poseSeq = (g_poseSeq + 1) % (int)favList.size();
                a = favList[(g_poseSeq < 0 ? 0 : g_poseSeq) % favList.size()];
            }
            if (a >= kAnimCount) {
                // a starred idle loop: its own looping script, and the next pick starts fresh (no blend over it)
                char sn[32]; sprintf(sn, "dadmod_menu_idleseq%d", a - kAnimCount);
                s_lastAnimApply = now; RetName(script, "pose_script", sn); g_poseLive = false;
            } else if (full) { s_lastAnimApply = now; RetName(script, "pose_cycle", kAnims[a].name); g_poseLive = true; }
            else RetName(script, "pose_next", kAnims[a].name);
            g_pose = a; g_poseAt = now; g_poseDue = false;
            Log("pose animation %s%s", FavLabel(a), full ? "" : " (blended)");
        }
    } else if (!g_cfg.poseList.empty()) {
        g_poseLive = false;
        bool change = g_poseDue || g_pose < 0
                   || (g_cfg.poses.cycle && g_cfg.poseList.size() > 1 && now - g_poseAt >= (DWORD)(g_cfg.poses.seconds * 1000));
        if (restart && g_pose >= 0) change = true;  // re-apply after other menus moved the skater
        static DWORD s_lastPoseApply;
        if (change && s_lastPoseApply && now - s_lastPoseApply < 1500) { change = false; g_poseDue = true; }  // see CF_MenuOpt
        if (change) {
            s_lastPoseApply = now;
            if (!restart || g_pose < 0) g_pose = Pick(g_cfg.poses, (int)g_cfg.poseList.size(), g_pose, &g_poseSeq);
            g_poseAt = now; g_poseDue = false;
            const Pose& p = g_cfg.poseList[g_pose];
            if (!p.script.empty()) RetName(script, "pose_script", p.script.c_str());
            else {
                RetInt(script, "pose_anims", (int)p.anims.size());
                for (int i = 0; i < 4; ++i) {  // the QB loop always plays four; repeat the list to fill them
                    char key[16]; sprintf(key, "pose_a%d", i + 1);
                    RetName(script, key, p.anims[i % p.anims.size()].c_str());
                }
            }
            Log("pose %d (%s)", g_pose + 1, p.name.c_str());
        }
    }

    }

    // camera
    if (g_cam < 0 || restart) {
        if (g_cam < 0) PickCamera();
        else if (!g_outValid) { g_camStart = g_camAt = now; }  // same scene: the shot keeps running, no restart
    }
    else if (g_cfg.cams.cycle && CamPickList().size() > 1 && now - g_camAt >= (DWORD)(g_cfg.cams.seconds * 1000)) PickCamera();
    static DWORD s_lastPosLog;
    if (restart || now - s_lastPosLog > 15000) { s_lastPosLog = now; Log("skater at %.1f %.1f %.1f", skater.x, skater.y, skater.z); }
    if (g_cfg.deckOff) RetInt(script, "deck_off", 1);
    Vec pos, dir;
    // Edit Skater screens: a third-person camera on a sphere around the skater. Right stick X turns it around
    // them, Y tilts it up / down (elevation -10..70 degrees), R2 zooms in, L2 out (by how far the trigger is
    // pulled); it always aims at the same point on the skater and eases to where you take it. Back on the main
    // list it goes back to normal.
    static float s_yaw, s_yawTo, s_el, s_elTo, s_zoom = 1, s_zoomTo = 1;
    static float s_look, s_dist, s_start, s_baseEl;  // the screen's aim height, distance, angle and tilt, eased between screens
    static bool s_elSet, s_shotSet;
    static DWORD s_padAt;
    {
        float dt = s_padAt ? (now - s_padAt) / 1000.0f : 0;
        if (dt > 0.1f) dt = 0.1f;
        s_padAt = now;
        static int s_ctxSeen = -1;
        if (s_ctxSeen != ctx) { s_ctxSeen = ctx; s_zoomTo = 1; }  // each screen frames its own body part; your turn and tilt stay
        if (!shop) { s_yaw = s_yawTo = 0; s_el = s_elTo = 0; s_zoom = s_zoomTo = 1; s_shotSet = false; g_camDragReset = true; }
        else {
            const DIJOYSTATE2* js = (const DIJOYSTATE2*)0x7D60F8;  // player 1, as padhub fills it (axes +-1000)
            auto ax = [](LONG v) { float f = v / 1000.0f; f = f > 1 ? 1 : f < -1 ? -1 : f; return fabsf(f) < 0.2f ? 0.0f : f; };
            float lz = js->lZ / 1000.0f;                             // padhub: L2 minus R2
            float zin = lz < -0.1f ? -lz : 0, zout = lz > 0.1f ? lz : 0;
            if (js->rgbButtons[11] & 0x80) zin = zin > 0.5f ? zin : 1;   // R2 as a button
            if (js->rgbButtons[10] & 0x80) zout = zout > 0.5f ? zout : 1; // L2 as a button
            float kTilt = 0, mYaw = 0, mTilt = 0;
            CamKeysMouse(&zin, &zout, &kTilt, &mYaw, &mTilt);   // keyboard and mouse (Noah 2026-11-20)
            s_yawTo -= mYaw;
            s_elTo += kTilt * 60.0f * dt + mTilt;
            s_yawTo -= ax(js->lRx) * 140.0f * dt;
            s_elTo -= ax(js->lRy) * 90.0f * dt;                      // stick up looks up (the camera drops)
            if (s_baseEl + s_elTo < -10) s_elTo = -10 - s_baseEl;      // whole tilt stays -10..70 degrees
            if (s_baseEl + s_elTo > 70) s_elTo = 70 - s_baseEl;
            s_zoomTo /= 1 + 3.0f * zin * dt;
            s_zoomTo *= 1 + 3.0f * zout * dt;
            s_zoomTo = s_zoomTo < 0.35f ? 0.35f : s_zoomTo > 3.0f ? 3.0f : s_zoomTo;
            float k = 14.0f * dt; k = k > 1 ? 1 : k;
            s_yaw += (s_yawTo - s_yaw) * k;
            s_el += (s_elTo - s_el) * k;
            s_zoom += (s_zoomTo - s_zoom) * k;
        }
    }
    if (shop && g_cfg.ctxCams && g_cfg.ctx[ctx].on) {
        CtxCam c = g_cfg.ctx[ctx];
        if (ctx == CTX_LEVELSEL && g_level == 0 && c.radius > 400) { c.radius = 230; c.height = 110; c.look = 40; }  // indoor skate shop
        float up = c.height - c.look, dist = sqrtf(c.radius * c.radius + up * up);
        float baseEl = atan2f(up, c.radius) * 180.0f / 3.14159265f;
        if (!s_shotSet) { s_look = c.look; s_dist = dist; s_start = c.start; s_baseEl = baseEl; s_shotSet = true; }
        {
            float dt2 = 0.016f;
            static DWORD s_shotAt;
            if (s_shotAt) { dt2 = (now - s_shotAt) / 1000.0f; if (dt2 > 0.1f) dt2 = 0.1f; }
            s_shotAt = now;
            float k2 = 6.0f * dt2; k2 = k2 > 1 ? 1 : k2;
            float tLook = c.look, tDist = dist, tEl = baseEl;
            if (g_itemOn && itemScreen && ctx != CTX_HEAD) { tLook = g_item.look; tDist = g_item.dist; tEl = g_item.tilt; }
            s_look += (tLook - s_look) * k2;
            s_dist += (tDist - s_dist) * k2;
            s_start += (c.start - s_start) * k2;
            s_baseEl += (tEl - s_baseEl) * k2;
        }
        Vec target = Add(skater, V(0, s_look, 0));
        float el = (s_baseEl + s_el) * 3.14159265f / 180.0f, d = s_dist * s_zoom;
        Vec flat = OrbitPos(V(0, 0, 0), 1, 0, s_start + s_yaw + c.speed * ((now - g_ctxAt) / 1000.0f));
        pos = Add(target, V(flat.x * cosf(el) * d, sinf(el) * d, flat.z * cosf(el) * d));
        dir = Framed(pos, target, Norm(Sub(pos, target)));
    } else {
        if (g_cfg.playerCam) { g_outValid = false; RetInt(script, "player_cam", 1); return true; }
        if (g_cam < 0) { g_outValid = false; return true; }
        CamPose(g_cfg.camList[g_cam], skater, (now - g_camStart) / 1000.0f, &pos, &dir);
    }
    ApplyBlend(&pos, &dir, now);
    RetVec(script, "cam_pos", pos);
    RetVec(script, "cam_dir", dir);
    return true;
}

static bool __cdecl CF_MenuMark(void* params, void* script) {
    const char* kind = nullptr;
    GetStringParam(params, "kind", &kind);
    if (!kind) return false;
    bool spot = !_stricmp(kind, "spot");
    const char* markLevel = nullptr;
    GetStringParam(params, "level", &markLevel);
    std::string levelKeyS = markLevel && *markLevel ? Lower(Trim(markLevel)) : "east_la";
    if (levelKeyS == "z_el") levelKeyS = "east_la";
    const char* levelKey = levelKeyS.c_str();
    Vec p = V(FloatParam(params, "px", 0), FloatParam(params, "py", 0), FloatParam(params, "pz", 0));
    Vec d = V(FloatParam(params, "dx", 0), FloatParam(params, "dy", 0), FloatParam(params, "dz", 1));
    LoadConfig();
    std::string path = ExeDirFile("mainmenu.ini"), data;
    ReadWholeFile(path, data);
    // next free number for this kind
    std::string prefix = spot ? "[spot " : "[camera ";
    int next = 1;
    std::string low = Lower(data);
    for (size_t at = low.find(prefix); at != std::string::npos; at = low.find(prefix, at + 1)) {
        int n = atoi(low.c_str() + at + prefix.size());
        if (n >= next) next = n + 1;
    }
    SYSTEMTIME t; GetLocalTime(&t);
    char sec[512];
    if (spot)
        sprintf(sec, "\r\n[spot %d]\r\nname = marked %02d-%02d %02d:%02d\r\nlevel = %s\r\npos = %.1f, %.1f, %.1f\r\ndir = %.4f, %.4f, %.4f\r\n",
                next, t.wMonth, t.wDay, t.wHour, t.wMinute, levelKey, p.x, p.y, p.z, d.x, d.y, d.z);
    else
        sprintf(sec, "\r\n[camera %d]\r\nname = marked %02d-%02d %02d:%02d\r\nstyle = fixed      ; or look / sway / pan (pan also needs pos2)\r\nspot = 0\r\nlevel = %s\r\npos = %.1f, %.1f, %.1f\r\ndir = %.4f, %.4f, %.4f\r\n",
                next, t.wMonth, t.wDay, t.wHour, t.wMinute, levelKey, p.x, p.y, p.z, d.x, d.y, d.z);
    if (!spot && p.x == 0 && p.y == 0 && p.z == 0) { Log("camera mark at 0,0,0 ignored"); return false; }
    if (!data.empty() && data[data.size() - 1] != '\n') data += "\r\n";
    data += sec;
    // A new spot becomes the one the menu uses (static spot_pick), so marking shows up right away.
    if (spot) {
        size_t at = Lower(data).find("\nspot_pick");
        if (at != std::string::npos) {
            size_t eq = data.find('=', at), end = data.find_first_of("\r\n;", eq);
            if (eq != std::string::npos && end != std::string::npos && eq < end) {
                char num[16]; sprintf(num, " %d ", next);
                data.replace(eq + 1, end - eq - 1, num);
            }
        }
    }
    if (!WriteWholeFile(path, data)) { Log("could not write mainmenu.ini"); return false; }
    Log("marked %s %d at %.1f %.1f %.1f", spot ? "spot" : "camera", next, p.x, p.y, p.z);
    RetInt(script, "index", next);
    return true;
}

// ---- in-game editor (Options > Dadmod > Main Menu options)
// THUGRECOMP_MenuOpt key="spots" step=-1|0|1 -> text (what to show); saves the [menu] value to
// mainmenu.ini and applies it at once. respot=1 when the skater should be placed again.

static void SetMenuValue(const char* key, const std::string& value) {
    std::string path = ExeDirFile("mainmenu.ini"), data;
    ReadWholeFile(path, data);
    std::string low = Lower(data);
    size_t menu = low.find("[menu]");
    if (menu == std::string::npos) { data = "[menu]\r\n" + data; low = Lower(data); menu = 0; }
    size_t secEnd = low.find("\n[", menu + 1);
    if (secEnd == std::string::npos) secEnd = data.size();
    std::string want = std::string("\n") + key;
    for (size_t at = low.find(want, menu); at != std::string::npos && at < secEnd; at = low.find(want, at + 1)) {
        size_t k = at + want.size();
        while (k < data.size() && (data[k] == ' ' || data[k] == '\t')) ++k;
        if (k >= data.size() || data[k] != '=') continue;  // a longer key that starts the same
        size_t end = data.find_first_of("\r\n;", k);
        if (end == std::string::npos) end = data.size();
        std::string v = " " + value;
        if (end < data.size() && data[end] == ';') v += "              ";
        data.replace(k + 1, end - k - 1, v);
        WriteWholeFile(path, data);
        return;
    }
    size_t lineEnd = data.find('\n', menu);
    std::string line = std::string(key) + " = " + value + "\r\n";
    if (lineEnd == std::string::npos) data += "\r\n" + line; else data.insert(lineEnd + 1, line);
    WriteWholeFile(path, data);
}

// key = value in any [section] (section name lowercase, e.g. "camera 3", "home east_la"); the section is added
// at the end of the file when missing. Keeps a trailing ; comment.
static void SetSecValue(std::string& data, const std::string& section, const char* key, const std::string& value) {
    std::string low = Lower(data), want = "[" + section + "]";
    size_t secAt = std::string::npos, bodyAt = 0, secEnd = data.size();
    for (size_t at = 0; at < data.size();) {
        size_t e = data.find('\n', at);
        e = e == std::string::npos ? data.size() : e + 1;
        std::string t = Trim(low.substr(at, e - at));
        if (!t.empty() && t[0] == '[') {
            if (secAt != std::string::npos) { secEnd = at; break; }
            size_t r = t.find(']');
            if (r != std::string::npos && "[" + Trim(t.substr(1, r - 1)) + "]" == want) { secAt = at; bodyAt = e; }
        }
        at = e;
    }
    if (secAt == std::string::npos) {
        if (!data.empty() && data[data.size() - 1] != '\n') data += "\r\n";
        data += "\r\n[" + section + "]\r\n" + key + " = " + value + "\r\n";
        return;
    }
    std::string k = Lower(key);
    size_t insertAt = bodyAt;
    for (size_t at = bodyAt; at < secEnd;) {
        size_t e = data.find('\n', at);
        e = e == std::string::npos ? data.size() : e + 1;
        if (e > secEnd) e = secEnd;
        std::string t = Trim(low.substr(at, e - at));
        if (!t.empty() && t[0] != ';' && t[0] != '#') insertAt = e;
        std::string rest = t.compare(0, k.size(), k) ? std::string() : Trim(t.substr(k.size()));
        if (!rest.empty() && rest[0] == '=') {
            size_t eq = data.find('=', at);
            size_t end = data.find_first_of("\r\n;", eq);
            if (end == std::string::npos || end > e) end = e;
            std::string v = " " + value;
            if (end < data.size() && data[end] == ';') v += "      ";
            data.replace(eq + 1, end - eq - 1, v);
            return;
        }
        at = e;
    }
    std::string line = std::string(key) + " = " + value + "\r\n";
    if (insertAt > 0 && data[insertAt - 1] != '\n') line = "\r\n" + line;
    data.insert(insertAt, line);
}
static void SetSecValueFile(const std::string& section, const char* key, const std::string& value) {
    std::string path = ExeDirFile("mainmenu.ini"), data;
    ReadWholeFile(path, data);
    SetSecValue(data, section, key, value);
    WriteWholeFile(path, data);
}
// cuts [section] out of data (returns its text; "" when missing)
static std::string CutSection(std::string& data, const std::string& section) {
    std::string low = Lower(data), want = "[" + section + "]";
    size_t a = std::string::npos;
    for (size_t at = 0; at < data.size();) {
        size_t e = data.find('\n', at);
        e = e == std::string::npos ? data.size() : e + 1;
        std::string t = Trim(low.substr(at, e - at));
        if (!t.empty() && t[0] == '[') {
            if (a != std::string::npos) { std::string s = data.substr(a, at - a); data.erase(a, at - a); return s; }
            size_t r = t.find(']');
            if (r != std::string::npos && "[" + Trim(t.substr(1, r - 1)) + "]" == want) a = at;
        }
        at = e;
    }
    if (a == std::string::npos) return "";
    std::string s = data.substr(a);
    data.erase(a);
    return s;
}
static void ArchiveIni(const std::string& text, const char* why) {
    if (text.empty()) return;
    std::string arch = ExeDirFile("mainmenu_deleted.txt"), old, t = text;
    ReadWholeFile(arch, old);
    SYSTEMTIME st; GetLocalTime(&st);
    char head[128];
    sprintf(head, "; %s %04d-%02d-%02d %02d:%02d:%02d\r\n", why, st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond);
    if (t[t.size() - 1] != '\n') t += "\r\n";
    WriteWholeFile(arch, old + head + t);
}
static std::string Num(float v, int decimals = 0) {
    char b[32];
    if (decimals) sprintf(b, "%.*f", decimals, v); else sprintf(b, "%d", (int)floorf(v + 0.5f));
    return b;
}
static std::string VecText(Vec v, bool unit) {
    char b[96];
    if (unit) sprintf(b, "%.4f, %.4f, %.4f", v.x, v.y, v.z); else sprintf(b, "%.1f, %.1f, %.1f", v.x, v.y, v.z);
    return b;
}

// ---- Set Main Menu Here (Quick Menu / pause > dadmod, while skating a level)
// THUGRECOMP_MenuSetHere level="BO" px py pz dx dy dz -> name (the menu level's name); false when that level has
// no main menu version. Makes it the menu level, with a [home <level>] spot where the skater stands and a camera
// on their front; spots and cameras go static so it shows on the next main menu.
static bool __cdecl CF_MenuSetHere(void* params, void* script) {
    const char* lv = nullptr;
    GetStringParam(params, "level", &lv);
    int idx = lv ? MenuLevelExact(Trim(lv)) : -1;
    if (idx < 0) { Log("set main menu here: level %s has no main menu version", lv ? lv : "?"); return false; }
    const char* key = kMenuLevels[idx].key;
    Vec p = V(FloatParam(params, "px", 0), FloatParam(params, "py", 0), FloatParam(params, "pz", 0));
    Vec d = V(FloatParam(params, "dx", 0), FloatParam(params, "dy", 0), FloatParam(params, "dz", 1));
    d.y = 0; d = Norm(d);  // stand upright even when set on a slope
    std::string path = ExeDirFile("mainmenu.ini"), data;
    if (!ReadWholeFile(path, data)) { LoadConfig(); ReadWholeFile(path, data); }
    std::string sec = std::string("home ") + key;
    ArchiveIni(CutSection(data, sec), "replaced by Set Main Menu Here");
    SYSTEMTIME t; GetLocalTime(&t);
    char name[64]; sprintf(name, "set here %02d-%02d %02d:%02d", t.wMonth, t.wDay, t.wHour, t.wMinute);
    size_t last = data.find_last_not_of("\r\n \t");
    data = last == std::string::npos ? std::string() : data.substr(0, last + 1) + "\r\n";
    data += "\r\n[" + sec + "]\r\nname = " + name + "\r\npos = " + VecText(p, false) + "\r\ndir = " + VecText(d, true) +
            "\r\ncamera = none       ; none = the Camera mode / Camera shot cameras, aimed from this spot's front\r\n";
    SetSecValue(data, "menu", "level", key);
    SetSecValue(data, "menu", "custom_level", key);
    SetSecValue(data, "menu", "spots", "static");
    SetSecValue(data, "menu", "use_home", "on");
    if (!WriteWholeFile(path, data)) { Log("could not write mainmenu.ini"); return false; }
    LoadConfig();
    Log("set main menu here: %s at %.1f %.1f %.1f facing %.3f %.3f", key, p.x, p.y, p.z, d.x, d.z);
    RetStr(script, "name", kMenuLevels[idx].name);
    return true;
}

// THUGRECOMP_MenuSaved index=i -> name, pick (menu level index), cur (1 = the menu level now); false past the end.
// The levels that have a [home <level>] (Set Main Menu Here), for Dadmod > Main Menu options > Custom menus.
static std::vector<int> SavedLevels() {
    std::vector<int> v;
    auto add = [&](const std::string& lv) {
        int i = MenuLevelExact(lv);
        if (i >= 0 && std::find(v.begin(), v.end(), i) == v.end()) v.push_back(i);
    };
    for (auto& sp : g_cfg.spotList) if (sp.isHome) add(sp.level);
    for (auto& c : g_cfg.camList) if (c.isHome) add(c.level);
    return v;
}
static bool __cdecl CF_MenuSaved(void* params, void* script) {
    int sp = IntParam(params, "star_pick", -1);  // d-pad Right in Custom menus: star / unstar that menu -> on
    if (sp >= 0) {
        if (sp >= kMenuLevelCount) return false;
        std::string path = ExeDirFile("mainmenu.ini"), data;
        ReadWholeFile(path, data);
        std::vector<std::string> stars = CustomStars(data);
        std::string k = Lower(kMenuLevels[sp].key), list;
        bool on = !IsStarred(stars, k.c_str());
        if (on) stars.push_back(k); else stars.erase(std::find(stars.begin(), stars.end(), k));
        for (auto& x : stars) list += (list.empty() ? "" : ",") + x;
        SetSecValue(data, "menu", "custom_stars", list);
        WriteWholeFile(path, data);
        RetInt(script, "on", on ? 1 : 0);
        return true;
    }
    int i = IntParam(params, "index", 0);
    if (i == 0) LoadConfig();
    std::vector<int> v = SavedLevels();
    if (i < 0 || i >= (int)v.size()) return false;
    RetStr(script, "name", kMenuLevels[v[i]].name);
    RetInt(script, "pick", v[i]);
    std::string data;
    ReadWholeFile(ExeDirFile("mainmenu.ini"), data);
    bool random = Lower(Trim(MenuValueRaw(data, "custom_random"))) == "on";  // Random gets the * instead
    RetInt(script, "cur", !random && v[i] == MenuLevelIndex(g_cfg.level) ? 1 : 0);
    RetInt(script, "star", IsStarred(CustomStars(data), kMenuLevels[v[i]].key) ? 1 : 0);
    return true;
}
// THUGRECOMP_MenuSavedDelete pick=N (MenuSaved's pick) -> name, file; false when that level has no saved menu.
// Custom menus > Square/F8: cuts the level's [home <level>] section out of mainmenu.ini into its own file in
// dadmod\backups\deleted_menus\ (paste it back into mainmenu.ini to restore it).
static bool __cdecl CF_MenuSavedDelete(void* params, void* script) {
    int idx = IntParam(params, "pick", -1);
    if (idx < 0 || idx >= kMenuLevelCount) return false;
    const char* key = kMenuLevels[idx].key;
    std::string path = ExeDirFile("mainmenu.ini"), data;
    if (!ReadWholeFile(path, data)) return false;
    std::string text = CutSection(data, std::string("home ") + key);
    if (text.empty()) { Log("delete custom menu %s: no [home %s]", key, key); return false; }
    std::string dir = ExeDirFile("backups");
    CreateDirectoryA(dir.c_str(), nullptr);
    dir += "\\deleted_menus";
    CreateDirectoryA(dir.c_str(), nullptr);
    SYSTEMTIME t; GetLocalTime(&t);
    char file[128];
    sprintf(file, "%s %04d-%02d-%02d %02d%02d%02d.ini", key, t.wYear, t.wMonth, t.wDay, t.wHour, t.wMinute, t.wSecond);
    std::string out = dir + "\\" + file;
    if (text[text.size() - 1] != '\n') text += "\r\n";
    // the copy goes first: when it can't be written the menu stays in mainmenu.ini
    if (!WriteWholeFile(out, "; Deleted from Custom menus. Paste this section back into dadmod\\mainmenu.ini to restore it\r\n" + text)) {
        Log("delete custom menu %s: could not write %s", key, out.c_str());
        return false;
    }
    if (!WriteWholeFile(path, data)) { Log("delete custom menu %s: could not write mainmenu.ini", key); return false; }
    LoadConfig();
    g_spot = -1; ChooseSpot();
    g_pose = -1; g_poseDue = true; g_cam = -1;
    Log("deleted custom menu [home %s] (moved to backups\\deleted_menus\\%s)", key, file);
    RetStr(script, "name", kMenuLevels[idx].name);
    RetStr(script, "file", file);
    return true;
}

// THUGRECOMP_MenuRestore index=N -> name, when (the Nth deleted custom menu, newest first); restore=N puts it back
// (Noah 2026-11-18). Deleted menus are the [home <level>] sections Custom menus > Square/F8 moved to
// dadmod\backups\deleted_menus\<level> <date>.ini. Restoring appends the section to mainmenu.ini again (unless that level
// already has a saved menu) and moves the file to deleted_menus\restored\, so nothing is lost either way.
static std::string SecBody(const std::string& data, const std::string& sec);
static std::vector<std::string> DeletedMenuFiles() {
    std::vector<std::pair<unsigned long long, std::string>> v;
    WIN32_FIND_DATAA fd;
    HANDLE h = FindFirstFileA(ExeDirFile("backups\\deleted_menus\\*.ini").c_str(), &fd);
    if (h != INVALID_HANDLE_VALUE) {
        do {
            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
            unsigned long long t = ((unsigned long long)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime;
            v.push_back({ t, fd.cFileName });
        } while (FindNextFileA(h, &fd));
        FindClose(h);
    }
    std::sort(v.begin(), v.end(), [](const std::pair<unsigned long long, std::string>& a, const std::pair<unsigned long long, std::string>& b) { return a.first > b.first; });
    std::vector<std::string> out;
    for (auto& p : v) out.push_back(p.second);
    return out;
}
static bool __cdecl CF_MenuRestore(void* params, void* script) {
    std::vector<std::string> files = DeletedMenuFiles();
    int r = IntParam(params, "restore", -1);
    int i = r >= 0 ? r : IntParam(params, "index", 0);
    if (i < 0 || i >= (int)files.size()) return false;
    std::string file = files[i], key = Lower(file.substr(0, file.find(' ')));
    int lv = MenuLevelExact(key);
    std::string when = file.find(' ') != std::string::npos ? file.substr(file.find(' ') + 1) : "";
    if (when.size() > 4) when = when.substr(0, when.size() - 4);   // drop ".ini"
    if (when.size() == 17 && when[10] == ' ') when = when.substr(0, 13) + ":" + when.substr(13, 2);   // 2026-11-17 010017 -> 2026-11-17 01:00
    RetStr(script, "name", lv >= 0 ? kMenuLevels[lv].name : key.c_str());
    RetStr(script, "when", when.c_str());
    if (r < 0) return true;
    std::string src = ExeDirFile(("backups\\deleted_menus\\" + file).c_str()), text, path = ExeDirFile("mainmenu.ini"), data;
    if (lv < 0 || !ReadWholeFile(src, text) || !ReadWholeFile(path, data)) return false;
    if (!SecBody(data, "home " + key).empty()) { RetStr(script, "why", "already saved"); return false; }
    size_t at = text.find('[');
    if (at == std::string::npos) return false;
    text = text.substr(at);
    if (data.size() && data[data.size() - 1] != '\n') data += "\r\n";
    data += "\r\n" + text;
    if (!WriteWholeFile(path, data)) return false;
    std::string dir = ExeDirFile("backups\\deleted_menus\\restored");
    CreateDirectoryA(dir.c_str(), nullptr);
    MoveFileA(src.c_str(), (dir + "\\" + file).c_str());
    LoadConfig();
    Log("restored custom menu [home %s] from backups\\deleted_menus\\%s", key.c_str(), file.c_str());
    return true;
}

static void SnapCamDefaults(std::string& data, const std::string& sec);
// ---- Reposition camera (main menu > Dadmod > Main Menu options > Camera)
// THUGRECOMP_MenuCamEdit start_edit=1 starts it (not begin=: begin is a QB keyword, it froze the script VM), query=1 -> true while it runs; sx sy sz -> cam_pos, cam_dir every frame; when it ends:
// done = 1 (saved as this level's camera, [home <level>] camera = fixed) or 2 (canceled), name = the level's name.
// Pad: left stick move, right stick look, LB/RB or LT/RT down/up, hold X (Square) faster; A (Cross) or Start
// saves, B (Circle) or Y (Triangle) cancels. Keys: WASD move, arrows look, Q/E down/up, Shift faster,
// Enter saves, Esc cancels.
static bool g_editInit;
static bool __cdecl CF_MenuCamEdit(void* params, void* script) {
    DWORD now = GetTickCount();
    if (IntParam(params, "query", 0)) { g_lastTick = now; return g_edit; }       // the menu driver (every frame): free cam running?
    if (IntParam(params, "start_edit", 0)) { g_edit = true; g_editInit = false; return true; }  // Reposition camera chosen
    if (!g_edit) return false;
    Vec skater = V(FloatParam(params, "sx", 0), FloatParam(params, "sy", 0), FloatParam(params, "sz", 0));
    if (!g_editInit) {
        g_editInit = true; g_editArmed = false; g_editAt = now;
        Vec fwd;
        if (g_outValid) { g_editPos = g_outPos; fwd = Mul(g_outDir, -1); }
        else { g_editPos = Add(skater, V(g_face.x * 160, 60, g_face.z * 160)); fwd = Norm(Sub(Add(skater, V(0, 40, 0)), g_editPos)); }
        g_editYaw = atan2f(fwd.x, fwd.z);
        g_editPitch = asinf(fwd.y < -1 ? -1 : fwd.y > 1 ? 1 : fwd.y);
        Log("reposition camera: free cam on");
    }
    float dt = (now - g_editAt) / 1000.0f;
    if (dt > 0.1f) dt = 0.1f;
    g_editAt = now;
    // player 1's pad as the engine sees it this frame (padhub fills it: axes +-1000, buttons in Xbox order)
    const DIJOYSTATE2* js = (const DIJOYSTATE2*)0x7D60F8;
    DWORD btn = 0;
    for (int i = 0; i < 13; ++i) if (js->rgbButtons[i] & 0x80) btn |= 1u << i;
    auto ax = [](LONG v) { float f = v / 1000.0f; f = f > 1 ? 1 : f < -1 ? -1 : f; return fabsf(f) < 0.2f ? 0.0f : f; };
    float lx = ax(js->lX), ly = ax(js->lY), rx = ax(js->lRx), ry = ax(js->lRy), lz = ax(js->lZ);
    DWORD pid = 0;
    HWND fgw = GetForegroundWindow();
    if (fgw) GetWindowThreadProcessId(fgw, &pid);
    bool fg = pid == GetCurrentProcessId();
    auto key = [&](int vk) { return fg && (GetAsyncKeyState(vk) & 0x8000) != 0; };
    auto b = [&](int bit) { return ((btn >> bit) & 1) != 0; };  // padhub bits: a b x y lb rb back start ls rs
    float mx = lx + (key('D') ? 1.f : 0.f) - (key('A') ? 1.f : 0.f);
    float mf = -ly + (key('W') ? 1.f : 0.f) - (key('S') ? 1.f : 0.f);
    float mu = -lz + (b(5) ? 1.f : 0.f) - (b(4) ? 1.f : 0.f) + (key('E') || key(VK_PRIOR) ? 1.f : 0.f) - (key('Q') || key(VK_NEXT) ? 1.f : 0.f);
    float turn = rx + (key(VK_RIGHT) ? 1.f : 0.f) - (key(VK_LEFT) ? 1.f : 0.f);
    float tilt = -ry + (key(VK_UP) ? 1.f : 0.f) - (key(VK_DOWN) ? 1.f : 0.f);
    float speed = 180.0f * (b(2) || b(8) || key(VK_SHIFT) ? 3.5f : 1.0f);
    // world: (f.z, 0, -f.x) is screen-left (see Framed), so turning right lowers the yaw
    g_editYaw -= turn * 1.7f * dt;
    g_editPitch += tilt * 1.2f * dt;
    if (g_editPitch > 1.45f) g_editPitch = 1.45f;
    if (g_editPitch < -1.45f) g_editPitch = -1.45f;
    Vec flat = V(sinf(g_editYaw), 0, cosf(g_editYaw)), screenRight = V(-cosf(g_editYaw), 0, sinf(g_editYaw));
    g_editPos = Add(g_editPos, Mul(Add(Add(Mul(flat, mf), Mul(screenRight, mx)), V(0, mu, 0)), speed * dt));
    Vec fwd = V(sinf(g_editYaw) * cosf(g_editPitch), sinf(g_editPitch), cosf(g_editYaw) * cosf(g_editPitch));
    Vec dir = Mul(fwd, -1);
    g_outPos = g_editPos; g_outDir = dir; g_outValid = true; g_bDur = 0;
    RetVec(script, "cam_pos", g_editPos);
    RetVec(script, "cam_dir", dir);
    RetStr(script, "name", kMenuLevels[g_level >= 0 && g_level < kMenuLevelCount ? g_level : 1].name);
    bool anyDown = btn != 0 || key(VK_RETURN) || key(VK_ESCAPE) || key(VK_BACK);
    if (!g_editArmed) { if (!anyDown) g_editArmed = true; return true; }  // wait for the press that opened it to let go
    bool save = b(0) || b(7) || key(VK_RETURN);
    bool cancel = b(1) || b(3) || key(VK_ESCAPE) || key(VK_BACK);
    if (!save && !cancel) return true;
    g_edit = false;
    if (cancel) {
        Log("reposition camera: canceled");
        StartBlend(g_cfg.blendSec > 0.6f ? 0.6f : g_cfg.blendSec);
        RetInt(script, "done", 2);
        return true;
    }
    // the same shot as orbit numbers too, so the camera editor can fine-tune it afterwards
    Vec rel = Sub(g_editPos, skater);
    float radius = sqrtf(rel.x * rel.x + rel.z * rel.z);
    float start = (atan2f(rel.x, rel.z) - atan2f(g_face.x, g_face.z)) * 180.0f / 3.14159265f;
    while (start > 180) start -= 360;
    while (start < -180) start += 360;
    float fl = fwd.x * fwd.x + fwd.z * fwd.z;
    float along = fl > 1e-4f ? -(rel.x * fwd.x + rel.z * fwd.z) / fl : 0;
    if (along < 0) along = 0;
    float look = rel.y + fwd.y * along;
    if (look < -50) look = -50;
    if (look > 300) look = 300;
    std::string path = ExeDirFile("mainmenu.ini"), data;
    ReadWholeFile(path, data);
    // each save is a new custom camera for this map (Noah 2026-10-23); Camera shot keeps one "Custom camera" entry
    int num = 0;
    {
        std::string low = Lower(data), want = std::string("[custom ") + LevelName() + " ";
        for (size_t at = low.find(want); at != std::string::npos; at = low.find(want, at + 1)) {
            int k2 = atoi(low.c_str() + at + want.size());
            if (k2 > num) num = k2;
        }
    }
    ++num;
    std::string sec = std::string("custom ") + LevelName() + " " + std::to_string(num);
    {
        bool wasCustom = g_cam >= 0 && g_cam < (int)g_cfg.camList.size() && g_cfg.camList[g_cam].custom;
        if (!wasCustom) SetSecValue(data, "menu", "custom_prev_pick", std::to_string(g_cfg.cams.pick));  // Default goes back here
        char nm[64]; sprintf(nm, "Custom camera %d", num);
        size_t last = data.find_last_not_of("\r\n \t");
        data = last == std::string::npos ? std::string() : data.substr(0, last + 1) + "\r\n";
        data += "\r\n[" + sec + "]\r\nname = " + nm + "\r\n";
        SetSecValue(data, "menu", (std::string("custom_cam_") + LevelName()).c_str(), sec);
    }
    SetSecValue(data, sec, "camera", "fixed");
    SetSecValue(data, sec, "cam_pos", VecText(g_editPos, false));
    SetSecValue(data, sec, "cam_dir", VecText(dir, true));
    SetSecValue(data, sec, "radius", Num(radius));
    SetSecValue(data, sec, "height", Num(rel.y));
    SetSecValue(data, sec, "look", Num(look));
    SetSecValue(data, sec, "start", Num(start));
    SetSecValue(data, sec, "speed", "0");
    SetSecValue(data, sec, "swing", "0");
    SetSecValue(data, "menu", "cameras", "static");
    SetSecValue(data, "menu", "use_home", "on");
    WriteWholeFile(path, data);
    LoadConfig();
    {   // show it now and keep it: the static Camera shot points at it
        std::vector<int> w = CamPickList();
        for (int i = 0; i < (int)w.size(); ++i)
            if (g_cfg.camList[w[i]].custom) { SetMenuValue("camera_pick", std::to_string(i + 1)); break; }
        LoadConfig();
    }
    g_cam = -1;
    PickCamera(0);
    Log("reposition camera: saved for %s at %.1f %.1f %.1f", LevelName(), g_editPos.x, g_editPos.y, g_editPos.z);
    RetInt(script, "done", 1);
    return true;
}

// a [menu] key's value straight from the file text ("" when missing)
static std::string MenuValueRaw(const std::string& data, const char* key) {
    std::string low = Lower(data), want = key;
    size_t menu = low.find("[menu]");
    if (menu == std::string::npos) return "";
    size_t end = low.find("\n[", menu + 1);
    for (size_t at = menu; at < (end == std::string::npos ? low.size() : end);) {
        size_t e = low.find('\n', at);
        e = e == std::string::npos ? low.size() : e + 1;
        std::string t = Trim(low.substr(at, e - at));
        if (!t.compare(0, want.size(), want)) {
            std::string rest = Trim(t.substr(want.size()));
            if (!rest.empty() && rest[0] == '=') {
                std::string v = data.substr(at, e - at);
                v = v.substr(v.find('=') + 1);
                size_t c = v.find_first_of(";#");
                return Trim(c == std::string::npos ? v : v.substr(0, c));
            }
        }
        at = e;
    }
    return "";
}

static std::vector<int> LevelSpots() {
    std::vector<int> v;
    for (int i = 0; i < (int)g_cfg.spotList.size(); ++i)
        if (g_cfg.spotList[i].level == kMenuLevels[MenuLevelIndex(g_cfg.level)].key) v.push_back(i);
    return v;
}

static int Wrap(int v, int lo, int hi) { return v < lo ? hi : v > hi ? lo : v; }

static int AnimIndex(const std::string& name) {
    for (int i = 0; i < kAnimCount; ++i) if (!_stricmp(kAnims[i].name, name.c_str())) return i;
    return -1;
}
static std::vector<int> AnimGroup(int cat) {
    std::vector<int> v;
    for (int i = 0; i < kAnimCount; ++i) if (kAnims[i].cat == cat) v.push_back(i);
    return v;
}
static bool IsFav(const char* name) {
    for (auto& f : g_cfg.favs) if (!_stricmp(f.c_str(), name)) return true;
    return false;
}
// what the menu skater plays when animations are in use: the favorites (poses = favorites) or the one picked
// the starred animations that exist (favorites in [menu]), in the order they were starred
// Idle loop sequences can be starred too (Noah 2026-11-17): stored in favorites as idleseq<n> and handed around as
// kAnimCount + n; the menu skater plays them with the QB script dadmod_menu_idleseq<n> (Levels.q)
static const int kSeqCount = 8;
static const char* kSeqNames[kSeqCount] = { "Idle Sequence Loop", "Pro Ped Idle Sequence Loop 1", "Pro Ped Idle Sequence Loop 2",
    "Skater Ped Idle Sequence Loop 1", "Skater Ped Idle Sequence Loop 2", "Kneeling Sequence Loop", "Sit/Lean Sequence Loop", "Sit (On Deck) Loop" };
static int SeqIndex(const std::string& f) {
    if (_strnicmp(f.c_str(), "idleseq", 7)) return -1;
    int n = atoi(f.c_str() + 7);
    return n >= 0 && n < kSeqCount ? kAnimCount + n : -1;
}
static std::string FavKey(int a) { return a < kAnimCount ? std::string(kAnims[a].name) : "idleseq" + std::to_string(a - kAnimCount); }
static const char* FavLabel(int a) { return a < kAnimCount ? kAnims[a].name : kSeqNames[a - kAnimCount]; }
static std::vector<int> FavAnims() {
    std::vector<int> v;
    for (auto& f : g_cfg.favs) { int i = AnimIndex(f); if (i < 0) i = SeqIndex(f); if (i >= 0) v.push_back(i); }
    return v;
}
static std::vector<int> PoseAnimList() {
    std::vector<int> v;
    if (g_cfg.posesFav) {
        for (auto& f : g_cfg.favs) { int i = AnimIndex(f); if (i >= 0) v.push_back(i); }
    } else if (g_cfg.animSource) {
        int i = AnimIndex(g_cfg.anim);
        if (i < 0) { std::vector<int> g = AnimGroup(Wrap(g_cfg.animGroup, 1, kAnimCatCount) - 1); if (!g.empty()) i = g[0]; }
        if (i >= 0) v.push_back(i);
    }
    return v;
}
static std::string AnimText() {
    int cat = Wrap(g_cfg.animGroup, 1, kAnimCatCount) - 1;
    std::vector<int> g = AnimGroup(cat);
    int at = AnimIndex(g_cfg.anim), pos = 0;
    for (int i = 0; i < (int)g.size(); ++i) if (g[i] == at) pos = i;
    if (g.empty()) return "none";
    char buf[160];
    sprintf(buf, "%d of %d: %s%s", pos + 1, (int)g.size(), kAnims[g[pos]].name, IsFav(kAnims[g[pos]].name) ? " *" : "");
    return buf;
}
static void SaveFavs() {
    std::string v;
    for (auto& f : g_cfg.favs) { if (!v.empty()) v += ", "; v += f; }
    SetMenuValue("favorites", v);
}
// THUGRECOMP_MenuFav: stars / unstars the animation shown on the "Animation" option -> text, fav
static bool __cdecl CF_MenuFav(void*, void* script) {
    LoadConfig();
    int cat = Wrap(g_cfg.animGroup, 1, kAnimCatCount) - 1;
    std::vector<int> g = AnimGroup(cat);
    if (g.empty()) return false;
    int at = AnimIndex(g_cfg.anim);
    bool inGroup = false;
    for (int i : g) if (i == at) inGroup = true;
    const char* name = kAnims[inGroup ? at : g[0]].name;
    bool fav = IsFav(name);
    if (fav) { for (size_t i = 0; i < g_cfg.favs.size(); ++i) if (!_stricmp(g_cfg.favs[i].c_str(), name)) { g_cfg.favs.erase(g_cfg.favs.begin() + i); break; } }
    else g_cfg.favs.push_back(name);
    SaveFavs();
    LoadConfig();
    if (g_cfg.posesFav) { g_pose = -1; g_poseDue = true; }
    Log("%s favorite: %s", fav ? "removed" : "added", name);
    RetStr(script, "text", AnimText().c_str());
    RetInt(script, "fav", fav ? 0 : 1);
    return true;
}

// Orbit Options > Default: the first edit of a camera saves its values as default_<field> in its section; Default puts them back
static const char* kCamFields[] = { "radius", "height", "look", "speed", "start", "swing", "range", "camera", "cam_pos", "cam_dir" };
static bool NoDefault(const char* f, const std::string& d) {  // the field wasn't in the section before the first edit
    return d.empty() || d == "(none)" || (d == "none" && strcmp(f, "camera") != 0);
}
static std::string IniValue(const std::string& body, const char* key);
static size_t SecStart(const std::string& data, const std::string& sec) {  // where "[sec]" starts a line, else npos
    std::string low = Lower(data), want = "[" + Lower(sec) + "]";
    for (size_t at = low.find(want); at != std::string::npos; at = low.find(want, at + 1))
        if (!at || low[at - 1] == '\n') return at;
    return std::string::npos;
}
static std::string SecBody(const std::string& data, const std::string& sec) {
    size_t at = SecStart(data, sec);
    if (at == std::string::npos) return "";
    size_t b = data.find('\n', at);
    if (b == std::string::npos) return "";
    size_t e = data.find("\n[", b);
    return data.substr(b, e == std::string::npos ? std::string::npos : e - b + 1);
}
static void SnapCamDefaults(std::string& data, const std::string& sec) {
    std::string body = SecBody(data, sec);
    if (!IniValue(body, "defaults_saved").empty()) return;
    for (auto* f : kCamFields) {
        std::string v = IniValue(body, f);
        SetSecValue(data, sec, (std::string("default_") + f).c_str(), v.empty() ? "(none)" : v);
    }
    SetSecValue(data, sec, "default_camera_pick", std::to_string(g_cfg.cams.pick));  // the Camera shot before any edit
    SetSecValue(data, sec, "defaults_saved", "yes");
}
static bool __cdecl CF_MenuOpt(void* params, void* script) {
    const char* key = nullptr;
    GetStringParam(params, "key", &key);
    if (!key) return false;
    int step = IntParam(params, "step", 0);
    LoadConfig();
    std::string k = key, text;
    char buf[160];
    bool respot = false;
    auto modeText = [](const Mode& m) { return std::string(m.cycle ? "Cycle" : "Static"); };
    if (k == "level") {
        int idx = MenuLevelIndex(g_cfg.level);
        int pick = IntParam(params, "pick", -1);  // the Menu level list picks one directly
        if (pick >= 0 && pick < kMenuLevelCount) {
            idx = pick; SetMenuValue("level", kMenuLevels[idx].key); step = 1;
            SetMenuValue("custom_random", "off");  // a picked menu ends Custom menus > Random
            if (idx != 0) SetMenuValue("custom_level", kMenuLevels[idx].key);  // what Menu scene > Custom menus goes back to
        }
        else if (step) { idx = Wrap(idx + step, 0, kMenuLevelCount - 1); SetMenuValue("level", kMenuLevels[idx].key); }
        text = kMenuLevels[idx].name;
        RetInt(script, "index", idx);
        RetInt(script, "pending", ClientMenuLevel(idx, false) != g_level ? 1 : 0);  // client: a level that isn't installed shows the skate shop
    } else if (k == "poses") {
        int mode = g_cfg.posesFav ? 2 : g_cfg.poses.cycle ? 1 : 0;
        if (step) { mode = Wrap(mode + step, 0, 2); SetMenuValue(key, mode == 2 ? "favorites" : mode == 1 ? "cycle" : "static"); }
        text = mode == 2 ? "Cycle favorites" : mode == 1 ? "Cycle" : "Static";
    } else if (k == "pose_mode") {
        // Noah 2026-11-17: Default, Single Animation, Cycle Animations, Random (in that order); the row under it
        // (anim_browse) opens the picker for the two that need one
        static const int kOrder[4] = { 3, 1, 0, 2 };
        int at = 0;
        for (int i = 0; i < 4; ++i) if (kOrder[i] == g_cfg.poseMode) at = i;
        if (step) {
            at = Wrap(at + step, 0, 3);
            int m = kOrder[at];
            SetMenuValue(key, m == 1 ? "one" : m == 2 ? "random" : m == 3 ? "default" : "favorites");
            g_cfg.poseMode = m;
            g_poseDue = true;
        }
        int mode = kOrder[at];
        text = mode == 3 ? "Default" : mode == 1 ? "Single Animation" : mode == 0 ? "Cycle Animations" : "Random";
        RetInt(script, "rebuild", 1);
    } else if (k == "anim_browse") {
        int mode = g_cfg.poseMode;
        RetInt(script, "show", mode == 1 || mode == 0 ? 1 : 0);
        RetInt(script, "single", mode == 1 ? 1 : 0);
        if (mode == 1) {
            std::string ini, lab;
            if (ReadWholeFile(ExeDirFile("mainmenu.ini"), ini)) lab = Trim(MenuValueRaw(ini, "pose_one_label"));
            if (lab.empty()) {
                int a = AnimIndex(g_cfg.poseOne);
                if (a < 0) a = SeqIndex(g_cfg.poseOne);
                lab = a >= 0 ? FavLabel(a) : "pick one";
            }
            snprintf(buf, sizeof(buf), "Animation: %s", lab.c_str());
        } else {
            snprintf(buf, sizeof(buf), "Animations: %d picked", (int)FavAnims().size());
        }
        text = buf;
    } else if (k == "pose_one") {
        std::vector<int> f = FavAnims();
        if (f.empty()) text = "None yet";
        else {
            int at = 0;
            for (int i = 0; i < (int)f.size(); ++i) if (!_stricmp(FavKey(f[i]).c_str(), g_cfg.poseOne.c_str())) at = i;
            if (step) {
                at = Wrap(at + step, 0, (int)f.size() - 1);
                SetMenuValue(key, FavKey(f[at]));
                if (g_cfg.poseMode != 1) SetMenuValue("pose_mode", "one");  // picking one means you want that one
            }
            text = FavLabel(f[at]);
        }
    } else if (k == "pose_source") {
        bool anim = g_cfg.animSource;
        if (step) { anim = !anim; SetMenuValue(key, anim ? "anim" : "curated"); }
        text = anim ? "Any animation" : "Curated poses";
    } else if (k == "anim_group") {
        int gsel = Wrap(g_cfg.animGroup, 1, kAnimCatCount);
        if (step) {
            gsel = Wrap(gsel + step, 1, kAnimCatCount);
            SetMenuValue(key, std::to_string(gsel));
            std::vector<int> g = AnimGroup(gsel - 1);
            if (!g.empty()) SetMenuValue("anim", kAnims[g[0]].name);
            SetMenuValue("pose_source", "anim");
        }
        sprintf(buf, "%s (%d)", kAnimCats[gsel - 1], (int)AnimGroup(gsel - 1).size()); text = buf;
    } else if (k == "anim") {
        if (step) {
            std::vector<int> g = AnimGroup(Wrap(g_cfg.animGroup, 1, kAnimCatCount) - 1);
            if (!g.empty()) {
                int at = AnimIndex(g_cfg.anim), pos = -1;
                for (int i = 0; i < (int)g.size(); ++i) if (g[i] == at) pos = i;
                pos = pos < 0 ? 0 : Wrap(pos + step, 0, (int)g.size() - 1);
                SetMenuValue(key, kAnims[g[pos]].name);
                SetMenuValue("pose_source", "anim");
                LoadConfig();
            }
        }
        text = AnimText();
    } else if (k == "anim_loop") {
        bool hold = g_cfg.animHold;
        if (step) { hold = !hold; SetMenuValue(key, hold ? "hold" : "loop"); }
        text = hold ? "Hold last frame" : "Loop";
    } else if (k == "spots" || k == "cameras") {
        Mode& m = k == "spots" ? g_cfg.spots : g_cfg.cams;
        if (step) { m.cycle = !m.cycle; SetMenuValue(key, m.cycle ? "cycle" : "static"); }
        text = modeText(m);
        respot = step && k == "spots";
    } else if (k == "spot_pick" || k == "pose_pick" || k == "camera_pick") {
        int count; std::string name;
        if (k == "spot_pick") count = (int)LevelSpots().size();
        else if (k == "pose_pick") count = (int)g_cfg.poseList.size();
        else count = (int)CamPickList().size();
        Mode& m = k == "spot_pick" ? g_cfg.spots : k == "pose_pick" ? g_cfg.poses : g_cfg.cams;
        int pick = count ? Wrap(m.pick, 1, count) : 0;
        if (step && count) { pick = Wrap(pick + step, 1, count); SetMenuValue(key, std::to_string(pick)); }
        if (!count) text = "none";
        else {
            if (k == "spot_pick") name = g_cfg.spotList[LevelSpots()[pick - 1]].name;
            else if (k == "pose_pick") name = g_cfg.poseList[pick - 1].name;
            else {
                const Cam& pc = g_cfg.camList[CamPickList()[pick - 1]];
                name = pc.custom ? "Custom camera" : pc.name;
            }
            text = name;
        }
        respot = step && k == "spot_pick";
    } else if (k == "pose_seconds" || k == "camera_seconds") {
        Mode& m = k == "pose_seconds" ? g_cfg.poses : g_cfg.cams;
        int v = (int)(m.seconds + 0.5f);
        if (step) { v += step * (v >= 30 ? 10 : v >= 10 ? 5 : 1); if (v < 2) v = 2; if (v > 300) v = 300; SetMenuValue(key, std::to_string(v)); }
        sprintf(buf, "%d seconds", v); text = buf;
    } else if (k == "camera_control") {
        bool player = g_cfg.playerCam;
        if (step) { player = !player; SetMenuValue(key, player ? "player" : "menu"); }
        text = player ? "You" : "Menu";
    } else if (k == "deck") {
        bool off = g_cfg.deckOff;
        if (step) { off = !off; SetMenuValue(key, off ? "off" : "on"); }
        text = off ? "Off" : "On";
    } else if (k == "framing") {
        int f = g_cfg.framing;
        if (step) { f = Wrap(f + step, -1, 1); SetMenuValue(key, f < 0 ? "left" : f > 0 ? "right" : "center"); }
        text = f < 0 ? "Left half" : f > 0 ? "Right half" : "Center";
    } else if (k == "shop_theme") {
        // cycles Auto (THUG Pro's date rule), Halloween dark, Halloween bright, Normal dark, Normal bright
        static const int order[5] = { 0, 1, 3, 2, 4 };
        static const char* names[5] = { "auto", "holiday", "normal", "holiday_bright", "normal_bright" };
        static const char* texts[5] = { "Auto", "Halloween dark", "Normal dark", "Halloween bright", "Normal bright" };
        int t = g_cfg.theme, at = -1;
        for (int i = 0; i < 5; ++i) if (order[i] == t) at = i;
        if (step) { t = order[at < 0 ? 0 : Wrap(at + step, 0, 4)]; SetMenuValue(key, names[t]); }
        text = texts[t];
        RetInt(script, "theme", t);
    } else if (k == "order") {
        bool random = g_cfg.cams.random;
        if (step) { random = !random; SetMenuValue(key, random ? "random" : "sequential"); }
        text = random ? "Random" : "In order";
    } else if (k == "blend_seconds") {
        float v = g_cfg.blendSec;
        if (step) { v += step * 0.25f; v = v < 0 ? 0 : v > 5 ? 5 : v; SetMenuValue(key, Num(v, 2)); }
        if (v < 0.01f) text = "Cut"; else { sprintf(buf, "%.2f sec", v); text = buf; }
    } else if (k == "use_home" || k == "context_cams" || k == "match_slope") {
        bool on = k == "use_home" ? g_cfg.useHome : k == "context_cams" ? g_cfg.ctxCams : g_cfg.matchSlope;
        if (step) { on = !on; SetMenuValue(key, on ? "on" : "off"); }
        text = on ? "On" : "Off";
        respot = step && k == "use_home";
    } else if (k == "custom_random") {
        // Custom menus > Random: set = 1 turns it on (the scene reloads and picks one); on = 1 while it's on
        std::string path = ExeDirFile("mainmenu.ini"), data;
        ReadWholeFile(path, data);
        bool on = Lower(Trim(MenuValueRaw(data, "custom_random"))) == "on";
        if (IntParam(params, "set", 0)) {
            on = true;
            SetSecValue(data, "menu", "custom_random", "on");
            if (MenuLevelIndex(g_cfg.level) == 0) {  // from a Skate shop scene: switch the Menu scene to Custom menus
                std::vector<int> v = SavedLevels();
                SetSecValue(data, "menu", "level", !v.empty() ? kMenuLevels[v.back()].key : "east_la");
            }
            WriteWholeFile(path, data);
        }
        RetInt(script, "on", on ? 1 : 0);
        text = on ? "On" : "Off";
    } else if (k == "menu_scene") {
        // one option for the scene behind the main menu: the stock Skate Shop (normal, Halloween bright, Halloween dark)
        // or your custom menus (the one picked in Custom menus, else the newest Set Main Menu Here save)
        // Halloween bright = the Halloween props with the shop's normal afternoon lighting (load_level picks the
        // lighting from shop_theme: only Halloween dark gets stock's October night lighting)
        // Starred (Noah 2026-11-17): each start shows one of the custom menus starred (d-pad Right) in Custom menus, at
        // random or in turn (Cycle order); all saved menus when none is starred. Same as custom_random = on.
        static const char* kNames[6] = { "Shop bright", "Shop dark", "Spooky", "Spooky dark", "Custom", "Starred" };
        int lv = MenuLevelIndex(g_cfg.level), cur;
        std::string path = ExeDirFile("mainmenu.ini"), data;
        ReadWholeFile(path, data);
        bool starred = Lower(Trim(MenuValueRaw(data, "custom_random"))) == "on";
        if (lv != 0) cur = starred ? 5 : 4;
        else cur = g_cfg.theme == 4 ? 1 : g_cfg.theme == 3 ? 2 : g_cfg.theme == 1 ? 3 : 0;
        if (step) {
            cur = Wrap(cur + step, 0, 5);
            std::string custom;  // the custom level in use, else the remembered one, else the newest saved one, else East LA
            if (cur >= 4) {
                std::vector<int> v = SavedLevels();
                std::string remembered = Lower(Trim(MenuValueRaw(data, "custom_level")));
                int ri = remembered.empty() ? -1 : MenuLevelExact(remembered);
                custom = lv > 0 ? kMenuLevels[lv].key : ri > 0 ? kMenuLevels[ri].key : !v.empty() ? kMenuLevels[v.back()].key : "east_la";
                SetSecValue(data, "menu", "level", custom);
                SetSecValue(data, "menu", "custom_random", cur == 5 ? "on" : "off");
            } else {
                if (lv != 0) SetSecValue(data, "menu", "custom_level", kMenuLevels[lv].key);
                SetSecValue(data, "menu", "level", "skateshop");
                SetSecValue(data, "menu", "shop_theme", cur == 1 ? "normal_night" : cur == 2 ? "holiday_bright" : cur == 3 ? "holiday" : "normal");
            }
            WriteWholeFile(path, data);
        }
        text = kNames[cur];
        RetInt(script, "pending", step ? 1 : 0);
    } else if (k == "ambient_people" || k == "ambient_level") {
        // Ambient life on the custom menu maps that have it (gen_menu_ambient.py), People + cars by default:
        // People = the map's ambient pedestrians (spawned by the menu); People + traffic = the live map, with its
        // people and vehicles exactly as in free skate (Load_MainMenu loads level_Mainmenu_<key>_live)
        static const char* kAmbientLevels[] = { "z_ho", "z_bh" };
        std::string path = ExeDirFile("mainmenu.ini"), data;
        ReadWholeFile(path, data);
        std::string v = Lower(Trim(MenuValueRaw(data, "ambient_people")));
        int mode = v == "off" ? 0 : v == "on" || v == "people" ? 1 : 2;  // default People + cars (Noah 2026-11-17)
        if (k == "ambient_level") {
            int idx = IntParam(params, "index", -1);
            bool allowed = false;
            for (auto* a : kAmbientLevels) if (idx >= 0 && idx < kMenuLevelCount && !strcmp(kMenuLevels[idx].key, a)) allowed = true;
#ifdef DADMOD_CLIENT_HAS_MAINMENU
            if (allowed && !ClientHasMenuArchive(std::string(kMenuLevels[idx].key) + "_live")) allowed = false;
#endif
            if (mode == 2 && allowed) {
                std::string st = std::string("level_Mainmenu_") + kMenuLevels[idx].key + "_live";
                RetName(script, "live_level", st.c_str());
                Log("ambient life: loading the live map %s", st.c_str());
            }
            return true;
        }
        int before = mode;
        if (step) { mode = Wrap(mode + step, 0, 2); SetMenuValue("ambient_people", mode == 2 ? "traffic" : mode == 1 ? "people" : "off"); }
        text = mode == 2 ? "People+cars" : mode == 1 ? "People" : "Off";
        RetInt(script, "on", mode >= 1 && g_ambientReady ? 1 : 0);  // the menu spawns the people; a live-loaded DLL waits for the next scene load
        RetInt(script, "pending", step && (mode == 2 || before == 2) ? 1 : 0);  // in or out of the live map: reload the scene
    } else if (k == "ambient_ok") {
        // a pedestrian at px py pz may spawn unless it would stand on the skater's spot or in the camera's view of them
        Vec p = V(FloatParam(params, "px", 0), FloatParam(params, "py", 0), FloatParam(params, "pz", 0));
        bool ok = true;
        if (g_spot >= 0 && g_spot < (int)g_cfg.spotList.size()) {
            Vec sp = g_cfg.spotList[g_spot].pos, d = Sub(p, sp);
            if (d.x * d.x + d.y * d.y + d.z * d.z < 150 * 150) ok = false;
            if (ok && g_outValid) {  // distance from the camera-to-skater line
                Vec ab = Sub(sp, g_outPos), ap = Sub(p, g_outPos);
                float l2 = ab.x * ab.x + ab.y * ab.y + ab.z * ab.z, u = l2 > 1 ? (ap.x * ab.x + ap.y * ab.y + ap.z * ab.z) / l2 : 0;
                if (u > 0 && u < 1) {
                    Vec c = Add(g_outPos, Mul(ab, u)), e = Sub(p, c);
                    if (e.x * e.x + e.y * e.y + e.z * e.z < 60 * 60) ok = false;
                }
            }
        }
        RetInt(script, "ok", ok ? 1 : 0);
    } else if (k == "menu_alive") {
        // create_main_menu: backing out to the main screen while the menu scene is already up and driven, so it
        // can skip the fade from black, the stock camera and re-placing the skater (they made it flash)
        RetInt(script, "alive", g_lastTick && GetTickCount() - g_lastTick < 3000 ? 1 : 0);
    } else if (k == "frozen") {
        RetInt(script, "on", g_frozen ? 1 : 0);  // thugpro_menu_idle: keep the skater paused after SkaterInit
    } else if (k == "tick_age") {
        // ms since the menu driver last ticked (the join fade: the driver dies when the menu level unloads)
        RetInt(script, "age", g_lastTick ? (int)(GetTickCount() - g_lastTick) : 999999);
    } else if (k == "pose_refresh") {
        g_poseDue = true;  // another screen re-inited the skater: put the menu pose back
    } else if (k == "cam_reposition") {
        text = "";
    } else if (k == "custom_cam_menu") {
        int n = (int)CustomCams().size();
        sprintf(buf, "%d saved", n); text = buf;
    } else if (k == "custom_cam") {
        // Custom camera menu row: index -> name, cur (the shot on screen), found
        std::vector<int> v = CustomCams();
        int i = IntParam(params, "index", 0);
        if (i < 0 || i >= (int)v.size()) { RetInt(script, "found", 0); return true; }
        RetInt(script, "found", 1);
        RetStr(script, "name", g_cfg.camList[v[i]].name.c_str());
        RetInt(script, "cur", v[i] == g_cam ? 1 : 0);
        text = g_cfg.camList[v[i]].name;
    } else if (k == "custom_pick" || k == "custom_del") {
        std::vector<int> v = CustomCams();
        int i = IntParam(params, "index", -1);
        if (i < 0 || i >= (int)v.size()) return true;
        Cam c = g_cfg.camList[v[i]];
        std::string path = ExeDirFile("mainmenu.ini"), data;
        ReadWholeFile(path, data);
        std::string selKey = std::string("custom_cam_") + LevelName();
        bool wasCustom = g_cam >= 0 && g_cam < (int)g_cfg.camList.size() && g_cfg.camList[g_cam].custom;
        if (k == "custom_pick") {
            if (!wasCustom) SetSecValue(data, "menu", "custom_prev_pick", std::to_string(g_cfg.cams.pick));
            SetSecValue(data, "menu", selKey.c_str(), c.sec);
            SetSecValue(data, "menu", "cameras", "static");
            WriteWholeFile(path, data);
            LoadConfig();
            std::vector<int> w = CamPickList();
            for (int j = 0; j < (int)w.size(); ++j) if (g_cfg.camList[w[j]].custom) SetMenuValue("camera_pick", std::to_string(j + 1));
            Log("custom camera: %s", c.name.c_str());
        } else {
            if (c.isHome) {  // a level's saved camera: keep its spot, just stop using the shot
                ArchiveIni("[" + c.sec + "]" + SecBody(data, c.sec), "custom camera deleted");
                SetSecValue(data, c.sec, "camera", "none");
            } else ArchiveIni(CutSection(data, c.sec), "custom camera deleted");
            bool wasActive = v[i] == g_cam;
            if (wasActive) SetSecValue(data, "menu", selKey.c_str(), "");
            WriteWholeFile(path, data);
            LoadConfig();
            if (wasActive && CustomCams().empty()) {  // nothing custom left here: the Camera shot used before
                std::string prev = Trim(MenuValueRaw(data, "custom_prev_pick"));
                if (!prev.empty()) SetMenuValue("camera_pick", prev);
            }
            Log("custom camera deleted: %s", c.name.c_str());
        }
        LoadConfig();
        g_cam = -1;
        StartBlend(g_cfg.blendSec > 0.1f ? g_cfg.blendSec : 1.0f);
        text = c.name;
    } else if (k == "cam_reset") {
        bool ok = g_cam >= 0 && g_cam < (int)g_cfg.camList.size();
        if (!ok) text = "No camera";
        else if (step) {
            Cam c = g_cfg.camList[g_cam];  // a copy: LoadConfig below rebuilds camList
            std::string path = ExeDirFile("mainmenu.ini"), data;
            ReadWholeFile(path, data);
            std::string body = SecBody(data, c.sec);
            size_t at = SecStart(data, c.sec);
            std::string prevPick;
            {
                std::string d2;
                ReadWholeFile(path, d2);
                prevPick = Trim(MenuValueRaw(d2, "custom_prev_pick"));
            }
            if (c.custom && !c.isHome && IniValue(body, "defaults_saved").empty()) {
                if (prevPick.empty()) text = "Done";
                else {
                    SetMenuValue("camera_pick", prevPick);
                    LoadConfig();
                    g_cam = -1;
                    StartBlend(g_cfg.blendSec > 0.1f ? g_cfg.blendSec : 1.0f);
                    Log("camera: back to Camera shot %s (the custom camera stays in Custom camera)", prevPick.c_str());
                    text = "Done";
                }
            }
            else if (IniValue(body, "defaults_saved").empty() || at == std::string::npos) text = "Done";
            else {
                // in place (the order of [camera N] sections is camera_pick's numbering): drop the edited fields and
                // the saved defaults, then write the defaults back as the fields
                size_t p = data.find('\n', at);
                p = p == std::string::npos ? data.size() : p + 1;
                size_t ins = p;
                while (p < data.size() && data[p] != '[') {
                    size_t e = data.find('\n', p);
                    e = e == std::string::npos ? data.size() : e + 1;
                    std::string line = data.substr(p, e - p);
                    std::string key = Lower(Trim(line.substr(0, line.find('='))));
                    bool drop = key == "defaults_saved" || key == "default_camera_pick";
                    for (auto* f : kCamFields) if (key == f || key == std::string("default_") + f) drop = true;
                    if (drop) { data.erase(p, e - p); continue; }
                    if (!Trim(line).empty()) ins = e;  // after the section's last non-blank line
                    p = e;
                }
                std::string add;
                for (auto* f : kCamFields) {
                    std::string d = IniValue(body, (std::string("default_") + f).c_str());
                    if (!NoDefault(f, d)) add += std::string(f) + " = " + d + "\r\n";
                }
                data.insert(ins, add);
                ArchiveIni("[" + c.sec + "]" + body, "edited shot replaced by Orbit Options > Default");  // nothing is lost
                std::string pick = IniValue(body, "default_camera_pick");
                if (!pick.empty()) SetSecValue(data, "menu", "camera_pick", pick);
                WriteWholeFile(path, data);
                LoadConfig();
                g_cam = -1;  // pick the restored shot now
                StartBlend(g_cfg.blendSec > 0.1f ? g_cfg.blendSec : 1.0f);
                Log("camera %s: back to its default", c.sec.c_str());
                text = "Done";
            }
        }
    } else if (!k.compare(0, 4, "cam_")) {
        // live camera editor: changes the camera on screen now ([camera N] or the level's [home]) and saves it
        bool ok = g_cam >= 0 && g_cam < (int)g_cfg.camList.size();
        Cam c = ok ? g_cfg.camList[g_cam] : Cam();
        if (ok && c.style != "orbit" && !c.isHome) ok = false;  // fixed / look / pan / sway shots have no orbit numbers
        if (!ok) text = g_cam >= 0 ? "Orbit only" : "No camera";
        else if (c.sec == "static camera" && (k == "cam_range" || k == "cam_speed")) text = "Still";  // Static never moves
        else if (k == "cam_range") {
            static const int kRanges[] = { 0, 270, 180, 120, 90, 60 };  // 0 = full circles
            int cur = (int)floorf(c.swing * 2 + 0.5f), at = 0, best = 9999;
            for (int i = 0; i < 6; ++i) { int d = abs(kRanges[i] - cur); if (d < best) { best = d; at = i; } }
            if (step) {
                at = Wrap(at + step, 0, 5);
                std::string path = ExeDirFile("mainmenu.ini"), data;
                ReadWholeFile(path, data);
                SnapCamDefaults(data, c.sec);
                if (c.isHome && c.style == "fixed") SetSecValue(data, c.sec, "camera", "orbit");
                SetSecValue(data, c.sec, "range", kRanges[at] ? std::to_string(kRanges[at]) : std::string("full"));
                if (fabsf(c.speed) < 0.5f) SetSecValue(data, c.sec, "speed", "8");  // a range needs the camera moving
                WriteWholeFile(path, data);
            }
            if (!kRanges[at]) text = "Full circle";
            else { sprintf(buf, "Sweep %d", kRanges[at]); text = buf; }
        } else {
            std::string field = k.substr(4);
            float v = field == "radius" ? c.radius : field == "height" ? c.height : field == "look" ? c.look :
                      field == "speed" ? c.speed : field == "start" ? c.start : field == "swing" ? c.swing : 0;
            float st = field == "radius" ? 10.0f : field == "speed" ? 1.0f : field == "start" ? 15.0f : field == "swing" ? 10.0f : 5.0f;
            if (step) {
                v = floorf(v / st + 0.5f) * st + step * st;
                if (field == "radius") v = v < 20 ? 20 : v > 3000 ? 3000 : v;
                else if (field == "height") v = v < -500 ? -500 : v > 1500 ? 1500 : v;
                else if (field == "look") v = v < -50 ? -50 : v > 300 ? 300 : v;
                else if (field == "speed") v = v < -60 ? -60 : v > 60 ? 60 : v;
                else if (field == "swing") v = v < 0 ? 0 : v > 180 ? 180 : v;
                else if (field == "start") { if (v > 180) v -= 360; if (v <= -180) v += 360; }
                std::string path = ExeDirFile("mainmenu.ini"), data;
                ReadWholeFile(path, data);
                SnapCamDefaults(data, c.sec);
                if (c.isHome && c.style == "fixed") SetSecValue(data, c.sec, "camera", "orbit");  // fine-tuning turns the free cam shot into an orbit
                SetSecValue(data, c.sec, field.c_str(), Num(v));
                WriteWholeFile(path, data);
            }
            if (field == "start") sprintf(buf, "%d%s", (int)v, (int)v == 0 ? " front" : (int)v == 180 || (int)v == -180 ? " behind" : (int)v == 90 || (int)v == -90 ? " side" : "");
            else if (field == "speed") sprintf(buf, (int)v ? "%d/sec" : "Still", (int)v);
            else if (field == "swing") sprintf(buf, (int)v ? "%d deg" : "Full circle", (int)v);
            else sprintf(buf, "%d", (int)v);
            text = buf;
        }
    } else return false;
    if (step) {
        LoadConfig();  // g_level stays the scene that is loaded; a new level applies on the next menu load
        if (respot && MenuLevelIndex(g_cfg.level) != g_level) respot = false;  // other scene: next load
        if (respot) { g_spot = -1; ChooseSpot(); }
        // Only reset what this option changes: re-posing re-inits the skater (SkaterInit), and doing
        // that several times a second (fast arrow presses) crashed the game.
        if (k == "poses" || k == "pose_pick" || k == "pose_seconds" || k == "pose_source" || k == "anim_group" || k == "anim" ||
            k == "pose_mode" || k == "pose_one" ||
            k == "anim_loop" || respot) { g_pose = -1; g_poseDue = true; }
        if (k == "cameras" || k == "camera_pick" || k == "camera_seconds" || k == "framing" || k == "order" || respot) g_cam = -1;
        if (!k.compare(0, 4, "cam_") && k != "cam_reset") StartBlend(0.3f);  // editor steps glide instead of jumping
        Log("menu option %s -> %s", key, text.c_str());
    }
    if (text.size() > 11) text = Trim(text.substr(0, 10)) + ".";  // fits between the option arrows (Noah 2026-10-23: no overlaps)
    RetStr(script, "text", text.c_str());
    RetInt(script, "respot", respot ? 1 : 0);
    return true;
}

// THUGRECOMP_MenuDelete kind="spot"|"camera" -> deletes the marked spot / camera that spot_pick / camera_pick
// points at. The section is copied to dadmod\mainmenu_deleted.txt first (nothing is lost for good). Spots are
// renumbered 1..n afterwards and cameras' "spot =" follow them (a camera tied to the deleted spot becomes "any").
struct IniSec { size_t a, b; std::string kind; int num; };
static std::vector<IniSec> IniSections(const std::string& data) {
    std::vector<IniSec> secs;
    std::string low = Lower(data);
    for (size_t at = 0; at < data.size();) {
        size_t e = data.find('\n', at);
        e = e == std::string::npos ? data.size() : e + 1;
        size_t k = at;
        while (k < e && (low[k] == ' ' || low[k] == '\t')) ++k;
        if (k < e && low[k] == '[') {
            if (!secs.empty()) secs.back().b = at;
            IniSec s; s.a = at; s.b = data.size(); s.num = 0;
            size_t r = low.find(']', k);
            std::string n = Trim(low.substr(k + 1, r == std::string::npos ? 0 : r - k - 1));
            if (!n.compare(0, 4, "spot") && n.size() > 4) { s.kind = "spot"; s.num = atoi(n.c_str() + 4); }
            else if (!n.compare(0, 6, "camera") && n.size() > 6) { s.kind = "camera"; s.num = atoi(n.c_str() + 6); }
            secs.push_back(s);
        }
        at = e;
    }
    return secs;
}
static std::string IniValue(const std::string& body, const char* key) {
    std::string low = Lower(body), want = std::string("\n") + key;
    for (size_t at = low.find(want); at != std::string::npos; at = low.find(want, at + 1)) {
        size_t k = at + want.size();
        while (k < low.size() && (low[k] == ' ' || low[k] == '\t')) ++k;
        if (k >= low.size() || low[k] != '=') continue;
        size_t end = body.find_first_of("\r\n;", k);
        return Trim(body.substr(k + 1, end == std::string::npos ? std::string::npos : end - k - 1));
    }
    return "";
}
static bool __cdecl CF_MenuDelete(void* params, void* script) {
    const char* kind = nullptr;
    GetStringParam(params, "kind", &kind);
    if (!kind) return false;
    bool spot = !_stricmp(kind, "spot");
    LoadConfig();
    std::string path = ExeDirFile("mainmenu.ini"), data;
    if (!ReadWholeFile(path, data)) return false;
    {   // a level's saved spot / camera ([home <level>], Set Main Menu Here): Y deletes the whole home section
        std::string homeSec;
        if (spot) {
            std::vector<int> v = LevelSpots();
            if (!v.empty()) { const Spot& sp = g_cfg.spotList[v[Wrap(g_cfg.spots.pick, 1, (int)v.size()) - 1]]; if (sp.isHome) homeSec = "home " + sp.level; }
        } else if (!CamPickList().empty()) {
            std::vector<int> w = CamPickList();
            const Cam& c = g_cfg.camList[w[Wrap(g_cfg.cams.pick, 1, (int)w.size()) - 1]];
            if (c.isHome) homeSec = c.sec;
        }
        if (!homeSec.empty()) {
            RetInt(script, "builtin", 0);
            if (IntParam(params, "check", 0)) return true;
            if (spot) ArchiveIni(CutSection(data, homeSec), "deleted");
            else {  // the level's own camera shot only: its saved spot stays
                std::string copy = data;
                ArchiveIni(CutSection(copy, homeSec), "deleted camera of");
                SetSecValue(data, homeSec, "camera", "none");
            }
            if (!WriteWholeFile(path, data)) return false;
            LoadConfig();
            g_spot = -1; ChooseSpot();
            g_pose = -1; g_poseDue = true; g_cam = -1;
            Log("deleted [%s] (a copy is in mainmenu_deleted.txt)", homeSec.c_str());
            RetInt(script, "respot", 1);
            return true;
        }
    }
    std::vector<IniSec> secs = IniSections(data);
    // find the section the picker shows (matched by position for spots, by name in number order for cameras)
    int target = -1;
    if (spot) {
        std::vector<int> v = LevelSpots();
        if (v.empty()) return false;
        const Spot& want = g_cfg.spotList[v[Wrap(g_cfg.spots.pick, 1, (int)v.size()) - 1]];
        for (int i = 0; i < (int)secs.size() && target < 0; ++i) {
            if (secs[i].kind != "spot") continue;
            Vec p;
            if (!ParseVec(IniValue(data.substr(secs[i].a, secs[i].b - secs[i].a), "pos"), &p)) continue;
            if (fabsf(p.x - want.pos.x) < 0.05f && fabsf(p.y - want.pos.y) < 0.05f && fabsf(p.z - want.pos.z) < 0.05f) target = i;
        }
    } else {
        std::vector<int> w = CamPickList();
        if (w.empty()) return false;
        const Cam& want = g_cfg.camList[w[Wrap(g_cfg.cams.pick, 1, (int)w.size()) - 1]];
        int num = atoi(want.sec.c_str() + 6);  // "camera N"
        for (int i = 0; i < (int)secs.size() && target < 0; ++i) if (secs[i].kind == "camera" && secs[i].num == num) target = i;
    }
    if (target < 0) { Log("delete %s: entry not found", kind); return false; }
    {   // the spots and camera shots that come with the mod (in kDefaultIni) can't be deleted, only marked ones
        std::string nm = Lower(IniValue(data.substr(secs[target].a, secs[target].b - secs[target].a), "name"));
        std::string def = kDefaultIni;
        std::vector<IniSec> ds = IniSections(def);
        bool builtin = false;
        for (auto& d : ds)
            if (d.kind == secs[target].kind && Lower(IniValue(def.substr(d.a, d.b - d.a), "name")) == nm) builtin = true;
        RetInt(script, "builtin", builtin ? 1 : 0);
        if (builtin || IntParam(params, "check", 0)) return true;
    }
    std::string removed = data.substr(secs[target].a, secs[target].b - secs[target].a);
    int removedNum = secs[target].num;
    {   // keep a copy
        std::string arch = ExeDirFile("mainmenu_deleted.txt"), old;
        ReadWholeFile(arch, old);
        SYSTEMTIME t; GetLocalTime(&t);
        char head[96];
        sprintf(head, "; deleted %04d-%02d-%02d %02d:%02d:%02d\r\n", t.wYear, t.wMonth, t.wDay, t.wHour, t.wMinute, t.wSecond);
        if (!removed.empty() && removed[removed.size() - 1] != '\n') removed += "\r\n";
        WriteWholeFile(arch, old + head + removed);
    }
    data.erase(secs[target].a, secs[target].b - secs[target].a);
    if (spot) {
        // renumber the remaining spots 1..n and remap the cameras' spot = N
        std::vector<int> nums;
        for (auto& s : secs) if (s.kind == "spot" && s.num != removedNum) nums.push_back(s.num);
        std::sort(nums.begin(), nums.end());
        std::map<int, int> remap;
        for (int i = 0; i < (int)nums.size(); ++i) remap[nums[i]] = i + 1;
        remap[removedNum] = 0;
        std::string out;
        bool inCam = false;
        for (size_t at = 0; at < data.size();) {
            size_t e = data.find('\n', at);
            e = e == std::string::npos ? data.size() : e + 1;
            std::string line = data.substr(at, e - at), ll = Lower(Trim(line));
            if (!ll.empty() && ll[0] == '[') {
                inCam = !ll.compare(0, 7, "[camera");
                if (!ll.compare(0, 5, "[spot")) {
                    int n = atoi(ll.c_str() + 5);
                    size_t r = line.find(']');
                    if (remap.count(n) && r != std::string::npos) line = "[spot " + std::to_string(remap[n]) + line.substr(r);
                }
            } else if (inCam && !ll.compare(0, 4, "spot")) {
                size_t eq = line.find('=');
                int n = eq == std::string::npos ? 0 : atoi(line.c_str() + eq + 1);
                if (n && remap.count(n)) {
                    size_t end = line.find_first_of("\r\n;", eq);
                    if (end == std::string::npos) end = line.size();
                    line.replace(eq + 1, end - eq - 1, " " + std::to_string(remap[n]) + (end < line.size() && line[end] == ';' ? "      " : ""));
                }
            }
            out += line;
            at = e;
        }
        data = out;
    }
    if (!WriteWholeFile(path, data)) return false;
    LoadConfig();
    // keep the picker on a valid entry, then show the change
    if (spot) {
        int count = (int)LevelSpots().size();
        if (g_cfg.spots.pick > count) { SetMenuValue("spot_pick", std::to_string(count < 1 ? 1 : count)); LoadConfig(); }
        g_spot = -1; ChooseSpot();
        g_pose = -1; g_poseDue = true;
    } else {
        int count = (int)CamPickList().size();
        if (g_cfg.cams.pick > count) { SetMenuValue("camera_pick", std::to_string(count < 1 ? 1 : count)); LoadConfig(); }
    }
    g_cam = -1;
    Log("deleted %s %d (a copy is in mainmenu_deleted.txt)", kind, removedNum);
    RetInt(script, "respot", spot ? 1 : 0);
    return true;
}

// ---- main screen item order (F9 reorder mode)
// THUGRECOMP_KeyPressed key="F9"          -> true once per press (only while the game window is in front); key="Alt+F12" needs Alt; key="Home" too
//                       key="Shift"       -> true while Shift is held
// THUGRECOMP_MenuOrder count=N pos=i       -> idx: which item goes at position i (main_order in [menu])
// THUGRECOMP_MenuOrderMove count=N from=i to=j  moves the item at position i to position j and saves

static bool __cdecl CF_KeyPressed(void* params, void*) {
    const char* key = nullptr;
    GetStringParam(params, "key", &key);
    if (!key) return false;
    // key="Shift": true while Shift is held (not once per press), game window in front. Edit Skater sliders use it
    // for fast steps on keyboard (Noah 2026-11-20). Older DLLs return false for it.
    if (_stricmp(key, "Shift") == 0) {
        DWORD spid = 0;
        HWND sfg = GetForegroundWindow();
        if (sfg) GetWindowThreadProcessId(sfg, &spid);
        return spid == GetCurrentProcessId() && (GetAsyncKeyState(VK_SHIFT) & 0x8000) != 0;
    }
    // key="Home": true once per press, game window in front, Alt/Ctrl not held (Noah 2026-11-21: Home = level select
    // in free skate, mods/homelevel). Older DLLs return false for it.
    if (_stricmp(key, "Home") == 0) {
        static bool homeWas = false;
        DWORD hpid = 0;
        HWND hfg = GetForegroundWindow();
        if (hfg) GetWindowThreadProcessId(hfg, &hpid);
        bool hnow = hpid == GetCurrentProcessId() && (GetAsyncKeyState(VK_HOME) & 0x8000) != 0 &&
                    (GetAsyncKeyState(VK_MENU) & 0x8000) == 0 && (GetAsyncKeyState(VK_CONTROL) & 0x8000) == 0;
        bool hfresh = hnow && !homeWas;
        homeWas = hnow;
        return hfresh;
    }
    // "Alt+F12" needs Alt held; a plain "F12" ignores the press while Alt is held (Noah 2026-11-02: Alt+F12 = Chat Art)
    bool alt = _strnicmp(key, "alt+", 4) == 0;
    if (alt) key += 4;
    if (key[0] != 'F' && key[0] != 'f') return false;
    int n = atoi(key + 1);
    if (n < 1 || n > 12) return false;
    int vk = VK_F1 + n - 1;
    static bool down[2][12];
    DWORD pid = 0;
    HWND fg = GetForegroundWindow();
    if (fg) GetWindowThreadProcessId(fg, &pid);
    bool altHeld = (GetAsyncKeyState(VK_MENU) & 0x8000) != 0;
    bool now = pid == GetCurrentProcessId() && (GetAsyncKeyState(vk) & 0x8000) != 0 && altHeld == alt;
    bool pressed = now && !down[alt][n - 1];
    down[alt][n - 1] = now;
    return pressed;
}

static std::vector<int> MainOrder(int count) {
    std::string path = ExeDirFile("mainmenu.ini"), data, val;
    ReadWholeFile(path, data);
    std::string low = Lower(data);
    size_t at = low.find("\nmain_order");
    if (at != std::string::npos) {
        size_t eq = data.find('=', at), end = data.find_first_of("\r\n;", eq == std::string::npos ? at : eq);
        if (eq != std::string::npos) val = data.substr(eq + 1, (end == std::string::npos ? data.size() : end) - eq - 1);
    }
    std::vector<int> order;
    std::vector<bool> used(count, false);
    for (auto& c : val) if (c == ',') c = ' ';
    char buf[256]; strncpy(buf, val.c_str(), 255); buf[255] = 0;
    for (char* t = strtok(buf, " \t"); t; t = strtok(nullptr, " \t")) {
        int v = atoi(t);
        if (v >= 0 && v < count && !used[v]) { used[v] = true; order.push_back(v); }
    }
    for (int i = 0; i < count; ++i) if (!used[i]) order.push_back(i);
    return order;
}

static bool __cdecl CF_MenuOrder(void* params, void* script) {
    int count = IntParam(params, "count", 0), pos = IntParam(params, "pos", 0);
    if (count <= 0 || pos < 0 || pos >= count) return false;
    RetInt(script, "idx", MainOrder(count)[pos]);
    return true;
}

static std::vector<std::string> g_orderUndo;  // previous main_order values, newest last (this session)

static std::string OrderText(const std::vector<int>& o) {
    std::string v;
    for (size_t i = 0; i < o.size(); ++i) { if (i) v += ","; v += std::to_string(o[i]); }
    return v;
}

static bool __cdecl CF_MenuOrderMove(void* params, void*) {
    int count = IntParam(params, "count", 0), from = IntParam(params, "from", -1), to = IntParam(params, "to", -1);
    if (count <= 0 || from < 0 || from >= count || to < 0 || to >= count) return false;
    std::vector<int> o = MainOrder(count);
    if (from == to) return true;
    g_orderUndo.push_back(OrderText(o));
    int item = o[from];
    o.erase(o.begin() + from);
    o.insert(o.begin() + to, item);
    std::string v = OrderText(o);
    SetMenuValue("main_order", v);
    Log("main screen order -> %s", v.c_str());
    return true;
}

// THUGRECOMP_MenuOrderUndo count=N   -> false when there is nothing to undo
static bool __cdecl CF_MenuOrderUndo(void*, void*) {
    if (g_orderUndo.empty()) return false;
    std::string v = g_orderUndo.back();
    g_orderUndo.pop_back();
    SetMenuValue("main_order", v);
    Log("main screen order undo -> %s", v.c_str());
    return true;
}

// THUGRECOMP_MenuOrderReset count=N  -> stock order (undoable)
static bool __cdecl CF_MenuOrderReset(void* params, void*) {
    int count = IntParam(params, "count", 0);
    if (count <= 0) return false;
    std::vector<int> o = MainOrder(count), def;
    for (int i = 0; i < count; ++i) def.push_back(i);
    if (o == def) return false;
    g_orderUndo.push_back(OrderText(o));
    SetMenuValue("main_order", OrderText(def));
    Log("main screen order reset");
    return true;
}


// THUGRECOMP_ScanText text="..." mode t x y c s center codes item  -> the text with a THUG color code in
// front of every letter. mode 0 = Scan (a rainbow sweeping across the letters along the angle c/s),
// 1 = Random Letter (every letter re-rolls when t ticks over), 2 = Random Letter static (rolls once),
// 3 = Matrix (greens flickering, a white head running down each column, now and then a letter briefly
// swapped for a random symbol). codes = the color codes to use, in order (a theme; default spectrum).
// x/y = the option's screen position, item = its index in the menu, t = time (float, speed applied by
// the caller). Existing \cN codes in the text are dropped. Rainbow modes in Menu UI (menuui.q).
static unsigned LfHash(unsigned a, unsigned b, unsigned c) {
    unsigned h = a * 0x9E3779B1u ^ (b + 0x7F4A7C15u) * 0x85EBCA77u ^ (c + 0x165667B1u) * 0xC2B2AE3Du;
    h ^= h >> 15; h *= 0x2C1B3C6Du; h ^= h >> 12; h *= 0x297A2D39u; h ^= h >> 15;
    return h;
}
// THUGRECOMP_TextClip text="..." max=N -> clipped: the text cut to at most N characters at a word boundary, with "..."
// Pause-style menus show descriptions in a fixed-size text element; long Dadmod descriptions overflowed it and
// corrupted the game's memory (crash). The right-side Dadmod description panel takes the full text.
static bool __cdecl CF_TextClip(void* params, void* script) {
    const char* text = nullptr;
    GetStringParam(params, "text", &text);
    if (!text) return false;
    int max = IntParam(params, "max", 100);
    std::string t = text;
    if ((int)t.size() > max && max > 4) {
        t = t.substr(0, max - 3);
        size_t sp = t.find_last_of(' ');
        if (sp != std::string::npos && sp > (size_t)max / 2) t = t.substr(0, sp);
        while (!t.empty() && (t.back() == ' ' || t.back() == ',' || t.back() == '.')) t.pop_back();
        t += "...";
    }
    RetStr(script, "clipped", t.c_str());
    return true;
}
// THUGRECOMP_UiClock rate=R wrap=W -> tr (float) = real time in 0.1 s steps * R, mod W; ms (int) = real-time ms mod 6000.
// One wall clock for every menu color effect (Noah 2026-11-17: Edit Skater colors ran at their own pace because each
// color loop counted its own ticks from when it was last restarted). Every menu reads the same clock, so all menus
// show the same phase at the same speed.
static bool __cdecl CF_UiClock(void* params, void* script) {
    static DWORD t0 = GetTickCount();
    DWORD ms = GetTickCount() - t0;
    float rate = FloatParam(params, "rate", 1.0f), wrap = FloatParam(params, "wrap", 10080.0f);
    if (wrap < 1.0f) wrap = 10080.0f;
    double v = fmod((double)ms / 100.0 * rate, (double)wrap);
    if (script) {
        void* ps = *(void**)((char*)script + 0x14);
        typedef void (__thiscall* Fn)(void*, DWORD, float);
        if (ps) ((Fn)kAddFloat)(ps, QbKey("tr"), (float)v);
    }
    RetInt(script, "ms", (int)(ms % 6000));
    return true;
}
// THUGRECOMP_Display key="mode"|"res" step=N -> text (Graphics > Display, Noah 2026-11-18). Reads and writes THUG Pro's
// own display settings (HKCU\Software\THUG Pro\Settings: windowed_mode, width/height = fullscreen size,
// window_width/window_height = window size, the same values its launcher writes), so the two never disagree. The game
// reads them when it starts, so a change shows after a restart. Resolution sets both sizes so switching modes keeps it;
// in windowed mode the list stops at what fits on the screen. DisplayCheckAtBoot fixes a size the monitor can't show.
struct DispMode { int w, h; };
static const char* kThugProKey = "Software\\THUG Pro\\Settings";
static DWORD DispGet(const char* name, DWORD def) {
    HKEY k; DWORD v = def, n = sizeof(v);
    if (RegOpenKeyExA(HKEY_CURRENT_USER, kThugProKey, 0, KEY_READ, &k) == ERROR_SUCCESS) {
        if (RegQueryValueExA(k, name, NULL, NULL, (BYTE*)&v, &n) != ERROR_SUCCESS) v = def;
        RegCloseKey(k);
    }
    return v;
}
static void DispSet(const char* name, DWORD v) {
    HKEY k;
    if (RegCreateKeyExA(HKEY_CURRENT_USER, kThugProKey, 0, NULL, 0, KEY_WRITE, NULL, &k, NULL) == ERROR_SUCCESS) {
        RegSetValueExA(k, name, 0, REG_DWORD, (const BYTE*)&v, sizeof(v));
        RegCloseKey(k);
    }
}
// sizes the main monitor can show (at least 800x600), smallest first; windowed = only the ones that fit the work area
static std::vector<DispMode> DispModes(bool windowed) {
    std::vector<DispMode> v;
    DEVMODEA dm = {}; dm.dmSize = sizeof(dm);
    RECT wa; SystemParametersInfoA(SPI_GETWORKAREA, 0, &wa, 0);
    for (DWORD i = 0; EnumDisplaySettingsA(NULL, i, &dm); i++) {
        int w = (int)dm.dmPelsWidth, h = (int)dm.dmPelsHeight;
        if (w < 800 || h < 600 || dm.dmBitsPerPel < 32) continue;
        if (windowed && (w > wa.right - wa.left || h > wa.bottom - wa.top)) continue;
        bool have = false;
        for (auto& m : v) if (m.w == w && m.h == h) have = true;
        if (!have) v.push_back({ w, h });
    }
    std::sort(v.begin(), v.end(), [](const DispMode& a, const DispMode& b) { return a.w != b.w ? a.w < b.w : a.h < b.h; });
    if (v.empty()) v.push_back({ GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN) });
    return v;
}
// THUG Pro draws at width x height in both modes (window_width / window_height only follow along), so every change
// writes all four and they never disagree
static void DispSetSize(int w, int h) { DispSet("width", w); DispSet("height", h); DispSet("window_width", w); DispSet("window_height", h); }
static bool DispFits(const std::vector<DispMode>& v, int w, int h) { for (auto& m : v) if (m.w == w && m.h == h) return true; return false; }
static bool __cdecl CF_Display(void* params, void* script) {
    const char* key = nullptr;
    GetStringParam(params, "key", &key);
    if (!key) return false;
    int step = IntParam(params, "step", 0);
    bool win = DispGet("windowed_mode", 0) != 0;
    int w = DispGet("width", 0), h = DispGet("height", 0);
    char buf[64];
    if (!strcmp(key, "mode")) {
        if (step) {
            win = !win;
            DispSet("windowed_mode", win ? 1 : 0);
            // keep the size if the new mode can show it, else the biggest one it can that isn't bigger
            std::vector<DispMode> v = DispModes(win);
            if (!(win ? (w > 0 && w <= v.back().w && h <= v.back().h) : DispFits(v, w, h))) {
                DispMode best = v.front();
                for (auto& m : v) if (m.w <= (w ? w : 99999) && m.h <= (h ? h : 99999)) best = m;
                w = best.w; h = best.h;
            }
            DispSetSize(w, h);
            Log("display: %s %dx%d (restart)", win ? "windowed" : "fullscreen", w, h);
        }
        RetStr(script, "text", win ? "Windowed" : "Fullscreen");
        return true;
    }
    if (!strcmp(key, "res")) {
        std::vector<DispMode> v = DispModes(win);
        if (step) {
            int at = -1;
            for (int i = 0; i < (int)v.size(); i++) if (v[i].w == w && v[i].h == h) at = i;
            if (at < 0) {   // a size not in the list (set by the launcher): start from the nearest one
                at = 0;
                for (int i = 0; i < (int)v.size(); i++) if (v[i].w <= w) at = i;
                if (step < 0) step = 0;
            }
            at = (at + step + (int)v.size()) % (int)v.size();
            w = v[at].w; h = v[at].h;
            DispSetSize(w, h);
            Log("display: resolution %dx%d (%s, restart)", w, h, win ? "windowed" : "fullscreen");
        }
        sprintf(buf, "%dx%d", w, h);
        RetStr(script, "text", buf);
        return true;
    }
    return false;
}
// before the game reads them: a fullscreen size the monitor can't show, or a window bigger than the screen, would start
// the game broken, so put back the desktop size (fullscreen) or the biggest size that fits (windowed)
static void DisplayCheckAtBoot() {
    bool win = DispGet("windowed_mode", 0) != 0;
    int w = DispGet("width", 0), h = DispGet("height", 0);
    if (!w || !h) return;   // never set: the game's own defaults
    if (win) {
        RECT wa; SystemParametersInfoA(SPI_GETWORKAREA, 0, &wa, 0);
        if (w <= wa.right - wa.left && h <= wa.bottom - wa.top) return;
        std::vector<DispMode> v = DispModes(true);
        DispSetSize(v.back().w, v.back().h);
        Log("display: window %dx%d didn't fit the screen, now %dx%d", w, h, v.back().w, v.back().h);
    } else {
        if (DispFits(DispModes(false), w, h)) return;
        int dw = GetSystemMetrics(SM_CXSCREEN), dh = GetSystemMetrics(SM_CYSCREEN);
        DispSetSize(dw, dh);
        Log("display: fullscreen %dx%d isn't a mode this monitor has, now %dx%d", w, h, dw, dh);
    }
}
static struct DispBootCheck { DispBootCheck() { DisplayCheckAtBoot(); } } g_dispBootCheck;   // runs when the DLL loads, before the game reads them

// Backslash escapes in the text other than \cN (a save name like "\s1kitty", button glyphs \m0 / \be) are
// copied through whole: a color code between the backslash and its letter made the menu print "\cl" as text
// (Load Skater, 2026-11-16). Returns the escape's length (2 or 3), or 0 when p is not a kept escape.
static int ScanKeepEsc(const char* p) {
    if (p[0] != '\\' || !p[1] || p[1] == 'c' || p[1] == 'C') return 0;
    if (strchr("mMbBsS", p[1]) && p[2]) return 3;
    return 2;
}
static bool __cdecl CF_ScanText(void* params, void* script) {
    // bright: red orange amber gold green bright-cyan cyan royal-blue violet magenta pink
    static const char kSpectrum[] = "gbe5f4d6us7l";
    static const char kSwap[] = "0123456789ABCDEFXZ$#@%&*+=<>?";
    const char* text = nullptr;
    GetStringParam(params, "text", &text);
    if (!text) return false;
    const char* codes = nullptr;
    GetStringParam(params, "codes", &codes);
    if (!codes || !*codes) codes = kSpectrum;
    int nc = (int)strlen(codes);
    int mode = IntParam(params, "mode", 0), item = IntParam(params, "item", 0);
    float t = FloatParam(params, "t", 0);
    float x = FloatParam(params, "x", 0), y = FloatParam(params, "y", 0);
    float c = FloatParam(params, "c", 1), s = FloatParam(params, "s", 0);
    float reveal = FloatParam(params, "reveal", 1);  // mode 4 (decode): how much of the text has resolved, 0..1
    unsigned textSeed = 0;
    for (const char* p = text; *p; ++p) textSeed = textSeed * 31 + (unsigned char)*p;
    if (IntParam(params, "center", 0)) {  // centred text: start half the word's width to the left
        int n = 0;
        for (const char* p = text; *p; ++p) {
            if (p[0] == '\\' && (p[1] == 'c' || p[1] == 'C') && p[2]) { p += 2; continue; }
            if (int e = ScanKeepEsc(p)) p += e - 1;
            ++n;
        }
        x -= n * 4.0f;
    }
    unsigned tick = (unsigned)floorf(t);
    // A menu item's text element copies its text into a 96-byte buffer with no bounds check (see
    // descbox.q), and "\cX" before every letter made long labels like "Remove nearest street light"
    // (24 letters -> 99 bytes) overflow it: heap corruption, then a crash when the menu was closed.
    // So a code is only written when the color changes, and never when it would push the result past
    // kMaxText (the rest of the text then keeps the last color).
    const size_t kMaxText = 95;
    size_t plainLeft = 0;
    for (const char* p = text; *p; ++p) {
        if (p[0] == '\\' && (p[1] == 'c' || p[1] == 'C') && p[2]) { p += 2; continue; }
        if (int e = ScanKeepEsc(p)) { plainLeft += e; p += e - 1; continue; }
        ++plainLeft;
    }
    std::string out;
    char lastCode = 0;
    int ci = 0;
    for (const char* p = text; *p; ++p) {
        if (p[0] == '\\' && (p[1] == 'c' || p[1] == 'C') && p[2]) { p += 2; continue; }
        if (int e = ScanKeepEsc(p)) {
            if (out.size() + e > kMaxText) break;
            out.append(p, e); plainLeft -= e; p += e - 1; ++ci;
            continue;
        }
        if (out.size() + 1 > kMaxText) break;
        char ch = *p;
        if (ch != ' ') {
            char code;
            if (mode == 1 || mode == 2) {
                unsigned h = LfHash(textSeed, (unsigned)ci, mode == 1 ? tick : 0);
                code = codes[h % nc];
            } else if (mode == 5) {
                // clean decode: resolved letters solid white, a green letter at the edge, dim green symbols after it
                int total = (int)plainLeft + ci, edge = (int)floorf(reveal * total);
                unsigned h = LfHash(textSeed, (unsigned)ci, tick);
                if (ci < edge) code = 'c';  // letters and digits only: not every font has the symbols
                else if (ci == edge) { code = '4'; ch = kSwap[(h >> 16) % 18]; }
                else { code = 'q'; ch = kSwap[(h >> 16) % 18]; }
            } else if (mode == 4) {
                // Matrix decode: resolved letters in flickering greens, a white head at the edge, scrambled
                // dim-green symbols after it (re-rolled every tick)
                int total = (int)plainLeft + ci, edge = (int)floorf(reveal * total);
                unsigned h = LfHash(textSeed, (unsigned)ci, tick);
                if (ci < edge) { unsigned r = h % 100; code = r < 55 ? '4' : r < 85 ? 'o' : 'f'; }
                else if (ci == edge) { code = 'c'; ch = kSwap[(h >> 16) % (sizeof kSwap - 1)]; }
                else { code = 'q'; ch = kSwap[(h >> 16) % (sizeof kSwap - 1)]; }
            } else if (mode == 3) {
                // a white head falls down each letter column; the letter just behind it is bright
                int col = (int)floorf((x + ci * 8.0f) / 8.0f);
                unsigned colSeed = LfHash((unsigned)col, 77, 0);
                int head = (int)floorf(t * 0.35f + (colSeed % 97)) % 14;
                int dist = head - item;
                unsigned h = LfHash(textSeed, (unsigned)ci, tick);
                if (dist == 0) code = 'c';
                else if (dist == 1) code = 'f';
                else {
                    unsigned r = h % 100;
                    code = r < 45 ? '4' : r < 70 ? 'o' : r < 88 ? 'f' : r < 97 ? 'q' : 'c';
                }
                if (dist == 0 || (h >> 8) % 100 < 3) ch = kSwap[(h >> 16) % (sizeof kSwap - 1)];  // brief glitch
            } else {
                float proj = ((x + ci * 8.0f) * c + y * s) / 16.0f;
                int idx = (int)floorf(t / 4.0f - proj);
                idx %= nc; if (idx < 0) idx += nc;
                code = codes[idx];
            }
            if (code != lastCode && out.size() + 3 + plainLeft <= kMaxText) { out += '\\'; out += 'c'; out += code; lastCode = code; }
        }
        out += ch;
        --plainLeft;
        ++ci;
    }
    RetStr(script, "text", out.c_str());
    return true;
}

