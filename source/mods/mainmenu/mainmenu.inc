"[context torso]\r\n"
"radius = 75\r\nheight = 48\r\nlook = 48\r\nstart = 15\r\n"
"[context legs]\r\n"
"radius = 80\r\nheight = 20\r\nlook = 20\r\nstart = 15\r\n"
"[context board]\r\n"
"radius = 85\r\nheight = 30\r\nlook = 25\r\nstart = 25\r\n";

// Before 2026-10-23 orbit "start" was a world angle, so some menu levels opened on the skater's back. Old
// files get orbit_start = front, the blend / home / context keys and the [context] block, and their stock
// orbit cameras are turned to face the skater (user-made orbits keep their numbers, now counted from the front).
static std::string MigrateIni(const std::string& data);

static std::string MigrateIni(const std::string& data) {
    // split into blocks: [0] = text before the first section, then one per [section] (header line included)
    std::vector<std::string> blocks(1), names(1);
    for (size_t at = 0; at < data.size();) {
        size_t e = data.find('\n', at);
        e = e == std::string::npos ? data.size() : e + 1;
        std::string line = data.substr(at, e - at), t = Trim(line);
        if (!t.empty() && t[0] == '[') {
            size_t r = t.find(']');
            blocks.push_back(""); names.push_back(Lower(Trim(t.substr(1, r == std::string::npos ? std::string::npos : r - 1))));
        }
        blocks.back() += line;
        at = e;
    }
    auto val = [](const std::string& b, const char* key) -> std::string {
        std::string low = Lower(b), want = key;
        for (size_t at = 0; at < b.size();) {
            size_t e = b.find('\n', at);
            e = e == std::string::npos ? b.size() : e + 1;
            std::string t = Trim(low.substr(at, e - at));
            if (!t.compare(0, want.size(), want)) {
                std::string rest = Trim(t.substr(want.size()));
                if (!rest.empty() && rest[0] == '=') {
                    std::string v = b.substr(at, e - at);
                    v = v.substr(v.find('=') + 1);
                    size_t c = v.find_first_of(";#");
                    return Trim(c == std::string::npos ? v : v.substr(0, c));
                }
            }
            at = e;
        }
        return std::string();
    };
    int menu = -1;
    bool hasCtx = false;
    for (size_t i = 1; i < blocks.size(); ++i) {
        if (names[i] == "menu" && menu < 0) menu = (int)i;
        if (!names[i].compare(0, 8, "context ")) hasCtx = true;
    }
    if (menu >= 0 && Lower(val(blocks[menu], "orbit_start")) == "front") return data;
    // drops `key = ...` lines from a block, then adds the new ones after its last non-blank line
    // drops `key = ...` lines from a block, then adds the new ones right after its last key line
    auto setKeys = [](std::string& b, const std::vector<std::pair<std::string, std::string>>& kv) {
        std::string out;
        size_t after = std::string::npos;  // end of the last key line kept
        for (size_t at = 0; at < b.size();) {
            size_t e = b.find('\n', at);
            e = e == std::string::npos ? b.size() : e + 1;
            std::string line = b.substr(at, e - at), t = Lower(Trim(line));
            bool drop = false;
            for (auto& p : kv) {
                if (t.compare(0, p.first.size(), p.first)) continue;
                std::string rest = Trim(t.substr(p.first.size()));
                if (!rest.empty() && rest[0] == '=') drop = true;
            }
            if (!drop) {
                out += line;
                if (!t.empty() && t[0] != ';' && t[0] != '#') after = out.size();
            }
            at = e;
        }
        if (after == std::string::npos) after = out.size();
        std::string add, lead = after > 0 && out[after - 1] != '\n' ? "\r\n" : "";
        for (auto& p : kv) add += p.first + " = " + p.second + "\r\n";
        out.insert(after, lead + add);
        b = out;
    };
    for (size_t i = 0; i < blocks.size(); ++i) {  // the old orbit line in the comments
        size_t at = blocks[i].find(";   orbit  circles the skater: radius, height, speed (degrees/second, minus = other way), start (degrees)");
        if (at == std::string::npos) continue;
        size_t e = blocks[i].find_first_of("\r\n", at);
        blocks[i].replace(at, (e == std::string::npos ? blocks[i].size() : e) - at,
            ";   orbit  circles the skater: radius, height, speed (degrees/second, minus = other way),\r\n"
            ";          start (degrees from the skater's front: 0 = their face, 90 = their side, 180 = behind),\r\n"
            ";          range (full = circles; 180 = sweep back and forth across their front only, e.g. by a wall)");
    }
    for (size_t i = 1; i < blocks.size(); ++i) {
        if (names[i].compare(0, 6, "camera") || Lower(val(blocks[i], "style")) != "orbit") continue;
        std::string nm = Lower(val(blocks[i], "name"));
        if (nm == "slow orbit") setKeys(blocks[i], { { "start", "0" } });
        else if (nm == "low front") setKeys(blocks[i], { { "start", "0" }, { "swing", "50" } });
        else if (nm == "high wide") setKeys(blocks[i], { { "start", "35" } });
    }
    std::vector<std::pair<std::string, std::string>> add;
    std::string mb = menu >= 0 ? blocks[menu] : "";
    if (val(mb, "blend_seconds").empty()) add.push_back(std::make_pair(std::string("blend_seconds"), std::string("1.5")));
    if (val(mb, "use_home").empty()) add.push_back(std::make_pair(std::string("use_home"), std::string("on")));
    if (val(mb, "context_cams").empty()) add.push_back(std::make_pair(std::string("context_cams"), std::string("on")));
    add.push_back(std::make_pair(std::string("orbit_start"), std::string("front")));
    if (menu >= 0) setKeys(blocks[menu], add);
    else { std::string b = "[menu]\r\n"; for (auto& p : add) b += p.first + " = " + p.second + "\r\n"; blocks.insert(blocks.begin() + 1, b); }
    std::string out;
    for (auto& b : blocks) out += b;
    if (!hasCtx) {
        std::string def = kDefaultIni;
        size_t at = def.find("; ---- Edit Skater screens");
        if (at != std::string::npos) {
            if (!out.empty() && out[out.size() - 1] != '\n') out += "\r\n";
            out += "\r\n" + def.substr(at);
        }
    }
    return out;
}

// orbit range = full | <degrees> (total arc across the skater's front, e.g. 180 for a spot against a wall):
// swing is half of it. Without range, the older swing key (degrees each side) still works.
static float RangeSwing(const std::string& range, float swing) {
    std::string r = Lower(Trim(range));
    if (r.empty()) return swing;
    if (r == "full" || r == "360" || r == "0") return 0;
    float v = (float)atof(r.c_str());
    return v > 0 && v < 360 ? v / 2 : 0;
}

static Mode ReadMode(std::map<std::string, std::string>& m, const char* key, const char* pick, const char* secs, float defSecs, bool random) {
    Mode r;
    r.cycle = Lower(Trim(m[key])) == "cycle";
    r.pick = m[pick].empty() ? 1 : atoi(m[pick].c_str());
    r.seconds = F(m[secs], defSecs);
    if (r.seconds < 1) r.seconds = 1;
    r.random = random;
    return r;
}

static void LoadConfig() {
    std::string path = ExeDirFile("mainmenu.ini"), data;
    if (!ReadWholeFile(path, data)) {
        WriteWholeFile(path, kDefaultIni);
        data = kDefaultIni;
        Log("mainmenu.ini was missing; wrote the default one");
    }
    {
        std::string m = MigrateIni(data);
        if (m != data) {
            WriteWholeFile(ExeDirFile("mainmenu_before_menucam.ini"), data);  // the old file, kept as it was
            WriteWholeFile(path, m);
            data = m;
            Log("mainmenu.ini: orbit start angles now count from the skater's front; added blend, home and Edit Skater camera settings");
        }
    }
    std::map<std::string, std::map<std::string, std::string>> sec;
    std::vector<std::string> order;
    std::string cur;
    size_t s = 0;
    while (s < data.size()) {
        size_t e = data.find('\n', s);
        std::string line = data.substr(s, e == std::string::npos ? std::string::npos : e - s);
        s = e == std::string::npos ? data.size() : e + 1;
        size_t c = line.find_first_of(";#");
        if (c != std::string::npos) line = line.substr(0, c);
        line = Trim(line);
        if (line.empty()) continue;
        if (line[0] == '[') {
            size_t r = line.find(']');
            cur = Lower(Trim(line.substr(1, r == std::string::npos ? std::string::npos : r - 1)));
            if (!sec.count(cur)) order.push_back(cur);
            sec[cur];
            continue;
        }
        size_t eq = line.find('=');
        if (eq == std::string::npos) continue;
        sec[cur][Lower(Trim(line.substr(0, eq)))] = Trim(line.substr(eq + 1));
    }
    Config c;
    auto& m = sec["menu"];
    c.level = Lower(m["level"]);
    c.playerCam = Lower(Trim(m["camera_control"])) == "player";
    c.deckOff = Lower(Trim(m["deck"])) == "off";
    std::string fr = Lower(Trim(m["framing"]));
    c.framing = fr == "center" ? 0 : fr == "right" ? 1 : -1;  // left by default: the menu panel covers the middle
    std::string th = Lower(Trim(m["shop_theme"]));
    c.theme = th == "holiday" ? 1 : th == "holiday_bright" ? 3 : th == "normal_night" ? 4 : th == "normal" || th == "normal_bright" ? 2 : 0;
    bool random = Lower(m["order"]) != "sequential";
    c.spots = ReadMode(m, "spots", "spot_pick", "spot_seconds", 60, random);
    c.poses = ReadMode(m, "poses", "pose_pick", "pose_seconds", 20, random);
    c.posesFav = Lower(Trim(m["poses"])) == "favorites";
    if (c.posesFav) c.poses.cycle = true;
    c.animSource = Lower(Trim(m["pose_source"])) == "anim";
    c.animHold = Lower(Trim(m["anim_loop"])) == "hold";
    {
        std::string pm = Lower(Trim(m["pose_mode"]));
        // 3 = Default (Noah 2026-11-17): the Pro Ped and Skater Ped idle sequence loops; also what a new install gets
        c.poseMode = pm == "one" ? 1 : pm == "random" ? 2 : pm == "favorites" ? 0 : 3;
        c.poseOne = Trim(m["pose_one"]);
    }
    c.animGroup = m["anim_group"].empty() ? 1 : atoi(m["anim_group"].c_str());
    c.anim = Trim(m["anim"]);
    {
        std::string f = m["favorites"];
        size_t s2 = 0;
        while (s2 <= f.size()) {
            size_t e2 = f.find(',', s2);
            if (e2 == std::string::npos) e2 = f.size();
            std::string one = Trim(f.substr(s2, e2 - s2));
            if (!one.empty()) c.favs.push_back(one);
            s2 = e2 + 1;
        }
    }
    c.cams = ReadMode(m, "cameras", "camera_pick", "camera_seconds", 12, random);
    for (auto& kv : m) if (!kv.first.compare(0, 11, "custom_cam_")) c.customSel[kv.first.substr(11)] = Lower(Trim(kv.second));
    c.blendSec = F(m["blend_seconds"], 1.5f);
    if (c.blendSec < 0) c.blendSec = 0;
    if (c.blendSec > 10) c.blendSec = 10;
    c.useHome = Lower(Trim(m["use_home"])) != "off";
    c.ctxCams = Lower(Trim(m["context_cams"])) != "off";
    c.matchSlope = Lower(Trim(m["match_slope"])) == "on";
    for (auto& n : order) {
        if (n.compare(0, 5, "item ")) continue;
        auto& x = sec[n];
        ItemCam it; it.look = F(x["look"], 40); it.dist = F(x["radius"], 60); it.tilt = F(x["tilt"], 10);
        c.items[Trim(n.substr(5))] = it;
    }
    for (int i = 0; i < CTX_COUNT; ++i) {
        c.ctx[i] = kCtxDefaults[i];
        if (i == CTX_MAIN) continue;
        std::string name = std::string("context ") + kCtxNames[i];
        if (!sec.count(name)) continue;
        auto& x = sec[name];
        std::string on = Lower(Trim(x["on"]));
        if (!on.empty()) c.ctx[i].on = !(on == "0" || on == "off" || on == "no");
        c.ctx[i].radius = F(x["radius"], c.ctx[i].radius); c.ctx[i].height = F(x["height"], c.ctx[i].height);
        c.ctx[i].look = F(x["look"], c.ctx[i].look); c.ctx[i].start = F(x["start"], c.ctx[i].start);
        c.ctx[i].speed = F(x["speed"], c.ctx[i].speed);
    }
    // Sections are numbered "[spot 3]"; keep them in number order so *_pick and spot = N match.
    for (int kind = 0; kind < 3; ++kind) {
        const char* prefix = kind == 0 ? "spot" : kind == 1 ? "pose" : "camera";
        std::vector<std::pair<int, std::string>> found;
        for (auto& n : order) {
            if (n.compare(0, strlen(prefix), prefix) != 0) continue;
            std::string rest = Trim(n.substr(strlen(prefix)));
            if (rest.empty() || !isdigit((unsigned char)rest[0])) continue;
            found.push_back(std::make_pair(atoi(rest.c_str()), n));
        }
        std::sort(found.begin(), found.end());
        for (auto& f : found) {
            auto& x = sec[f.second];
            if (kind == 0) {
                Spot sp; sp.name = x["name"]; sp.level = Lower(x["level"].empty() ? "east_la" : x["level"]); sp.isHome = false;
                sp.hasPos = ParseVec(x["pos"], &sp.pos);
                sp.hasDir = ParseVec(x["dir"], &sp.dir);
                if (sp.hasPos) c.spotList.push_back(sp);
                else Log("[%s] has no pos; skipped", f.second.c_str());
            } else if (kind == 1) {
                Pose p; p.name = x["name"]; p.script = x["script"];
                std::string a = x["anims"].empty() ? x["anim"] : x["anims"];
                for (auto& ch : a) if (ch == ',') ch = ' ';
                char buf[256]; strncpy(buf, a.c_str(), 255); buf[255] = 0;
                for (char* t = strtok(buf, " \t"); t && p.anims.size() < 4; t = strtok(nullptr, " \t")) p.anims.push_back(t);
                if (!p.script.empty() || !p.anims.empty()) c.poseList.push_back(p);
                else Log("[%s] has no script or anims; skipped", f.second.c_str());
            } else {
                Cam k; k.name = x["name"]; k.style = Lower(x["style"].empty() ? "fixed" : x["style"]);
                k.spot = atoi(x["spot"].c_str());
                k.level = Lower(Trim(x["level"]));
                if (k.level.empty() && k.style != "orbit") k.level = "east_la";
                k.hasPos = ParseVec(x["pos"], &k.pos);
                k.hasDir = ParseVec(x["dir"], &k.dir);
                k.hasPos2 = ParseVec(x["pos2"], &k.pos2);
                k.radius = F(x["radius"], 160); k.height = F(x["height"], 50); k.look = F(x["look"], 40);
                k.speed = F(x["speed"], 8); k.seconds = F(x["seconds"], 10); k.amount = F(x["amount"], 6);
                k.start = F(x["start"], 0); k.swing = RangeSwing(x["range"], F(x["swing"], 0));
                k.sec = f.second; k.isHome = false; k.custom = k.style != "orbit";
                if (k.seconds < 1) k.seconds = 1;
                bool ok = k.style == "orbit" || ((k.style == "look" || k.style == "pan") && k.hasPos)
                       || ((k.style == "fixed" || k.style == "sway") && k.hasPos && k.hasDir);
                if (k.style == "pan" && !k.hasPos2) ok = false;
                if (ok) c.camList.push_back(k);
                else Log("[%s] style %s is missing pos/dir/pos2; skipped", f.second.c_str(), k.style.c_str());
            }
        }
    }
    // [home <level>] (Set Main Menu Here / Reposition camera): that level's own spot and camera, added after the
    // marked ones so spot_pick / camera_pick numbers don't move
    for (auto& n : order) {
        if (n.compare(0, 5, "home ")) continue;
        auto& x = sec[n];
        std::string lv = Lower(Trim(n.substr(5)));
        if (lv == "z_el") lv = "east_la";
        if (MenuLevelExact(lv) < 0) { Log("[%s]: unknown level; skipped", n.c_str()); continue; }
        std::string label = x["name"].empty() ? std::string("saved for ") + kMenuLevels[MenuLevelExact(lv)].name : x["name"];
        Spot sp; sp.name = label; sp.level = lv; sp.isHome = true;
        sp.hasPos = ParseVec(x["pos"], &sp.pos);
        sp.hasDir = ParseVec(x["dir"], &sp.dir);
        if (sp.hasPos) c.spotList.push_back(sp);
        std::string cs = Lower(Trim(x["camera"]));
        if (cs.empty() || cs == "none") continue;
        Cam k; k.name = label; k.style = cs == "fixed" ? "fixed" : "orbit"; k.spot = 0; k.level = lv;
        k.hasPos = ParseVec(x["cam_pos"], &k.pos);
        k.hasDir = ParseVec(x["cam_dir"], &k.dir);
        k.hasPos2 = false;
        k.radius = F(x["radius"], 160); k.height = F(x["height"], 50); k.look = F(x["look"], 40);
        k.speed = F(x["speed"], 0); k.start = F(x["start"], 0); k.swing = RangeSwing(x["range"], F(x["swing"], 0));
        k.seconds = 10; k.amount = 6;
        k.sec = n; k.isHome = true; k.custom = true;
        if (k.style == "fixed" && !(k.hasPos && k.hasDir)) k.style = "orbit";
        c.camList.push_back(k);
    }
    // [custom <level> <n>] (Reposition camera, 2026-10-23): the custom cameras saved on that map
    for (auto& n : order) {
        if (n.compare(0, 7, "custom ")) continue;
        auto& x = sec[n];
        std::string rest = Trim(n.substr(7));
        size_t sp2 = rest.find(' ');
        std::string lv = Lower(Trim(rest.substr(0, sp2)));
        if (MenuLevelExact(lv) < 0) { Log("[%s]: unknown level; skipped", n.c_str()); continue; }
        std::string cs = Lower(Trim(x["camera"]));
        Cam k; k.name = x["name"].empty() ? n : x["name"]; k.style = cs == "orbit" ? "orbit" : "fixed"; k.spot = 0; k.level = lv;
        k.hasPos = ParseVec(x["cam_pos"], &k.pos);
        k.hasDir = ParseVec(x["cam_dir"], &k.dir);
        k.hasPos2 = false;
        k.radius = F(x["radius"], 160); k.height = F(x["height"], 50); k.look = F(x["look"], 40);
        k.speed = F(x["speed"], 0); k.start = F(x["start"], 0); k.swing = RangeSwing(x["range"], F(x["swing"], 0));
        k.seconds = 10; k.amount = 6;
        k.sec = n; k.isHome = false; k.custom = true;
        if (k.style == "fixed" && !(k.hasPos && k.hasDir)) k.style = "orbit";
        c.camList.push_back(k);
    }
    {   // Camera shot "Static" (Noah 2026-11-17): one still shot of the skater, no orbit or movement. Orbit Options
        // tune its distance, height, aim and angle ([static camera] in mainmenu.ini); it never moves
        auto& x = sec["static camera"];
        Cam k; k.name = "Static"; k.style = "orbit"; k.spot = 0; k.level = "";
        k.pos = k.dir = k.pos2 = V(0, 0, 0); k.hasPos = k.hasDir = k.hasPos2 = false;
        k.radius = F(x["radius"], 150); k.height = F(x["height"], 45); k.look = F(x["look"], 45);
        k.speed = 0; k.start = F(x["start"], 20); k.swing = 0; k.seconds = 10; k.amount = 6;
        k.sec = "static camera"; k.isHome = false; k.custom = false;
        c.camList.push_back(k);
    }
    g_cfg = c;
    Log("loaded mainmenu.ini: level %s, %d spots (%s), %d poses (%s), %d cameras (%s)",
        c.level.empty() ? "east_la" : c.level.c_str(),
        (int)c.spotList.size(), c.spots.cycle ? "cycle" : "static",
        (int)c.poseList.size(), c.poses.cycle ? "cycle" : "static",
        (int)c.camList.size(), c.cams.cycle ? "cycle" : "static");
}

// Picks an index into `count` candidates. static = mode.pick (1-based, clamped);
// cycle = random (never the same twice in a row) or the next one after `seq`.
static int Pick(const Mode& m, int count, int prev, int* seq) {
    if (count <= 0) return -1;
    if (!m.cycle) { int p = m.pick - 1; return p < 0 ? 0 : p >= count ? count - 1 : p; }
    if (m.random) {
        if (count == 1) return 0;
        int p;
        do p = rand() % count; while (p == prev);
        return p;
    }
    *seq = (*seq + 1) % count;
    return *seq;
}

static const char* LevelName() { return kMenuLevels[g_level >= 0 && g_level < kMenuLevelCount ? g_level : 1].key; }

static std::vector<int> CamCandidates() {
    std::vector<int> v;
    for (int i = 0; i < (int)g_cfg.camList.size(); ++i) {
        int s = g_cfg.camList[i].spot;
        const std::string& lv = g_cfg.camList[i].level;
        if (!lv.empty() && lv != LevelName()) continue;
        if (s == 0 || (g_spot >= 0 && s == g_spot + 1)) v.push_back(i);
    }
    return v;
}

// The shots camera_pick / cycling choose from for the loaded scene: the cameras for this level and spot, then the
// level's own saved shot ([home <level>] from Reposition camera) unless use_home = off.
// The custom cameras saved on the loaded map, and the one in use there (custom_cam_<level>, else the newest)
static std::vector<int> CustomCams() {
    std::vector<int> v;
    for (int i : CamCandidates()) if (g_cfg.camList[i].custom) v.push_back(i);
    return v;
}
static int CustomSelected() {
    std::vector<int> v = CustomCams();
    if (v.empty()) return -1;
    auto it = g_cfg.customSel.find(LevelName());
    if (it != g_cfg.customSel.end())
        for (int i : v) if (Lower(g_cfg.camList[i].sec) == it->second) return i;
    return v.back();
}
static bool IsStaticCam(int i) { return i >= 0 && i < (int)g_cfg.camList.size() && g_cfg.camList[i].sec == "static camera"; }
static std::vector<int> CamPickList() {
    std::vector<int> v = CamCandidates(), w;
    for (int i : v) if (!g_cfg.camList[i].custom && !IsStaticCam(i)) w.push_back(i);
    int cc = CustomSelected();
    if (g_cfg.useHome && cc >= 0) w.push_back(cc);  // Camera shot's one "Custom camera" entry
    for (int i : v) if (IsStaticCam(i)) w.push_back(i);  // "Static" last, so older camera_pick numbers keep their shot
    return w;
}
static void PickCamera(float blend = -1) {
    std::vector<int> w = CamPickList();
    int prev = g_cam;
    int prevPos = -1;
    for (int i = 0; i < (int)w.size(); ++i) if (w[i] == g_cam) prevPos = i;
    int p = Pick(g_cfg.cams, (int)w.size(), prevPos, &g_camSeq);
    g_cam = p < 0 ? -1 : w[p];
    g_camAt = g_camStart = GetTickCount();
    if (g_cam != prev || blend >= 0) StartBlend(blend >= 0 ? blend : g_cfg.blendSec);
    if (g_cam >= 0) Log("camera %d (%s, %s)", g_cam + 1, g_cfg.camList[g_cam].name.c_str(), g_cfg.camList[g_cam].style.c_str());
}

static void RetVec(void* script, const char* key, Vec v) {
    void* params = *(void**)((char*)script + 0x14);
    typedef void (__thiscall* Fn)(void*, DWORD, float, float, float);
    if (params) ((Fn)kAddVector)(params, QbKey(key), v.x, v.y, v.z);
}
static void RetName(void* script, const char* key, const char* name) {
    void* params = *(void**)((char*)script + 0x14);
    typedef void (__thiscall* Fn)(void*, DWORD, DWORD);
    if (params) ((Fn)kAddChecksum)(params, QbKey(key), QbKey(name));
}
static float FloatParam(void* params, const char* key, float def) {
    float v = def;
    typedef bool (__thiscall* Fn)(void*, DWORD, float*, bool);
    ((Fn)kGetFloat)(params, QbKey(key), &v, false);
    return v;
}

// The spot for the scene that is loaded: the level's saved spot ([home <level>]) when spots are static,
// otherwise a pick among the level's spots (the saved one included when cycling).
static void ChooseSpot() {
    std::vector<int> v, w;
    int home = -1;
    for (int i = 0; i < (int)g_cfg.spotList.size(); ++i)
        if (g_cfg.spotList[i].level == LevelName()) { v.push_back(i); if (g_cfg.spotList[i].isHome) home = i; }
    if (!g_cfg.spots.cycle && g_cfg.useHome && home >= 0) { g_spot = home; return; }
    for (int i : v) if (i != home || (g_cfg.useHome && g_cfg.spots.cycle)) w.push_back(i);
    int prevPos = -1;
    for (int i = 0; i < (int)w.size(); ++i) if (w[i] == g_spot) prevPos = i;
    int p = Pick(g_cfg.spots, (int)w.size(), prevPos, &g_spotSeq);
    g_spot = p < 0 ? -1 : w[p];
}

// Custom menus > Random (custom_random = on): each menu scene load picks one of the saved custom menus, not the one
// picked last time when there are 2+ (random_last). Plain back-outs don't reload the scene, so they keep it.
static std::vector<int> SavedLevels();
static std::string MenuValueRaw(const std::string& data, const char* key);
static void SetSecValue(std::string& data, const std::string& section, const char* key, const std::string& value);
// Starred custom menus (Noah 2026-11-17): custom_stars = comma list of level keys, starred with d-pad Right in
// Custom menus. Cycle starred (custom_random = on) picks among the starred ones, or among all saved menus when none
// is starred; in turn when Cycle order is In order (order = sequential), else at random (not the last one twice).
static std::vector<std::string> CustomStars(const std::string& data) {
    std::vector<std::string> v;
    std::string s = Lower(Trim(MenuValueRaw(data, "custom_stars"))), cur;
    for (size_t i = 0; i <= s.size(); ++i) {
        if (i == s.size() || s[i] == ',') { cur = Trim(cur); if (!cur.empty()) v.push_back(cur); cur.clear(); }
        else cur += s[i];
    }
    return v;
}
static bool IsStarred(const std::vector<std::string>& stars, const char* key) {
    return std::find(stars.begin(), stars.end(), Lower(key)) != stars.end();
}
static void PickRandomCustom() {
    std::string path = ExeDirFile("mainmenu.ini"), data;
    if (!ReadWholeFile(path, data)) return;
    if (Lower(Trim(MenuValueRaw(data, "custom_random"))) != "on") return;
    if (MenuLevelIndex(g_cfg.level) == 0) return;  // Menu scene is a Skate shop
    std::vector<int> v = SavedLevels(), c, st;
    if (v.empty()) return;
    std::vector<std::string> stars = CustomStars(data);
    for (int i : v) if (IsStarred(stars, kMenuLevels[i].key)) st.push_back(i);
    if (!st.empty()) v = st;
    std::string last = Lower(Trim(MenuValueRaw(data, "random_last")));
    const char* key;
    if (Lower(Trim(MenuValueRaw(data, "order"))) == "sequential") {
        int at = -1;
        for (int i = 0; i < (int)v.size(); ++i) if (last == kMenuLevels[v[i]].key) at = i;
        key = kMenuLevels[v[(at + 1) % v.size()]].key;
    } else {
        for (int i : v) if (v.size() < 2 || last != kMenuLevels[i].key) c.push_back(i);
        if (c.empty()) c = v;
        static bool seeded;
        if (!seeded) { srand(GetTickCount()); seeded = true; }
        key = kMenuLevels[c[rand() % c.size()]].key;
    }
    SetSecValue(data, "menu", "level", key);
    SetSecValue(data, "menu", "custom_level", key);
    SetSecValue(data, "menu", "random_last", key);
    WriteWholeFile(path, data);
    LoadConfig();
    Log("custom menus: cycle pick %s (from %d%s)", key, (int)v.size(), st.empty() ? "" : " starred");
}
static bool __cdecl CF_MenuLevel(void*, void* script) {
    LoadConfig();
    PickRandomCustom();
    g_level = ClientMenuLevel(MenuLevelIndex(g_cfg.level));
    ChooseSpot();
    g_pose = -1; g_cam = -1; g_poseDue = true;
    g_outValid = false; g_bDur = 0; g_faceValid = false; g_edit = false; g_ctx = CTX_MAIN;  // new scene: cut, no blend
    g_poseLive = false; g_levelSet = true; g_mainPosValid = false; g_backTurned = false; g_userTurned = false; g_lastTick = 0;
    g_ambientReady = true;
    g_frozen = false; g_slopeTries = 0;
    if (g_spot >= 0) Log("menu level %s, spot %d (%s)", LevelName(), g_spot + 1, g_cfg.spotList[g_spot].name.c_str());
    else Log("menu level %s, no spot (stock placement)", LevelName());
    RetInt(script, "level", g_level);
    return true;
}

// a live helper loaded while the menu is up never saw CF_MenuLevel: pick up the scene that is showing
static void EnsureLevel() {
    if (g_levelSet) return;
    g_levelSet = true;
    LoadConfig();
    g_level = ClientMenuLevel(MenuLevelIndex(g_cfg.level));
    ChooseSpot();
}
static bool __cdecl CF_MenuSpot(void*, void* script) {
    EnsureLevel();
    if (g_spot < 0 || g_spot >= (int)g_cfg.spotList.size()) return false;
    const Spot& s = g_cfg.spotList[g_spot];
    RetVec(script, "spot_pos", s.pos);
    if (s.hasDir) RetVec(script, "spot_dir", s.dir);
