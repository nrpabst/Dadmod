{ name = "gfx_res" b = 1 p = { id = gfx_res key = "gfx_res" label = "Resolution" kind = dispres min = 0 max = 0 def = 0 desc = "The game's size: the sizes your monitor supports (in a window, the ones that fit the screen). Sets the window and fullscreen size together. Shows after you restart the game." pdesc = "The game's size. Shows after you restart the game." } }
{ name = "gfx_postfx" b = 1 p = { id = gfx_postfx key = "gfx_postfx" label = "Graphics effects" kind = reshade min = 0 max = 1 def = 0 list = gfx_postfx desc = "Shown only when ReShade is installed. dadmod uses dadmod's graphics effects; ReShade skips dadmod's screen effects so only ReShade's show." } }
{ name = "gfx_aniso" b = 1 p = { id = gfx_aniso key = "gfx_aniso" label = "Texture filtering" kind = gfxlist min = 0 max = 4 def = 4 list = gfx_aniso desc = "Anisotropic filtering: keeps floors, roads and walls seen at an angle sharp instead of blurry. 16x looks best and costs very little. Changes show right away." pdesc = "Keeps floors and walls seen at an angle sharp. 16x looks best and costs very little." } }
{ name = "gfx_lodbias" b = 1 p = { id = gfx_lodbias key = "gfx_lodbias" label = "Texture sharpness" kind = gfxlist min = 0 max = 4 def = 0 list = gfx_lodbias desc = "Makes the game use more detailed texture copies at a distance. Higher is crisper but can shimmer when moving. Changes show right away." pdesc = "Uses more detailed textures at a distance. Higher is crisper but can shimmer." } }
{ name = "gfx_uismooth" b = 1 p = { id = gfx_uismooth key = "gfx_uismooth" label = "Smooth menu graphics" kind = gfxlist min = 0 max = 1 def = 0 list = gfx_uismooth desc = "Smooths blocky scaled-up menu and HUD graphics. Changes show right away." } }
{ name = "gfx_fxaa" b = 1 p = { id = gfx_fxaa key = "gfx_fxaa" label = "FXAA" kind = gfxlist min = 0 max = 2 def = 0 list = gfx_fxaa desc = "Smooths jagged edges of the 3D scene (menus and HUD stay sharp). High quality runs it twice for smoother edges. Changes show right away." pdesc = "Smooths jagged edges of the 3D scene; menus and HUD stay sharp." } }
{ name = "gfx_msaa" b = 1 p = { id = gfx_msaa key = "gfx_msaa" label = "MSAA (restart)" kind = gfxlist min = 0 max = 3 def = 0 list = gfx_msaa desc = "Proper anti-aliasing of geometry edges. Needs a restart of the game. Turns off ambient occlusion, haze, depth of field and outlines, which need the depth buffer." pdesc = "Smooths geometry edges. Needs a restart. Turns off the depth effects." } }
{ name = "gfx_sharpen" b = 1 p = { id = gfx_sharpen key = "gfx_sharpen" label = "Sharpening" kind = num min = 0 max = 10 def = 0 desc = "Contrast-adaptive sharpening (like AMD FidelityFX CAS): brings out texture detail without halos. 3 to 5 is a good start. Changes show right away." pdesc = "Brings out texture detail without halos. 3 to 5 is a good start." } }
{ name = "gfx_bloom" b = 1 p = { id = gfx_bloom key = "gfx_bloom" label = "Bloom" kind = num min = 0 max = 10 def = 0 desc = "A soft glow around bright lights and sky. 2 to 4 is subtle. Changes show right away." } }
{ name = "gfx_ssao" b = 1 p = { id = gfx_ssao key = "gfx_ssao" label = "Ambient occlusion" kind = num min = 0 max = 10 def = 0 desc = "Soft shadows where walls meet floors, under rails and in corners, so the world looks less flat. Needs the depth buffer, so it is off while MSAA is on. Changes show right away." pdesc = "Soft shadows in corners and under rails. Off while MSAA is on." } }
{ name = "gfx_fog" b = 1 p = { id = gfx_fog key = "gfx_fog" label = "Distance haze" kind = num min = 0 max = 10 def = 0 desc = "A light atmospheric haze that grows with distance and softens far-away pop-in. Needs the depth buffer, so it is off while MSAA is on. Changes show right away." pdesc = "Haze that grows with distance and softens pop-in. Off while MSAA is on." } }
{ name = "gfx_dof" b = 1 p = { id = gfx_dof key = "gfx_dof" label = "Depth of field" kind = num min = 0 max = 10 def = 0 desc = "Blurs things far away like a camera lens, keeping you and the area around you sharp. Needs the depth buffer, so it is off while MSAA is on. Changes show right away." pdesc = "Blurs far-away things like a camera lens. Off while MSAA is on." } }
{ name = "gfx_outline" b = 1 p = { id = gfx_outline key = "gfx_outline" label = "Outlines" kind = gfxlist min = 0 max = 2 def = 0 list = gfx_outline desc = "Dark outlines around shapes, or a full cartoon cel-shaded look. Needs the depth buffer, so it is off while MSAA is on. Changes show right away." pdesc = "Dark outlines, or a cartoon cel-shaded look. Off while MSAA is on." } }
{ name = "gfx_mblur" b = 1 p = { id = gfx_mblur key = "gfx_mblur" label = "Motion blur" kind = num min = 0 max = 10 def = 0 desc = "Blends in a little of the last frame for a smooth, fast feel. High values leave ghost trails. Changes show right away." pdesc = "Blends in a little of the last frame. High values leave ghost trails." } }
{ name = "gfx_preset" b = 1 p = { id = gfx_preset key = "gfx_preset" label = "Color look" kind = gfxlist min = 0 max = 10 def = 0 list = gfx_preset desc = "A one-click color grade on top of the sliders. None leaves the colors as the game made them. Changes show right away." pdesc = "A one-click color grade on top of the sliders. None leaves the colors alone." } }
{ name = "gfx_bright" b = 1 p = { id = gfx_bright key = "gfx_bright" label = "Brightness" kind = num min = -10 max = 10 def = 0 desc = "Lifts or lowers the whole picture. 0 is normal. Changes show right away." } }
{ name = "gfx_contrast" b = 1 p = { id = gfx_contrast key = "gfx_contrast" label = "Contrast" kind = num min = -10 max = 10 def = 0 desc = "Difference between darks and lights. 0 is normal. Changes show right away." } }
{ name = "gfx_sat" b = 1 p = { id = gfx_sat key = "gfx_sat" label = "Saturation" kind = num min = -10 max = 10 def = 0 desc = "Color strength. -10 is black and white, 0 is normal. Changes show right away." } }
{ name = "gfx_vibrance" b = 1 p = { id = gfx_vibrance key = "gfx_vibrance" label = "Vibrance" kind = num min = 0 max = 10 def = 0 desc = "Boosts dull colors while leaving already strong colors alone. 0 is off. Changes show right away." pdesc = "Boosts dull colors and leaves strong ones alone. 0 is off." } }
{ name = "gfx_gamma" b = 1 p = { id = gfx_gamma key = "gfx_gamma" label = "Gamma" kind = num min = -10 max = 10 def = 0 desc = "Brightens or darkens the midtones without washing out blacks and whites. 0 is normal. Changes show right away." pdesc = "Brightens or darkens the midtones. 0 is normal." } }
{ name = "gfx_temp" b = 1 p = { id = gfx_temp key = "gfx_temp" label = "Color temperature" kind = num min = -10 max = 10 def = 0 desc = "Cooler (blue) below 0, warmer (orange) above 0. Changes show right away." } }
{ name = "gfx_tint" b = 1 p = { id = gfx_tint key = "gfx_tint" label = "Tint" kind = num min = -10 max = 10 def = 0 desc = "Greener below 0, more magenta above 0. Changes show right away." } }
{ name = "gfx_pixelate" b = 1 p = { id = gfx_pixelate key = "gfx_pixelate" label = "Pixelate" kind = gfxlist min = 0 max = 3 def = 0 list = gfx_pixelate desc = "Chunky retro pixels for the 3D scene, like an old console. Changes show right away." } }
{ name = "gfx_crt" b = 1 p = { id = gfx_crt key = "gfx_crt" label = "CRT TV" kind = gfxlist min = 0 max = 2 def = 0 list = gfx_crt desc = "Old TV look: scanlines, a shadow mask and optionally a curved screen. Covers menus and HUD too. Changes show right away." pdesc = "Old TV look: scanlines, a shadow mask, optionally a curved screen." } }
{ name = "gfx_grain" b = 1 p = { id = gfx_grain key = "gfx_grain" label = "Film grain" kind = num min = 0 max = 10 def = 0 desc = "Light film noise that hides blocky textures and color banding. Changes show right away." } }
{ name = "gfx_chroma" b = 1 p = { id = gfx_chroma key = "gfx_chroma" label = "Chromatic aberration" kind = num min = 0 max = 10 def = 0 desc = "A faint red and blue color fringe toward the screen edges, like a real lens. Changes show right away." pdesc = "A faint red and blue fringe toward the screen edges, like a real lens." } }
{ name = "gfx_vignette" b = 1 p = { id = gfx_vignette key = "gfx_vignette" label = "Vignette" kind = num min = 0 max = 10 def = 0 desc = "Darkens the corners of the screen a little, like a camera lens. Changes show right away." } }
{ name = "gfx_galaxy" b = 1 p = { id = gfx_galaxy key = "gfx_galaxy" label = "Sky" kind = gfxlist min = 0 max = 14 def = 0 list = gfx_galaxy desc = "Swap every level's sky: galaxies, Matrix, aurora, synthwave, storm, black hole and more." } }
{ name = "gfx_tod" b = 1 p = { id = gfx_tod key = "gfx_tod" label = "Time of day" kind = gfxlist min = 0 max = 6 def = 0 list = gfx_tod desc = "Level / server follows the level, or the server when one runs a day/night fade. Pick a time to use your own (only your screen), even when the server changes it." } }
{ name = "gfx_skypop" b = 1 p = { id = gfx_skypop key = "gfx_skypop" label = "Sky boost" kind = num min = 0 max = 10 def = 5 desc = "Richer sky colors that match the time of day: deep blue days, orange sunsets, stars at night. 0 leaves the sky as the game draws it." pdesc = "Richer sky colors for the time of day, with stars at night. 0 is off." } }
{ name = "gfx_lamps" b = 1 p = { id = gfx_lamps key = "gfx_lamps" label = "Street lights" kind = num min = 0 max = 10 def = 6 desc = "Lamps glow and light up around them in the evening and at night. 0 turns them off." } }
{ name = "gfx_lampadd" b = 1 p = { id = gfx_lampadd key = "gfx_lampadd" label = "Add street light here" kind = gfxact min = 0 max = 0 def = 0 desc = "Adds a street light at the camera. Use the free camera to put it right at a lamp." } }
{ name = "gfx_lampdel" b = 1 p = { id = gfx_lampdel key = "gfx_lampdel" label = "Remove nearest street light" kind = gfxact min = 0 max = 0 def = 0 desc = "Removes the street light closest to the camera." } }
{ name = "gfx_skydef" b = 1 p = { id = gfx_skydef key = "gfx_galaxy" label = "Default sky" kind = skyreset min = 0 max = 0 def = 0 desc = "Puts the sky back to default: the level's own sky, the level's own time of day and sky boost 5." pdesc = "Back to the level's own sky and time of day, sky boost 5." } }
{ name = "gfx_daylen" b = 1 p = { id = gfx_daylen key = "gfx_daylen" label = "Day length" kind = gfxlist min = 0 max = 4 def = 2 list = gfx_daylen desc = "How long a full day takes when Time of day is Dynamic." } }
{ name = "gfx_weather" b = 1 p = { id = gfx_weather key = "gfx_weather" label = "Weather" kind = gfxlist min = 0 max = 5 def = 0 list = gfx_weather desc = "Rain, a thunderstorm, snow or fog over every level, or Dynamic. Only on your screen." } }
{ name = "gfx_wxclear" b = 1 p = { id = gfx_wxclear key = "gfx_wxclear" label = "Dynamic: clear skies" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_shotkey desc = "Whether Dynamic weather can pick clear skies. Turn off the ones you do not want." } }
{ name = "gfx_wxrain" b = 1 p = { id = gfx_wxrain key = "gfx_wxrain" label = "Dynamic: rain" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_shotkey desc = "Whether Dynamic weather can pick rain. Turn off the ones you do not want." } }
{ name = "gfx_wxstorm" b = 1 p = { id = gfx_wxstorm key = "gfx_wxstorm" label = "Dynamic: thunderstorms" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_shotkey desc = "Whether Dynamic weather can pick thunderstorms. Turn off the ones you do not want." } }
{ name = "gfx_wxsnow" b = 1 p = { id = gfx_wxsnow key = "gfx_wxsnow" label = "Dynamic: snow" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_shotkey desc = "Whether Dynamic weather can pick snow. Turn off the ones you do not want." } }
{ name = "gfx_wxfog" b = 1 p = { id = gfx_wxfog key = "gfx_wxfog" label = "Dynamic: fog" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_shotkey desc = "Whether Dynamic weather can pick fog. Turn off the ones you do not want." } }
{ name = "gfx_wxamt" b = 1 p = { id = gfx_wxamt key = "gfx_wxamt" label = "Weather intensity" kind = num min = 1 max = 10 def = 6 desc = "How heavy the rain, snow or fog is." } }
{ name = "gfx_fireworks" b = 1 p = { id = gfx_fireworks key = "gfx_fireworks" label = "Fireworks" kind = gfxlist min = 0 max = 2 def = 0 list = gfx_fireworks desc = "Fireworks over the level when a game ends. Auto also fires them every few minutes." } }
{ name = "gfx_fwevery" b = 1 p = { id = gfx_fwevery key = "gfx_fwevery" label = "Auto fireworks every" kind = gfxlist min = 0 max = 3 def = 2 list = gfx_fwevery desc = "How often Auto fireworks go off." } }
{ name = "gfx_fwnow" b = 1 p = { id = gfx_fwnow key = "gfx_fireworks" label = "Launch fireworks now" kind = gfxfire min = 0 max = 0 def = 0 desc = "Fire a fireworks show right now." } }
{ name = "gfx_fps" b = 1 p = { id = gfx_fps key = "gfx_fps" label = "FPS counter" kind = gfxlist min = 0 max = 2 def = 0 list = gfx_fps desc = "Frames per second in the top left corner. Tiny shows just the number, right in the corner. Changes show right away." pdesc = "Frames per second in the top left. Tiny shows just the number." } }
{ name = "gfx_shotkey" b = 1 p = { id = gfx_shotkey key = "gfx_shotkey" label = "Screenshot key (F11)" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_shotkey desc = "F11 saves a PNG screenshot to the dadmod screenshots folder." } }
{ name = "gfx_shothud" b = 1 p = { id = gfx_shothud key = "gfx_shothud" label = "Screenshots show menus" kind = gfxlist min = 0 max = 1 def = 0 list = gfx_shothud desc = "On: F11 screenshots include menus and the HUD. Off: just the game picture." } }
{ name = "gfx_vsync" b = 1 p = { id = gfx_vsync key = "gfx_vsync" label = "V-sync (restart)" kind = gfxlist min = 0 max = 2 def = 0 list = gfx_vsync desc = "Locks frames to your monitor to stop tearing. Needs a restart of the game." } }
{ name = "gfx_mirror" b = 1 p = { id = gfx_mirror key = "gfx_mirror" label = "Mirror mode" kind = gfxlist min = 0 max = 1 def = 0 list = gfx_mirror desc = "Flips the 3D view left to right, like skating a mirrored copy of the level, and swaps left and right steering to match. Menus, the HUD and text stay normal. Only on your screen." pdesc = "Flips the 3D view left to right and swaps steering to match. Only your screen." } }
{ name = "gfx_levelsfx" b = 1 p = { id = gfx_levelsfx key = "gfx_levelsfx" label = "Level sounds" kind = num min = 0 max = 100 def = 100 step = 5 desc = "Volume of water, crowds, machines, cars and other sounds that come from things in a map. 0 turns them off. Skaters' own sounds stay as they are. Changes apply right away." } }
{ name = "gfx_tricksfx" b = 1 p = { id = gfx_tricksfx key = "gfx_tricksfx" label = "Special trick sounds" kind = num min = 0 max = 100 def = 100 step = 5 desc = "Volume of the sound clips some special tricks play, like the guitar grind. 0 turns them off. Changes apply right away, even to a clip that is playing." } }
{ name = "gfx_bginput" b = 1 p = { id = gfx_bginput key = "gfx_bginput" label = "Background input" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_bginput desc = "On: your controller keeps playing the game while another window (browser, Discord) is in front. Off: input only works while the game window is in front. Changes apply right away." } }
{ name = "gfx_deadzone" b = 1 p = { id = gfx_deadzone key = "gfx_deadzone" label = "Stick dead zone" kind = num min = 0 max = 10 def = 0 desc = "Ignores small stick movements so a worn stick stops drifting your skater. 0 is off; raise it until drifting stops. Changes apply right away." } }
{ name = "gfx_abswap" b = 1 p = { id = gfx_abswap key = "gfx_abswap" label = "Swap A/B and X/Y" kind = gfxlist min = 0 max = 1 def = 0 list = gfx_abswap desc = "For Nintendo-style controllers: swaps A with B and X with Y so the buttons match the labels on your pad. Changes apply right away." } }
{ name = "gfx_launchbinds" b = 1 p = { id = gfx_launchbinds key = "gfx_launchbinds" label = "Use launcher button layout" kind = gfxlist min = 0 max = 1 def = 0 list = gfx_launchbinds desc = "On uses the button bindings you set in the THUG Pro launcher. Off uses the standard dadmod Xbox-style layout. Changes apply right away." } }
{ name = "gfx_bind_kb" b = 1 p = { id = gfx_bind_kb key = "none" label = "Keyboard bindings" kind = uiaction min = 0 max = 0 def = 0 action = dadmod_binds_kb_open desc = "Pick the key for each action while skating. Changes apply right away." } }
{ name = "gfx_bind_pad" b = 1 p = { id = gfx_bind_pad key = "none" label = "Controller bindings" kind = uiaction min = 0 max = 0 def = 0 action = dadmod_binds_pad_open desc = "Pick the controller button for each action. Changes apply right away." } }
{ name = "gfx_padpopup" b = 1 p = { id = gfx_padpopup key = "gfx_padpopup" label = "Controller popups" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_padpopup desc = "Shows a short message when a controller is plugged in or unplugged." } }
{ name = "gfx_reset" b = 1 p = { id = gfx_reset key = "gfx_aniso" label = "Reset graphics" kind = gfxreset min = 0 max = 0 def = 0 desc = "Puts every graphics setting back to its default (16x texture filtering, F11 screenshots on, effects off). Weather settings are not changed" pdesc = "Puts every graphics setting back to its default. Weather is not changed." } }
{ name = "mui_reset" b = 2 p = {  } }
]

script dadmod_square_getup
    dadmod_sqget_get
    if ( <sqget_on> = 0 )
        return
    endif
    if IsTrue THUGPRO_ObserveOn
        return
    endif
    if ( ( GameModeEquals is_firefight ) or ( GameModeEquals is_king ) or ( GameModeEquals is_ctf ) or ( IsTrue AlreadyEndedRun ) )
        return
    endif
    begin
        if not IsInBail
            return
        endif
        if not Held Square
            break
        endif
        wait 1 gameframe
    repeat
    begin
        if not IsInBail
            return
        endif
        if Held Square
            dadmod_square_getup_blocked
            if ( <blocked> = 0 )
                break
            endif
        endif
        wait 1 gameframe
    repeat
    begin
        if not IsInBail
            return
        endif
        if not InAir
            break
        endif
        wait 1 gameframe
    repeat
    if IsTrue AlreadyEndedRun
        return
    endif
    SetCurrentBailEndpose
    MakeSkaterGoto dadmod_bail_cancel_state
endscript

script dadmod_bail_cancel_state
    NoQuickGetup
    TantrumOff
    ExitTantrum
    SwitchOnBoard
    BoardRotate Normal
    if ObjectExists id = BurnMoFo
        BurnMoFo : unhide
    endif
    if ObjectExists id = SmokeyMoFo
        SmokeyMoFo : unhide
    endif
    OnExceptionRun
    ResetEventHandlersFromTable StartSkateExceptionTable
    VibrateOff
    PlayAnim anim = idle BlendPeriod = 0.15
    goto BailDone
endscript

script dadmod_square_getup_blocked
    if ObjectExists id = keyboard_anchor
        return blocked = 1
    endif
    root_window : GetSingleTag menu_state
    if GotParam menu_state
        if ( <menu_state> = on )
            return blocked = 1
        endif
    endif
    return blocked = 0
endscript

script dadmod_sqget_get
    on = 1
    if THUGRECOMP_SettingLoad key = "square_getup"
        if ( <value> = 0 )
            on = 0
        endif
    endif
    return sqget_on = <on>
endscript

script dadmod_sqget_text
    dadmod_sqget_get
    if ( <sqget_on> = 1 )
        return sqget_text = "On"
    endif
    return sqget_text = "Off"
endscript

script dadmod_sqget_toggle
    if ScreenElementExists id = dadmod_sqget_item
        if dadmod_sqget_item : GetSingleTag sqget_lock
            if ( <sqget_lock> = 1 )
                return
            endif
        endif
        dadmod_sqget_item : SetTags sqget_lock = 1
        SpawnScript dadmod_sqget_unlock
    endif
    dadmod_sqget_get
    if ( <sqget_on> = 1 )
        on = 0
    else
        on = 1
    endif
    THUGRECOMP_SettingSave key = "square_getup" value = <on>
    dadmod_sqget_text
    thugpro_menu_item_update_extra_text id = dadmod_sqget_item text = <sqget_text>
endscript

script dadmod_sqget_unlock
    wait 6 gameframes
    if ScreenElementExists id = dadmod_sqget_item
        dadmod_sqget_item : SetTags sqget_lock = 0
    endif
endscript

script dadmod_tsfx_get
    on = 1
    if THUGRECOMP_SettingLoad key = "screen_fx"
        if ( <value> = 0 )
            on = 0
        endif
    endif
    return tsfx_on = <on>
endscript

script dadmod_tsfx_text
    dadmod_tsfx_get
    if ( <tsfx_on> = 1 )
        return tsfx_text = "On"
    endif
    return tsfx_text = "Off"
endscript

script dadmod_tsfx_toggle
    if ScreenElementExists id = dadmod_tsfx_item
        if dadmod_tsfx_item : GetSingleTag tsfx_lock
            if ( <tsfx_lock> = 1 )
                return
            endif
        endif
        dadmod_tsfx_item : SetTags tsfx_lock = 1
        SpawnScript dadmod_tsfx_unlock
    endif
    dadmod_tsfx_get
    if ( <tsfx_on> = 1 )
        on = 0
    else
        on = 1
    endif
    THUGRECOMP_SettingSave key = "screen_fx" value = <on>
    dadmod_tsfx_text
    thugpro_menu_item_update_extra_text id = dadmod_tsfx_item text = <tsfx_text>
endscript

script dadmod_tsfx_unlock
    wait 6 gameframes
    if ScreenElementExists id = dadmod_tsfx_item
        dadmod_tsfx_item : SetTags tsfx_lock = 0
    endif
endscript

dadmod_skater_unsaved = 0

dadmod_midload_paused = 0

script dadmod_midload_mark
    Change dadmod_skater_unsaved = 1
endscript

script dadmod_midload_mark_run
    Change dadmod_skater_unsaved = 1
    <dadmod_run> <...>
endscript

script dadmod_midload_io
    if GotParam Type
        if ChecksumEquals a = <Type> b = optionsandpros
            Change dadmod_skater_unsaved = 0
        endif
    endif
endscript

script dadmod_midload_can_show
    if IsObserving
        return show = 0
    endif
    if LevelIs Load_MainMenu
        return show = 0
    endif
    if LevelIs load_sk5ed
        return show = 0
    endif
    if not ObjectExists id = skater
        return show = 0
    endif
    return show = 1
endscript

script dadmod_midload_quick_item
    dadmod_midload_can_show
    if ( <show> = 0 )
        return
    endif
    make_thugpro_menu_item {
    text = "Load Skater"
    id = dadmod_midload_item
    description_text = "Load a saved skater without leaving this level. Online, dadmod players see it right away"
    pad_choose_script = dadmod_midload_open
    }
endscript

script dadmod_midload_open
    dadmod_midload_can_show
    if ( <show> = 0 )
        return
    endif
    thugpro_menu_destroy
    kill_start_key_binding
    if ( dadmod_midload_paused = 0 )
        if not InNetGame
            PauseGame
            GoalManager_PauseAllGoals
            Change dadmod_midload_paused = 1
        endif
    endif
    dadmod_midload_files
endscript

script dadmod_midload_files
    memcard_menus_cleanup
    thugpro_menu_destroy
    Change SavingOrLoading = Loading
    GetMemCardDirectoryListing FileType = optionsandpros
    if not GotParam DirectoryListing
        dadmod_midload_message text = "No saved skaters were found."
        return
    endif
    SetScreenElementLock id = root_window off
    GoalManager_HidePoints
    thugpro_menu_create {
    menu_name = files
    menu_title = "Load Skater"
    menu_style = MENU_STYLE_MIDDLE
    helper_text = load_files_menu_helper_text
    pad_back_script = generic_menu_pad_back
    pad_back_params = { callback = dadmod_midload_cancel }
    show_description_panel
    show_element_counter
    colorful
    num_items_to_show = 11
    scrolling
    boxed
    }
    ForEachIn {
    <DirectoryListing>
    Do = thugpro_files_menu_add_item
    params = {
    pad_choose_script = dadmod_midload_pick
    }
    }
    RemoveParameter DirectoryListing
    thugpro_menu_create_remainder_items
    GetMaxTHPS4FilesAllowed
    current_menu : SetTags menu_item_max_count = <MaxTHPS4FilesAllowed>
    thugpro_menu_finalize <...>
endscript

script dadmod_midload_pick
    GetTags
    if GotParam corrupt
        return
    endif
    if GotParam BadVersion
        return
    endif
    if not GotParam filename
        return
    endif
    generic_menu_pad_choose_sound
    memcard_menus_cleanup
    thugpro_menu_destroy
    if ( dadmod_skater_unsaved = 1 )
        <ask> = "You have unsaved changes to this skater. Loading another skater will discard them. Continue?"
    else
        <ask> = "Load this skater? Your current skater will be replaced."
    endif
    create_snazzy_dialog_box {
    title = "Load Skater"
    text = <ask>
    text_dims = (3.2e+02,0.0)
    pad_back_script = dadmod_midload_files
    buttons = [
    { font = small text = "No" pad_choose_script = dadmod_midload_files }
    { font = small text = "Yes" pad_choose_script = dadmod_midload_go pad_choose_params = { filename = <filename> } }
    ]
    }
endscript

script dadmod_midload_go
    memcard_menus_cleanup
    thugpro_menu_destroy
    dadmod_midload_can_show
    if ( <show> = 0 )
        dadmod_midload_close
        return
    endif
    Change SavingOrLoading = Loading
    SetSectionsToApplyWhenLoading ApplyCustomSkater
    if InNetGame
        THUGRECOMP_SkinLocalZero on = 1
    endif
    if LoadFromMemoryCard Name = <filename> Type = optionsandpros
        if ( load_successful = 0 )
            Change load_successful = 1
            THUGRECOMP_SkinLocalZero on = 0
            dadmod_midload_message text = "That skater could not be loaded."
            return
        endif
        Change dadmod_skater_unsaved = 0
        GetCurrentSkaterProfileIndex
        RefreshSkaterScale profile = <currentSkaterProfileIndex> Skater = 0
        RefreshSkaterVisibility profile = <currentSkaterProfileIndex> Skater = 0
        UpdateTrickMappings Skater = 0
        THUGRECOMP_SkinLocalZero on = 0
        dadmod_midload_close
        dadmod_midload_settle
        if InNetGame
            dadmod_midload_online_note
        endif
    else
        THUGRECOMP_SkinLocalZero on = 0
        dadmod_midload_message text = "That skater could not be loaded."
    endif
endscript

script dadmod_midload_message
    memcard_menus_cleanup
    thugpro_menu_destroy
    create_snazzy_dialog_box {
    title = "Load Skater"
    text = <text>
    text_dims = (3.2e+02,0.0)
    pad_back_script = dadmod_midload_cancel
    buttons = [
    { font = small text = "OK" pad_choose_script = dadmod_midload_cancel }
    ]
    }
endscript

script dadmod_midload_cancel
    memcard_menus_cleanup
    thugpro_menu_destroy
    if ( dadmod_midload_paused = 1 )
        Change dadmod_midload_paused = 0
        GoalManager_UnpauseAllGoals
        UnpauseGame
    endif
    dadmod_midload_can_show
    if ( <show> = 1 )
        thugpro_show_quick_menu
    else
        dadmod_midload_close
    endif
endscript

script dadmod_midload_close
    dialog_box_exit no_pad_start
    thugpro_menu_destroy
    if ( dadmod_midload_paused = 1 )
        Change dadmod_midload_paused = 0
        GoalManager_UnpauseAllGoals
        UnpauseGame
    endif
    SetScreenElementProps id = root_window tags = { menu_state = off }
    GoalManager_ShowPoints
    restore_start_key_binding
    if ObjectExists id = skater
        if not IsObserving
            GetSkaterId
            <objID> : NetEnablePlayerInput
        endif
    endif
endscript

script dadmod_midload_settle
    if not ObjectExists id = skater
        return
    endif
    skater : TurnOffSpecialItem
    if ScriptExists dadmod_noclip_is_on
        dadmod_noclip_is_on
        if GotParam dadmod_nc_on
            if ( <dadmod_nc_on> = 1 )
                return
            endif
        endif
    endif
    if skater : walking
        MakeSkaterGoto GroundOrAirWaitState
    else
        if not skater : InAir
            MakeSkaterGoto OnGroundAi
        endif
    endif
endscript

script dadmod_midload_online_note
    note = "Skater loaded. Other players see your new skater after you rejoin."
    if THUGRECOMP_SkinSend
        note = "Skater loaded. Players with dadmod see your new skater now, everyone else after you rejoin."
    endif
    create_snazzy_dialog_box {
    title = "Load Skater"
    text = <note>
    text_dims = (3.2e+02,0.0)
    pad_back_script = dadmod_midload_close
    buttons = [
    { font = small text = "OK" pad_choose_script = dadmod_midload_close }
    ]
    }
endscript

dadmod_bhra_keep = 0

dadmod_bhra_easy = 0

dadmod_bhra_loaded = 0

script dadmod_bhra_load
    keep = 0
    easy = 0
    if THUGRECOMP_SettingLoad key = "bhra_keep"
        if ( <value> = 1 )
            keep = 1
        endif
    endif
    if THUGRECOMP_SettingLoad key = "bhra_easy"
        if ( <value> = 1 )
            easy = 1
        endif
    endif
    Change dadmod_bhra_keep = <keep>
    Change dadmod_bhra_easy = <easy>
    Change dadmod_bhra_loaded = 1
endscript

script dadmod_bhra_dbg
    GetSingleTag dadmod_bhra_probe
    if GotParam dadmod_bhra_probe
        if InAir
            bhra_a = 1
        else
            bhra_a = 0
        endif
        GetStartTime
        FormatText TextName = bhra_t "bhra t=%t %w air=%a" t = <StartTime> w = <what> a = <bhra_a>
        THUGRECOMP_Log text = <bhra_t>
    endif
endscript

script dadmod_bhra_easy_time RevertTime = 5
    if not IsTrue dadmod_bhra_loaded
        dadmod_bhra_load
    endif
    if IsTrue dadmod_bhra_easy
        if ( <RevertTime> < 10 )
            return RevertTime = 10
        endif
    endif
endscript

script dadmod_bhra_poll frames = 12
    SetTags bhra_x = 0
    begin
        if Held x
            SetTags bhra_x = 3
        else
            GetSingleTag bhra_x
            if GotParam bhra_x
                if ( <bhra_x> > 0 )
                    SetTags bhra_x = ( <bhra_x> - 1 )
                endif
            endif
        endif
        wait 1 gameframe
    repeat <frames>
    SetTags bhra_x = 0
endscript

script dadmod_bhra_land2_arm RevertTime = 5
    if not IsTrue dadmod_bhra_loaded
        dadmod_bhra_load
    endif
    if IsTrue dadmod_bhra_keep
    else
        if IsTrue dadmod_bhra_easy
        else
            return
        endif
    endif
    Obj_KillSpawnedScript Name = dadmod_bhra_poll
    pf = ( <RevertTime> + 4 )
    Obj_SpawnScript dadmod_bhra_poll params = { frames = <pf> }
    dadmod_bhra_dbg what = "land2 vert window armed"
    return bhra_arm = 1
endscript

script dadmod_bhra_dd_arm
    if IsSkaterOnVehicle
        return
    endif
    if not IsTrue dadmod_bhra_loaded
        dadmod_bhra_load
    endif
    if IsTrue dadmod_bhra_keep
    else
        if IsTrue dadmod_bhra_easy
        else
            return
        endif
    endif
    Obj_KillSpawnedScript Name = dadmod_bhra_poll
    Obj_SpawnScript dadmod_bhra_poll params = { frames = 90 }
    dadmod_bhra_dbg what = "skate-in window armed"
    return bhra_arm = 1
endscript

script dadmod_bhra_dd_easy_wait
    if IsTrue dadmod_bhra_easy
        SetExtraTricks_Reverts duration = 20
        dadmod_bhra_dbg what = "easy: skate-in window held 15 more frames"
        wait 15 gameframes
    endif
endscript

script dadmod_bhra_cand
    GetSingleTag bhra_x
    if GotParam bhra_x
        if ( <bhra_x> > 0 )
            return bhra_cand = 1
        endif
    endif
endscript

script dadmod_bhra_interrupt src = 1
    dadmod_bhra_cand
    if GotParam bhra_cand
        SetTags bhra_wait = <src> bhra_hopped = 0
        Obj_KillSpawnedScript Name = dadmod_bhra_watch
        if IsTrue dadmod_bhra_keep
            SetTags bhra_pending = 1
            dadmod_bhra_dbg what = "interrupted with the ollie button down: bank deferred"
            Obj_SpawnScript dadmod_bhra_watch params = { src = <src> }
            return deferred = 1
        endif
        Obj_SpawnScript dadmod_bhra_watch params = { src = <src> nobank = 1 }
    endif
endscript

script dadmod_bhra_land2_out
    dadmod_bhra_interrupt src = 1
    if GotParam deferred
        return
    endif
    dadmod_bhra_dbg what = "land2 interrupted: banked"
    LandSkaterTricks
endscript

script dadmod_bhra_skatein_out
    if not InAir
        dadmod_bhra_interrupt src = 2
        if not GotParam deferred
            dadmod_bhra_dbg what = "skate-in interrupted: banked"
            LandSkaterTricks
        endif
    endif
    ResetLandedFromVert
    ResetLandingFromBankDrop
endscript

script dadmod_bhra_skatein_exc
    OnGroundExceptions_NoOllieAfterEndofRun
    if IsTrue dadmod_bhra_keep
        if GoalManager_GoalShouldExpire
            SetException ex = Ollied scr = Ollie
        endif
    endif
endscript

script dadmod_bhra_ollie_mark
    GetSingleTag bhra_wait
    if GotParam bhra_wait
        if ( <bhra_wait> > 0 )
            SetTags bhra_wait = 0 bhra_hopped = <bhra_wait>
            if IsTrue dadmod_bhra_easy
                if ( <bhra_wait> = 2 )
                    SetExtraTricks_Reverts duration = 50
                else
                    SetExtraTricks_Reverts duration = 20
                endif
            endif
            dadmod_bhra_dbg what = "ollie: it was a hop"
        endif
    endif
endscript

script dadmod_bhra_watch src = 1
    wait 1 gameframe
    GetSingleTag bhra_hopped
    SetTags bhra_wait = 0
    hop = 0
    if GotParam bhra_hopped
        hop = <bhra_hopped>
    endif
    SetTags bhra_hopped = 0
    if GotParam nobank
        return
    endif
    if ( <hop> = 0 )
        dadmod_bhra_dbg what = "no ollie followed: banking"
        dadmod_bhra_flush
        return
    endif
    frames = 7
    if ( <src> = 2 )
        frames = 51
    else
        if IsTrue dadmod_bhra_easy
            frames = 21
        endif
    endif
    begin
        GetSingleTag bhra_pending
        if not GotParam bhra_pending
            return
        endif
        if ( <bhra_pending> = 0 )
            return
        endif
        if BailIsOn
            dadmod_bhra_dbg what = "flip or grab during the hop: banking"
            break
        endif
        wait 1 gameframe
    repeat <frames>
    dadmod_bhra_dbg what = "no revert in the window: banking"
    dadmod_bhra_flush
endscript

script dadmod_bhra_flush
    GetSingleTag bhra_pending
    if GotParam bhra_pending
        if ( <bhra_pending> = 1 )
            SetTags bhra_pending = 0
            dadmod_bhra_dbg what = "pending combo banked"
            LandSkaterTricks
        endif
    endif
endscript

script dadmod_bhra_revert_check
    GetSingleTag bhra_pending
    if GotParam bhra_pending
        if ( <bhra_pending> = 1 )
            SetTags bhra_pending = 0
            Obj_KillSpawnedScript Name = dadmod_bhra_watch
            if InAir
                if IsTrue dadmod_bhra_keep
                    dadmod_bhra_dbg what = "air revert after a hop: combo kept"
                    return bhra_air = 1
                endif
            endif
            dadmod_bhra_dbg what = "revert after a hop on the ground: banked"
            LandSkaterTricks
        endif
    endif
endscript

script dadmod_bhra_toggle_get
    dadmod_bhra_load
    if ( <which> = easy )
        return bhra_on = ( dadmod_bhra_easy )
    endif
    return bhra_on = ( dadmod_bhra_keep )
endscript

script dadmod_bhra_text
    dadmod_bhra_toggle_get which = keep
    if ( <bhra_on> = 1 )
        bhra_keep_text = "On"
    else
        bhra_keep_text = "Off"
    endif
    dadmod_bhra_toggle_get which = easy
    if ( <bhra_on> = 1 )
        bhra_easy_text = "On"
    else
        bhra_easy_text = "Off"
    endif
    return bhra_keep_text = <bhra_keep_text> bhra_easy_text = <bhra_easy_text>
endscript

script dadmod_bhra_keep_toggle
    dadmod_bhra_toggle id = dadmod_bhra_keep_item which = keep key = "bhra_keep"
endscript

script dadmod_bhra_easy_toggle
    dadmod_bhra_toggle id = dadmod_bhra_easy_item which = easy key = "bhra_easy"
endscript

script dadmod_bhra_toggle
    if ScreenElementExists id = <id>
        if <id> : GetSingleTag bhra_lock
            if ( <bhra_lock> = 1 )
                return
            endif
        endif
        <id> : SetTags bhra_lock = 1
        SpawnScript dadmod_bhra_unlock params = { id = <id> }
    endif
    dadmod_bhra_toggle_get which = <which>
    if ( <bhra_on> = 1 )
        on = 0
        bhra_t = "Off"
    else
        on = 1
        bhra_t = "On"
    endif
    THUGRECOMP_SettingSave key = <key> value = <on>
    dadmod_bhra_load
    if ScreenElementExists id = <id>
        thugpro_menu_item_update_extra_text id = <id> text = <bhra_t>
    endif
endscript

script dadmod_bhra_unlock
    wait 6 gameframes
    if ScreenElementExists id = <id>
        <id> : SetTags bhra_lock = 0
    endif
endscript

thugpro_mainmenu_east_la = 1

script dadmod_lobby_fade_in
    if ScreenElementExists id = current_menu_anchor
        DoScreenElementMorph id = current_menu_anchor alpha = 0
        wait 1 gameframe
        if ScreenElementExists id = current_menu_anchor
            DoScreenElementMorph id = current_menu_anchor alpha = 1 time = 0.8
        endif
    endif
endscript

script dadmod_menu_watch
    wait 30 gameframes
    begin
        if ObjectExists id = Skater
            if LocalSkaterExists
                break
            endif
        endif
        wait 1 gameframe
    repeat 900
    wait 20 gameframes
    if not LevelIs Load_MainMenu
        return
    endif
    if not ObjectExists id = Skater
        return
    endif
    THUGRECOMP_MenuOpt key = "menu_alive" step = 0
    if (<alive> = 0)
        THUGRECOMP_Log text = "main menu: no screen started the menu scene, starting it"
        thugpro_orient_menu_skater
    endif
endscript

script thugpro_orient_menu_skater
    orient_skateshop_skater
    if THUGRECOMP_MenuSpot
        GetSkaterId
        <objID> : Obj_SetPosition position = <spot_pos>
        if GotParam spot_dir
            <objID> : Obj_SetOrientation dir = <spot_dir>
        endif
    endif
    if IsTrue thugpro_mainmenu_east_la
        MakeSkaterGoto SkateshopIdle
    else
        thugpro_menu_apply_theme
    endif
    KillSpawnedScript Name = thugpro_menu_driver
    SpawnScript thugpro_menu_driver
    KillSpawnedScript Name = dadmod_menu_ambient_spawn
    SpawnScript dadmod_menu_ambient_spawn
endscript

script dadmod_menu_ambient_spawn
    wait 10 gameframes
    THUGRECOMP_MenuOpt key = "ambient_people" step = 0
    if not GotParam on
        return
    endif
    if not (<on> = 1)
        return
    endif
    dadmod_menu_ambient_peds
    i = 0
    begin
        if (<i> = <array_size>)
            break
        endif
        e = ( <peds> [ <i> ] )
        n = ( <e> . n )
        p = ( <e> . p )
        THUGRECOMP_MenuOpt key = "ambient_ok" step = 0 px = ( <p> . (1.0,0.0,0.0) ) py = ( <p> . (0.0,1.0,0.0) ) pz = ( <p> . (0.0,0.0,1.0) )
        if (<ok> = 1)
            if not ObjectExists id = <n>
                Create name = <n>
                if ObjectExists id = <n>
                    THUGRECOMP_Log text = "main menu: ambient ped created"
                endif
            endif
        endif
        i = ( <i> + 1 )
        wait 1 gameframe
    repeat
endscript

script dadmod_menu_ambient_kill
    dadmod_menu_ambient_peds
    i = 0
    begin
        if (<i> = <array_size>)
            break
        endif
        n = ( ( <peds> [ <i> ] ) . n )
        if ObjectExists id = <n>
            Kill name = <n>
        endif
        i = ( <i> + 1 )
    repeat
endscript

script dadmod_menu_ambient_peds
    lv = "none"
    GetLevelStructureName
    if StructureContains structure = ( <level_structure_name> ) level
        lv = ( <level_structure_name> . level )
    endif
    FormatText ChecksumName = lvck "%s" s = <lv>
    dadmod_menu_ambient_list level = <lvck>
    GetArraySize <peds>
    return peds = <peds> array_size = <array_size>
endscript

script dadmod_menu_ambient_apply
    THUGRECOMP_MenuOpt key = "ambient_people" step = 0
    if (<on> = 1)
        KillSpawnedScript Name = dadmod_menu_ambient_spawn
        SpawnScript dadmod_menu_ambient_spawn
    else
        KillSpawnedScript Name = dadmod_menu_ambient_spawn
        dadmod_menu_ambient_kill
    endif
endscript

thugpro_shop_holiday_nodes = [ TRG_PedController TRG_prop_pumpkin_1 TRG_prop_pumpkin_2 TRG_prop_pumpkin_3 TRG_prop_pumpkin_small TRG_prop_pumpkin_huge TRG_prop_pumpkin_counter_1 TRG_prop_pumpkin_counter_2 TRG_prop_pumpkin_bench TRG_prop_candle_cluster_big TRG_prop_candle_cluster_big_2 TRG_G_SkPro_HellPortalDoor01 ]

thugpro_shop_holiday_peds = [ TRG_Ped01 TRG_Ped02 TRG_Ped03 ]

thugpro_shop_normal_nodes = [ shirt_stand_03 glasses_shelf sunglasses_5 ]

script thugpro_menu_apply_theme
    if IsTrue thugpro_mainmenu_east_la
        return
    endif
    THUGRECOMP_MenuOpt key = "shop_theme" step = 0
    if (<theme> = 0)
        return
    endif
    if ( ( <theme> = 1 ) or ( <theme> = 3 ) )
        thugpro_menu_theme_each list = ( thugpro_shop_holiday_nodes ) run = thugpro_menu_theme_create
        thugpro_menu_theme_each list = ( thugpro_shop_normal_nodes ) run = thugpro_menu_theme_kill
    else
        thugpro_menu_theme_each list = ( thugpro_shop_holiday_nodes ) run = thugpro_menu_theme_kill
        thugpro_menu_theme_each list = ( thugpro_shop_holiday_peds ) run = thugpro_menu_theme_kill
        thugpro_menu_theme_each list = ( thugpro_shop_normal_nodes ) run = thugpro_menu_theme_create
    endif
    thugpro_menu_theme_create element = TRG_LightController
    SetSceneColor color = 8421504 sky = 8421504
endscript

script thugpro_menu_theme_each
    GetArraySize <list>
    i = 0
    begin
        if (<i> = <array_size>)
            break
        endif
        <run> element = ( <list> [ <i> ] )
        i = ( <i> + 1 )
    repeat
endscript

script thugpro_menu_theme_create
    if not ObjectExists id = <element>
        Create name = <element>
    endif
endscript

script thugpro_menu_theme_kill
    if ObjectExists id = <element>
        Kill name = <element>
    endif
endscript

script thugpro_menu_driver
    restart = 1
    last_focus = none
    retake = 0
    last_menu = 0
    player_cam_on = 0
    known_menu = 0
    begin
        wait 1 gameframe
        menu_now = 0
        if ScreenElementExists id = server_list_menu
            menu_now = 11
        endif
        if ScreenElementExists id = lobby_list_anchor
            menu_now = 11
        endif
        if ScreenElementExists id = startup_menu
            menu_now = 1
        endif
        if ScreenElementExists id = ss_menu
            menu_now = 2
        endif
        if ScreenElementExists id = dadmod_mainmenu_menu
            menu_now = 3
        endif
        if ScreenElementExists id = dadmod_layout_menu
            menu_now = 3
        endif
        if ScreenElementExists id = dadmod_savedmenu_menu
            menu_now = 3
        endif
        if ScreenElementExists id = dadmod_restoremenu_menu
            menu_now = 3
        endif
        if ScreenElementExists id = dadmod_customcam_menu
            menu_now = 3
        endif
        if ScreenElementExists id = #"0x9603af5d"
            menu_now = 4
        endif
        if ScreenElementExists id = #"0xda94d458"
            menu_now = 5
        endif
        if ScreenElementExists id = #"0x414f113e"
            menu_now = 5
        endif
        if ScreenElementExists id = #"0x57be0828"
            menu_now = 5
        endif
        if ScreenElementExists id = #"0x6ce9ed8f"
            menu_now = 6
        endif
        if ScreenElementExists id = #"0x747da42b"
            menu_now = 7
        endif
        if ScreenElementExists id = #"0x8410fa99"
            menu_now = 7
        endif
        if ScreenElementExists id = #"0xe7ffb1c5"
            menu_now = 7
        endif
        if ScreenElementExists id = #"0x7d64890c"
            menu_now = 7
        endif
        if ScreenElementExists id = #"0xb24fc836"
            menu_now = 7
        endif
        if ScreenElementExists id = select_skater_anchor
            menu_now = 8
        endif
        if ScreenElementExists id = level_select_menu
            menu_now = 11
        endif
        if ScreenElementExists id = multiplayer_menu
            menu_now = 1
            KillSkaterCamAnim All
        endif
        if ScreenElementExists id = dadmod_lobby_wait
            menu_now = 11
        endif
        if THUGRECOMP_MenuCamEdit query = 1
            menu_now = 9
        endif
        if ScreenElementExists id = #"0x6ce9ed8f"
            focus_now = ( dadmod_ui_focused )
            if not (<focus_now> = <last_focus>)
                last_focus = <focus_now>
                if ScreenElementExists id = { <focus_now> child = text }
                    GetTextElementString id = { <focus_now> child = text }
                    THUGRECOMP_MenuFocus text = <String>
                endif
            endif
        endif
        if (<menu_now> = 1)
            if ObjectExists id = Skater
                if Skater : IsHidden
                    Skater : unhide
                endif
            endif
        endif
        if (<menu_now> = 3)
            dadmod_mm_keys_tick
            dadmod_mm_fav_tick
        endif
        if (<menu_now> = 1)
            if IsTrue dadmod_mm_reopen
                Change dadmod_mm_reopen = 0
                SpawnScript dadmod_mm_reopen_menu
            endif
            if THUGRECOMP_KeyPressed key = "F9"
                SpawnScript thugpro_main_reorder_toggle
            endif
            if THUGRECOMP_KeyPressed key = "F10"
                SpawnScript thugpro_main_order_undo
            endif
            if THUGRECOMP_KeyPressed key = "F12"
                SpawnScript thugpro_main_order_reset
            endif
            dadmod_pad_chord
            if (<chord> = 1)
                SpawnScript thugpro_main_reorder_toggle
            endif
            if (<chord> = 2)
                SpawnScript thugpro_main_order_undo
            endif
            if (<chord> = 3)
                SpawnScript thugpro_main_order_reset
            endif
        endif
        if (<menu_now> = 0)
            last_menu = 0
            if ( ( <known_menu> = 2 ) or ( <known_menu> = 8 ) )
                KillSkaterCamAnim All
                if ObjectExists id = menu_cam
                    SetActiveCamera id = menu_cam
                endif
            endif
        else
            known_menu = <menu_now>
            if not (<menu_now> = <last_menu>)
                retake = 1
                if (<menu_now> = 11)
                    if ScreenElementExists id = server_list_menu
                        SpawnScript dadmod_lobby_fade_in
                    endif
                endif
            endif
            last_menu = <menu_now>
            GetSkaterId
            <objID> : Obj_GetPosition
            if (<menu_now> = 9)
                THUGRECOMP_MenuCamEdit sx = ( <Pos> . (1.0,0.0,0.0) ) sy = ( <Pos> . (0.0,1.0,0.0) ) sz = ( <Pos> . (0.0,0.0,1.0) )
                if GotParam done
                    SpawnScript dadmod_mm_cam_edit_end params = { done = <done> name = <name> }
                    RemoveParameter done
                endif
            else
                <objID> : Obj_GetOrientation
                THUGRECOMP_MenuTick restart = <restart> ctx = <menu_now> sx = ( <Pos> . (1.0,0.0,0.0) ) sy = ( <Pos> . (0.0,1.0,0.0) ) sz = ( <Pos> . (0.0,0.0,1.0) ) fx = <x> fy = <y> fz = <z>
            endif
            restart = 0
            if GotParam spin
                <objID> : Obj_RotY speed = 400 angle = 180
                RemoveParameter spin
            endif
            if GotParam face_dir
                <objID> : Obj_SetOrientation dir = <face_dir>
                RemoveParameter face_dir
            endif
            if GotParam freeze
                <objID> : PausePhysics
                RemoveParameter freeze
            endif
            if GotParam unfreeze
                <objID> : UnpausePhysics
                RemoveParameter unfreeze
            endif
            if GotParam keep_pos
                <objID> : Obj_SetPosition position = <keep_pos>
                if GotParam keep_dir
                    <objID> : Obj_SetOrientation dir = <keep_dir>
                    RemoveParameter keep_dir
                endif
                RemoveParameter keep_pos
            endif
            if GotParam pose_script
                MakeSkaterGoto thugpro_menu_idle params = { pose_script = <pose_script> }
                RemoveParameter pose_script
            endif
            if GotParam pose_cycle
                MakeSkaterGoto thugpro_menu_idle params = { pose_cycle = <pose_cycle> }
                RemoveParameter pose_cycle
            endif
            if GotParam pose_next
                <objID> : Obj_PlayAnim anim = <pose_next> BlendPeriod = 0.6 cycle
                RemoveParameter pose_next
            endif
            if GotParam pose_anims
                if not GotParam pose_hold
                    pose_hold = 0
                endif
                MakeSkaterGoto thugpro_menu_idle params = { pose_a1 = <pose_a1> pose_a2 = <pose_a2> pose_a3 = <pose_a3> pose_a4 = <pose_a4> pose_hold = <pose_hold> }
                RemoveParameter pose_anims
                RemoveParameter pose_hold
            endif
            if GotParam cam_pos
                if (<retake> = 1)
                    KillSkaterCamAnim All
                    if not ObjectExists id = menu_cam
                        create_menu_camera
                    endif
                    menu_cam : unpause
                endif
                if (<menu_now> > 3)
                    if (<menu_now> < 9)
                        KillSkaterCamAnim All
                    endif
                    if (<menu_now> = 11)
                        KillSkaterCamAnim All
                    endif
                endif
                menu_cam : Obj_SetPosition position = <cam_pos>
                menu_cam : Obj_SetOrientation dir = <cam_dir>
                SetActiveCamera id = menu_cam
                retake = 0
                player_cam_on = 0
                RemoveParameter cam_pos
                RemoveParameter cam_dir
            endif
            if GotParam deck_off
                if ScreenElementExists id = menu_bg_texture
                    DestroyScreenElement id = menu_bg_texture
                endif
                RemoveParameter deck_off
            endif
            if GotParam player_cam
                if ( ( <retake> = 1 ) or ( <player_cam_on> = 0 ) )
                    if ObjectExists id = skatercam0
                        SetActiveCamera id = skatercam0
                    endif
                    retake = 0
                    player_cam_on = 1
                endif
                RemoveParameter player_cam
            endif
        endif
    repeat
endscript

script dadmod_mm_cam_reposition
    SpawnScript dadmod_mm_cam_edit_begin
endscript

script dadmod_mm_cam_edit_begin
    wait 1 gameframe
    destroy_menu_background_title
    if ScreenElementExists id = helper_text_anchor
        DestroyScreenElement id = helper_text_anchor
    endif
    if ScreenElementExists id = current_menu_anchor
        DestroyScreenElement id = current_menu_anchor
    endif
    THUGRECOMP_MenuCamEdit start_edit = 1
    dadmod_mm_cam_edit_text
endscript

script dadmod_mm_cam_edit_text
    dadmod_mm_cam_edit_text_off
    dadmod_mm_cam_edit_line id = dadmod_camedit_text1 y = 360 text = "REPOSITION CAMERA"
    if dadmod_on_pad
        dadmod_mm_cam_edit_line id = dadmod_camedit_text2 y = 380 text = "Left stick: move   Right stick: look   \\bg/\\bh or \\be/\\bf: down/up   Hold \\b1: faster"
        dadmod_mm_cam_edit_line id = dadmod_camedit_text3 y = 400 text = "\\b3 or \\b8: save this camera   \\b2 or \\b0: cancel"
    else
        dadmod_mm_cam_edit_line id = dadmod_camedit_text2 y = 380 text = "WASD: move   Arrows: look   Q/E or PgUp/PgDn: down/up   Hold Shift: faster"
        dadmod_mm_cam_edit_line id = dadmod_camedit_text3 y = 400 text = "Enter: save this camera   Esc or Backspace: cancel"
    endif
endscript

script dadmod_mm_cam_edit_line
    CreateScreenElement {
    Type = TextElement
    parent = root_window
    id = <id>
    font = dialog
    text = <text>
    Pos = ( (320.0,0.0) + (0.0,1.0) * <y> )
    just = [ center center ]
    scale = 0.6
    rgba = [ 128 128 128 128 ]
    z_priority = 1000
    }
endscript

script dadmod_mm_cam_edit_text_off
    if ScreenElementExists id = dadmod_camedit_text1
        DestroyScreenElement id = dadmod_camedit_text1
    endif
    if ScreenElementExists id = dadmod_camedit_text2
        DestroyScreenElement id = dadmod_camedit_text2
    endif
    if ScreenElementExists id = dadmod_camedit_text3
        DestroyScreenElement id = dadmod_camedit_text3
    endif
    if ScreenElementExists id = dadmod_camedit_text4
        DestroyScreenElement id = dadmod_camedit_text4
    endif
endscript

script dadmod_mm_cam_edit_end
    dadmod_mm_cam_edit_text_off
    wait 2 gameframes
    if (dadmod_layout_node > -1)
        dadmod_layout_open node = ( dadmod_layout_node )
    else
        create_dadmod_setup_menu
    endif
    if (<done> = 1)
        FormatText TextName = text "Camera saved for %n" n = <name>
    else
        text = "Camera not changed"
    endif
    KillSpawnedScript Name = thugpro_mark_show
    SpawnScript thugpro_mark_show params = { text = <text> }
endscript

script dadmod_custom_random_pick
    THUGRECOMP_MenuOpt key = "custom_random" set = 1
    Change dadmod_mm_armed = none
    Change dadmod_mm_reopen = 1
    SpawnScript dadmod_reload_menu_scene
endscript

script dadmod_saved_menu_menu
    default_skateshop_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_savedmenu
    menu_title = "Custom menus"
    menu_style = MENU_STYLE_LEFT
    helper_text = {
    helper_text_elements_pc = [ { text = "\\b7/\\b4 = Select" } { text = "\\bn = Back" } { text = "\\bm = Accept" } { text = "\\b5 = Star" } { text = "F8 = Delete" } ]
    helper_text_elements_console = [ { text = "\\b7/\\b4 = Select" } { text = "\\m1 = Back" } { text = "\\m0 = Accept" } { text = "\\b5 = Star" } { text = "\\b1 = Delete" } ]
    }
    pad_back_script = dadmod_menu_level_back
    show_description_panel
    show_gradient
    scrolling
    }
    i = 0
    begin
        if not THUGRECOMP_MenuSaved index = <i>
            break
        endif
        if (<cur> = 1)
            FormatText TextName = t "%s (now)" s = <name>
            d = "The main menu you have now. Right stars it (*): Menu scene Starred picks among starred menus"
        else
            t = <name>
            d = "Load this saved main menu: the level, your skater's spot and the camera. Right stars it (*) for Menu scene Starred"
        endif
        sx = " "
        if (<star> = 1)
            sx = "*"
        endif
        FormatText ChecksumName = item_id "dadmod_saved_%i" i = <pick>
        if (( dadmod_mm_armed ) = <item_id>)
            FormatText TextName = t "Delete %s?" s = <name>
            dadmod_btn pad = x key = "F8"
            FormatText TextName = d "Press %b again to delete it. A copy is kept in the dadmod backups folder" b = <btn>
        endif
        make_thugpro_menu_item {
        id = <item_id>
        text = <t>
        extra_text = <sx>
        description_text = <d>
        pad_choose_script = dadmod_menu_level_pick
        pad_choose_params = { pick = <pick> }
        }
        SetScreenElementProps id = <item_id> event_handlers = [ { pad_right dadmod_saved_star params = { pick = <pick> id = <item_id> } } ]
        i = ( <i> + 1 )
    repeat
    if (<i> = 0)
        make_thugpro_menu_item {
        text = "Nothing saved yet"
        description_text = "While skating a level: Quick Menu > Set Main Menu Here saves your spot there as a main menu"
        not_focusable
        }
    endif
    if THUGRECOMP_MenuRestore index = 0
        make_thugpro_menu_item {
        text = "Restore deleted menus  >"
        sub_label = "Restore deleted menus"
        id = dadmod_saved_restore
        description_text = "Put back a custom menu you deleted"
        pad_choose_script = dadmod_restore_menus_menu
        }
    endif
    dadmod_desc_panel_right
    if GotParam focus_target
        if ScreenElementExists id = <focus_target>
            thugpro_menu_finalize focus_target = <focus_target>
            return
        endif
    endif
    thugpro_menu_finalize
endscript

script dadmod_restore_menus_menu
    default_skateshop_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_restoremenu
    menu_title = "Restore deleted menus"
    menu_style = MENU_STYLE_LEFT
    helper_text = generic_helper_text
    pad_back_script = dadmod_saved_menu_menu
    pad_back_params = { focus_target = dadmod_saved_restore }
    show_description_panel
    show_gradient
    scrolling
    }
    i = 0
    begin
        if not THUGRECOMP_MenuRestore index = <i>
            break
        endif
        FormatText TextName = d "Put %n back in Custom menus (deleted %w)" n = <name> w = <when>
        make_thugpro_menu_item {
        text = <name>
        description_text = <d>
        pad_choose_script = dadmod_restore_menu_pick
        pad_choose_params = { index = <i> }
        }
        i = ( <i> + 1 )
    repeat 64
    if (<i> = 0)
        make_thugpro_menu_item {
        text = "Nothing to restore"
        description_text = "Menus you delete in Custom menus show up here"
        not_focusable
        }
    endif
    dadmod_desc_panel_right
    thugpro_menu_finalize
endscript

script dadmod_restore_menu_pick
    if THUGRECOMP_MenuRestore restore = <index>
        FormatText TextName = text "%n is back in Custom menus" n = <name>
    else
        if GotParam why
            FormatText TextName = text "%n already has a saved menu" n = <name>
        else
            text = "Could not restore that menu"
        endif
    endif
    KillSpawnedScript Name = thugpro_mark_show
    SpawnScript thugpro_mark_show params = { text = <text> }
    SpawnScript dadmod_restore_menus_reopen
endscript

script dadmod_restore_menus_reopen
    wait 2 gameframes
    dadmod_saved_menu_menu
endscript

script dadmod_saved_star
    if THUGRECOMP_MenuSaved star_pick = <pick>
        if (<on> = 1)
            thugpro_menu_item_update_extra_text id = <id> text = "*"
        else
            thugpro_menu_item_update_extra_text id = <id> text = " "
        endif
    endif
endscript

script dadmod_set_menu_here
    if GotParam from_quick
        exit_quick_menu
    endif
    mark_level = "east_la"
    GetLevelStructureName
    if StructureContains structure = ( <level_structure_name> ) level
        mark_level = ( <level_structure_name> . level )
    endif
    GetSkaterId
    if not ObjectExists id = <objID>
        KillSpawnedScript Name = thugpro_mark_show
        SpawnScript thugpro_mark_show params = { text = "No skater to set the main menu from" }
        return
    endif
    <objID> : Obj_GetPosition
    <objID> : Obj_GetOrientation
    THUGRECOMP_MenuSetHere {
    level = <mark_level>
    px = ( <Pos> . (1.0,0.0,0.0) )
    py = ( <Pos> . (0.0,1.0,0.0) )
    pz = ( <Pos> . (0.0,0.0,1.0) )
    dx = <x>
    dy = <y>
    dz = <z>
    }
    if GotParam name
        FormatText TextName = text "Custom menu saved: %n. Your skater will stand right here on the main menu" n = <name>
    else
        FormatText TextName = text "This level (%l) has no main menu version, so the main menu was not changed" l = <mark_level>
    endif
    KillSpawnedScript Name = thugpro_mark_show
    SpawnScript thugpro_mark_show params = { text = <text> }
endscript

script dadmod_mm_reopen_menu
    wait 2 gameframes
    if ScreenElementExists id = startup_menu
        if (dadmod_layout_node > -1)
            dadmod_layout_open node = ( dadmod_layout_node )
        else
            create_dadmod_setup_menu
        endif
    endif
endscript

script thugpro_menu_idle
    dadmod_menu_idleseq_kill
    Obj_GetId
    <objID> : Obj_ShadowOff
    <objID> : ClearExceptions
    <objID> : TurnOffSpecialItem
    if not IsTrue LAST_SELECTED_SKATER_HIDE_BOARD
        SkaterInit NoAnims ReturnControl NoEndRun
    else
        SkaterInit NoAnims ReturnControl NoEndRun no_board = no_board
    endif
    <objID> : CancelRotateDisplay
    <objID> : TurnOffSpecialItem
    thugpro_DisablePlayerInput
    THUGRECOMP_MenuOpt key = "frozen" step = 0
    if (<on> = 1)
        <objID> : PausePhysics
    endif
    SetRollingFriction 10000
    if GotParam pose_script
        SpawnSkaterScript <pose_script>
    else
        if GotParam pose_cycle
            SpawnSkaterScript thugpro_menu_pose_cycle params = { anim = <pose_cycle> }
            return
        endif
        SpawnSkaterScript thugpro_menu_pose_anims params = { pose_a1 = <pose_a1> pose_a2 = <pose_a2> pose_a3 = <pose_a3> pose_a4 = <pose_a4> pose_hold = <pose_hold> }
    endif
endscript

script thugpro_menu_pose_cycle
    Obj_GetId
    if AnimExists <anim>
        <objID> : Obj_PlayAnim anim = <anim> BlendPeriod = 0.3 cycle
    endif
endscript

script dadmod_menu_idleseq_kill
    KillSpawnedScript Name = dadmod_menu_idleseq0
    KillSpawnedScript Name = dadmod_menu_idleseq1
    KillSpawnedScript Name = dadmod_menu_idleseq2
    KillSpawnedScript Name = dadmod_menu_idleseq3
    KillSpawnedScript Name = dadmod_menu_idleseq4
    KillSpawnedScript Name = dadmod_menu_idleseq5
    KillSpawnedScript Name = dadmod_menu_idleseq6
    KillSpawnedScript Name = dadmod_menu_idleseq7
endscript

script dadmod_menu_idleseq0
    dadmod_menu_idleseq_loop n = 0
endscript

script dadmod_menu_idleseq5
    dadmod_menu_idleseq_loop n = 5
endscript

script dadmod_menu_idleseq6
    dadmod_menu_idleseq_loop n = 6
endscript

script dadmod_menu_idleseq7
    dadmod_menu_idleseq_loop n = 7
endscript

script dadmod_menu_idleseq1
    dadmod_menu_idleseq_loop n = 1
endscript

script dadmod_menu_idleseq2
    dadmod_menu_idleseq_loop n = 2
endscript

script dadmod_menu_idleseq3
    dadmod_menu_idleseq_loop n = 3
endscript

script dadmod_menu_idleseq4
    dadmod_menu_idleseq_loop n = 4
endscript

script dadmod_menu_idleseq_loop
    Obj_GetId
    dadmod_anim_seq_pieces n = <n>
    if not GotParam pieces
        return
    endif
    GetArraySize <pieces>
    if (<array_size> = 0)
        return
    endif
    i = 0
    begin
        e = ( <pieces> [ <i> ] )
        if AnimExists ( <e> . a )
            if ( ( <e> . c ) = 1 )
                <objID> : Obj_PlayAnim anim = ( <e> . a ) BlendPeriod = 0.3 cycle
            else
                <objID> : Obj_PlayAnim anim = ( <e> . a ) BlendPeriod = 0.3
            endif
        endif
        wait ( <e> . t ) seconds
        i = ( <i> + 1 )
        if (<i> = <array_size>)
            i = 0
        endif
    repeat
endscript

script thugpro_menu_pose_anims pose_hold = 0
    Obj_GetId
    if not AnimExists <pose_a1>
        return
    endif
    if (<pose_hold> = 1)
        <objID> : Obj_PlayAnim anim = <pose_a1>
        return
    endif
    begin
        <objID> : Obj_PlayAnim anim = <pose_a1>
        <objID> : Obj_WaitAnimFinished
        <objID> : Obj_PlayAnim anim = <pose_a2>
        <objID> : Obj_WaitAnimFinished
        <objID> : Obj_PlayAnim anim = <pose_a3>
        <objID> : Obj_WaitAnimFinished
        <objID> : Obj_PlayAnim anim = <pose_a4>
        <objID> : Obj_WaitAnimFinished
    repeat
endscript

script thugpro_mark_vec_text
    vx = ( <v> . (1.0,0.0,0.0) )
    vy = ( <v> . (0.0,1.0,0.0) )
    vz = ( <v> . (0.0,0.0,1.0) )
    FormatText TextName = vec_text "(%a, %b, %c)" a = <vx> b = <vy> c = <vz>
    return vec_text = <vec_text>
endscript

script thugpro_mark_show
    if ScreenElementExists id = thugpro_mark_text
        DestroyScreenElement id = thugpro_mark_text
    endif
    CreateScreenElement {
    Type = TextElement
    parent = root_window
    id = thugpro_mark_text
    font = dialog
    text = <text>
    Pos = (3.2e+02,6e+01)
    just = [ center center ]
    scale = 0.7
    rgba = [ 128 128 128 128 ]
    z_priority = 1000
    }
    wait 15 seconds
    if ScreenElementExists id = thugpro_mark_text
        DestroyScreenElement id = thugpro_mark_text
    endif
endscript

script thugpro_mark_menu_skater
    exit_quick_menu
    Skater : Obj_GetPosition
    Skater : Obj_GetOrientation
    dir = ( <x> * (1.0,0.0,0.0) + <y> * (0.0,1.0,0.0) + <z> * (0.0,0.0,1.0) )
    thugpro_mark_save kind = "spot" what = "MENU SKATER" Pos = <Pos> dir = <dir>
endscript

thugpro_freecam_shot = 0

thugpro_freecam_pos = (0.0,0.0,0.0)

thugpro_freecam_dir = (0.0,0.0,1.0)

script thugpro_freecam_track
    Change thugpro_freecam_shot = 0
    begin
        if not IsTrue view_mode
            break
        endif
        Change thugpro_freecam_shot = 1
        wait 1 gameframes
    repeat
endscript

script thugpro_freecam_quick_menu
    wait 2 gameframes
    thugpro_show_quick_menu
endscript

script thugpro_mark_menu_camera
    if not GotParam from_viewer
        exit_quick_menu
        if IsTrue thugpro_freecam_shot
            Change thugpro_freecam_shot = 0
            viewer_cam : Obj_GetPosition
            viewer_cam : Obj_GetOrientation
            dir = ( <x> * (1.0,0.0,0.0) + <y> * (0.0,1.0,0.0) + <z> * (0.0,0.0,1.0) )
            thugpro_mark_save kind = "camera" what = "FREE CAM SHOT" Pos = <Pos> dir = <dir>
            return
        endif
    endif
    if IsTrue view_mode
        viewer_cam : Obj_GetPosition
        viewer_cam : Obj_GetOrientation
    else
        skatercam0 : Obj_GetPosition
        skatercam0 : Obj_GetOrientation
    endif
    dir = ( <x> * (1.0,0.0,0.0) + <y> * (0.0,1.0,0.0) + <z> * (0.0,0.0,1.0) )
    thugpro_mark_save kind = "camera" what = "MENU CAMERA" Pos = <Pos> dir = <dir>
endscript

script dadmod_balance_get
    lvl = 1
    if THUGRECOMP_SettingLoad key = "balance_mode"
        lvl = <value>
    endif
    if ( <lvl> > 3 )
        lvl = 1
    endif
    if ( <lvl> < 0 )
        lvl = 1
    endif
    dadmod_balance_online
    if ( <online> = 1 )
        if ( <lvl> = 3 )
            lvl = 1
        endif
    endif
    return lvl = <lvl>
endscript

script dadmod_balance_text
    dadmod_balance_get
    switch <lvl>
    case 0
        t = "Easy"
    case 2
        t = "Sick"
    case 3
        t = "Infinite"
    default
        t = "Default"
    endswitch
    return balance_text = <t>
endscript

script dadmod_balance_stock
    Change GrindParams = ( GrindParams + { Lean_Gravity_Stat = { (0.02,0.02) STATS_RAILBALANCE #"switch" = standard_switch diff = LEAN_GRAVITY_DIFF } Instable_Rate = { (0.104,0.09) STATS_RAILBALANCE #"switch" = standard_switch } Instable_Base = { (1.0,1.0) STATS_RAILBALANCE #"switch" = standard_switch } Lean_Rnd_Speed = { (7.07,6.0) STATS_RAILBALANCE #"switch" = standard_switch limit = 6 } Lean_Acc = { (1e+01,1e+01) STATS_RAILBALANCE #"switch" = standard_switch diff = LEAN_ACC_DIFF } Lean_Min_Speed = { (5.0,5.0) STATS_RAILBALANCE #"switch" = standard_switch } } )
    Change ManualParams = ( ManualParams + { Lean_Gravity_Stat = { (0.02,0.02) diff = LEAN_GRAVITY_DIFF STATS_MANUAL #"switch" = standard_switch } Instable_Rate = { (0.099,0.07) STATS_MANUAL #"switch" = standard_switch diff = (0.5,2.0) } Instable_Base = { (1.0,1.0) STATS_MANUAL #"switch" = standard_switch } Lean_Rnd_Speed = { (2e+01,2e+01) STATS_MANUAL #"switch" = standard_switch } Lean_Acc = { (1e+01,1e+01) STATS_MANUAL #"switch" = standard_switch diff = LEAN_ACC_DIFF } Lean_Min_Speed = { (5.0,5.0) STATS_MANUAL #"switch" = standard_switch } } )
    Change LipParams = ( LipParams + { Lean_Gravity_Stat = { (0.02,0.02) STATS_LIPBALANCE #"switch" = standard_switch diff = LEAN_GRAVITY_DIFF } Instable_Rate = { (0.5,0.2) STATS_LIPBALANCE #"switch" = standard_switch } Instable_Base = { (1.0,1.0) STATS_LIPBALANCE #"switch" = standard_switch } Lean_Rnd_Speed = { (2e+01,2e+01) STATS_LIPBALANCE #"switch" = standard_switch } Lean_Acc = { (1e+01,1e+01) STATS_LIPBALANCE #"switch" = standard_switch diff = LEAN_ACC_DIFF } Lean_Min_Speed = { (1e+01,1e+01) STATS_LIPBALANCE #"switch" = standard_switch } } )
endscript

script dadmod_balance_apply
    dadmod_balance_stock
    dadmod_balance_get
    switch <lvl>
    case 0
        Change GrindParams = ( GrindParams + { Lean_Gravity_Stat = { (0.00002,0.00002) STATS_RAILBALANCE #"switch" = standard_switch } Lean_Acc = { (7.5,7.5) STATS_RAILBALANCE #"switch" = standard_switch } } )
        Change ManualParams = ( ManualParams + { Lean_Gravity_Stat = { (0.00002,0.00002) STATS_MANUAL #"switch" = standard_switch } Instable_Rate = { (0.0495,0.035) STATS_MANUAL #"switch" = standard_switch } Lean_Acc = { (7.5,7.5) STATS_MANUAL #"switch" = standard_switch } } )
        Change LipParams = ( LipParams + { Lean_Gravity_Stat = { (0.00002,0.00002) STATS_LIPBALANCE #"switch" = standard_switch } Lean_Acc = { (7.5,7.5) STATS_LIPBALANCE #"switch" = standard_switch } } )
    case 2
        Change ManualParams = ( ManualParams + { Instable_Rate = { (0.198,0.14) STATS_MANUAL #"switch" = standard_switch } } )
    case 3
        Change GrindParams = ( GrindParams + { Instable_Rate = { (0.0,0.0) STATS_RAILBALANCE #"switch" = standard_switch } Instable_Base = { (0.0,0.0) STATS_RAILBALANCE #"switch" = standard_switch } Lean_Gravity_Stat = { (0.0,0.0) STATS_RAILBALANCE #"switch" = standard_switch diff = LEAN_GRAVITY_DIFF } Lean_Rnd_Speed = { (0.0,0.0) STATS_RAILBALANCE #"switch" = standard_switch } } )
        Change ManualParams = ( ManualParams + { Instable_Rate = { (0.0,0.0) STATS_MANUAL #"switch" = standard_switch diff = (0.5,2.0) } Instable_Base = { (0.0,0.0) STATS_MANUAL #"switch" = standard_switch } Lean_Gravity_Stat = { (0.0,0.0) STATS_MANUAL #"switch" = standard_switch diff = LEAN_GRAVITY_DIFF } Lean_Rnd_Speed = { (0.0,0.0) STATS_MANUAL #"switch" = standard_switch } } )
        Change LipParams = ( LipParams + { Instable_Rate = { (0.0,0.0) STATS_LIPBALANCE #"switch" = standard_switch } Instable_Base = { (0.0,0.0) STATS_LIPBALANCE #"switch" = standard_switch } Lean_Gravity_Stat = { (0.0,0.0) STATS_LIPBALANCE #"switch" = standard_switch diff = LEAN_GRAVITY_DIFF } Lean_Rnd_Speed = { (0.0,0.0) STATS_LIPBALANCE #"switch" = standard_switch } } )
    endswitch
    dadmod_balance_flags
endscript

script dadmod_balance_flags
    dadmod_balance_get
    dadmod_balance_unflag
    if ( <lvl> = 3 )
        THUGRECOMP_SettingSave key = "gfx_balancelock" value = 1
    else
        THUGRECOMP_SettingSave key = "gfx_balancelock" value = 0
    endif
endscript

script dadmod_balance_unflag
    own = 0
    if THUGRECOMP_SettingLoad key = "bal_own_rail"
        own = <value>
    endif
    if ( <own> = 1 )
        UnSetGlobalFlag flag = CHEAT_PERFECT_RAIL
        THUGRECOMP_SettingSave key = "bal_own_rail" value = 0
    endif
    own = 0
    if THUGRECOMP_SettingLoad key = "bal_own_manual"
        own = <value>
    endif
    if ( <own> = 1 )
        UnSetGlobalFlag flag = CHEAT_PERFECT_MANUAL
        THUGRECOMP_SettingSave key = "bal_own_manual" value = 0
    endif
endscript

script dadmod_balance_cycle
    dadmod_balance_get
    if GotParam left
        lvl = ( <lvl> - 1 )
    else
        lvl = ( <lvl> + 1 )
    endif
    if ( <lvl> < 0 )
        lvl = 3
    endif
    if ( <lvl> > 3 )
        lvl = 0
    endif
    dadmod_balance_online
    if ( <online> = 1 )
        if ( <lvl> = 3 )
            if GotParam left
                lvl = 2
            else
                lvl = 0
            endif
        endif
    endif
    THUGRECOMP_SettingSave key = "balance_mode" value = <lvl>
    dadmod_balance_apply
    dadmod_balance_text
    thugpro_menu_item_update_extra_text id = dadmod_balance_item text = <balance_text>
endscript

script dadmod_pause_veh_noop
endscript

script dadmod_menu
    Change dadmod_anims_main = 0
    dialog_box_exit
    generic_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod
    menu_title = "dadmod"
    menu_style = MENU_STYLE_LEFT
    pad_back_script = create_pause_menu
    helper_text = generic_helper_text
    show_description_panel
    show_gradient
    boxed
    }
    make_thugpro_menu_item {
    text = "Gameplay  >"
    sub_label = "Gameplay"
    id = dadmod_pause_gameplay
    description_text = "Balance, player speed, bail cancel, bank drops and mirror mode"
    pad_choose_script = dadmod_pause_gameplay_menu
    }
    make_thugpro_menu_item {
    text = "Animations  >"
    sub_label = "Animations"
    id = dadmod_pause_anims
    description_text = "Play any skater animation on your skater"
    pad_choose_script = dadmod_anims_menu
    }
    make_thugpro_menu_item {
    text = "Throwables  >"
    sub_label = "Throwables"
    id = dadmod_pause_throw
    description_text = "Get ammo and throw stuff at people with Square, in any server. Everyone sees it"
    pad_choose_script = dadmod_throw_menu
    }
    make_thugpro_menu_item {
    text = "Sky & weather  >"
    sub_label = "Sky & weather"
    id = dadmod_pause_skywx
    description_text = "Sky, time of day, sky boost and weather"
    pad_choose_script = dadmod_pause_skywx_menu
    }
    make_thugpro_menu_item {
    text = "Sound  >"
    sub_label = "Sound"
    id = dadmod_pause_sound
    description_text = "Level sounds and special trick sounds"
    pad_choose_script = dadmod_pause_sound_menu
    }
    make_thugpro_menu_item {
    text = "Controls  >"
    sub_label = "Controls"
    id = dadmod_pause_controls
    description_text = "Background input, dead zone, button layout, popups and key and controller bindings"
    pad_choose_script = dadmod_pause_controls_menu
    }
    make_thugpro_menu_item {
    text = "Graphics  >"
    sub_label = "Graphics"
    id = dadmod_pause_gfx
    description_text = "Every graphics setting: display, effects, color, retro looks and more."
    pad_choose_script = dadmod_pause_graphics
    pad_choose_params = { from = dadmod }
    }
    make_thugpro_menu_item {
    text = "Set Main Menu Here"
    id = dadmod_pause_set_menu_here
    description_text = "Make this level the main menu, with your skater standing right here and the camera on their front"
    pad_choose_script = dadmod_set_menu_here
    }
    if GotParam focus_id
        thugpro_menu_finalize focus_target = <focus_id>
    else
        thugpro_menu_finalize
    endif
endscript

script dadmod_pause_sub_create
    dialog_box_exit
    generic_menu_cleanup
    thugpro_menu_create {
    menu_name = <name>
    menu_title = <title>
    menu_style = MENU_STYLE_LEFT
    pad_back_script = dadmod_menu
    pad_back_params = { focus_id = <back_id> }
    helper_text = generic_helper_text
    show_description_panel
    show_gradient
    boxed
    }
endscript

script dadmod_pause_gameplay_menu
    dadmod_pause_sub_create name = dadmod_gameplay title = "gameplay" back_id = dadmod_pause_gameplay
    dadmod_balance_text
    make_thugpro_menu_item {
    id = dadmod_balance_item
    text = "Balance"
    extra_text = <balance_text>
    description_text = "How hard grinds, manuals and lips are to balance, using the stock game's Easy and Sick balance. Default is the stock game; Infinite never tips. Only you."
    option_arrows_callback = dadmod_balance_cycle
    option_arrows
    pad_choose
    }
    dadmod_speed_text
    make_thugpro_menu_item {
    id = dadmod_speed_item
    text = "Player speed"
    extra_text = <speed_text>
    description_text = "1-4 slow motion, 5 normal, 6-10 a higher top speed that you build up to. Only you."
    option_arrows_callback = dadmod_speed_cycle
    option_arrows
    pad_choose
    }
    dadmod_sqget_text
    make_thugpro_menu_item {
    id = dadmod_sqget_item
    text = "Bail cancel"
    extra_text = <sqget_text>
    description_text = "When you bail, press Square to get straight back on your board. Only you; off in Firefight, King of the Hill and Capture the Flag."
    option_arrows_callback = dadmod_sqget_toggle
    option_arrows
    pad_choose
    }
    dadmod_bhra_text
    make_thugpro_menu_item {
    id = dadmod_bhra_keep_item
    text = "BHRA keeps combo"
    extra_text = <bhra_keep_text>
    description_text = "Bunny Hop Revert (BHRA): a hop then a revert in the air keeps your combo going. Only you."
    option_arrows_callback = dadmod_bhra_keep_toggle
    option_arrows
    pad_choose
    }
    make_thugpro_menu_item {
    id = dadmod_bhra_easy_item
    text = "Easy BHRA"
    extra_text = <bhra_easy_text>
    description_text = "Longer revert window around the hop, so Bunny Hop Reverts are easier to land. Only you."
    option_arrows_callback = dadmod_bhra_easy_toggle
    option_arrows
    pad_choose
    }
    dadmod_tsfx_text
    make_thugpro_menu_item {
    id = dadmod_tsfx_item
    text = "Trick Screen Effects"
    extra_text = <tsfx_text>
    description_text = "The full-screen effects of special tricks, like the 3D Scary Grind film look. Only your screen."
    option_arrows_callback = dadmod_tsfx_toggle
    option_arrows
    pad_choose
    }
    if THUGRECOMP_BankDropsOn
        bankdrop_text = "On"
    else
        bankdrop_text = "Off"
    endif
    make_thugpro_menu_item {
    id = bankdrop_toggle_id
    text = "Bank drops"
    extra_text = <bankdrop_text>
    description_text = ( Desc_Controls_BankDrop )
    option_arrows_callback = toggle_thugrecomp_bankdrops
    option_arrows
    pad_choose
    }
    dadmod_ui_item id = gfx_mirror_pause key = "gfx_mirror" label = "Mirror mode" kind = gfxlist min = 0 max = 1 def = 0 list = gfx_mirror desc = "Flips the 3D view left to right and swaps steering to match. Only your screen."
    thugpro_menu_finalize
endscript

script dadmod_pause_skywx_menu
    dadmod_pause_sub_create name = dadmod_skywx title = "sky & weather" back_id = dadmod_pause_skywx
    dadmod_ui_item id = gfx_galaxy_pause key = "gfx_galaxy" label = "Sky" kind = gfxlist min = 0 max = 14 def = 0 list = gfx_galaxy desc = "Swap the sky: galaxies, Matrix, aurora, synthwave, storm, black hole and more."
    dadmod_ui_item id = gfx_tod_pause key = "gfx_tod" label = "Time of day" kind = gfxlist min = 0 max = 6 def = 0 list = gfx_tod desc = "Level / server follows the level, or the server when one runs a day/night fade. Pick a time to use your own (only your screen), even when the server changes it."
    dadmod_ui_item id = gfx_skypop_pause key = "gfx_skypop" label = "Sky boost" kind = num min = 0 max = 10 def = 5 desc = "Richer sky colors to match the time of day, with stars at night."
    dadmod_ui_item id = gfx_skydef_pause key = "gfx_galaxy" label = "Default sky" kind = skyreset min = 0 max = 0 def = 0 desc = "Back to the level's own sky and time of day, sky boost 5."
    make_thugpro_menu_item {
    text = "Weather  >"
    sub_label = "Weather"
    id = dadmod_pause_wx
    description_text = "Rain, thunderstorms, snow, fog and fireworks"
    pad_choose_script = dadmod_pause_weather
    }
    if GotParam focus_id
        thugpro_menu_finalize focus_target = <focus_id>
    else
        thugpro_menu_finalize
    endif
endscript

script dadmod_pause_sound_menu
    dadmod_pause_sub_create name = dadmod_sound title = "sound" back_id = dadmod_pause_sound
    dadmod_ui_item id = gfx_levelsfx_pause key = "gfx_levelsfx" label = "Level sounds" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_levelsfx desc = "Water, crowds, machines and other sounds that come from spots in a map. Off silences them from the next map load."
    dadmod_ui_item id = gfx_tricksfx_pause key = "gfx_tricksfx" label = "Special trick sounds" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_tricksfx desc = "The sound clips some special tricks play, like the guitar grind. Off keeps them quiet."
    thugpro_menu_finalize
endscript

script dadmod_pause_controls_menu
    dadmod_pause_sub_create name = dadmod_controls title = "controls" back_id = dadmod_pause_controls
    dadmod_ui_item id = gfx_bginput_pause key = "gfx_bginput" label = "Background input" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_bginput desc = "On: controller works while another window is in front. Off: only when the game is in front."
    dadmod_ui_item id = gfx_deadzone_pause key = "gfx_deadzone" label = "Stick dead zone" kind = num min = 0 max = 10 def = 0 desc = "Ignores small stick moves so a worn stick stops drifting. 0 is off."
    dadmod_ui_item id = gfx_abswap_pause key = "gfx_abswap" label = "Swap A/B and X/Y" kind = gfxlist min = 0 max = 1 def = 0 list = gfx_abswap desc = "For Nintendo-style pads: swaps A with B and X with Y to match the labels."
    dadmod_ui_item id = gfx_launchbinds_pause key = "gfx_launchbinds" label = "Use launcher button layout" kind = gfxlist min = 0 max = 1 def = 0 list = gfx_launchbinds desc = "On: the bindings set in the THUG Pro launcher. Off: the Xbox-style layout."
    dadmod_ui_item id = gfx_padpopup_pause key = "gfx_padpopup" label = "Controller popups" kind = gfxlist min = 0 max = 1 def = 1 list = gfx_padpopup desc = "Shows a short message when a controller is plugged in or unplugged."
    make_thugpro_menu_item {
    text = "Keyboard bindings  >"
    id = dadmod_pause_bindkb
    description_text = "Change which key does what while skating. Changes apply right away."
    pad_choose_script = dadmod_binds_menu
    pad_choose_params = { dev = 0 from = 1 }
    }
    make_thugpro_menu_item {
    text = "Controller bindings  >"
    id = dadmod_pause_bindpad
    description_text = "Change which controller button does what. Changes apply right away."
    pad_choose_script = dadmod_binds_menu
    pad_choose_params = { dev = 1 from = 1 }
    }
    if GotParam focus_id
        thugpro_menu_finalize focus_target = <focus_id>
    else
        thugpro_menu_finalize
    endif
endscript

