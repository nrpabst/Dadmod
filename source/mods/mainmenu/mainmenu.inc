struct LayChild { int type; std::string key, label, desc; bool grey, hide; int child; };
struct LayNode { std::string title; int parent; std::vector<LayChild> kids; };
static std::vector<LayNode> g_lay;

static void LoadLayout() {
    std::string path = ExeDirFile("dadmod_layout.txt"), data;
    if (!ReadWholeFile(path, data) || data.find('|') == std::string::npos) {
        data = kLayoutDefault;
        WriteWholeFile(path, data);
    }
    // 2026-11-19: layouts saved before the ReShade row existed get it as the first Graphics row (the row only shows
    // when ReShade is loaded). The old file is kept in dadmod\backups.
    if (data.find("|gfx_postfx|") == std::string::npos) {
        size_t g = data.find("menu||Graphics||");
        if (g != std::string::npos) {
            size_t ls = data.rfind('\n', g); ls = ls == std::string::npos ? 0 : ls + 1;
            size_t le = data.find('\n', g);
            if (le != std::string::npos) {
                std::string indent(g - ls, ' ');
                CreateDirectoryA(ExeDirFile("backups").c_str(), nullptr);
                WriteWholeFile(ExeDirFile("backups\\dadmod_layout.txt.before_reshade_row"), data);
                bool crlf = le > 0 && data[le - 1] == '\r';
                data.insert(le + 1, indent + "  item|gfx_postfx|||" + (crlf ? "\r\n" : "\n"));
                WriteWholeFile(path, data);
                Log("layout: added the ReShade row (gfx_postfx) to the Graphics menu");
            }
        }
    }
    // 2026-11-22: Time of day is the first Sky & weather row (Noah). A layout still in the old default order
    // (Sky, Fog, Fog intensity, Time of day) gets the Time of day line moved to the top. The old file is kept in dadmod\\backups.
    {
        size_t g = data.find("|gfx_galaxy|"), t = data.find("|gfx_tod|");
        if (g != std::string::npos && t != std::string::npos && t > g) {
            size_t gs = data.rfind('\n', g); gs = gs == std::string::npos ? 0 : gs + 1;
            size_t ts = data.rfind('\n', t); ts = ts == std::string::npos ? 0 : ts + 1;
            size_t te = data.find('\n', t); te = te == std::string::npos ? data.size() : te + 1;
            std::string between = data.substr(gs, ts - gs);
            if (between.find("|gfx_todfog|") != std::string::npos && between.find("|gfx_fogamt|") != std::string::npos &&
                std::count(between.begin(), between.end(), '\n') == 3) {
                std::string tl = data.substr(ts, te - ts);
                if (tl.empty() || tl.back() != '\n') tl += (data.find("\r\n") != std::string::npos ? "\r\n" : "\n");
                CreateDirectoryA(ExeDirFile("backups").c_str(), nullptr);
                WriteWholeFile(ExeDirFile("backups\\dadmod_layout.txt.before_tod_top"), data);
                data.erase(ts, te - ts);
                data.insert(gs, tl);
                WriteWholeFile(path, data);
                Log("layout: moved Time of day to the top of Sky & weather");
            }
        }
    }
    // 2026-11-23: the Fog and Fog intensity rows are gone (fog is a Weather choice, Intensity covers it): drop their lines
    {
        bool cut = false;
        std::string out;
        size_t s0 = 0;
        while (s0 < data.size()) {
            size_t e = data.find('\n', s0);
            size_t n = e == std::string::npos ? data.size() : e + 1;
            std::string line = data.substr(s0, n - s0);
            if (line.find("item|gfx_todfog|") != std::string::npos || line.find("item|gfx_fogamt|") != std::string::npos) cut = true;
            else out += line;
            s0 = n;
        }
        if (cut) {
            CreateDirectoryA(ExeDirFile("backups").c_str(), nullptr);
            WriteWholeFile(ExeDirFile("backups\\dadmod_layout.txt.before_wx_rows"), data);
            data = out;
            WriteWholeFile(path, data);
            Log("layout: removed the old Fog rows from Sky & weather");
        }
    }
    g_lay.clear();
    LayNode root; root.title = "Dadmod"; root.parent = -1;
    g_lay.push_back(root);
    std::vector<int> stack(1, 0);  // node id per depth
    size_t s = 0;
    while (s < data.size()) {
        size_t e = data.find('\n', s);
        std::string line = data.substr(s, e == std::string::npos ? std::string::npos : e - s);
        s = e == std::string::npos ? data.size() : e + 1;
        if (!line.empty() && line.back() == '\r') line.pop_back();
        size_t ind = line.find_first_not_of(' ');
        if (ind == std::string::npos || line[ind] == '#') continue;
        int depth = (int)ind / 2;
        std::vector<std::string> f;
        size_t a = ind;
        for (;;) { size_t b = line.find('|', a); f.push_back(line.substr(a, b == std::string::npos ? std::string::npos : b - a)); if (b == std::string::npos) break; a = b + 1; }
        while (f.size() < 5) f.push_back("");
        if ((int)stack.size() > depth + 1) stack.resize(depth + 1);
        if ((int)stack.size() < depth + 1) depth = (int)stack.size() - 1;  // over-indented: hang it on the deepest menu
        LayChild c;
        std::string t = Lower(Trim(f[0]));
        c.type = t == "menu" ? 0 : t == "item" ? 1 : t == "label" ? 2 : t == "sep" ? 3 : -1;
        if (c.type < 0) continue;
        c.key = Trim(f[1]); c.label = Trim(f[2]); c.grey = Lower(f[3]).find("grey") != std::string::npos; c.hide = Lower(f[3]).find("hide") != std::string::npos; c.desc = Trim(f[4]);
        c.child = -1;
        int parent = stack[depth];
        if (c.type == 0) {
            LayNode n; n.title = c.label.empty() ? "Menu" : c.label; n.parent = parent;
            c.child = (int)g_lay.size();
            g_lay.push_back(n);
            g_lay[parent].kids.push_back(c);
            stack.push_back(c.child);
        } else {
            g_lay[parent].kids.push_back(c);
        }
    }
}

static bool __cdecl CF_LayoutInfo(void* params, void* script) {
    int node = IntParam(params, "node", 0);
    if (node == 0 || g_lay.empty()) LoadLayout();
    if (node < 0 || node >= (int)g_lay.size()) node = 0;
    RetStr(script, "title", g_lay[node].title.c_str());
    RetInt(script, "count", (int)g_lay[node].kids.size());
    RetInt(script, "parent", g_lay[node].parent);
    RetInt(script, "node", node);
    return true;
}

static bool __cdecl CF_LayoutChild(void* params, void* script) {
    int node = IntParam(params, "node", 0), i = IntParam(params, "index", 0);
    if (g_lay.empty()) LoadLayout();
    if (node < 0 || node >= (int)g_lay.size() || i < 0 || i >= (int)g_lay[node].kids.size()) return false;
    const LayChild& c = g_lay[node].kids[i];
    RetInt(script, "type", c.type);
    RetStr(script, "key", c.key.c_str());
    RetStr(script, "label", c.label.c_str());
    RetStr(script, "desc", c.desc.c_str());
    RetInt(script, "grey", c.grey ? 1 : 0);
    RetInt(script, "hide", c.hide ? 1 : 0);
    RetInt(script, "child", c.child);
    return true;
}

// ---- reorder / grey / hide any THUG Pro menu (menu_order.txt, edited in THUGPro Manager > Dadmod Menus)
// Every option made by make_thugpro_menu_item is reported (THUGRECOMP_MenuSeen) and listed per menu in
// menu_items_seen.txt so the Manager knows what each menu contains. A menu with a section in
// menu_order.txt is built in that order: the item script parks each option (THUGRECOMP_CapturePush) and
// thugpro_menu_finalize replays them (THUGRECOMP_CaptureNext). Options not in the file keep their place at
// the end, so nothing disappears.
//   [menu_name]            (the name given to thugpro_menu_create, e.g. startup, game_pause)
//   text|flags             flags: grey, hide
static const DWORD kGetChecksumM = 0x476950;  // bool __thiscall CStruct::GetChecksum(DWORD key, DWORD*, bool)
static DWORD ChecksumParam(void* params, const char* key) {
    DWORD v = 0;
    typedef bool (__thiscall* Fn)(void*, DWORD, DWORD*, bool);
    ((Fn)kGetChecksumM)(params, QbKey(key), &v, false);
    return v;
}
static std::string StripCodes(const char* t) {
    std::string s;
    for (const char* p = t; *p; ++p) {
        if (p[0] == '\\' && (p[1] == 'c' || p[1] == 'C') && p[2]) { p += 2; continue; }
        s += *p;
    }
    return Trim(s);
}
struct OrderEntry { std::string text; bool grey, hide; };
static std::map<DWORD, std::vector<OrderEntry>> g_order;   // anchor checksum (<name>_menu) -> order
static DWORD g_orderStamp;
static void LoadMenuOrder() {
    DWORD now = GetTickCount();
    if (g_orderStamp && now - g_orderStamp < 500) return;  // re-read at most twice a second
    g_orderStamp = now;
    g_order.clear();
    std::string data;
    if (!ReadWholeFile(ExeDirFile("menu_order.txt"), data)) return;
    DWORD cur = 0;
    size_t s = 0;
    while (s < data.size()) {
        size_t e = data.find('\n', s);
        std::string line = Trim(data.substr(s, e == std::string::npos ? std::string::npos : e - s));
        s = e == std::string::npos ? data.size() : e + 1;
        if (line.empty() || line[0] == '#') continue;
        if (line[0] == '[') {
            std::string name = Trim(line.substr(1, line.find(']') == std::string::npos ? std::string::npos : line.find(']') - 1));
            cur = name[0] == '#' ? strtoul(name.c_str() + 1, nullptr, 16) : QbKey((name + "_menu").c_str());
            g_order[cur];
            continue;
        }
        if (!cur) continue;
        size_t bar = line.rfind('|');
        OrderEntry o;
        o.text = Lower(Trim(bar == std::string::npos ? line : line.substr(0, bar)));
        std::string fl = bar == std::string::npos ? "" : Lower(line.substr(bar + 1));
        o.grey = fl.find("grey") != std::string::npos;
        o.hide = fl.find("hide") != std::string::npos;
        g_order[cur].push_back(o);
    }
}

// what has been seen, per menu (checksum -> texts in build order)
static std::map<DWORD, std::vector<std::string>> g_seen;
static bool g_seenLoaded;
static void SaveSeen() {
    std::string out = "# Menus and their options as the game built them (written by the game; read by THUGPro Manager)\r\n";
    for (auto& m : g_seen) {
        char h[16]; sprintf(h, "[%08x]\r\n", m.first);
        out += h;
        for (auto& t : m.second) out += t + "\r\n";
    }
    WriteWholeFile(ExeDirFile("menu_items_seen.txt"), out);
}
static void LoadSeen() {
    g_seenLoaded = true;
    std::string data;
    if (!ReadWholeFile(ExeDirFile("menu_items_seen.txt"), data)) return;
    DWORD cur = 0;
    size_t s = 0;
    while (s < data.size()) {
        size_t e = data.find('\n', s);
        std::string line = Trim(data.substr(s, e == std::string::npos ? std::string::npos : e - s));
        s = e == std::string::npos ? data.size() : e + 1;
        if (line.empty() || line[0] == '#') continue;
        if (line[0] == '[') { cur = strtoul(line.c_str() + 1, nullptr, 16); g_seen[cur]; continue; }
        if (cur) g_seen[cur].push_back(line);
    }
}
// THUGRECOMP_MenuSeen menu=<anchor checksum> text="..."
static bool __cdecl CF_MenuSeen(void* params, void*) {
    DWORD menu = ChecksumParam(params, "menu");
    const char* text = nullptr;
    GetStringParam(params, "text", &text);
    if (!menu || !text) return true;
    std::string t = StripCodes(text);
    if (t.empty()) return true;
    {   // the Edit Skater part list (one menu for head, torso, legs, deck...): its first option says which
        static DWORD s_last, s_lastAt;
        DWORD now = GetTickCount();
        if (menu == 0x6ce9ed8f && (s_last != menu || now - s_lastAt > 300)) {
            std::string f = Lower(t);
            g_optCtx = f == "face" ? CTX_HEAD : f == "shirt style" || f == "head tattoo" ? CTX_TORSO : f == "pants" ? CTX_LEGS :
                       f == "board type" ? CTX_BOARD : CTX_EDIT;
        }
        s_last = menu; s_lastAt = now;
    }
    if (!g_seenLoaded) LoadSeen();
    auto& v = g_seen[menu];
    for (auto& x : v) if (Lower(x) == Lower(t)) return true;
    v.push_back(t);
    SaveSeen();
    return true;
}
// THUGRECOMP_MenuHasOrder menu=<anchor> -> true when menu_order.txt has a section for it
static bool __cdecl CF_MenuHasOrder(void* params, void*) {
    LoadMenuOrder();
    return g_order.count(ChecksumParam(params, "menu")) != 0;
}
struct Captured { DWORD id; std::string text; };
static std::vector<Captured> g_cap;
static std::vector<int> g_capOrder;
static size_t g_capNext;
static DWORD g_capMenu;
// THUGRECOMP_CapturePush id=<holder> text="..."
static bool __cdecl CF_CapturePush(void* params, void*) {
    Captured c; c.id = ChecksumParam(params, "id");
    const char* text = nullptr; GetStringParam(params, "text", &text);
    c.text = text ? Lower(StripCodes(text)) : "";
    g_cap.push_back(c);
    g_capOrder.clear();
    return true;
}
// THUGRECOMP_CaptureNext menu=<anchor> -> id, grey, hide for the next option to build; false when done
static bool __cdecl CF_CaptureNext(void* params, void* script) {
    DWORD menu = ChecksumParam(params, "menu");
    if (g_capOrder.empty() || menu != g_capMenu) {
        g_capMenu = menu; g_capNext = 0; g_capOrder.clear();
        LoadMenuOrder();
        std::vector<bool> used(g_cap.size(), false);
        auto it = g_order.find(menu);
        if (it != g_order.end())
            for (auto& o : it->second)
                for (size_t i = 0; i < g_cap.size(); ++i)
                    if (!used[i] && !g_cap[i].text.empty() && g_cap[i].text == o.text) { used[i] = true; g_capOrder.push_back((int)i); break; }
        for (size_t i = 0; i < g_cap.size(); ++i) if (!used[i]) g_capOrder.push_back((int)i);
    }
    if (g_capNext >= g_capOrder.size()) { g_cap.clear(); g_capOrder.clear(); return false; }
    const Captured& c = g_cap[g_capOrder[g_capNext++]];
    bool grey = false, hide = false;
    auto it = g_order.find(menu);
    if (it != g_order.end()) for (auto& o : it->second) if (o.text == c.text) { grey = o.grey; hide = o.hide; break; }
    if (hide) {  // never hide everything: if no option would stay visible, ignore hiding for this menu
        bool anyShown = false;
        for (auto& x : g_cap) {
            bool h = false;
            if (it != g_order.end()) for (auto& o : it->second) if (o.text == x.text) { h = o.hide; break; }
            if (!h) { anyShown = true; break; }
        }
        if (!anyShown) hide = false;
    }
    typedef void (__thiscall* Fn)(void*, DWORD, DWORD);
    void* sp = *(void**)((char*)script + 0x14);
    if (sp) ((Fn)kAddChecksum)(sp, QbKey("id"), c.id);
    RetInt(script, "grey", grey ? 1 : 0);
    RetInt(script, "hide", hide ? 1 : 0);
    RetInt(script, "stock", g_capOrder[g_capNext - 1]);   // its place in the stock build order (menu reorder reset)
    return true;
}
// THUGRECOMP_CaptureClear: drop anything parked (a menu was abandoned before finalize)
static bool __cdecl CF_CaptureClear(void*, void*) { g_cap.clear(); g_capOrder.clear(); return true; }

// ---- reorder any menu in game (Noah 2026-11-19: "the menu reorder found in main menu to work in every single menu")
// F9 in a menu puts it in move mode (QB: menuitem.q dadmod_reorder_*); every move saves the menu's new order as a
// "[#<anchor checksum>]" section of menu_order.txt, which the capture/replay above applies whenever the menu is built.
// Undo (F10) puts the section back as it was before the last change; reset (F12) removes it (stock order).
static DWORD g_roMenu;
static std::vector<std::string> g_roTexts;
static std::map<DWORD, std::vector<std::string>> g_roUndo;   // menu -> earlier sections (text block, "" = none)
static bool SectionKeyIs(const std::string& header, DWORD menu) {
    std::string name = Trim(header.substr(1, header.find(']') == std::string::npos ? std::string::npos : header.find(']') - 1));
    if (name.empty()) return false;
    DWORD k = name[0] == '#' ? strtoul(name.c_str() + 1, nullptr, 16) : QbKey((name + "_menu").c_str());
    return k == menu;
}
// splits menu_order.txt into everything but the menu's section(s) (rest) and that section's lines (block)
static void SplitOrderFile(DWORD menu, std::string& rest, std::string& block) {
    std::string data;
    ReadWholeFile(ExeDirFile("menu_order.txt"), data);
    rest.clear(); block.clear();
    bool in = false;
    size_t s = 0;
    while (s < data.size()) {
        size_t e = data.find('\n', s);
        std::string raw = data.substr(s, e == std::string::npos ? std::string::npos : e - s + 1);
        s = e == std::string::npos ? data.size() : e + 1;
        std::string line = Trim(raw);
        if (!line.empty() && line[0] == '[') in = SectionKeyIs(line, menu);
        (in ? block : rest) += raw;
    }
    if (!rest.empty() && rest.back() != '\n') rest += "\r\n";
}
static void WriteOrderFile(const std::string& data) {
    WriteWholeFile(ExeDirFile("menu_order.txt"), data);
    g_orderStamp = 0;   // re-read on the next menu build
}
// THUGRECOMP_ReorderBegin menu=<anchor> / ReorderAdd text="..." / ReorderSave -> the menu's options in the new order
static bool __cdecl CF_ReorderBegin(void* params, void*) { g_roMenu = ChecksumParam(params, "menu"); g_roTexts.clear(); return g_roMenu != 0; }
static bool __cdecl CF_ReorderAdd(void* params, void*) {
    const char* text = nullptr; GetStringParam(params, "text", &text);
    g_roTexts.push_back(text ? StripCodes(text) : "");
    return true;
}
static bool __cdecl CF_ReorderSave(void*, void*) {
    if (!g_roMenu) return false;
    std::string rest, block;
    SplitOrderFile(g_roMenu, rest, block);
    LoadMenuOrder();
    std::map<std::string, std::string> flags;   // keep grey/hide marks the Manager set
    auto it = g_order.find(g_roMenu);
    if (it != g_order.end()) for (auto& o : it->second) flags[o.text] = std::string(o.grey ? "grey" : "") + (o.grey && o.hide ? "," : "") + (o.hide ? "hide" : "");
    char h[32]; sprintf(h, "[#%08x]\r\n", g_roMenu);
    std::string sec = h;
    for (auto& t : g_roTexts) {
        if (t.empty()) continue;
        auto f = flags.find(Lower(t));
        sec += t + "|" + (f != flags.end() ? f->second : "") + "\r\n";
    }
    if (it != g_order.end())   // options the Manager hid are not on screen: keep them (still hidden) at the end
        for (auto& o : it->second) {
            if (!o.hide) continue;
            bool listed = false;
            for (auto& t : g_roTexts) if (Lower(t) == o.text) listed = true;
            if (!listed) sec += o.text + "|" + flags[o.text] + "\r\n";
        }
    g_roUndo[g_roMenu].push_back(block);
    WriteOrderFile(rest + sec);
    Log("menu order: saved %d options for menu %08x", (int)g_roTexts.size(), g_roMenu);
    return true;
}
// The order shown while moving: position -> index of the option's kept copy (dadmod_keep_<i>, in build order)
static DWORD g_permMenu;
static std::vector<int> g_perm;
static std::vector<std::vector<int>> g_permUndo;
// THUGRECOMP_ReorderPermInit menu=<anchor> count=N [fresh=1]   (keeps the current order when it is the same menu)
static bool __cdecl CF_ReorderPermInit(void* params, void*) {
    DWORD menu = ChecksumParam(params, "menu");
    int n = IntParam(params, "count", 0);
    if (IntParam(params, "fresh", 0) || menu != g_permMenu || (int)g_perm.size() != n) {   // fresh: entering move mode (the menu is built in its saved order)
        g_permMenu = menu; g_perm.clear(); g_permUndo.clear();
        for (int i = 0; i < n; ++i) g_perm.push_back(i);
    }
    return n > 0;
}
// THUGRECOMP_ReorderPermAt pos=i -> idx
static bool __cdecl CF_ReorderPermAt(void* params, void* script) {
    int p = IntParam(params, "pos", -1);
    if (p < 0 || p >= (int)g_perm.size()) return false;
    RetInt(script, "idx", g_perm[p]);
    return true;
}
// THUGRECOMP_ReorderPermMove from=i to=j  (undoable)
static bool __cdecl CF_ReorderPermMove(void* params, void*) {
    int f = IntParam(params, "from", -1), t = IntParam(params, "to", -1), n = (int)g_perm.size();
    if (f < 0 || t < 0 || f >= n || t >= n || f == t) return false;
    g_permUndo.push_back(g_perm);
    int v = g_perm[f];
    g_perm.erase(g_perm.begin() + f);
    g_perm.insert(g_perm.begin() + t, v);
    return true;
}
// THUGRECOMP_ReorderPermPush (before a reset)  /  THUGRECOMP_ReorderPermSet pos=i idx=k
static bool __cdecl CF_ReorderPermPush(void*, void*) { g_permUndo.push_back(g_perm); return true; }
static bool __cdecl CF_ReorderPermSet(void* params, void*) {
    int p = IntParam(params, "pos", -1), k = IntParam(params, "idx", -1);
    if (p < 0 || p >= (int)g_perm.size()) return false;
    g_perm[p] = k;
    return true;
}
// THUGRECOMP_ReorderUndo menu=<anchor> -> false when there is nothing to undo
static bool __cdecl CF_ReorderUndo(void* params, void*) {
    DWORD menu = ChecksumParam(params, "menu");
    if (menu == g_permMenu && !g_permUndo.empty()) { g_perm = g_permUndo.back(); g_permUndo.pop_back(); }
    auto& u = g_roUndo[menu];
    if (u.empty()) return false;
    std::string rest, block;
    SplitOrderFile(menu, rest, block);
    WriteOrderFile(rest + u.back());
    u.pop_back();
    Log("menu order: undid the last change for menu %08x", menu);
    return true;
}
// THUGRECOMP_ReorderReset menu=<anchor> -> removes the menu's section (stock order; undoable); false when it had none
static bool __cdecl CF_ReorderReset(void* params, void*) {
    DWORD menu = ChecksumParam(params, "menu");
    std::string rest, block;
    SplitOrderFile(menu, rest, block);
    if (block.empty()) return false;
    g_roUndo[menu].push_back(block);
    WriteOrderFile(rest);
    Log("menu order: menu %08x back to its stock order", menu);
    return true;
}

// THUGRECOMP_MenuFavAnim anim=<checksum> [toggle=1] [refresh=1] -> true when it is a main menu favorite (after the
// toggle); count = how many are starred. Pause > dadmod > Animations stars them; Skater pose cycles them.
static bool __cdecl CF_MenuFavAnim(void* params, void* script) {
    if (IntParam(params, "refresh", 0) || IntParam(params, "toggle", 0) || g_cfg.poseList.empty()) LoadConfig();
    DWORD ck = ChecksumParam(params, "anim");
    static std::map<DWORD, int> s_byKey;  // the menu asks for every animation in a list: look them up once
    if (s_byKey.empty()) for (int i = 0; i < kAnimCount; ++i) s_byKey[QbKey(kAnims[i].name)] = i;
    auto hit = s_byKey.find(ck);
    const char* name = ck && hit != s_byKey.end() ? kAnims[hit->second].name : nullptr;
    static char s_seqName[16];
    int seq = IntParam(params, "seq", -1);  // seq=<n>: an idle loop sequence (Animations > Idle loops)
    if (seq >= 0 && seq < kSeqCount) { sprintf(s_seqName, "idleseq%d", seq); name = s_seqName; }
    bool fav = name && IsFav(name);
    // single_hide=1: the picker is choosing a Single Animation, so no ticks are shown
    if (IntParam(params, "single_hide", 0) && !IntParam(params, "toggle", 0) && !IntParam(params, "single", 0)) {
        RetInt(script, "count", (int)g_cfg.favs.size());
        return false;
    }
    // single=1 label="<menu text>": Pose mode Single Animation plays this one (Noah 2026-11-17)
    if (name && IntParam(params, "single", 0)) {
        const char* label = nullptr;
        GetStringParam(params, "label", &label);
        SetMenuValue("pose_one", name);
        SetMenuValue("pose_one_label", label ? label : name);
        SetMenuValue("pose_mode", "one");
        LoadConfig();
        g_poseDue = true;
        Log("main menu single animation: %s", name);
        RetInt(script, "count", (int)g_cfg.favs.size());
        return true;
    }
    if (name && IntParam(params, "toggle", 0)) {
        if (fav) { for (size_t i = 0; i < g_cfg.favs.size(); ++i) if (!_stricmp(g_cfg.favs[i].c_str(), name)) { g_cfg.favs.erase(g_cfg.favs.begin() + i); break; } }
        else g_cfg.favs.push_back(name);
        SaveFavs();
        LoadConfig();
        fav = !fav;
        g_poseDue = true;
        Log("%s main menu favorite: %s", fav ? "added" : "removed", name);
    }
    RetInt(script, "count", (int)g_cfg.favs.size());
    return fav;
}

