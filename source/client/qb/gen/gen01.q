script handle_start_pressed
    root_window : GetTags
    if not ( thugpro_observe_hud_visible )
        Change thugpro_observe_hud_visible = 0
        thugpro_observe_toggle_hud
        Change thugpro_observe_hud_visible = 1
    endif
    if ( is_changing_levels = 1 )
        return
    endif
    if LevelIs Load_MainMenu
        return
    endif
    if InNetGame
        THUGPROResetViewer
    else
        THUGPROResetViewer unfreeze
    endif
    if ChecksumEquals a = <menu_state> b = on
        if GotParam pause_controller
            if not ( <pause_controller> = -1 )
                if not ( <device_num> = <pause_controller> )
                    return
                endif
            endif
        endif
        if not InNetGame
            UnpauseGame
        endif
        exit_pause_menu
        Change inside_pause = 0
    endif
    if ChecksumEquals a = <menu_state> b = off
        Change viewer_buttons_enabled = 0
        if not InMultiplayergame
            if not ControllerBoundToSkater controller = <device_num> Skater = 0
                return
            endif
        else
            if InSplitScreenGame
                if not ControllerBoundToSkater controller = <device_num> Skater = 0
                    if not ControllerBoundToSkater controller = <device_num> Skater = 1
                        return
                    endif
                endif
            endif
        endif
        SetTags pause_controller = <device_num>
        possibly_remove_temp_special_trick
        KillSpawnedScript Name = goal_accept_trigger
        if not InNetGame
            GetSkaterId
            if GetSkaterCamAnimParams Skater = <objID>
                if ( <allow_pause> = 0 )
                    return
                endif
            endif
            dadmod_freeskate_menu_live
            if ( <dadmod_fs_live> = 1 )
                if ObjectExists id = Skater
                    Skater : NetDisablePlayerInput
                endif
            else
                printf "-------------------- PAUSING GAME ----------------------"
                PauseGame
                GoalManager_PauseAllGoals
            endif
            wait 1 gameframe
        endif
        set_pause_menu_allow_continue
        create_pause_menu device_num = <device_num> from_start
    endif
endscript

script dadmod_freeskate_menu_live
    dadmod_fs_live = 0
    if not InNetGame
        if not InSplitScreenGame
            if GameModeEquals is_singlesession
                dadmod_fs_live = 1
            endif
            if GameModeEquals is_freeskate
                dadmod_fs_live = 1
            endif
            if CustomParkMode editing
                dadmod_fs_live = 0
            endif
            if CustomParkMode testing
                dadmod_fs_live = 0
            endif
            if GoalManager_HasActiveGoals
                dadmod_fs_live = 0
            endif
        endif
    endif
    return dadmod_fs_live = <dadmod_fs_live>
endscript

script level_select_change_level
    if InNetGame
        if ( thugpro_mapvote_active = 1 )
            if not ( <level> = Load_MainMenu )
                create_net_panel_message text = "Map vote running" msg_time = 3000
                return
            endif
        endif
    endif
    if GetGlobalFlag flag = FLAG_AUTO_SERVER_MODE
        AutoServer_Destroy_Timer
        if ( AutoServer_PausedTimer = 1 )
            Change AutoServer_PausedTimer = 0
        endif
    endif
    GoalManager_ShowPoints
    if not GoalManager_HasActiveGoals
        GoalManager_ShowGoalPoints
    endif
    DestroyIfObjectExist id = level_select_anchor
    DestroyIfObjectExist id = current_menu_anchor
    if LevelIs load_sk5ed
        load_parked_textures_to_main_memory unload
    endif
    if LevelIs Load_MainMenu
        SetColorBufferClear clear = 0
    endif
    if LevelIs load_sk5ed_gameplay
        raileditor : DestroyEditedRailSectors DoNotUpdateSuperSectors
    endif
    if InNetGame
        show_warning = 1
    endif
    if IsCustomPark
        really_change_level <...>
    else
        if not LevelIs <level>
            really_change_level <...>
        else
            if GotParam chose_same_level_script
                <chose_same_level_script>
            else
                if root_window : GetSingleTag no_exit_pause_menu
                    THUGPRO_LevelSelect_menu_exit
                    return
                endif
                if GotParam end_run
                    THUGPRO_LevelSelect_menu_exit end_run
                    return
                endif
                if InSplitScreenGame
                    THUGPRO_LevelSelect_menu_exit end_run
                    return
                endif
            endif
        endif
    endif
    THUGPRO_LevelSelect_menu_exit no_new_menu
    if InNetGame
        if OnServer
            exit_pause_menu NetServerChangeLevelMUSICFix
        endif
    else
        exit_pause_menu
    endif
endscript

script level_select_valid_choice
    if GotParam level
        array = level_select_last_level_played
        SetArrayElement arrayname = array index = 0 newvalue = <level>
    endif
    if GotParam filename
        GetCustomParkName
        if not ( <filename> = <Name> )
            if LoadFromMemoryCard Name = <filename> Type = Park
            else
                return
            endif
        endif
    endif
    GetTags
    if GotParam dadmod_pauserow
        return
    endif
    if GotParam level_callback_script
        <level_callback_script> <...>
    endif
endscript

script select_skater_menu_back
    if IsInternetGameHost
        QuitGame
        return
    endif
    if IsJoiningInternetGame
        QuitGame
        return
    endif
    if ObjectExists id = select_skater_anchor
        DestroyScreenElement id = select_skater_anchor
        restore_start_key_binding
    endif
    thugpro_orient_menu_skater
    Skater : CancelRotateDisplay
    FakeLights Percent = 100 prefix = TRG_TR_Level_Light
    Skater : SetTags stopskateshopstreams = 1
    <callback> from_skater_select
endscript

script new_select_skater_hmenu_focus
    thugpro_orient_menu_skater
    if ( LAST_SELECTED_SKATER_MENU_ID = <new_name> )
        first_time_in_focus = 1
    endif
    Change LAST_SELECTED_SKATER_MENU_ID = <new_name>
    GetTags
    DoScreenElementMorph {
    id = <id>
    rgba = ( MENU_SS_SKATER_INDICATOR_FOCUS_COLOR )
    time = 0.2
    }
    <stored_display_name> = <display_name>
    if GotParam no_board
        Change LAST_SELECTED_SKATER_HIDE_BOARD = 1
    else
        Change LAST_SELECTED_SKATER_HIDE_BOARD = 0
    endif
    if GotParam skater_behavior_script
        if not GotParam first_time_in_focus
            SpawnSkaterScript SkateshopBehaviorSpawner params = { script_name = <skater_behavior_script> }
        endif
    else
        if not GotParam first_time_in_focus
            ResetLastSkaterBehaviorStuff
            SpawnSkaterScript SkateshopBehavior
        endif
    endif
    GetCurrentSkaterProfileIndex
    switch <Name>
    case ped
        load_other_skater { profile = <currentSkaterProfileIndex> Skater = 0 <...> }
    default
        load_pro_skater { profile = <currentSkaterProfileIndex> Skater = 0 <...> }
    endswitch
    if ScreenElementExists id = stats_block_menu_anchor
        DestroyScreenElement id = stats_block_menu_anchor
    endif
    if not GameModeEquals is_net
        create_thugpro_style_test_menu_stats no_animate
        GetSkaterProfileInfo player = <currentSkaterProfileIndex>
    endif
    if ScreenElementExists id = menu_title_text
        SetScreenElementProps {
        id = menu_title_text
        text = <stored_display_name>
        }
    endif
    <id> : GetSingleTag selected_skin_index
    if GotParam selected_skin_index
        if not GotParam first_time_in_focus
            Change LAST_SELECTED_SKATER_SKIN_INDEX = <selected_skin_index>
        endif
    endif
    <id> : GetSingleTag has_multiple_skins
    if GotParam has_multiple_skins
        if GotParam first_time_in_focus
            <id> : SetTags selected_skin_index = ( LAST_SELECTED_SKATER_SKIN_INDEX )
        endif
        <id> : skaterselect_skater_update_skin skins = <sub_menu> <...>
    else
        if ScreenElementExists id = skaterselect_sub_menu_text
            DoScreenElementMorph {
            id = skaterselect_sub_menu_text
            alpha = 0.0
            time = 0.2
            }
        endif
    endif
    SpawnScript TemporarilyDisableInput params = { time = 60 }
endscript

script create_new_ss_menu
    hide_select_skater_arrows
    thugpro_orient_menu_skater
    cas_remove_ped_stuff_from_skater
    KillSkaterCamAnim All
    PlaySkaterCamAnim Name = skateshop_startcam play_hold
    if GotParam change_gamemode
        <change_gamemode>
    endif
    GetCurrentSkaterProfileIndex
    GetGameMode
    switch <gamemode>
    case career
        <menu_title> = "Story Mode"
    case freeskate
        <menu_title> = "Freeskate"
    case net
        <menu_title> = "THUGPRO Online"
        <callback> = select_network_play_multi
        <change_gamemode> = change_gamemode_net
    case singlesession
        Change in_server_options = 0
        <menu_title> = "Freeskate"
        <change_gamemode> = change_gamemode_singlesession
    case creategoals
        <menu_title> = 'Create Goals'
    case classic
        <menu_title> = 'Classic Mode'
    default
        <menu_title> = 'Skateshop'
    endswitch
    if ( launch_to_createatrick = 1 )
        <menu_title> = 'Create Tricks'
    endif
    kill_start_key_binding
    thugpro_menu_create {
    menu_name = ss
    menu_title = <menu_title>
    menu_style = MENU_STYLE_RIGHT
    helper_text = generic_helper_text
    pad_back_script = launch_new_select_skater_menu
    pad_back_params = { callback = <callback> change_gamemode = <change_gamemode> }
    show_description_panel
    show_gradient
    boxed
    }
    GetCurrentSkaterProfileIndex
    if GameModeEquals is_net
        if ( network_connection_type = internet )
            <connection_extra_text> = "INTERNET"
            make_thugpro_menu_item {
            text = "Ready"
            id = ss_play_level
            pad_choose_script = spawn_lobby_list
            }
        else
            <connection_extra_text> = "LAN"
            make_thugpro_menu_item {
            text = "Ready"
            id = ss_play_level
            pad_choose_script = new_ss_menu_exit
            pad_choose_params = { new_menu_script = select_lan_play }
            }
        endif
        make_thugpro_menu_item {
        text = "Connection"
        extra_text = <connection_extra_text>
        id = ss_connection
        not_focusable
        }
        GetPreferenceString pref_type = network network_id
        make_thugpro_menu_item {
        text = "Player Name"
        extra_text = <ui_string>
        id = menu_player_name
        pad_choose_script = new_ss_menu_exit
        pad_choose_params = {
        new_menu_script = launch_onscreen_keyboard_from_net_options_menu
        title = "PLAYER NAME"
        field = "network_id"
        text = <ui_string>
        min_length = 1
        max_length = 15
        }
        }
        make_thugpro_menu_item {
        text = "Edit Taunts"
        id = network_option_taunts
        pad_choose_script = create_taunt_options_menu
        }
    else
        make_thugpro_menu_item {
        text = "Select Level"
        id = ss_play_level
        pad_choose_script = new_ss_menu_exit
        pad_choose_params = { new_menu_script = launch_level_select_menu <...> }
        }
    endif
    get_current_skater_name
    if not ( <Name> = custom )
        <not_focusable> = not_focusable
    endif
    if GameModeEquals is_net
        SetAllStats value = 10
    endif
    make_thugpro_menu_item {
    text = "Edit Appearance"
    pad_choose_script = pre_cas_menu_exit
    pad_choose_params = { new_menu_script = skateshop_create_cas_menu from_ss_menu }
    <not_focusable>
    }
    if not GameModeEquals is_net
        make_thugpro_menu_item {
        text = "Edit Stats"
        pad_choose_script = create_thugpro_style_test_menu_stats
        pad_choose_params = {
        callback_script = launch_new_ss_menu
        edit
        }
        }
    endif
    make_thugpro_menu_item {
    text = "Edit Tricks"
    pad_choose_script = new_ss_menu_exit
    pad_choose_params = {
    new_menu_script = create_edit_tricks_menu
    hide_bg = 1
    from_ss_menu
    }
    }
    if not GameModeEquals is_net
        get_difficulty_level_text
        make_thugpro_menu_item {
        text = "Difficulty"
        description_text = "Difficulty affects how easy tricks are to land"
        extra_text = <difficulty_level_text>
        option_arrows pad_choose
        option_arrows_callback = option_menu_change_difficulty
        }
    endif
    make_thugpro_menu_item {
    text = "Save Skater"
    pad_choose_script = new_ss_menu_exit
    description_text = "Custom skater appearance, tricks and stats"
    pad_choose_params = {
    new_menu_script = launch_skater_select_menu_save_game_sequence
    callback_script = launch_new_ss_menu
    }
    }
    make_thugpro_menu_item {
    text = "Load Skater"
    pad_choose_script = new_ss_menu_exit
    description_text = "Custom skater appearance, tricks and stats"
    pad_choose_params = {
    new_menu_script = launch_skater_select_menu_load_game_sequence
    callback_script = launch_new_ss_menu
    }
    }
    if GameModeEquals is_net
        make_thugpro_menu_item {
        text = "Save Online Prefs"
        id = network_option_save
        description_text = "Player name and server options"
        pad_choose_script = launch_save_network_settings
        }
        make_thugpro_menu_item {
        text = "Load Online Prefs"
        description_text = "Player name and server options"
        id = network_option_load
        pad_choose_script = maybe_load_net_settings
        }
    endif
    thugpro_menu_finalize <...>
endscript

script create_dadmod_mainmenu_menu
    default_skateshop_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_mainmenu
    menu_title = "Main Menu options"
    menu_style = MENU_STYLE_LEFT
    helper_text = dadmod_mm_helper_text
    pad_back_script = dadmod_mm_back
    show_description_panel
    show_gradient
    }
    dadmod_mmopt_item id = mmopt_scene key = "menu_scene" label = "Menu scene" desc = "The stock Skate Shop (normal or Halloween), your custom menu, or Starred: each start shows one of the menus you starred in Custom menus. Loads right away"
    dadmod_mmopt_item id = mmopt_saved key = "saved_menu" label = "Custom menus" desc = "Main menus you saved while skating (Quick Menu > Set Main Menu Here). Pick one to load it. Right stars menus for Menu scene Starred. F8 (or X / Square on a controller) twice deletes one"
    dadmod_mmopt_item id = mmopt_camctl key = "camera_control" label = "Camera control" desc = "Menu: the cameras below move by themselves. You: the stick turns the camera around your skater"
    dadmod_mmopt_item id = mmopt_theme key = "shop_theme" label = "Skate shop theme" desc = "Halloween or normal look for the Skate Shop scene. Auto turns Halloween on in October"
    dadmod_mmopt_item id = mmopt_deck key = "deck" label = "Deck graphic" desc = "The big deck picture behind the menu. Off shows the whole scene"
    dadmod_mmopt_item id = mmopt_framing key = "framing" label = "Skater on screen" desc = "Which side of the screen your skater stands on. Left keeps them clear of the menu"
    dadmod_mmopt_item id = mmopt_cams key = "cameras" label = "Camera mode" desc = "Static keeps one shot. Cycle switches shots on a timer"
    dadmod_mmopt_item id = mmopt_campick key = "camera_pick" label = "Camera shot" desc = "The shot to use when Camera mode is Static. The Static shot is one still view with no orbit or movement"
    dadmod_mmopt_item id = mmopt_ccam key = "custom_cam_menu" label = "Custom camera" desc = "Use one of the cameras you saved on this map (Reposition camera saves them)"
    dadmod_mmopt_item id = mmopt_camsec key = "camera_seconds" label = "Shot time" desc = "How long each shot stays up when Camera mode is Cycle"
    dadmod_mmopt_item id = mmopt_spots key = "spots" label = "Spot mode" desc = "Static keeps one spot. Cycle picks another of this level's spots each time the menu loads"
    dadmod_mmopt_item id = mmopt_pmode key = "pose_mode" label = "Pose mode" desc = "Default: the idle loops. Single Animation: one you pick. Cycle Animations: the ones you pick, in turn. Random: anything"
    dadmod_mmopt_item id = mmopt_anims key = "anim_browse" label = "Animations" desc = "Opens the animation picker"
    dadmod_mmopt_item id = mmopt_pone key = "pose_one" label = "Favorite" desc = "The favorite used by One favorite. Star favorites in pause > dadmod > Animations"
    dadmod_mmopt_item id = mmopt_ambient key = "ambient_people" label = "Ambient life" desc = "People, or people and traffic like free skate, on custom menu maps that have them (Hollywood, Beverly Hills)"
    dadmod_mmopt_item id = mmopt_ptime key = "pose_seconds" label = "Time per animation" desc = "How long each animation plays before blending into the next"
    dadmod_mmopt_item id = mmopt_order key = "order" label = "Cycle order" desc = "Random or in order, for everything that cycles: Starred menus, camera shots, poses and spots"
    dadmod_mmopt_item id = mmopt_ce_reposition key = "cam_reposition" label = "Reposition camera" desc = "Fly a free camera to frame a shot. Saves it as a custom camera for this map"
    dadmod_mmopt_item id = mmopt_ce_radius key = "cam_radius" label = "Distance" desc = "How far the camera is from your skater"
    dadmod_mmopt_item id = mmopt_ce_height key = "cam_height" label = "Height" desc = "How high the camera is above your skater's feet"
    dadmod_mmopt_item id = mmopt_ce_look key = "cam_look" label = "Aim height" desc = "Where the camera aims: low for the feet, about 60 for the face"
    dadmod_mmopt_item id = mmopt_ce_start key = "cam_start" label = "Angle" desc = "Where the camera sits around your skater: 0 is their front, 180 is behind"
    dadmod_mmopt_item id = mmopt_ce_speed key = "cam_speed" label = "Orbit speed" desc = "How fast the camera moves around your skater. Still stops it"
    dadmod_mmopt_item id = mmopt_ce_range key = "cam_range" label = "Orbit range" desc = "Full circle, or sweep back and forth in front. 180 never goes behind them"
    dadmod_mmopt_item id = mmopt_ce_reset key = "cam_reset" label = "Reset this shot" desc = "Put this shot back the way it was before you changed it here"
    dadmod_mmopt_item id = mmopt_ce_blend key = "blend_seconds" label = "Blend time" desc = "How long the camera glides to a new shot. Cut jumps straight there"
    dadmod_mmopt_item id = mmopt_ce_home key = "use_home" label = "Use saved spots" desc = "On: each level uses the spot and camera you saved there"
    dadmod_mmopt_item id = mmopt_ce_context key = "context_cams" label = "Close-ups" desc = "The camera moves in close on the Edit Skater screens"
    dadmod_mmopt_item id = mmopt_slope key = "match_slope" label = "Match slope" desc = "On: your skater leans with the ground they stand on. Off: they stand straight up"
    dadmod_desc_panel_right
    thugpro_menu_finalize <...>
endscript

script dadmod_mmopt_item
    THUGRECOMP_MenuOpt key = <key> step = 0
    if (<key> = "saved_menu")
        FormatText TextName = t "%s  >" s = <label>
        make_thugpro_menu_item {
        text = <t>
        sub_label = <label>
        id = <id>
        description_text = <desc>
        pad_choose_script = dadmod_saved_menu_menu
        }
        return
    endif
    if (<key> = "custom_cam_menu")
        FormatText TextName = t "%s  >" s = <label>
        make_thugpro_menu_item {
        text = <t>
        sub_label = <label>
        id = <id>
        extra_text = <text>
        description_text = <desc>
        pad_choose_script = dadmod_custom_cam_menu
        }
        return
    endif
    if (<key> = "anim_browse")
        if (<show> = 0)
            return
        endif
        FormatText TextName = t "%s  >" s = <text>
        if (<single> = 1)
            desc = "Pick the animation your skater plays here"
        else
            desc = "Tick (*) the animations your skater cycles here. X or Right ticks one"
        endif
        make_thugpro_menu_item {
        text = <t>
        id = <id>
        description_text = <desc>
        pad_choose_script = dadmod_anims_menu_main
        pad_choose_params = { single = <single> }
        }
        return
    endif
    if (<key> = "cam_reset")
        make_thugpro_menu_item {
        text = <label>
        id = <id>
        description_text = <desc>
        pad_choose_script = dadmod_mm_cam_reset
        }
        return
    endif
    if (<key> = "cam_reposition")
        make_thugpro_menu_item {
        text = <label>
        id = <id>
        extra_text = <text>
        description_text = <desc>
        pad_choose_script = dadmod_mm_cam_reposition
        }
        return
    endif
    if (<key> = "level")
        FormatText TextName = t "%s  >" s = <label>
        make_thugpro_menu_item {
        text = <t>
        sub_label = <label>
        id = <id>
        extra_text = <text>
        description_text = <desc>
        pad_choose_script = dadmod_menu_level_menu
        }
        return
    endif
    make_thugpro_menu_item {
    text = <label>
    id = <id>
    extra_text = <text>
    description_text = <desc>
    option_arrows
    option_arrows_callback = dadmod_mmopt_change
    option_arrows_callback_params = { key = <key> }
    pad_choose
    }
endscript

script dadmod_mmopt_change
    GetTags
    step = 1
    if GotParam left
        step = -1
    endif
    THUGRECOMP_MenuOpt key = <key> step = <step>
    Change dadmod_mm_armed = none
    thugpro_menu_item_update_extra_text id = <id> text = <text>
    if (<key> = "pose_mode")
        dadmod_layout_open node = ( dadmod_layout_node ) focus_id = <id>
        return
    endif
    if (<key> = "ambient_people")
        if (<pending> = 1)
            Change dadmod_mm_reopen = 1
            SpawnScript dadmod_reload_menu_scene
            return
        endif
        SpawnScript dadmod_menu_ambient_apply
        return
    endif
    if (<key> = "menu_scene")
        Change dadmod_mm_reopen = 1
        SpawnScript dadmod_reload_menu_scene
        return
    endif
    if (<key> = "level")
        Change dadmod_mm_reopen = 1
        SpawnScript dadmod_reload_menu_scene
        return
    endif
    if (<respot> = 1)
        thugpro_orient_menu_skater
    endif
    if GotParam theme
        if not IsTrue thugpro_mainmenu_east_la
            if (<theme> = 0)
                Change dadmod_mm_reopen = 1
                SpawnScript dadmod_reload_menu_scene
                return
            endif
            thugpro_menu_apply_theme
        endif
    endif
endscript

dadmod_dirty = 0

dadmod_mm_reopen = 0

dadmod_mm_armed = none

dadmod_mm_helper_text = {
helper_text_elements_pc = [ { text = "\\b7/\\b4 = Select" } { text = "\\b6/\\b5 = Adjust" } { text = "\\bn = Back" } { text = "\\bm = Accept" } { text = "F8 = Delete" } { text = "F7 = Favorite" } ]
helper_text_elements_console = [ { text = "\\b7/\\b4 = Select" } { text = "\\b6/\\b5 = Adjust" } { text = "\\m1 = Back" } { text = "\\m0 = Accept" } { text = "\\b0 = Delete" } { text = "\\b1 = Favorite" } ]
}

script dadmod_mm_back
    if THUGRECOMP_PadHeld button = "y"
        return
    endif
    Change dadmod_mm_armed = none
    create_dadmod_setup_menu
endscript

dadmod_mm_armed_frames = 0

script dadmod_mm_keys_tick
    if (dadmod_mm_armed_frames > 0)
        Change dadmod_mm_armed_frames = ( dadmod_mm_armed_frames - 1 )
        if (dadmod_mm_armed_frames = 0)
            if ScreenElementExists id = dadmod_savedmenu_menu
                dadmod_saved_disarm
            else
                dadmod_mm_disarm
            endif
        endif
    endif
    if ScreenElementExists id = dadmod_savedmenu_menu
        dadmod_saved_keys_tick
        return
    endif
    dadmod_hit = 0
    if THUGRECOMP_KeyPressed key = "F8"
        dadmod_hit = 1
    endif
    if THUGRECOMP_PadPressed button = "y"
        dadmod_hit = 1
    endif
    if (<dadmod_hit> = 0)
        return
    endif
    focused = ( dadmod_ui_focused )
    if (<focused> = mmopt_spotpick)
        dadmod_mm_delete_press focused = <focused> kind = spot key = "spot_pick"
    endif
endscript

script dadmod_saved_keys_tick
    dadmod_hit = 0
    if THUGRECOMP_KeyPressed key = "F8"
        dadmod_hit = 1
    endif
    if THUGRECOMP_PadPressed button = "x"
        dadmod_hit = 1
    endif
    if (<dadmod_hit> = 0)
        return
    endif
    focused = ( dadmod_ui_focused )
    pick = -1
    p = 0
    begin
        FormatText ChecksumName = item_id "dadmod_saved_%i" i = <p>
        if (<item_id> = <focused>)
            pick = <p>
            break
        endif
        p = ( <p> + 1 )
    repeat 100
    if (<pick> < 0)
        return
    endif
    if not (( dadmod_mm_armed ) = <focused>)
        Change dadmod_mm_armed = <focused>
        Change dadmod_mm_armed_frames = 180
        SpawnScript dadmod_saved_menu_menu params = { focus_target = <focused> }
        return
    endif
    Change dadmod_mm_armed = none
    Change dadmod_mm_armed_frames = 0
    if THUGRECOMP_MenuSavedDelete pick = <pick>
        FormatText TextName = text "Deleted %n. A copy is in dadmod backups" n = <name>
    else
        text = "Could not delete that menu"
    endif
    SpawnScript dadmod_saved_menu_menu
    KillSpawnedScript Name = thugpro_mark_show
    SpawnScript thugpro_mark_show params = { text = <text> }
    thugpro_orient_menu_skater
endscript

script dadmod_saved_disarm
    focused = ( dadmod_mm_armed )
    Change dadmod_mm_armed = none
    SpawnScript dadmod_saved_menu_menu params = { focus_target = <focused> }
endscript

script dadmod_mm_fav_tick
    if not (( dadmod_ui_focused ) = mmopt_anim)
        return
    endif
    dadmod_fav = 0
    if THUGRECOMP_KeyPressed key = "F7"
        dadmod_fav = 1
    endif
    if THUGRECOMP_PadPressed button = "x"
        dadmod_fav = 1
    endif
    if (<dadmod_fav> = 1)
        if THUGRECOMP_MenuFav
            thugpro_menu_item_update_extra_text id = mmopt_anim text = <text>
        endif
    endif
endscript

script dadmod_mm_delete_press
    if (<kind> = spot)
        THUGRECOMP_MenuDelete kind = "spot" check = 1
    else
        THUGRECOMP_MenuDelete kind = "camera" check = 1
    endif
    if GotParam builtin
        if (<builtin> = 1)
            dadmod_mm_disarm
            Change dadmod_mm_armed = <focused>
            Change dadmod_mm_armed_frames = 120
            thugpro_menu_item_update_extra_text id = <focused> text = "Built-in, can't delete"
            return
        endif
    endif
    if not (( dadmod_mm_armed ) = <focused>)
        dadmod_mm_disarm
        Change dadmod_mm_armed = <focused>
        Change dadmod_mm_armed_frames = 180
        dadmod_btn pad = y key = "F8"
        FormatText TextName = dm_again "Press %b again to delete" b = <btn>
        thugpro_menu_item_update_extra_text id = <focused> text = <dm_again>
        return
    endif
    Change dadmod_mm_armed = none
    Change dadmod_mm_armed_frames = 0
    if (<kind> = spot)
        THUGRECOMP_MenuDelete kind = "spot"
    else
        THUGRECOMP_MenuDelete kind = "camera"
    endif
    THUGRECOMP_MenuOpt key = <key> step = 0
    thugpro_menu_item_update_extra_text id = <focused> text = <text>
    if (<respot> = 1)
        thugpro_orient_menu_skater
    endif
endscript

script dadmod_mm_disarm
    if (( dadmod_mm_armed ) = mmopt_spotpick)
        THUGRECOMP_MenuOpt key = "spot_pick" step = 0
        thugpro_menu_item_update_extra_text id = mmopt_spotpick text = <text>
    endif
    if (( dadmod_mm_armed ) = mmopt_campick)
        THUGRECOMP_MenuOpt key = "camera_pick" step = 0
        thugpro_menu_item_update_extra_text id = mmopt_campick text = <text>
    endif
    Change dadmod_mm_armed = none
endscript

script dadmod_back_to_main
    THUGRECOMP_MenuOpt key = "level" step = 0
    if IsTrue dadmod_dirty
        pending = 1
    endif
    Change dadmod_dirty = 0
    if (<pending> = 1)
        SpawnScript dadmod_reload_menu_scene
    else
        create_main_menu
    endif
endscript

script dadmod_reload_menu_scene
    DestroyIfObjectExist id = current_menu_anchor
    change_level level = Load_MainMenu
endscript

script dadmod_join_fade
    DestroyIfObjectExist id = dadmod_join_fade_box
    CreateScreenElement {
    Type = SpriteElement
    parent = root_window
    id = dadmod_join_fade_box
    texture = black
    Pos = (3.2e+02,2.4e+02)
    rgba = [ 0 0 0 128 ]
    scale = (1.9e+02,1.9e+02)
    just = [ center center ]
    alpha = 0
    z_priority = -90
    }
    DoScreenElementMorph id = dadmod_join_fade_box alpha = 1 time = 0.4
    wait 10 gameframes
    begin
        if not ScreenElementExists id = dadmod_join_fade_box
            return
        endif
        GetCurrentLevel
        if not (<level> = Load_MainMenu)
            if not ScreenElementExists id = dialog_box_anchor
                break
            endif
        endif
        if ScreenElementExists id = server_list_menu
            DoScreenElementMorph id = dadmod_join_fade_box alpha = 0 time = 0.3
            wait 20 gameframes
            break
        endif
        wait 1 gameframe
    repeat 5400
    DestroyIfObjectExist id = dadmod_join_fade_box
endscript

script dadmod_mm_cam_reset
    THUGRECOMP_MenuOpt key = "cam_reset" step = 1
    SpawnScript dadmod_mm_cam_reset_reopen
endscript

script dadmod_mm_cam_reset_reopen
    wait 3 gameframes
    dadmod_mm_cam_refresh_item id = mmopt_ce_radius key = "cam_radius"
    dadmod_mm_cam_refresh_item id = mmopt_ce_height key = "cam_height"
    dadmod_mm_cam_refresh_item id = mmopt_ce_look key = "cam_look"
    dadmod_mm_cam_refresh_item id = mmopt_ce_start key = "cam_start"
    dadmod_mm_cam_refresh_item id = mmopt_ce_speed key = "cam_speed"
    dadmod_mm_cam_refresh_item id = mmopt_ce_range key = "cam_range"
    dadmod_mm_cam_refresh_item id = mmopt_campick key = "camera_pick"
endscript

script dadmod_mm_cam_refresh_item
    if ScreenElementExists id = <id>
        THUGRECOMP_MenuOpt key = <key> step = 0
        thugpro_menu_item_update_extra_text id = <id> text = <text>
    endif
endscript

script dadmod_custom_cam_menu
    default_skateshop_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_customcam
    menu_title = "Custom camera"
    menu_style = MENU_STYLE_LEFT
    helper_text = generic_helper_text
    pad_back_script = dadmod_menu_level_back
    show_description_panel
    show_gradient
    scrolling
    }
    i = 0
    begin
        THUGRECOMP_MenuOpt key = "custom_cam" step = 0 index = <i>
        if not (<found> = 1)
            break
        endif
        if (<cur> = 1)
            FormatText TextName = t "%s (now)" s = <name>
        else
            t = <name>
        endif
        make_thugpro_menu_item {
        text = <t>
        description_text = "Use this camera on the menu"
        pad_choose_script = dadmod_custom_cam_pick
        pad_choose_params = { index = <i> }
        }
        i = ( <i> + 1 )
    repeat 64
    if (<i> = 0)
        make_thugpro_menu_item {
        text = "None on this map"
        description_text = "Camera > Reposition camera saves one here"
        not_focusable
        }
    endif
    dadmod_desc_panel_right
    thugpro_menu_finalize
endscript

script dadmod_custom_cam_pick
    THUGRECOMP_MenuOpt key = "custom_pick" step = 0 index = <index>
    SpawnScript dadmod_custom_cam_reopen
endscript

script dadmod_custom_cam_del
    THUGRECOMP_MenuOpt key = "custom_del" step = 0 index = <index>
    SpawnScript dadmod_custom_cam_reopen
endscript

script dadmod_custom_cam_reopen
    wait 3 gameframes
    dadmod_custom_cam_menu
endscript

dadmod_online_levels = [
{ name = "Streets" level = #"0x001202e3" cmds = [ "!STREETS" ] }
{ name = "New York City (THPS2)" level = #"0x341caf9f" cmds = [ "!THPS2NY" "!NYC" ] }
{ name = "Skatestreet" level = #"0x6552c592" cmds = [ "!SKATESTREET" ] }
{ name = "Bullring" level = #"0xe0d4e51a" cmds = [ "!BULLRING" ] }
{ name = "Skate Heaven" level = #"0xf06d95da" cmds = [ "!SKATEHEAVEN" ] }
{ name = "Chopper Drop" level = #"0x73babdd0" cmds = [ "!CHOPPERDROP" ] }
{ name = "Training (P8)" level = #"0x1a69989e" cmds = [ "!P8TRAINING" ] }
{ name = "Suburbs (P8)" level = #"0x16a10a9a" cmds = [ "!P8SUBURBS" "!SUBURBS" ] }
{ name = "Downtown (P8)" level = #"0x896a81b2" cmds = [ "!P8DOWNTOWN" ] }
{ name = "Car Factory (P8)" level = #"0x27eeac8d" cmds = [ "!P8CARFACTORY" "!CARFACTORY" ] }
{ name = "Crete Park (P8)" level = #"0x2843fdc8" cmds = [ "!P8CRETEPARK" "!CRETEPARK" ] }
