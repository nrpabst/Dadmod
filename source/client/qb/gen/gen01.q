script spawned_wall_tag anim = standing_tag2
    OnExitRun TagClearFlagsScript
    SetTags dadmod_tagging = 1
    ProjectilesOff
    EnterTagging
    ClearExceptionGroup WalkingStateExceptions
    DisablePlayerInput AllowCameraControl
    SetException ex = SkaterCollideBail scr = SkaterCollideBail
    Walk_ScaleAnimSpeed off
    if SkaterIsNamed skater_shrek
        if GotParam is_hanging
            anim = Shrek_BurpHangingTag
        else
            anim = Shrek_BurpTag
        endif
    else
        if ( Graffiti_Tag_style = 1 )
            if GotParam is_hanging
                anim = Shrek_BurpHangingTag
            else
                anim = Shrek_BurpTag
            endif
        else
            Obj_SpawnScript THUG2_SFX_Tag_Spray_Wallplant
            TurnOnSpecialItem specialitem_details = spraycan_details
        endif
    endif
    PlayAnim anim = <anim> BlendPeriod = 0.4
    begin
        if Released Triangle
            if not SkaterIsNamed skater_shrek
                StopSound SK6_Walk_Spray_Tag_01
            endif
            break
        endif
        if AnimFinished
            if Held Triangle
                wait 0.05 second
            endif
            break
        endif
        waitonegameframe
    repeat
    EnablePlayerInput
    if GotParam is_hanging
        goto HangState
    else
        goto GroundOrAirWaitState
    endif
endscript

script TagClearFlagsScript
    SetTags dadmod_tagging = 0
    ProjectilesOn
    ExitTagging
    TagClearFlags
    TurnOffSpecialItem
    SprayPaintOff
endscript

thugpro_main_reorder = 0

thugpro_main_reorder_pick = -1

thugpro_main_helper = {
helper_text_elements_PC = [ { text = "\\b7/\\b4 = Select" } { text = "\\bm = Accept" } { text = "F9 = Reorder" } { text = "F10 = Undo" } { text = "F12 = Default" } ]
helper_text_elements_Console = [ { text = "\\b7/\\b4 = Select" } { text = "\\m0 = Accept" } { text = "\\b9+\\bg = Reorder" } { text = "\\b9+\\bh = Undo" } { text = "\\b9+\\be = Default" } ]
}

thugpro_main_helper_reorder = {
helper_text_elements_PC = [ { text = "\\b7/\\b4 = Select" } { text = "\\bm = Pick up / Put here" } { text = "F9 = Done" } { text = "F10 = Undo" } { text = "F12 = Default" } ]
helper_text_elements_Console = [ { text = "\\b7/\\b4 = Select" } { text = "\\m0 = Pick up / Put here" } { text = "\\b9+\\bg = Done" } { text = "\\b9+\\bh = Undo" } { text = "\\b9+\\be = Default" } ]
}

script dadmod_main_green_focus
    GetTags
    if ScreenElementExists id = { <id> child = text }
        SetScreenElementProps id = { <id> child = text } rgba = [ 0 128 35 128 ]
    endif
endscript

script thugpro_main_item
    fs = nullscript
    params = { }
    switch <idx>
    case 0
        text = "Play Online"
        desc = ( Desc_SS_PlayOnline )
        run = select_network_play_multi
    case 1
        text = "Freeskate"
        desc = ( Desc_SS_Freeskate )
        run = launch_new_select_skater_menu
        params = { callback = create_main_menu change_gamemode = change_gamemode_singlesession }
    case 2
        text = "Edit Skater"
        desc = ( Desc_SS_EditSkater )
        run = launch_pre_cas_menu
    case 3
        text = "Park Editor"
        desc = ( Desc_SS_ParkEditor )
        run = launch_park_editor
    case 4
        text = "Options"
        desc = ( Desc_SS_Options )
        run = create_setup_options_menu
    case 5
        text = "Kalimod Features"
        desc = "Every feature of this mod..."
        run = #"0xc46e26a0"
        fs = #"0x4c606620"
    case 6
        text = "Dadmod"
        desc = "Dadmod settings: the main menu scene, cameras and more"
        run = create_dadmod_setup_menu
        fs = dadmod_main_green_focus
    case 7
        text = "Quit Game"
        desc = ( Desc_SS_Quit )
        run = main_menu_exit_game
    endswitch
    if (<idx> = 5)
        if not ScriptExists #"0xc46e26a0"
            return
        endif
    endif
    ufs = nullscript
    fparams = { }
    if IsTrue thugpro_main_reorder
        if ( ( thugpro_main_reorder_pick ) = <pos> )
            FormatText TextName = text "\\c4> %s <" s = <text>
            desc = "Now choose where to put it"
            fs = nullscript
        else
            desc = "Choose an item to move it, then choose where it goes. F10 undoes a move, F12 puts the stock order back, F9 when done"
            fs = thugpro_main_reorder_focus
            ufs = thugpro_main_reorder_unfocus
            fparams = { plain = <text> }
        endif
        run = thugpro_main_reorder_choose
        params = { pos = <pos> }
    endif
    dadmod_ui_main_item_scale
    FormatText ChecksumName = cid "dadmod_main_item_%i" i = <idx>
    make_thugpro_menu_item {
    id = <cid>
    text = <text>
    description_text = <desc>
    pad_choose_script = <run>
    pad_choose_params = <params>
    focus_script = <fs>
    focus_params = <fparams>
    unfocus_script = <ufs>
    unfocus_params = <fparams>
    centered
    scale = <item_scale>
    }
    FormatText TextName = ckey "ui_item%i" i = <idx>
    dadmod_ui_color key = <ckey>
    if GotParam color
        SetScreenElementProps id = <cid> tags = { dadmod_rgba = <color> }
        SetScreenElementProps id = { <cid> child = text } rgba = <color>
    endif
    FormatText TextName = fkey "ui_item%i_fx" i = <idx>
    dadmod_ui_get key = <fkey> def = 0
    if (<value> > 0)
        SetScreenElementProps id = <cid> tags = { dadmod_fx = <value> }
    endif
endscript

script thugpro_main_reorder_focus
    GetTags
    if ScreenElementExists id = { <id> child = text }
        if ( ( thugpro_main_reorder_pick ) = -1 )
            FormatText TextName = t "\\cc> %s <" s = <plain>
        else
            FormatText TextName = t "\\c2> %s <" s = <plain>
        endif
        SetScreenElementProps id = { <id> child = text } text = <t>
        SetScreenElementProps id = <id> tags = { dadmod_txt = <t> }
    endif
endscript

script thugpro_main_reorder_unfocus
    GetTags
    if ScreenElementExists id = { <id> child = text }
        SetScreenElementProps id = { <id> child = text } text = <plain>
        SetScreenElementProps id = <id> tags = { dadmod_txt = <plain> }
    endif
endscript

script thugpro_main_reorder_choose
    if ( ( thugpro_main_reorder_pick ) = -1 )
        Change thugpro_main_reorder_pick = <pos>
    else
        THUGRECOMP_MenuOrderMove count = 8 from = ( thugpro_main_reorder_pick ) to = <pos>
        Change thugpro_main_reorder_pick = -1
    endif
    thugpro_main_menu_refresh
endscript

script thugpro_main_order_undo
    if THUGRECOMP_MenuOrderUndo
        Change thugpro_main_reorder_pick = -1
        thugpro_main_menu_refresh
    endif
endscript

script thugpro_main_order_reset
    if THUGRECOMP_MenuOrderReset count = 8
        Change thugpro_main_reorder_pick = -1
        thugpro_main_menu_refresh
    endif
endscript

script thugpro_main_reorder_toggle
    if IsTrue thugpro_main_reorder
        Change thugpro_main_reorder = 0
    else
        Change thugpro_main_reorder = 1
    endif
    Change thugpro_main_reorder_pick = -1
    thugpro_main_menu_refresh
endscript

script thugpro_main_menu_refresh
    if not ScreenElementExists id = startup_menu
        return
    endif
    SetMenuPadMappings [ active use_as_first ]
    if IsTrue thugpro_main_reorder
        main_helper = thugpro_main_helper_reorder
    else
        main_helper = thugpro_main_helper
    endif
    dadmod_ui_main_style
    thugpro_menu_create {
    menu_name = startup
    menu_title = "SKATESHOP"
    menu_title_texture = thugpro_logo_new
    menu_title_scale = <title_scale>
    menu_style = <style>
    helper_text = <main_helper>
    show_description_panel
    }
    thugpro_menu_create_background { }
    CreateScreenElement {
    Type = SpriteElement
    parent = current_menu_anchor
    texture = top_gradient
    id = menu_top_gradient
    alpha = 0.8
    scale = (9e+01,1e+01)
    Pos = (0.0,0.0)
    just = [ left top ]
    rgba = [ 0 0 0 128 ]
    z_priority = 0
    }
    i = 0
    begin
        THUGRECOMP_MenuOrder count = 8 pos = <i>
        thugpro_main_item idx = <idx> pos = <i>
        i = ( <i> + 1 )
    repeat 8
    thugpro_menu_finalize
    dadmod_ui_offset_main
endscript

script GeneralBail friction = 18 Friction2 = 20 HeavyFriction = 100
    Obj_GetType
    if ( <ObjType> = OBJECT_TYPE_PED )
        goto Ped_Skater_BeginBail params = <...>
        return
    endif
    THUGPRO_NetEndRun
    if GotParam BoardHideFix
        SwitchOffBoard
    endif
    Obj_SetBoundingSphere 100
    if GotParam UnrotateBoardFirst
        if BoardIsRotated
            BoardRotate
        endif
    endif
    if GotParam NoBailBoard
        NoBailBoard = 1
    endif
    NollieOff
    PressureOff
    KillSpecial
    created_trick_cleanup
    if not IsTrue GLOBAL_SkaterVoiceOff
        if not GotParam NoScuff
            if SkaterIsNamed skater_shrek
                PlaySkaterStream Type = "bail_"
            else
                PlaySkaterStream Type = "bail"
            endif
        endif
    endif
    InBail
    LaunchStateChangeEvent state = Skater_InBail
    SetExtraPush radius = 48 speed = 100 Rotate = 6
    if not GotParam dont_face_vel
        TurnToFaceVelocity
    endif
    if not GotParam BoardAlwaysOn
        if not ( nobails = 1 )
            Obj_SpawnScript BailBoardControl params = { BoardOffFrame = <BoardOffFrame> BoardVel = <BoardVel> BoardRotVel = <BoardRotVel> BoardSkaterVel = <BoardSkaterVel> NoBailBoard = <NoBailBoard> gurney = <gurney> }
        endif
    endif
    if AnimEquals Special_GrafPunk_Idle
        HandleDoubleCanOff
    endif
    SparksOff
    VibrateOff
    ClearExceptions
    DisablePlayerInput AllowCameraControl
    BailSkaterTricks
    Obj_KillSpawnedScript Name = dadmod_bail_reform
    unhide
    Obj_KillSpawnedScript Name = dadmod_square_getup
    Obj_SpawnScript dadmod_square_getup
    StopBalanceTrick
    SetException ex = CarBail scr = CarBail
    if ( nobails = 1 )
        goto BailDone
    endif
    if GotParam Endpose
        SetCurrentBailEndpose <Endpose>
    else
        SetCurrentBailEndpose
    endif
    if GotParam GroundGoneBail
        SetException ex = GroundGone scr = <GroundGoneBail> params = { <...> }
    endif
    if GotParam SmackAnim
        SetException ex = FlailHitWall scr = BailSmack params = { SmackAnim = <SmackAnim> }
        SetException ex = FlailLeft scr = BailSmack params = { SmackAnim = <SmackAnim> }
        SetException ex = FlailRight scr = BailSmack params = { SmackAnim = <SmackAnim> }
    endif
    if InSlapGame
        SetException ex = SkaterCollideBail scr = SkaterCollideBail
    else
        if GameModeEquals is_firefight
            SetEventHandler ex = SkaterCollideBail scr = Bail_FireFight_SkaterCollideBail
        endif
    endif
    if GotParam sound
    else
        PlayBonkSound
    endif
    if GotParam NoBlending
        PlayAnim anim = <Anim1> NoRestart BlendPeriod = 0.0
    else
        PlayAnim anim = <Anim1> NoRestart BlendPeriod = 0.3
    endif
    if not InSplitScreenGame
        if not GetGlobalFlag flag = TAP_BUTTONS_EXPLAINED
            Create_Panel_Message { text = "Tip: tap buttons to get up faster"
            id = skater_hint
            style = skater_hint_style
            Pos = (3.2e+02,1.7e+02)
            rgba = [ 32 75 102 100 ]
            }
            SetGlobalFlag flag = TAP_BUTTONS_EXPLAINED
            thugpro_save_key_value key = "TAP_BUTTONS_EXPLAINED" value = 1
        endif
    endif
    if OnRail
        Obj_SpawnScript FallOffRail params = { xmove = <xmove> moveframes = <moveframes> }
        WaitAnim <IntoAirFrame> frames
        ClearException GroundGone
        Vibrate Actuator = 1 Percent = 100 duration = 0.2
        if GotParam BonkSound
            PlayBonkSound
        endif
        if GotParam Nutter
            GetSidewaysVector
            SetSpeed 0
            begin
                if not OnRail
                    SetState AIR
                    goto GroundGoneBail params = { <...> }
                endif
                wait 1 gameframe
            repeat 20
            if Flipped
                Boost = -100
            else
                Boost = 100
            endif
            SetSkaterVelocity vel_x = ( <vel_x> * <Boost> ) vel_y = <vel_y> vel_z = ( <vel_z> * <Boost> )
        endif
        SetState AIR
        move y = 2.0
        Rotate y = randomrange (1.0,2e+01)
        if GotParam ForceFall
            goto GroundGoneBail params = { <...> }
        endif
    endif
    WaitOnGround
    if not GetGlobalFlag flag = BLOOD_OFF
        if not GotParam NoScuff
            Scuff_skater
        endif
        if GotParam Bloodframe
            WaitAnim frame <Bloodframe>
            Obj_SpawnScript BloodSmall
            PlaySound random( @ hitblood01 @ hitblood02 @ hitblood03 )
        endif
    endif
    Vibrate Actuator = 1 Percent = 100 duration = 0.2
    SetRollingFriction <HeavyFriction>
    if GotParam HitBody
        SpawnScript HitBody params = { <...> }
    endif
    if not GotParam BashOff
        BashOn
        if not GoalManager_GoalShouldExpire
            TantrumOn
        endif
    endif
    wait 3 frames
    SetRollingFriction <friction>
    WaitAnim 30 Percent
    SpeedCheckStop
    SetRollingFriction <Friction2>
    WaitAnim 50 Percent
    SpeedCheckStop
    if GotParam BoardEarlyOn
        BoardRotate Normal
        SwitchOnBoard
    endif
    WaitAnim 75 Percent
    if GotParam BoardHideFix
        SwitchOnBoard
    endif
    SpeedCheckStop
    if GotParam FoleySound
    endif
    Obj_WaitAnimFinished
    SpeedCheckStop
    NoQuickGetup
    if GotParam Endpose
        GetTags
        if GotParam waitfortantrum
            RemoveTags tags = [ waitfortantrum ]
            return
        endif
        printf "No tantrum detected heading to endpose"
        TantrumOff
        goto <Endpose>
    endif
    goto BailDone
endscript

