{ name = "mmopt_slope" b = 0 p = { id = mmopt_slope key = "match_slope" label = "Match slope" desc = "On: your skater leans with the ground they stand on. Off: they stand straight up" } }
{ name = "mui_edit_theme" b = 1 p = { id = mui_edit_theme key = "none" label = "Edit Theme" kind = uiaction min = 0 max = 0 def = 0 action = dadmod_theme_open desc = "Opens the stock Edit Theme menu for your custom theme: meters, icons and every theme color, plus Random Theme and Saved Themes" } }
{ name = "mui_c_theme" b = 1 p = { id = mui_c_theme key = "ui_colortheme" label = "Theme" kind = ctheme min = 1 max = 11 def = 1 desc = "A ready-made color set for all menus. Only used when Effect is Theme. Your own colors below still win where you set them" } }
{ name = "mui_c_thmode" b = 1 p = { id = mui_c_thmode key = "ui_theme_mode" label = "Theme style" kind = thmode min = 0 max = 5 def = 0 desc = "How the theme colors are laid out: solid, one per option, per letter, or moving. Anything but Solid colors the options itself, so Text FX and Highlight FX wait until it is Solid" } }
{ name = "mui_c_text" b = 1 p = { id = mui_c_text key = "ui_text" label = "Text color" kind = color min = 0 max = 13 def = 0 desc = "Color of menu options that are not highlighted" } }
{ name = "mui_c_textfx" b = 1 p = { id = mui_c_textfx key = "ui_text_fx" label = "Text FX" kind = fx min = 0 max = 4 def = 0 desc = "Effect on options that are not highlighted. Scan runs the colors across the letters. the Effect or a Theme style other than Solid take over while on" } }
{ name = "mui_c_focus" b = 1 p = { id = mui_c_focus key = "ui_focus" label = "Highlight color" kind = color min = 0 max = 13 def = 0 desc = "Color of the option you are on, with every Effect. Scan tints it as it moves; Rainbow, Confetti, Mosaic, Matrix and Shuffle keep the option you are on solid in this color. Default leaves each Effect its own look" } }
{ name = "mui_c_focusfx" b = 1 p = { id = mui_c_focusfx key = "ui_focus_fx" label = "Highlight FX" kind = fx min = 0 max = 4 def = 0 desc = "Effect on the option you are on. Scan runs the colors across the letters. the Effect or a Theme style other than Solid take over while on" } }
{ name = "mui_c_bar" b = 1 p = { id = mui_c_bar key = "ui_bar" label = "Bar color" kind = color min = 0 max = 13 def = 0 desc = "Color of the bar behind the option you are on" } }
{ name = "mui_c_barfx" b = 1 p = { id = mui_c_barfx key = "ui_bar_fx" label = "Bar FX" kind = barfx min = 0 max = 10 def = 0 desc = "Effect on the highlight bar. Glitch is the stock jitter, Still turns it off. Breathe, Pulse, Rainbow, Two-tone (to the Highlight color), Strobe, Neon flicker, Heartbeat, Police lights, or Slide (the bar slides in each time you move). Speed follows FX speed" } }
{ name = "mui_c_title" b = 1 p = { id = mui_c_title key = "ui_title" label = "Title color" kind = color min = 0 max = 13 def = 0 desc = "Color of menu titles" } }
{ name = "mui_c_titlefx" b = 1 p = { id = mui_c_titlefx key = "ui_title_fx" label = "Title effect" kind = titlefx min = 0 max = 12 def = 0 desc = "Effect on the menu title at the top. Uses your theme: its colors on Theme, rainbow colors otherwise. Breathe, Pulse, Two-tone and Strobe pulse the title color. Fade and Scan run the colors over it. Confetti, Mosaic and Per letter color each letter. Decode unscrambles it, then settles. Match menu copies the Effect or Theme style" } }
{ name = "mui_c_fxspeed" b = 1 p = { id = mui_c_fxspeed key = "ui_fx_speed" label = "FX speed" kind = num min = 1 max = 10 def = 5 desc = "How fast the Fade and Flash FX and every Bar FX go, plus the Title effect. Scan uses the Effect speed" } }
{ name = "mui_c_desc" b = 1 p = { id = mui_c_desc key = "desc_color" label = "Box text" kind = color min = 0 max = 13 def = 0 desc = "Color of the text in this description box" } }
{ name = "mui_c_descacc" b = 1 p = { id = mui_c_descacc key = "desc_accent_color" label = "Box line" kind = color min = 0 max = 13 def = 0 desc = "Color of the thin line on top of this description box. Default follows the bar color" } }
{ name = "mui_c_reset" b = 1 p = { id = mui_c_reset key = "ui_text" label = "Reset colors" kind = colorreset min = 0 max = 0 def = 0 desc = "Puts every text color, effect, theme and rainbow setting back to stock. Main screen size and position stay" } }
{ name = "mui_c_bright" b = 1 p = { id = mui_c_bright key = "ui_bright" label = "Menu brightness" kind = num min = 20 max = 200 step = 5 def = 100 desc = "Brightness of all menu colors. 100 is normal" } }
{ name = "mui_c_sat" b = 1 p = { id = mui_c_sat key = "ui_sat" label = "Menu saturation" kind = num min = 0 max = 200 step = 5 def = 100 desc = "Color strength of all menu colors. 0 is grey, 100 is normal" } }
{ name = "mui_rb_true" b = 1 p = { id = mui_rb_true key = "ui_rainbow" label = "Color scan" kind = truerainbow min = 0 max = 0 def = 5 desc = "One press: a rainbow scans across the letters of every menu. Effect Static turns it off" } }
{ name = "mui_rainbow" b = 1 p = { id = mui_rainbow key = "ui_rainbow" label = "Effect" kind = rainbow min = 0 max = 11 def = 0 desc = "Off keeps the stock menu colors, except your Highlight style, Highlight color and Main menu colors. Static uses only your own colors and the main menu colors. Theme uses the Theme and Theme style below. Random picks a new effect every time the game starts. Rainbow, Scan, Confetti, Mosaic, Matrix, Random and Shuffle move the colors" } }
{ name = "mui_rb_speed" b = 1 p = { id = mui_rb_speed key = "ui_rb_speed" label = "Effect speed" kind = num min = 1 max = 10 def = 4 desc = "How fast the Effect moves (Rainbow, Scan, Confetti, Matrix) and Scan FX. 4 is the default. Greyed out while nothing on this page uses it" } }
{ name = "mui_rb_speed_def" b = 1 p = { id = mui_rb_speed_def key = "ui_rb_speed" label = "Reset speed" kind = reset min = 0 max = 0 def = 4 desc = "Puts the effect speed back to 4" } }
{ name = "mui_rb_angle" b = 1 p = { id = mui_rb_angle key = "ui_rb_angle" label = "Direction" kind = angle min = 0 max = 315 step = 45 def = 0 desc = "Which way Rainbow, Confetti, Matrix and Scan FX sweep across the menu. Greyed out while nothing on this page uses it" } }
{ name = "mui_rb_angle_def" b = 1 p = { id = mui_rb_angle_def key = "ui_rb_angle" label = "Reset direction" kind = reset min = 0 max = 0 def = 0 desc = "Puts the direction back to left to right" } }
{ name = "mui_hl_style" b = 1 p = { id = mui_hl_style key = "ui_hl_style" label = "Highlight style" kind = gfxlist min = 0 max = 7 def = 0 list = ui_hl_style desc = "How the option you are on stands out. Default is the bar. Grow, Slide, Brackets, Underline, Side marker, Spotlight (dims the rest) or Wave" } }
{ name = "mui_br_color" b = 1 p = { id = mui_br_color key = "ui_br_color" label = "Brackets color" kind = gfxlist min = 0 max = 10 def = 10 list = ui_br_color desc = "Color of the > < brackets around the option you are on. Text color uses the option's own color. Letter-by-letter effects recolor them" } }
{ name = "mui_br_speed" b = 1 p = { id = mui_br_speed key = "ui_br_speed" label = "Brackets speed" kind = num min = 1 max = 10 def = 5 desc = "How fast the Scan brackets change color. 5 is the default" } }
{ name = "mui_side" b = 1 p = { id = mui_side key = "ui_side" label = "Position" kind = gfxlist min = 0 max = 2 def = 2 list = ui_side desc = "Where the main screen menu sits: left, center or right" } }
{ name = "mui_main_def" b = 1 p = { id = mui_main_def key = "none" label = "Defaults" kind = uiaction min = 0 max = 0 def = 0 action = dadmod_ui_main_defaults desc = "Puts position, size, text size, nudges, deck graphic and logo back to stock" } }
{ name = "mui_logo" b = 1 p = { id = mui_logo key = "ui_logo" label = "THUG PRO logo" kind = gfxlist min = 0 max = 1 def = 0 list = ui_logo desc = "Shows or hides the THUG PRO logo above the main screen menu" } }
{ name = "mui_size" b = 1 p = { id = mui_size key = "ui_size" label = "Size" kind = num min = 70 max = 120 step = 5 def = 100 desc = "Size of the main screen menu, logo and options together. 100 is stock" } }
{ name = "mui_scale" b = 1 p = { id = mui_scale key = "ui_scale" label = "Text size" kind = num min = 60 max = 200 step = 5 def = 120 desc = "Text size of the main screen options on their own. 120 is stock" } }
{ name = "mui_x" b = 1 p = { id = mui_x key = "ui_x" label = "Nudge L/R" kind = num min = -320 max = 320 step = 5 def = 0 desc = "Fine-tunes the options left or right. 0 is stock" } }
{ name = "mui_y" b = 1 p = { id = mui_y key = "ui_y" label = "Nudge U/D" kind = num min = -240 max = 240 step = 5 def = 0 desc = "Fine-tunes the options up or down. 0 is stock" } }
{ name = "mui_item0" b = 1 p = { id = mui_item0 key = "ui_item0" label = "Play Online" kind = color min = 0 max = 13 def = 0 desc = "Color of Play Online on the main screen when it is not highlighted" } }
