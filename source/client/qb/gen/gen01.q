    dadmod_ui_item id = mui_itemfx3 key = "ui_item3_fx" label = "Park Editor" kind = fx min = 0 max = 5 def = 0 desc = "Effect for Park Editor on the main screen when it is not highlighted: fade, flash, scan or matrix"
