    dadmod_ui_item id = mui_itemfx7 key = "ui_item7_fx" label = "Quit Game" kind = fx min = 0 max = 5 def = 0 desc = "Effect for Quit Game on the main screen when it is not highlighted: fade, flash, scan or matrix"
