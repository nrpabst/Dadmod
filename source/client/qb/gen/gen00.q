        return pieces = [ { a = Ped_M_Talk2_RightHere t = 2.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Talk2_KnowWhatIMean t = 3.4 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Talk2_MixIt t = 2.233 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Talk2_SureThing t = 1.667 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Talk2_WhatDoYouThink t = 2.733 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Talk2_OfCourse t = 2.233 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Talk2_RoundAndRound t = 3.633 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Talk2_GoAhead t = 3.267 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Talk2_UpAbove t = 3.467 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } { a = Ped_M_Idle1 t = 1.967 c = 0 } ]
    case 1
        return pieces = [ { a = Pro_Idle03a t = 6.333 c = 0 } { a = Pro_Idle03b t = 1.9 c = 0 } { a = Pro_Idle03a t = 6.333 c = 0 } { a = Pro_Idle03to06 t = 2.1 c = 0 } { a = Pro_Idle06a t = 2.0 c = 0 } { a = Pro_Idle06b t = 3.0 c = 0 } { a = Pro_Idle06a t = 2.0 c = 0 } { a = Pro_Idle06to03 t = 2.567 c = 0 } ]
    case 2
