dadmod_ui_scan_dir_names = [ "Right" "Down-right" "Down" "Down-left" "Left" "Up-left" "Up" "Up-right" ]

script dadmod_ui_scan_dir
    if (<value> < 0)
        value = 0
    endif
    dir = ( ( <value> + 22 ) / 45 )
    CastToInteger dir
    dadmod_ui_mod v = <dir> m = 8
    return dir = <v>
endscript

script dadmod_ui_effect_resolve
    if (<v> = 10)
        if THUGRECOMP_SettingLoad key = "ui_random_pick"
            return v = <value>
        endif
        return v = 5
    endif
    return v = <v>
endscript

script dadmod_ui_random_roll
    GetRandomValue Name = pick a = 1 b = 9 Integer
    THUGRECOMP_SettingSave key = "ui_random_pick" value = <pick>
    if (<pick> = 9)
        GetArraySize dadmod_ui_theme_names
        GetRandomValue Name = rtheme a = 1 b = ( <array_size> - 1 ) Integer
        THUGRECOMP_SettingSave key = "ui_random_theme" value = <rtheme>
    endif
endscript

script dadmod_ui_get
    v = <def>
    if THUGRECOMP_SettingLoad key = <key>
        v = <value>
    endif
    if GotParam raw
        return value = <v>
    endif
    if (<key> = "ui_rainbow")
        dadmod_ui_effect_resolve v = <v>
        if (<v> = 9)
            return value = 0
        endif
        if (<v> = 11)
            return value = 0
        endif
        return value = <v>
    endif
    keep = <v>
    m = 0
    if THUGRECOMP_SettingLoad key = "ui_rainbow"
        m = <value>
    endif
    stored_m = <m>
    dadmod_ui_effect_resolve v = <m>
    m = <v>
    v = <keep>
    if ( ( <key> = "ui_colortheme" ) or ( <key> = "ui_theme_mode" ) )
        if not (<m> = 9)
            return value = 0
        endif
        if (<key> = "ui_colortheme")
            if (<stored_m> = 10)
                if THUGRECOMP_SettingLoad key = "ui_random_theme"
                    return value = <value>
                endif
            endif
            if (<v> < 1)
                return value = 1
            endif
        endif
    endif
    if (<m> = 9)
        if ( ( <key> = "ui_bar" ) or ( <key> = "ui_title" ) )
            return value = <def>
        endif
    endif
    if (<m> = 0)
        offkeys = [ "ui_text" "ui_bar" "ui_title" "ui_text_fx" "ui_focus_fx" "ui_bar_fx" "ui_title_fx" "ui_bright" "ui_sat" "desc_color" "desc_accent_color" ]
        GetArraySize <offkeys>
        i = 0
        begin
            if (<i> = <array_size>)
                break
            endif
            if ( ( <offkeys> [ <i> ] ) = <key> )
                return value = <def>
            endif
            i = ( <i> + 1 )
        repeat
    endif
    return value = <v>
endscript

script dadmod_ui_color
    dadmod_ui_get key = <key> def = 0
    GetArraySize dadmod_ui_palette
    if (<value> > 0)
        if (<value> < <array_size>)
            dadmod_ui_adjust color = ( ( dadmod_ui_palette [ <value> ] ) . rgba )
            return color = <color>
        endif
    endif
endscript

script dadmod_ui_clamp
    if (<v> < 0)
        v = 0
    endif
    if (<v> > 255)
        v = 255
    endif
    CastToInteger v
    return v = <v>
endscript

script dadmod_ui_adjust
    if ( ( ( dadmod_ui_bright ) = 1.0 ) and ( ( dadmod_ui_sat ) = 1.0 ) )
        return color = <color>
    endif
    r = ( <color> [ 0 ] )
    g = ( <color> [ 1 ] )
    b = ( <color> [ 2 ] )
    gray = ( ( <r> + <g> + <b> ) / 3.0 )
    dadmod_ui_clamp v = ( ( <gray> + ( <r> - <gray> ) * ( dadmod_ui_sat ) ) * ( dadmod_ui_bright ) )
    r = <v>
    dadmod_ui_clamp v = ( ( <gray> + ( <g> - <gray> ) * ( dadmod_ui_sat ) ) * ( dadmod_ui_bright ) )
    g = <v>
    dadmod_ui_clamp v = ( ( <gray> + ( <b> - <gray> ) * ( dadmod_ui_sat ) ) * ( dadmod_ui_bright ) )
    b = <v>
    out = [ 0 0 0 128 ]
    SetArrayElement arrayname = out index = 0 newvalue = <r>
    SetArrayElement arrayname = out index = 1 newvalue = <g>
    SetArrayElement arrayname = out index = 2 newvalue = <b>
    SetArrayElement arrayname = out index = 3 newvalue = ( <color> [ 3 ] )
    return color = <out>
endscript

script dadmod_ui_apply
    dadmod_tod_watch_start
    Change dadmod_ui_gen = ( dadmod_ui_gen + 1 )
    if (dadmod_ui_saved = 0)
        Change dadmod_ui_orig = { unhl = ( ( THUGPRO_GlobalThemeInfo ) . UNHIGHLIGHTED_TEXT_COLOR ) hl = ( ( THUGPRO_GlobalThemeInfo ) . HIGHLIGHTED_TEXT_COLOR ) title = ( ( THUGPRO_GlobalThemeInfo ) . MENU_TITLE_COLOR ) }
        Change dadmod_ui_saved = 1
    endif
    dadmod_ui_get key = "ui_bright" def = 100
    Change dadmod_ui_bright = ( <value> / 100.0 )
    dadmod_ui_get key = "ui_sat" def = 100
    Change dadmod_ui_sat = ( <value> / 100.0 )
    unhl = ( ( dadmod_ui_orig ) . unhl )
    hl = ( ( dadmod_ui_orig ) . hl )
    title = ( ( dadmod_ui_orig ) . title )
    focus = [ 128 128 128 128 ]
    dadmod_ui_get key = "ui_colortheme" def = 0
    GetArraySize dadmod_ui_themes
    if (<value> > 0)
        if (<value> < <array_size>)
            th = ( dadmod_ui_themes [ <value> ] )
            unhl = ( <th> . text )
            hl = ( <th> . bar )
            title = ( <th> . title )
            focus = ( <th> . focus )
        endif
    endif
    if not ( ( ( dadmod_ui_bright ) = 1.0 ) and ( ( dadmod_ui_sat ) = 1.0 ) )
        dadmod_ui_adjust color = <unhl>
        unhl = <color>
        if (<hl> = _TP_YELLOW_VALUE)
            hl = ( _TP_YELLOW_VALUE )
        endif
        if (<title> = _TP_YELLOW_VALUE)
            title = ( _TP_YELLOW_VALUE )
        endif
        dadmod_ui_adjust color = <hl>
        hl = <color>
        dadmod_ui_adjust color = <title>
        title = <color>
        dadmod_ui_adjust color = <focus>
        focus = <color>
        RemoveParameter color
    endif
    dadmod_ui_color key = "ui_text"
    if GotParam color
        unhl = <color>
        RemoveParameter color
    endif
    dadmod_ui_color key = "ui_bar"
    if GotParam color
        hl = <color>
        RemoveParameter color
    endif
    dadmod_ui_color key = "ui_title"
    if GotParam color
        title = <color>
        RemoveParameter color
    endif
    dadmod_ui_color key = "ui_focus"
    if GotParam color
        focus = <color>
        RemoveParameter color
    endif
    Change THUGPRO_GlobalThemeInfo = ( THUGPRO_GlobalThemeInfo + { UNHIGHLIGHTED_TEXT_COLOR = <unhl> HIGHLIGHTED_TEXT_COLOR = <hl> MENU_TITLE_COLOR = <title> } )
    Change dadmod_ui_focus_rgba = <focus>
    Change dadmod_ui_text_rgba = <unhl>
    if (<hl> = _TP_YELLOW_VALUE)
        hl = ( _TP_YELLOW_VALUE )
    endif
    if (<title> = _TP_YELLOW_VALUE)
        title = ( _TP_YELLOW_VALUE )
    endif
    Change dadmod_ui_bar_rgba = <hl>
    Change dadmod_ui_title_rgba = <title>
    dadmod_ui_get key = "ui_rb_speed" def = 4
    dadmod_ui_level v = <value>
    Change dadmod_ui_rb_speed = <v>
    Change dadmod_ui_rb_rate = ( dadmod_ui_rates [ ( <v> - 1 ) ] )
    dadmod_ui_get key = "ui_fx_speed" def = 5
    dadmod_ui_level v = <value>
    Change dadmod_ui_fx_ms = ( dadmod_ui_fx_ms_table [ ( <v> - 1 ) ] )
    Change dadmod_ui_rb_theme = 0
    dadmod_ui_get key = "ui_rb_angle" def = 0
    dadmod_ui_scan_dir value = <value>
    Change dadmod_ui_rb_angle = ( <dir> * 3 )
    any_fx = 0
    dadmod_ui_get key = "ui_text_fx" def = 0
    fx_text = <value>
    dadmod_ui_get key = "ui_focus_fx" def = 0
    fx_focus = <value>
    dadmod_ui_get key = "ui_bar_fx" def = 0
    fx_bar = <value>
    dadmod_ui_get key = "ui_title_fx" def = 0
    fx_title = <value>
    if (<fx_title> = 12)
        dadmod_ui_title_match
        fx_title = <e>
    endif
    dadmod_ui_get key = "ui_hl_style" def = 0
    Change dadmod_ui_fx = { text = <fx_text> focus = <fx_focus> bar = <fx_bar> title = <fx_title> hl = <value> }
    if ( ( <fx_text> > 0 ) or ( <fx_focus> > 0 ) or ( <fx_bar> > 0 ) or ( <fx_title> > 0 ) )
        any_fx = 1
    endif
    Change dadmod_ui_item_scan = 0
    i = 0
    begin
        FormatText TextName = k "ui_item%i_fx" i = <i>
        dadmod_ui_get key = <k> def = 0
        if (<value> > 0)
            any_fx = 1
        endif
        if (<value> > 3)
            Change dadmod_ui_item_scan = 1
        endif
        i = ( <i> + 1 )
    repeat 8
    dadmod_ui_get key = "ui_rainbow" def = 0
    rb_on = <value>
    dadmod_ui_get key = "ui_colortheme" def = 0
    ct_on = <value>
    GetArraySize dadmod_ui_themes
    if not (<ct_on> < <array_size>)
        ct_on = 0
    endif
    if (<ct_on> < 0)
        ct_on = 0
    endif
    dadmod_ui_get key = "ui_theme_mode" def = 0
    busy = 0
    if (<rb_on> > 0)
        busy = 1
    else
        if ( ( <ct_on> > 0 ) and ( <value> > 0 ) )
            busy = 1
        endif
    endif
    Change dadmod_ui_items_busy = <busy>
    KillSpawnedScript Name = dadmod_ui_fx_loop
    if (<any_fx> = 1)
        SpawnScript dadmod_ui_fx_loop NotSessionSpecific = 1
    endif
    KillSpawnedScript Name = dadmod_ui_rainbow_loop
    dadmod_ui_scan_restore
    if (<rb_on> = 0)
        Change dadmod_ui_rb_theme = <ct_on>
    endif
    dadmod_ui_get key = "ui_rainbow" def = 0
    if (<value> > 0)
        Change dadmod_ui_rb_theme = 0
        SpawnScript dadmod_ui_rainbow_loop NotSessionSpecific = 1 params = { speed = <value> }
    else
        dadmod_ui_get key = "ui_colortheme" def = 0
        ct = <value>
        dadmod_ui_get key = "ui_theme_mode" def = 0
        GetArraySize dadmod_ui_themes
        if (<ct> > 0)
            if (<ct> < <array_size>)
                if (<value> > 0)
                    Change dadmod_ui_rb_theme = <ct>
                    switch <value>
                    case 1
                        loop_mode = 9
                    case 2
                        loop_mode = 10
                    case 3
                        loop_mode = 4
                    case 4
                        loop_mode = 5
                    default
                        loop_mode = 6
                    endswitch
                    SpawnScript dadmod_ui_rainbow_loop NotSessionSpecific = 1 params = { speed = <loop_mode> }
                endif
            endif
        endif
    endif
    if not ( ( ( dadmod_ui_fx ) . bar ) = 0 )
        Change random_effect_break_loop = 1
        fb = ( dadmod_ui_focused )
        if ScreenElementExists id = { <fb> child = bar }
            DoScreenElementMorph id = { <fb> child = bar } alpha = 1.0 time = 0
        endif
    endif
endscript

script dadmod_ui_item_tags
    RemoveParameter dadmod_rgba
    RemoveParameter dadmod_lgen
    <c> : GetTags
    lgen = -1
    if GotParam dadmod_lgen
        lgen = <dadmod_lgen>
    endif
    if GotParam dadmod_rgba
        return lgen = <lgen> own = <dadmod_rgba>
    endif
    return lgen = <lgen>
endscript

script dadmod_ui_repaint
    focused = ( dadmod_ui_focused )
    if ScreenElementExists id = current_menu
        if GetScreenElementChildren id = current_menu
            GetArraySize <children>
            i = 0
            begin
                if (<i> = <array_size>)
                    break
                endif
                c = ( <children> [ <i> ] )
                if ScreenElementExists id = { <c> child = text }
                    color = ( dadmod_ui_text_rgba )
                    dadmod_ui_item_tags c = <c>
                    if GotParam own
                        color = <own>
                        RemoveParameter own
                    endif
                    if (<c> = <focused>)
                        color = ( dadmod_ui_focus_rgba )
                    endif
                    SetScreenElementProps id = { <c> child = text } rgba = <color>
                endif
                i = ( <i> + 1 )
            repeat
        endif
    endif
    if ScreenElementExists id = { <focused> child = bar }
        SetScreenElementProps id = { <focused> child = bar } rgba = ( dadmod_ui_bar_rgba )
    endif
    if ScreenElementExists id = menu_title_text
        SetScreenElementProps id = menu_title_text rgba = ( dadmod_ui_title_rgba ) alpha = 1.0
        dadmod_ui_title_plain
    endif
endscript

script dadmod_ui_level
    if (<v> < 1)
        v = 1
    endif
    if (<v> > 10)
        v = 10
    endif
    return v = <v>
endscript

script dadmod_ui_mod
    begin
        if (<v> < <m>)
            break
        endif
        v = ( <v> - <m> )
    repeat
    return v = <v>
endscript

script dadmod_ui_dim
    out = [ 0 0 0 128 ]
    r = ( ( <color> [ 0 ] ) * 0.25 )
    g = ( ( <color> [ 1 ] ) * 0.25 )
    b = ( ( <color> [ 2 ] ) * 0.25 )
    CastToInteger r
    CastToInteger g
    CastToInteger b
    SetArrayElement arrayname = out index = 0 newvalue = <r>
    SetArrayElement arrayname = out index = 1 newvalue = <g>
    SetArrayElement arrayname = out index = 2 newvalue = <b>
    SetArrayElement arrayname = out index = 3 newvalue = ( <color> [ 3 ] )
    return color = <out>
endscript

script dadmod_ui_fx_target
    if (<e> = 0)
        return
    endif
    if (<e> = 4)
        if not GotParam pos_id
            pos_id = <id>
        endif
        dadmod_ui_scan_offset c = <pos_id>
        k = ( <tr> / 4 + 2400 - <off> )
        CastToInteger k
        dadmod_ui_wheel_color k = <k>
        DoScreenElementMorph id = <id> rgba = <color> time = 0.1
        return
    endif
    p = ( dadmod_ui_fx_ms )
    if (<e> = 2)
        p = ( <p> * 0.6 )
    endif
    if (<e> = 3)
        p = ( <p> * 0.2 )
    endif
    CastToInteger p
    if (<p> < 2)
        p = 2
    endif
    half = ( <p> / 2 )
    dadmod_ui_mod v = <t> m = <p>
    ph = <v>
    if (<ph> < <half>)
        target = <base>
        rem = ( <half> - <ph> )
    else
        dadmod_ui_dim color = <base>
        target = <color>
        rem = ( <p> - <ph> )
    endif
    if (<e> = 1)
        DoScreenElementMorph id = <id> rgba = <target> time = ( <rem> / 1000.0 )
    else
        SetScreenElementProps id = <id> rgba = <target>
    endif
endscript

script dadmod_ui_fx_item
    RemoveParameter dadmod_fx
    RemoveParameter dadmod_rgba
    <c> : GetTags
    e = ( <fx> . text )
    if GotParam dadmod_fx
        e = <dadmod_fx>
    endif
    base = ( dadmod_ui_text_rgba )
    if GotParam dadmod_rgba
        base = <dadmod_rgba>
    endif
    if (<e> = 4)
        dadmod_ui_fx_scan c = <c> tr = <tr> i = <i>
        return
    endif
    if (<e> = 5)
        dadmod_ui_scan_item c = <c> t = ( <tr> * 3 ) i = <i> lmode = 3 codes = ( ( dadmod_ui_themes [ 11 ] ) . codes )
        return
    endif
    if (<scan_any> = 1)
        dadmod_ui_fx_plain c = <c>
    endif
    dadmod_ui_fx_target id = { <c> child = text } e = <e> base = <base> t = <t> tr = <tr> pos_id = <c>
endscript

script dadmod_ui_fx_scan
    if <c> : GetSingleTag dadmod_txt
        dadmod_ui_scan_item c = <c> t = <tr> i = <i> lmode = 0
    else
        dadmod_ui_scan_offset c = <c>
        k = ( <tr> / 4 + 2400 - <off> )
        CastToInteger k
        dadmod_ui_wheel_color k = <k>
        DoScreenElementMorph id = { <c> child = text } rgba = <color> time = 0.1
    endif
endscript

script dadmod_ui_fx_plain
    RemoveParameter dadmod_txt
    <c> : GetTags
    if GotParam dadmod_txt
        SetScreenElementProps id = { <c> child = text } text = <dadmod_txt>
    endif
endscript

script dadmod_ui_fx_loop
    t = 0
    tr = 0
    begin
        THUGRECOMP_UiClock rate = ( dadmod_ui_rb_rate ) wrap = 10080
        t = <ms>
        fx = ( dadmod_ui_fx )
        scan_any = 0
        if ( ( ( <fx> . text ) = 4 ) or ( ( <fx> . focus ) = 4 ) or ( dadmod_ui_item_scan = 1 ) )
            scan_any = 1
        endif
        focused = ( dadmod_ui_focused )
        if ScreenElementExists id = current_menu
            if ( dadmod_ui_items_busy = 0 )
                if GetScreenElementChildren id = current_menu
                    GetArraySize <children>
                    i = 0
                    begin
                        if (<i> = <array_size>)
                            break
                        endif
                        c = ( <children> [ <i> ] )
                        if ScreenElementExists id = { <c> child = text }
                            if (<c> = <focused>)
                                if ( ( <fx> . focus ) = 4 )
                                    dadmod_ui_fx_scan c = <c> tr = <tr> i = <i>
                                else
                                    if (<scan_any> = 1)
                                        dadmod_ui_fx_plain c = <c>
                                    endif
                                    dadmod_ui_fx_target id = { <c> child = text } e = ( <fx> . focus ) base = ( dadmod_ui_focus_rgba ) t = <t> tr = <tr> pos_id = <c>
                                endif
                            else
                                dadmod_ui_fx_item c = <c> fx = <fx> t = <t> tr = <tr> i = <i> scan_any = <scan_any>
                            endif
                        endif
                        i = ( <i> + 1 )
                    repeat
                endif
            endif
            if ScreenElementExists id = { <focused> child = bar }
                dadmod_ui_bar_fx id = { <focused> child = bar } e = ( <fx> . bar ) t = <t>
            endif
        endif
        if ScreenElementExists id = menu_title_text
            dadmod_ui_title_fx e = ( <fx> . title ) t = <t> tr = <tr>
        endif
        wait 0.1 seconds
    repeat
endscript

script dadmod_ui_random_color
    random(
    @ color = [ 128 16 16 128 ]
    @ color = [ 128 64 0 128 ]
    @ color = [ 128 110 0 128 ]
    @ color = [ 80 128 0 128 ]
    @ color = [ 0 110 30 128 ]
    @ color = [ 0 120 120 128 ]
    @ color = [ 60 100 128 128 ]
    @ color = [ 20 40 128 128 ]
    @ color = [ 80 20 128 128 ]
    @ color = [ 128 50 100 128 ]
    @ color = [ 128 128 128 128 ]
    )
    th = ( dadmod_ui_themes [ ( dadmod_ui_rb_theme ) ] )
    if StructureContains structure = <th> colors
        cols = ( <th> . colors )
        GetArraySize <cols>
        n = <array_size>
        GetRandomValue Name = v a = 0 b = ( <n> - 1 ) Integer
        color = ( <cols> [ <v> ] )
    endif
    dadmod_ui_adjust color = <color>
    return color = <color>
endscript

dadmod_ui_wheel = [
[ 128 0 0 128 ]
[ 128 32 0 128 ]
[ 128 64 0 128 ]
[ 128 96 0 128 ]
[ 128 128 0 128 ]
[ 96 128 0 128 ]
[ 64 128 0 128 ]
[ 32 128 0 128 ]
[ 0 128 0 128 ]
[ 0 128 32 128 ]
[ 0 128 64 128 ]
[ 0 128 96 128 ]
[ 0 128 128 128 ]
[ 0 96 128 128 ]
[ 0 64 128 128 ]
[ 0 32 128 128 ]
[ 0 0 128 128 ]
[ 32 0 128 128 ]
[ 64 0 128 128 ]
[ 96 0 128 128 ]
[ 128 0 128 128 ]
[ 128 0 96 128 ]
[ 128 0 64 128 ]
[ 128 0 32 128 ]
]

dadmod_ui_rand_tick = 0

script dadmod_ui_wheel_color
    th = ( dadmod_ui_themes [ ( dadmod_ui_rb_theme ) ] )
    if StructureContains structure = <th> colors
        cols = ( <th> . colors )
        GetArraySize <cols>
        dadmod_ui_mod v = ( <k> / 4 ) m = <array_size>
        CastToInteger v
        dadmod_ui_adjust color = ( <cols> [ <v> ] )
        return color = <color>
    endif
    begin
        if (<k> < 24)
            break
        endif
        k = ( <k> - 24 )
    repeat
    dadmod_ui_adjust color = ( dadmod_ui_wheel [ <k> ] )
    return color = <color>
endscript

script dadmod_ui_wheel_lerp
    th = ( dadmod_ui_themes [ ( dadmod_ui_rb_theme ) ] )
    if StructureContains structure = <th> colors
        cols = ( <th> . colors )
        p = <f>
    else
        cols = ( dadmod_ui_wheel )
        p = <f>
    endif
    GetArraySize <cols>
    i0 = <p>
    CastToInteger i0
    frac = ( <p> - <i0> )
    dadmod_ui_mod v = <i0> m = <array_size>
    a = <v>
    v = ( <a> + 1 )
    if (<v> = <array_size>)
        v = 0
    endif
    c0 = ( <cols> [ <a> ] )
    c1 = ( <cols> [ <v> ] )
    out = [ 0 0 0 128 ]
    j = 0
    begin
        x = ( ( <c0> [ <j> ] ) + ( ( <c1> [ <j> ] ) - ( <c0> [ <j> ] ) ) * <frac> )
        CastToInteger x
        SetArrayElement arrayname = out index = <j> newvalue = <x>
        j = ( <j> + 1 )
    repeat 4
    dadmod_ui_adjust color = <out>
    return color = <color>
endscript

script dadmod_ui_effect_step
    order = [ 0 11 9 10 5 4 6 7 8 1 2 3 ]
    GetArraySize <order>
    pos = 0
    begin
        if (<pos> = <array_size>)
            pos = 0
            break
        endif
        if ( ( <order> [ <pos> ] ) = <value> )
            break
        endif
        pos = ( <pos> + 1 )
    repeat
    if GotParam left
        pos = ( <pos> - 1 )
        if (<pos> < 0)
            pos = ( <array_size> - 1 )
        endif
    else
        pos = ( <pos> + 1 )
        if (<pos> = <array_size>)
            pos = 0
        endif
    endif
    return value = ( <order> [ <pos> ] )
endscript

script dadmod_ui_rb_need
    dadmod_ui_get key = "ui_rainbow" def = 0
    eff = <value>
    eff_on = 0
    if (<eff> > 0)
        eff_on = 1
    endif
    if (<eff> = 0)
        dadmod_ui_get key = "ui_colortheme" def = 0
        if (<value> > 0)
            dadmod_ui_get key = "ui_theme_mode" def = 0
            switch <value>
            case 3
                eff = 4
            case 4
                eff = 5
            case 5
                eff = 6
            endswitch
        endif
    endif
    spd = 0
    dir = 0
    if (<eff> > 3)
        spd = 1
    endif
    if (<eff> > 4)
        dir = 1
    endif
    if (<eff> = 7)
        spd = 0
        dir = 0
    endif
    fxkeys = [ "ui_text_fx" "ui_focus_fx" ]
    GetArraySize <fxkeys>
    i = 0
    begin
        if (<i> = <array_size>)
            break
        endif
        dadmod_ui_get key = ( <fxkeys> [ <i> ] ) def = 0
        if (<value> = 4)
            spd = 1
            dir = 1
        endif
        i = ( <i> + 1 )
    repeat
    te = ( ( dadmod_ui_fx ) . title )
    if (<te> = 6)
        spd = 1
        dir = 1
    endif
    if ( ( <te> = 7 ) or ( <te> = 9 ) )
        spd = 1
    endif
    if (<te> = 11)
        dir = 1
    endif
    return rb_spd = <spd> rb_dir = <dir> rb_on = <eff_on>
endscript

script dadmod_ui_should_grey
    dadmod_ui_get key = "ui_rainbow" def = 0 raw
    dadmod_ui_effect_resolve v = <value>
    m = <v>
    if ( ( <key> = "ui_colortheme" ) or ( <key> = "ui_theme_mode" ) )
        if (<m> = 9)
            return grey_it = 0
        endif
        return grey_it = 1
    endif
    if (<m> = 0)
        offkeys = [ "ui_text" "ui_bar" "ui_title" "ui_text_fx" "ui_focus_fx" "ui_bar_fx" "ui_title_fx" "ui_bright" "ui_sat" "desc_color" "desc_accent_color" "ui_rb_speed" "ui_rb_angle" "ui_fx_speed" ]
        GetArraySize <offkeys>
        i = 0
        begin
            if (<i> = <array_size>)
                break
            endif
            if ( ( <offkeys> [ <i> ] ) = <key> )
                return grey_it = 1
            endif
            i = ( <i> + 1 )
        repeat
    endif
    if ( ( <key> = "ui_bar" ) or ( <key> = "ui_title" ) )
        if (<m> = 9)
            return grey_it = 1
        endif
    endif
    if (<key> = "ui_focus_fx")
        if ( ( <m> > 1 ) and ( <m> < 9 ) )
            return grey_it = 1
        endif
    endif
    if ( ( <key> = "ui_bar" ) or ( <key> = "ui_bar_fx" ) )
        dadmod_ui_get key = "ui_hl_style" def = 0
        hs = <value>
        if ( ( <hs> = 1 ) or ( <hs> = 2 ) or ( <hs> = 3 ) or ( <hs> = 6 ) or ( <hs> = 7 ) )
            return grey_it = 1
        endif
        if (<key> = "ui_bar_fx")
            if ( ( <hs> = 4 ) or ( <hs> = 5 ) )
                return grey_it = 1
            endif
        endif
    endif
    if ( ( <key> = "ui_text" ) or ( <key> = "ui_text_fx" ) )
        if ( ( <m> = 0 ) or ( <m> = 9 ) or ( <m> = 11 ) )
            return grey_it = 0
        endif
        return grey_it = 1
    endif
    if (<key> = "ui_rb_speed")
        dadmod_ui_rb_need
        if (<rb_spd> = 0)
            return grey_it = 1
        endif
    endif
    if (<key> = "ui_rb_angle")
        dadmod_ui_rb_need
        if (<rb_dir> = 0)
            return grey_it = 1
        endif
    endif
    return grey_it = 0
endscript

script dadmod_ui_lerp
    out = [ 0 0 0 128 ]
    j = 0
    begin
        x = ( ( <a> [ <j> ] ) + ( ( <b> [ <j> ] ) - ( <a> [ <j> ] ) ) * <f> )
        CastToInteger x
        SetArrayElement arrayname = out index = <j> newvalue = <x>
        j = ( <j> + 1 )
    repeat 4
    return color = <out>
endscript

script dadmod_ui_bar_fx
    if (<e> < 2)
        return
    endif
    if (<e> = 10)
        return
    endif
    if not GotParam base
        base = ( dadmod_ui_bar_rgba )
    endif
    if not GotParam other
        other = ( dadmod_ui_focus_rgba )
    endif
    p = ( dadmod_ui_fx_ms )
    CastToInteger p
    switch <e>
    case 2
        p = ( <p> * 2 )
    case 3
        p = ( <p> / 2 )
    case 6
        p = ( <p> / 4 )
    case 9
        p = ( <p> / 2 )
    case 8
        p = ( <p> * 3 / 2 )
    endswitch
    if GotParam slow
        if (<e> = 2)
            p = ( <p> * <slow> )
        endif
    endif
    CastToInteger p
    if (<p> < 200)
        p = 200
    endif
    dadmod_ui_mod v = <t> m = <p>
    ph = ( <v> * 1.0 / <p> )
    tri = ( <ph> * 2.0 )
    if (<tri> > 1.0)
        tri = ( 2.0 - <tri> )
    endif
    white = [ 128 128 128 128 ]
    switch <e>
    case 2
        dadmod_ui_dim color = <base>
        dadmod_ui_lerp a = <base> b = <color> f = <tri>
        DoScreenElementMorph id = <id> rgba = <color> time = 0.1
    case 3
        dadmod_ui_lerp a = <base> b = <white> f = ( <tri> * 0.6 )
        DoScreenElementMorph id = <id> rgba = <color> time = 0.1
    case 4
        dadmod_ui_wheel_lerp f = ( <t> * 8.0 / <p> )
        DoScreenElementMorph id = <id> rgba = <color> time = 0.1
    case 5
        dadmod_ui_lerp a = <base> b = <other> f = <tri>
        DoScreenElementMorph id = <id> rgba = <color> time = 0.1
    case 6
        if (<ph> < 0.5)
            SetScreenElementProps id = <id> rgba = <base>
        else
            dadmod_ui_dim color = <base>
            dadmod_ui_dim color = <color>
            SetScreenElementProps id = <id> rgba = <color>
        endif
    case 7
        GetRandomValue Name = flick a = 0 b = 9 Integer
        if (<flick> < 2)
            dadmod_ui_dim color = <base>
            SetScreenElementProps id = <id> rgba = <color>
        else
            SetScreenElementProps id = <id> rgba = <base>
        endif
    case 8
        beat = 0
        if (<ph> < 0.08)
            beat = 1
        endif
        if (<ph> > 0.16)
            if (<ph> < 0.24)
                beat = 1
            endif
        endif
        if (<beat> = 1)
            dadmod_ui_lerp a = <base> b = <white> f = 0.6
            DoScreenElementMorph id = <id> rgba = <color> time = 0.05
        else
            DoScreenElementMorph id = <id> rgba = <base> time = 0.15
        endif
    case 9
        if (<ph> < 0.5)
            SetScreenElementProps id = <id> rgba = [ 128 12 12 128 ]
        else
            SetScreenElementProps id = <id> rgba = [ 16 40 128 128 ]
        endif
    endswitch
endscript

script dadmod_bar_slide
    DoMorph time = 0 Pos = { (-40.0,0.0) relative } alpha = 0
    DoMorph time = 0.12 Pos = { (40.0,0.0) relative } alpha = 1
endscript

script dadmod_ui_scan_offset
    trig = ( dadmod_ui_trig [ ( dadmod_ui_rb_angle ) ] )
    GetScreenElementPosition id = <c>
    x = ( <ScreenElementPos> . (1.0,0.0) )
    y = ( <ScreenElementPos> . (0.0,1.0) )
    return off = ( ( <x> * ( <trig> . c ) + <y> * ( <trig> . s ) ) / 12.0 )
endscript

script dadmod_ui_scan_item
    RemoveParameter dadmod_txt
    RemoveParameter dadmod_center
    RemoveParameter dadmod_brk
    <c> : GetTags
    center = 0
    if GotParam dadmod_center
        center = 1
    endif
    trig = ( dadmod_ui_trig [ ( dadmod_ui_rb_angle ) ] )
    GetScreenElementPosition id = <c>
    if not GotParam codes
        codes = ( ( dadmod_ui_themes [ ( dadmod_ui_rb_theme ) ] ) . codes )
    endif
    if GotParam dadmod_txt
        THUGRECOMP_ScanText text = <dadmod_txt> mode = <lmode> codes = <codes> item = <i> t = <t> x = ( <ScreenElementPos> . (1.0,0.0) ) y = ( <ScreenElementPos> . (0.0,1.0) ) c = ( <trig> . c ) s = ( <trig> . s ) center = <center>
        v = ( 128 * ( dadmod_ui_bright ) )
        dadmod_ui_clamp v = <v>
        gray = [ 128 128 128 128 ]
        SetArrayElement arrayname = gray index = 0 newvalue = <v>
        SetArrayElement arrayname = gray index = 1 newvalue = <v>
        SetArrayElement arrayname = gray index = 2 newvalue = <v>
        if GotParam dadmod_brk
            if not (<dadmod_brk> = "")
                brk = <dadmod_brk>
                if (<brk> = "scan")
                    dadmod_hl_brk_code t = <t>
                    brk = <brk_code>
                endif
                THUGRECOMP_TextClip text = <text> max = 80
                FormatText TextName = text "%b> \\c0%t %b<" b = <brk> t = <clipped>
            endif
        endif
        SetScreenElementProps id = { <c> child = text } text = <text> rgba = <gray>
    else
        dadmod_ui_scan_offset c = <c> i = <i>
        k = ( <t> / 4 + 2400 - <off> )
        CastToInteger k
        dadmod_ui_wheel_color k = <k>
        DoScreenElementMorph id = { <c> child = text } rgba = <color> time = 0.1
    endif
endscript

script dadmod_ui_scan_restore
    if ScreenElementExists id = current_menu
        if GetScreenElementChildren id = current_menu
            GetArraySize <children>
            i = 0
            begin
                if (<i> = <array_size>)
                    break
                endif
                c = ( <children> [ <i> ] )
                if ScreenElementExists id = { <c> child = text }
                    RemoveParameter dadmod_txt
                    <c> : GetTags
                    if GotParam dadmod_txt
                        SetScreenElementProps id = { <c> child = text } text = <dadmod_txt>
                    endif
                endif
                i = ( <i> + 1 )
            repeat
        endif
    endif
endscript

script dadmod_ui_scan_or_hl
    if (<hl_own> = 1)
        if (<c> = ( dadmod_ui_focused ))
            dadmod_ui_hl_plain c = <c> t = <t>
            return
        endif
    endif
    dadmod_ui_scan_item c = <c> t = <t> i = <i> lmode = <lmode>
endscript

script dadmod_ui_hl_plain
    RemoveParameter dadmod_txt
    RemoveParameter dadmod_brk
    <c> : GetTags
    if not GotParam dadmod_txt
        SetScreenElementProps id = { <c> child = text } rgba = ( dadmod_ui_focus_rgba )
        return
    endif
    text = <dadmod_txt>
    if GotParam dadmod_brk
        if not (<dadmod_brk> = "")
            brk = <dadmod_brk>
            if (<brk> = "scan")
                dadmod_hl_brk_code t = <t>
                brk = <brk_code>
            endif
            THUGRECOMP_TextClip text = <dadmod_txt> max = 80
            FormatText TextName = text "%b> \\c0%t %b<" b = <brk> t = <clipped>
        endif
    endif
    SetScreenElementProps id = { <c> child = text } text = <text> rgba = ( dadmod_ui_focus_rgba )
endscript

script dadmod_ui_rainbow_loop
    t = 0
    begin
        hl_own = 0
        if THUGRECOMP_SettingLoad key = "ui_focus"
            if (<value> > 0)
                hl_own = 1
            endif
        endif
        if (<speed> > 3)
            THUGRECOMP_UiClock rate = ( dadmod_ui_rb_rate ) wrap = 10080
            t = <tr>
        endif
        if ScreenElementExists id = current_menu
            if GetScreenElementChildren id = current_menu
                GetArraySize <children>
                i = 0
                begin
                    if (<i> = <array_size>)
                        break
                    endif
                    c = ( <children> [ <i> ] )
                    if ScreenElementExists id = { <c> child = text }
                        switch <speed>
                        case 1
                            if not <c> : GetSingleTag dadmod_rgba
                                dadmod_ui_item_tags c = <c>
                                RemoveParameter own
                                if not (<lgen> = ( dadmod_ui_gen ))
                                    dadmod_ui_random_color
                                    SetScreenElementProps id = <c> tags = { dadmod_lrgba = <color> dadmod_lgen = ( dadmod_ui_gen ) }
                                    if not (<c> = ( dadmod_ui_focused ))
                                        SetScreenElementProps id = { <c> child = text } rgba = <color>
                                    endif
                                endif
                            endif
                        case 4
                            dadmod_ui_wheel_lerp f = ( <t> / 4.0 )
                            fade_c = <color>
                            dadmod_ui_wheel_lerp f = ( <t> / 4.0 + 2.5 )
                            SetScreenElementProps id = <c> tags = { dadmod_lrgba = <fade_c> dadmod_frgba = <color> dadmod_lgen = ( dadmod_ui_gen ) }
                            if (<hl_own> = 1)
                                dadmod_ui_lerp a = ( dadmod_ui_focus_rgba ) b = <color> f = 0.35
                                SetScreenElementProps id = <c> tags = { dadmod_frgba = <color> }
                            endif
                            if (<c> = ( dadmod_ui_focused ))
                                DoScreenElementMorph id = { <c> child = text } rgba = <color> time = 0.1
                            else
                                DoScreenElementMorph id = { <c> child = text } rgba = <fade_c> time = 0.1
                            endif
                        case 5
                            dadmod_ui_scan_or_hl c = <c> t = <t> i = <i> lmode = 0 hl_own = <hl_own>
                        case 6
                            dadmod_ui_scan_or_hl c = <c> t = <t> i = <i> lmode = 1 hl_own = <hl_own>
                        case 7
                            dadmod_ui_scan_or_hl c = <c> t = <t> i = <i> lmode = 2 hl_own = <hl_own>
                        case 8
                            dadmod_ui_scan_or_hl c = <c> t = <t> i = <i> lmode = 3 hl_own = <hl_own>
                        case 9
                            th = ( dadmod_ui_themes [ ( dadmod_ui_rb_theme ) ] )
                            cols = ( <th> . colors )
                            GetArraySize <cols>
                            dadmod_ui_mod v = <i> m = <array_size>
                            dadmod_ui_adjust color = ( <cols> [ <v> ] )
                            SetScreenElementProps id = <c> tags = { dadmod_lrgba = <color> dadmod_lgen = ( dadmod_ui_gen ) }
                            if not (<c> = ( dadmod_ui_focused ))
                                SetScreenElementProps id = { <c> child = text } rgba = <color>
                            endif
                        case 10
                            dadmod_ui_scan_or_hl c = <c> t = 0 i = <i> lmode = 0 hl_own = <hl_own>
                        default
                            if not ( ( <hl_own> = 1 ) and ( <c> = ( dadmod_ui_focused ) ) )
                                dadmod_ui_random_color
                                SetScreenElementProps id = { <c> child = text } rgba = <color>
                            endif
                        endswitch
                    endif
                    i = ( <i> + 1 )
                repeat
            endif
        endif
        if (<speed> < 4)
            t = ( <t> + 1 )
        endif
        if (<t> > 9599)
            t = 0
        endif
        switch <speed>
        case 1
            wait 0.5 seconds
        case 2
            wait 1.2 seconds
        case 4
            wait 0.1 seconds
        case 5
            wait 0.1 seconds
        case 6
            wait 0.1 seconds
        case 7
            wait 0.5 seconds
        case 8
            wait 0.1 seconds
        case 9
            wait 0.5 seconds
        case 10
            wait 0.5 seconds
        default
            wait 0.25 seconds
        endswitch
    repeat
endscript

script dadmod_ui_main_style
    dadmod_ui_get key = "ui_size" def = 100
    tscale = ( 0.42 * <value> / 100.0 )
    dadmod_ui_get key = "ui_side" def = 2
    switch <value>
    case 0
        return style = MENU_STYLE_LEFT title_scale = <tscale>
    case 1
        return style = MENU_STYLE_MIDDLE title_scale = <tscale>
    endswitch
    return style = MENU_STYLE_RIGHT title_scale = <tscale>
endscript

script dadmod_ui_main_item_scale
    dadmod_ui_get key = "ui_size" def = 100
    size = <value>
    dadmod_ui_get key = "ui_scale" def = 120
    return item_scale = ( <value> * <size> / 10000.0 )
endscript

script dadmod_ui_offset_main
    dadmod_ui_get key = "ui_logo" def = 0
    if (<value> = 1)
        if ScreenElementExists id = menu_title_texture
            DestroyScreenElement id = menu_title_texture
        endif
    endif
    dadmod_ui_get key = "ui_x" def = 0
    x = <value>
    dadmod_ui_get key = "ui_y" def = 0
    y = <value>
    if ( ( <x> = 0 ) and ( <y> = 0 ) )
        return
    endif
    if ScreenElementExists id = current_menu
        GetScreenElementPosition id = current_menu
        SetScreenElementProps id = current_menu pos = ( <ScreenElementPos> + (1.0,0.0) * <x> + (0.0,1.0) * <y> )
    endif
endscript

script thugpro_menu_item_focus
    GetTags
    Change dadmod_ui_focused = <id>
    text_id = { <id> child = text }
    if ScreenElementExists id = <text_id>
        frgba = ( dadmod_ui_focus_rgba )
        if GotParam dadmod_frgba
            if GotParam dadmod_lgen
                if (<dadmod_lgen> = ( dadmod_ui_gen ))
                    frgba = <dadmod_frgba>
                endif
            endif
        endif
        SetScreenElementProps {
        id = <text_id>
        rgba = <frgba>
        }
    endif
    thugpro_menu_update_scrollbar {
    scrollbar_id = { current_menu_anchor child = scrollbar }
    id = <id>
    parent = <parent>
    }
    if not GotParam child_texture_persistent
        icon_id = { <id> child = icon }
        if ScreenElementExists id = <icon_id>
            DoScreenElementMorph {
            id = <icon_id>
            alpha = 0.9
            time = 0.1
            }
        endif
    endif
    if ScreenElementExists id = { <id> child = left_arrow }
        DoScreenElementMorph {
        id = { <id> child = left_arrow }
        alpha = 1
        }
        DoScreenElementMorph {
        id = { <id> child = left_arrow }
        scale = 0.4
        time = 0.1
        }
    endif
    if ScreenElementExists id = { <id> child = right_arrow }
        DoScreenElementMorph {
        id = { <id> child = right_arrow }
        alpha = 1
        }
        DoScreenElementMorph {
        id = { <id> child = right_arrow }
        scale = 0.4
        time = 0.1
        }
    endif
    bar_id = { <id> child = bar }
    if ScreenElementExists id = <bar_id>
        DoScreenElementMorph {
        id = <bar_id>
        alpha = 1.0
        time = 0.1
        }
        SetScreenElementProps {
        id = <bar_id>
        rgba = ( ( THUGPRO_GlobalThemeInfo ) . HIGHLIGHTED_TEXT_COLOR )
        }
        dadmod_hl_style
        if ( ( ( ( dadmod_ui_fx ) . bar ) = 0 ) and ( <hl> = 0 ) )
            RunScriptOnScreenElement id = <bar_id> do_random_effect_paused
        endif
        if ( ( ( dadmod_ui_fx ) . bar ) = 10 )
            RunScriptOnScreenElement id = <bar_id> dadmod_bar_slide
        endif
    endif
    dadmod_hl_focus id = <id>
    dadmod_fit_extra id = <id> time = 0.08
endscript

script thugpro_menu_item_unfocus
    GetTags
    text_id = { <id> child = text }
    if ScreenElementExists id = <text_id>
        rgba = ( ( THUGPRO_GlobalThemeInfo ) . UNHIGHLIGHTED_TEXT_COLOR )
        if GotParam dadmod_rgba
            rgba = <dadmod_rgba>
        endif
        if GotParam dadmod_lgen
            if (<dadmod_lgen> = ( dadmod_ui_gen ))
                rgba = <dadmod_lrgba>
            endif
        endif
        SetScreenElementProps id = <text_id> rgba = <rgba>
    endif
    if ScreenElementExists id = { <id> child = left_arrow }
        DoScreenElementMorph {
        id = { <id> child = left_arrow }
        alpha = 0
        scale = 0
        }
    endif
    if ScreenElementExists id = { <id> child = right_arrow }
        DoScreenElementMorph {
        id = { <id> child = right_arrow }
        alpha = 0
        scale = 0
        }
    endif
    if not GotParam child_texture_persistent
        icon_id = { <id> child = icon }
        if ScreenElementExists id = <icon_id>
            DoScreenElementMorph {
            id = <icon_id>
            alpha = 0.0
            }
        endif
    endif
    bar_id = { <id> child = bar }
    if ScreenElementExists id = <bar_id>
        DoScreenElementMorph {
        id = <bar_id>
        alpha = 0.0
        }
    endif
    Change random_effect_break_loop = 1
    KillSpawnedScript Name = do_random_effect_paused
    KillSpawnedScript Name = do_random_effect_paused_2
    dadmod_hl_unfocus id = <id>
    dadmod_fit_extra id = <id> time = 0.08
endscript

script thugpro_load_theme
    if GotParam value
        thugpro_change_theme theme = <value> dont_save
    endif
    dadmod_ui_random_roll
    dadmod_theme_first_save
    Change dadmod_ui_saved = 0
    dadmod_ui_apply
    dadmod_ui_repaint
endscript

script dadmod_ui_title_plain
    if ScreenElementExists id = menu_title_text
        RemoveParameter dadmod_txt
        menu_title_text : GetTags
        if GotParam dadmod_txt
            SetScreenElementProps id = menu_title_text text = <dadmod_txt>
        endif
    endif
endscript

script create_dadmod_ui_menu
    default_skateshop_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_menuui
    scrolling
    menu_title = "Menu UI"
    menu_style = MENU_STYLE_LEFT
    helper_text = generic_helper_text
    pad_back_script = create_dadmod_setup_menu
    show_description_panel
    show_gradient
    }
    make_thugpro_menu_item {
    text = "Text colors"
    id = mui_text
    description_text = "Every text color setting in one place: color scan, rainbow, themes, your own colors and effects, and the description box"
    pad_choose_script = create_dadmod_ui_colours_menu
    }
    make_thugpro_menu_item {
    text = "Main screen"
    id = mui_main_menu
    description_text = "Size and position of the main screen options, plus a color and effect for each one"
    pad_choose_script = create_dadmod_ui_main_menu
    }
    dadmod_ui_item id = mui_edit_theme key = "none" label = "Edit Theme" kind = uiaction min = 0 max = 0 def = 0 action = dadmod_theme_open desc = "Opens the stock Edit Theme menu for your custom theme: meters, icons and every theme color, plus Random Theme and Saved Themes"
    make_thugpro_menu_item {
    text = "Reset Menu UI"
    id = mui_reset
    description_text = "Puts every Menu UI setting back to stock"
    pad_choose_script = dadmod_ui_reset
    }
    dadmod_desc_panel_right
    thugpro_menu_finalize <...>
endscript

script dadmod_ui_submenu
    default_skateshop_menu_cleanup
    thugpro_menu_create {
    menu_name = <name>
    scrolling
    menu_title = <title>
    menu_style = MENU_STYLE_LEFT
    helper_text = generic_helper_text
    pad_back_script = <back>
    show_description_panel
    show_gradient
    }
endscript

script create_dadmod_ui_colours_menu
    dadmod_ui_submenu name = dadmod_menuui_colours title = "Text colors" back = create_dadmod_ui_menu
    dadmod_ui_item id = mui_c_theme key = "ui_colortheme" label = "Theme" kind = ctheme min = 1 max = 11 def = 1 desc = "A ready-made color set for all menus. Only used when Effect is Theme. Your own colors below still win where you set them"
    dadmod_ui_item id = mui_c_thmode key = "ui_theme_mode" label = "Theme style" kind = thmode min = 0 max = 5 def = 0 desc = "How the theme colors are laid out: solid, one per option, per letter, or moving. Anything but Solid colors the options itself, so Text FX and Highlight FX wait until it is Solid"
    dadmod_ui_item id = mui_c_text key = "ui_text" label = "Text color" kind = color min = 0 max = 13 def = 0 desc = "Color of menu options that are not highlighted"
    dadmod_ui_item id = mui_c_textfx key = "ui_text_fx" label = "Text FX" kind = fx min = 0 max = 4 def = 0 desc = "Effect on options that are not highlighted. Scan runs the colors across the letters. the Effect or a Theme style other than Solid take over while on"
    dadmod_ui_item id = mui_c_focus key = "ui_focus" label = "Highlight color" kind = color min = 0 max = 13 def = 0 desc = "Color of the option you are on, with every Effect. Scan tints it as it moves; Rainbow, Confetti, Mosaic, Matrix and Shuffle keep the option you are on solid in this color. Default leaves each Effect its own look"
    dadmod_ui_item id = mui_c_focusfx key = "ui_focus_fx" label = "Highlight FX" kind = fx min = 0 max = 4 def = 0 desc = "Effect on the option you are on. Scan runs the colors across the letters. the Effect or a Theme style other than Solid take over while on"
    dadmod_ui_item id = mui_c_bar key = "ui_bar" label = "Bar color" kind = color min = 0 max = 13 def = 0 desc = "Color of the bar behind the option you are on"
    dadmod_ui_item id = mui_c_barfx key = "ui_bar_fx" label = "Bar FX" kind = barfx min = 0 max = 10 def = 0 desc = "Effect on the highlight bar. Glitch is the stock jitter, Still turns it off. Breathe, Pulse, Rainbow, Two-tone (to the Highlight color), Strobe, Neon flicker, Heartbeat, Police lights, or Slide (the bar slides in each time you move). Speed follows FX speed"
    dadmod_ui_item id = mui_c_title key = "ui_title" label = "Title color" kind = color min = 0 max = 13 def = 0 desc = "Color of menu titles"
    dadmod_ui_item id = mui_c_titlefx key = "ui_title_fx" label = "Title effect" kind = titlefx min = 0 max = 12 def = 0 desc = "Effect on the menu title at the top. Uses your theme: its colors on Theme, rainbow colors otherwise. Breathe, Pulse, Two-tone and Strobe pulse the title color. Fade and Scan run the colors over it. Confetti, Mosaic and Per letter color each letter. Decode unscrambles it, then settles. Match menu copies the Effect or Theme style"
    dadmod_ui_item id = mui_c_fxspeed key = "ui_fx_speed" label = "FX speed" kind = num min = 1 max = 10 def = 5 desc = "How fast the Fade and Flash FX and every Bar FX go, plus the Title effect. Scan uses the Effect speed"
    dadmod_ui_item id = mui_c_desc key = "desc_color" label = "Box text" kind = color min = 0 max = 13 def = 0 desc = "Color of the text in this description box"
    dadmod_ui_item id = mui_c_descacc key = "desc_accent_color" label = "Box line" kind = color min = 0 max = 13 def = 0 desc = "Color of the thin line on top of this description box. Default follows the bar color"
    dadmod_ui_item id = mui_c_reset key = "ui_text" label = "Reset colors" kind = colorreset min = 0 max = 0 def = 0 desc = "Puts every text color, effect, theme and rainbow setting back to stock. Main screen size and position stay"
    dadmod_ui_item id = mui_c_bright key = "ui_bright" label = "Menu brightness" kind = num min = 20 max = 200 step = 5 def = 100 desc = "Brightness of all menu colors. 100 is normal"
    dadmod_ui_item id = mui_c_sat key = "ui_sat" label = "Menu saturation" kind = num min = 0 max = 200 step = 5 def = 100 desc = "Color strength of all menu colors. 0 is grey, 100 is normal"
    dadmod_desc_panel_right
    thugpro_menu_finalize <...>
endscript

script create_dadmod_ui_rainbow_menu
    dadmod_ui_submenu name = dadmod_menuui_rainbow title = "Rainbow" back = create_dadmod_ui_menu
    dadmod_ui_item id = mui_rb_true key = "ui_rainbow" label = "Color scan" kind = truerainbow min = 0 max = 0 def = 5 desc = "One press: a rainbow scans across the letters of every menu. Effect Static turns it off"
    dadmod_ui_item id = mui_rainbow key = "ui_rainbow" label = "Effect" kind = rainbow min = 0 max = 11 def = 0 desc = "Off keeps the stock menu colors, except your Highlight style, Highlight color and Main menu colors. Static uses only your own colors and the main menu colors. Theme uses the Theme and Theme style below. Random picks a new effect every time the game starts. Rainbow, Scan, Confetti, Mosaic, Matrix, Random and Shuffle move the colors"
    dadmod_ui_item id = mui_rb_speed key = "ui_rb_speed" label = "Effect speed" kind = num min = 1 max = 10 def = 4 desc = "How fast the Effect moves (Rainbow, Scan, Confetti, Matrix) and Scan FX. 4 is the default. Greyed out while nothing on this page uses it"
    dadmod_ui_item id = mui_rb_speed_def key = "ui_rb_speed" label = "Reset speed" kind = reset min = 0 max = 0 def = 4 desc = "Puts the effect speed back to 4"
    dadmod_ui_item id = mui_rb_angle key = "ui_rb_angle" label = "Direction" kind = angle min = 0 max = 315 step = 45 def = 0 desc = "Which way Rainbow, Confetti, Matrix and Scan FX sweep across the menu. Greyed out while nothing on this page uses it"
    dadmod_ui_item id = mui_rb_angle_def key = "ui_rb_angle" label = "Reset direction" kind = reset min = 0 max = 0 def = 0 desc = "Puts the direction back to left to right"
    dadmod_desc_panel_right
    thugpro_menu_finalize <...>
endscript

script create_dadmod_ui_main_menu
    dadmod_ui_submenu name = dadmod_menuui_main title = "Main screen" back = create_dadmod_ui_menu
    dadmod_ui_item id = mui_hl_style key = "ui_hl_style" label = "Highlight style" kind = gfxlist min = 0 max = 7 def = 0 list = ui_hl_style desc = "How the option you are on stands out. Default is the bar. Grow, Slide, Brackets, Underline, Side marker, Spotlight (dims the rest) or Wave"
    dadmod_ui_item id = mui_br_color key = "ui_br_color" label = "Brackets color" kind = gfxlist min = 0 max = 10 def = 10 list = ui_br_color desc = "Color of the > < brackets around the option you are on. Text color uses the option's own color. Letter-by-letter effects recolor them"
    dadmod_ui_item id = mui_br_speed key = "ui_br_speed" label = "Brackets speed" kind = num min = 1 max = 10 def = 5 desc = "How fast the Scan brackets change color. 5 is the default"
    dadmod_ui_item id = mui_side key = "ui_side" label = "Position" kind = gfxlist min = 0 max = 2 def = 2 list = ui_side desc = "Where the main screen menu sits: left, center or right"
    dadmod_ui_item id = mui_main_def key = "none" label = "Defaults" kind = uiaction min = 0 max = 0 def = 0 action = dadmod_ui_main_defaults desc = "Puts position, size, text size, nudges, deck graphic and logo back to stock"
    dadmod_ui_item id = mui_logo key = "ui_logo" label = "THUG PRO logo" kind = gfxlist min = 0 max = 1 def = 0 list = ui_logo desc = "Shows or hides the THUG PRO logo above the main screen menu"
    dadmod_ui_item id = mui_size key = "ui_size" label = "Size" kind = num min = 70 max = 120 step = 5 def = 100 desc = "Size of the main screen menu, logo and options together. 100 is stock"
    dadmod_ui_item id = mui_scale key = "ui_scale" label = "Text size" kind = num min = 60 max = 200 step = 5 def = 120 desc = "Text size of the main screen options on their own. 120 is stock"
    dadmod_ui_item id = mui_x key = "ui_x" label = "Nudge L/R" kind = num min = -320 max = 320 step = 5 def = 0 desc = "Fine-tunes the options left or right. 0 is stock"
    dadmod_ui_item id = mui_y key = "ui_y" label = "Nudge U/D" kind = num min = -240 max = 240 step = 5 def = 0 desc = "Fine-tunes the options up or down. 0 is stock"
    make_thugpro_menu_item {
    text = "Option colors"
    id = mui_items
    description_text = "Give each main screen option its own color"
    pad_choose_script = create_dadmod_ui_items_menu
    }
    make_thugpro_menu_item {
    text = "Option effects"
    id = mui_items_fx
    description_text = "Give each main screen option its own effect: fade, flash or scan"
    pad_choose_script = create_dadmod_ui_itemsfx_menu
    }
    dadmod_desc_panel_right
    thugpro_menu_finalize <...>
endscript

