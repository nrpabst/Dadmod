        endif
    endif
    if ObjectExists id = skater
        if skater : AnimExists Ped_M_Cheer_KneelingIdle
    star = " "
    if THUGRECOMP_MenuFavAnim seq = 5 single_hide = ( dadmod_anims_single )
        star = "*"
    endif
    make_thugpro_menu_item {
    id = dadmod_anim_sq5
    text = "Kneeling Loop"
    extra_text = <star>
    description_text = "Loops on your skater until you push the stick, ollie or pick Stop. Right stars it (*). Loop by Kali (Kalimod v2)"
    pad_choose_script = dadmod_anim_seq_choose
    pad_choose_params = { n = 5 a = Ped_M_Cheer_KneelingIdle id = dadmod_anim_sq5 t = "Kneeling Sequence Loop" }
    }
    SetScreenElementProps id = dadmod_anim_sq5 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 5 id = dadmod_anim_sq5 t = "Kneeling Sequence Loop" } } ]
        endif
    endif
    if ObjectExists id = skater
        if skater : AnimExists Ped_SIT_Idle
    star = " "
    if THUGRECOMP_MenuFavAnim seq = 6 single_hide = ( dadmod_anims_single )
        star = "*"
    endif
    make_thugpro_menu_item {
    id = dadmod_anim_sq6
    text = "Sit/Lean Loop"
    extra_text = <star>
    description_text = "Loops on your skater until you push the stick, ollie or pick Stop. Right stars it (*). Loop by Kali (Kalimod v2)"
    pad_choose_script = dadmod_anim_seq_choose
    pad_choose_params = { n = 6 a = Ped_SIT_Idle id = dadmod_anim_sq6 t = "Sit/Lean Sequence Loop" }
    }
    SetScreenElementProps id = dadmod_anim_sq6 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 6 id = dadmod_anim_sq6 t = "Sit/Lean Sequence Loop" } } ]
        endif
    endif
    if ObjectExists id = skater
        if skater : AnimExists Ped_M_Cheer_SittingIdle
    star = " "
    if THUGRECOMP_MenuFavAnim seq = 7 single_hide = ( dadmod_anims_single )
        star = "*"
    endif
    make_thugpro_menu_item {
    id = dadmod_anim_sq7
    text = "Sit (On Deck) Loop"
    extra_text = <star>
    description_text = "Loops on your skater until you push the stick, ollie or pick Stop. Right stars it (*). Loop by Kali (Kalimod v2)"
    pad_choose_script = dadmod_anim_seq_choose
    pad_choose_params = { n = 7 a = Ped_M_Cheer_SittingIdle id = dadmod_anim_sq7 t = "Sit (On Deck) Loop" }
    }
    SetScreenElementProps id = dadmod_anim_sq7 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 7 id = dadmod_anim_sq7 t = "Sit (On Deck) Loop" } } ]
        endif
    endif
    make_thugpro_menu_item { text = "Idle loops by Kali (Kalimod v2)" description_text = "These idle loops are Kali's, from Kalimod v2. Thanks, Kali!" not_focusable }
    thugpro_menu_finalize
endscript

script dadmod_anims_cat
    if GotParam favs
        title = "starred"
    else
    if GotParam find
        FormatText TextName = title "search: %s" s = <find>
    else
        switch <cat>
        case 0
            title = "standing and people"
        case 1
            title = "skating basics"
        case 2
            title = "flip tricks"
        case 3
            title = "grabs"
        case 4
            title = "grinds and slides"
        case 5
            title = "lips and handplants"
        case 6
            title = "flatland and manuals"
        case 7
            title = "specials"
        case 8
            title = "bails and get-ups"
        case 9
            title = "tantrums"
        case 10
            title = "walking and on foot"
        endswitch
    endif
    endif
    sq = "Star"
    if GotParam favs
        sq = "Unstar"
    endif
    FormatText TextName = sq_pc "\\b5 = %s" s = <sq>
    FormatText TextName = sq_con "\\b5 = %s" s = <sq>
    anim_ht = { helper_text_elements_pc = [ { text = "\\b7/\\b4 = Select" } { text = "\\bn = Back" } { text = "\\bm = Accept" } { text = <sq_pc> } ] helper_text_elements_console = [ { text = "\\b7/\\b4 = Select" } { text = "\\m1 = Back" } { text = "\\m0 = Accept" } { text = <sq_con> } ] }
    dialog_box_exit
    generic_menu_cleanup
    thugpro_menu_create {
    menu_name = dadmod_anims_list
    scrolling
    num_items_to_show = 13
    menu_title = <title>
    menu_style = MENU_STYLE_LEFT
    pad_back_script = dadmod_anims_menu
    helper_text = <anim_ht>
    show_description_panel
    show_gradient
    boxed
    }
    THUGRECOMP_MenuFavAnim refresh = 1
    matched = 0
    shown = 0
    if GotParam favs
        if THUGRECOMP_MenuFavAnim seq = 0
            make_thugpro_menu_item { id = dadmod_anim_sq0 text = "Idle Sequence Loop" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 0 a = Ped_M_Talk2_RightHere id = dadmod_anim_sq0 t = "Idle Sequence Loop" } }
            SetScreenElementProps id = dadmod_anim_sq0 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 0 id = dadmod_anim_sq0 t = "Idle Sequence Loop" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 1
            make_thugpro_menu_item { id = dadmod_anim_sq1 text = "Pro Ped Idle Sequence Loop 1" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 1 a = Pro_Idle03a id = dadmod_anim_sq1 t = "Pro Ped Idle Sequence Loop 1" } }
            SetScreenElementProps id = dadmod_anim_sq1 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 1 id = dadmod_anim_sq1 t = "Pro Ped Idle Sequence Loop 1" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 2
            make_thugpro_menu_item { id = dadmod_anim_sq2 text = "Pro Ped Idle Sequence Loop 2" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 2 a = Pro_Idle05d id = dadmod_anim_sq2 t = "Pro Ped Idle Sequence Loop 2" } }
            SetScreenElementProps id = dadmod_anim_sq2 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 2 id = dadmod_anim_sq2 t = "Pro Ped Idle Sequence Loop 2" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 3
            make_thugpro_menu_item { id = dadmod_anim_sq3 text = "Skater Ped Idle Sequence Loop 1" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 3 a = Ped_M_SkateIdleA id = dadmod_anim_sq3 t = "Skater Ped Idle Sequence Loop 1" } }
            SetScreenElementProps id = dadmod_anim_sq3 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 3 id = dadmod_anim_sq3 t = "Skater Ped Idle Sequence Loop 1" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 4
            make_thugpro_menu_item { id = dadmod_anim_sq4 text = "Skater Ped Idle Sequence Loop 2" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 4 a = Ped_M_SkateIdle1 id = dadmod_anim_sq4 t = "Skater Ped Idle Sequence Loop 2" } }
            SetScreenElementProps id = dadmod_anim_sq4 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 4 id = dadmod_anim_sq4 t = "Skater Ped Idle Sequence Loop 2" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 5
            make_thugpro_menu_item { id = dadmod_anim_sq5 text = "Kneeling Sequence Loop" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 5 a = Ped_M_Cheer_KneelingIdle id = dadmod_anim_sq5 t = "Kneeling Sequence Loop" } }
            SetScreenElementProps id = dadmod_anim_sq5 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 5 id = dadmod_anim_sq5 t = "Kneeling Sequence Loop" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 6
            make_thugpro_menu_item { id = dadmod_anim_sq6 text = "Sit/Lean Sequence Loop" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 6 a = Ped_SIT_Idle id = dadmod_anim_sq6 t = "Sit/Lean Sequence Loop" } }
            SetScreenElementProps id = dadmod_anim_sq6 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 6 id = dadmod_anim_sq6 t = "Sit/Lean Sequence Loop" } } ]
            shown = ( <shown> + 1 )
        endif
        if THUGRECOMP_MenuFavAnim seq = 7
            make_thugpro_menu_item { id = dadmod_anim_sq7 text = "Sit (On Deck) Loop" extra_text = "*" description_text = "An idle loop. Right unstars it" pad_choose_script = dadmod_anim_seq_choose pad_choose_params = { n = 7 a = Ped_M_Cheer_SittingIdle id = dadmod_anim_sq7 t = "Sit (On Deck) Loop" } }
            SetScreenElementProps id = dadmod_anim_sq7 event_handlers = [ { pad_right dadmod_anim_seq_square params = { n = 7 id = dadmod_anim_sq7 t = "Sit (On Deck) Loop" } } ]
            shown = ( <shown> + 1 )
        endif
    endif
    i = 0
    begin
        e = ( dadmod_anim_list [ <i> ] )
        ok = 0
        star = " "
        if THUGRECOMP_MenuFavAnim anim = ( <e> . a ) single_hide = ( dadmod_anims_single )
            star = "*"
        endif
        if GotParam favs
            if ( <star> = "*" )
                ok = 1
            endif
        else
        if GotParam find
            if THUGRECOMP_TextHas text = ( <e> . t ) find = <find>
                ok = 1
            endif
        else
            if ( ( <e> . c ) = <cat> )
                ok = 1
            endif
        endif
        endif
        if ( <ok> = 1 )
            if ( ( dadmod_anims_main ) = 1 )
                if not GotParam favs
                    if not THUGRECOMP_TextHas text = ( <e> . t ) find = "idle"
                        ok = 0
                    endif
                endif
            endif
        endif
        if ( <ok> = 1 )
            ae_anim = ( <e> . a )
            if ObjectExists id = skater
                if not skater : AnimExists <ae_anim>
                    ok = 0
                endif
            endif
        endif
        if ( <ok> = 1 )
            matched = ( <matched> + 1 )
            FormatText ChecksumName = item_id "dadmod_anim_it%i" i = <i>
            make_thugpro_menu_item { id = <item_id> text = ( <e> . t ) extra_text = <star> description_text = "Plays it on your skater. Right stars it (*)" pad_choose_script = dadmod_anim_choose pad_choose_params = { i = <i> t = ( <e> . t ) id = <item_id> } }
            SetScreenElementProps id = <item_id> event_handlers = [ { pad_right dadmod_anim_square params = { i = <i> id = <item_id> } } ]
            shown = ( <shown> + 1 )
        endif
        i = ( <i> + 1 )
    repeat 675
    if ( <shown> = 0 )
        make_thugpro_menu_item { text = "Nothing here" description_text = "Try another word, or star some animations first" pad_choose_script = dadmod_anims_menu }
    endif
    thugpro_menu_finalize
endscript

script dadmod_anims_find
    text = ""
    if THUGRECOMP_TextLoad key = "anim_find"
        if not ( <value> = "-" )
            text = <value>
        endif
    endif
    thugpro_menu_destroy
    create_onscreen_keyboard {
    allow_cancel
    keyboard_cancel_script = dadmod_anims_find_cancel
    keyboard_done_script = dadmod_anims_find_done
    keyboard_title = "Find an animation"
    min_length = 0
    max_length = 30
    text = <text>
    }
endscript

script dadmod_anims_find_done
    GetTextElementString id = keyboard_current_string
    destroy_onscreen_keyboard
    if ( <String> = "" )
        dadmod_anims_menu
        return
    endif
    THUGRECOMP_TextSave key = "anim_find" value = <String>
    dadmod_anims_cat find = <String>
endscript

script dadmod_anims_find_cancel
    destroy_onscreen_keyboard
    dadmod_anims_menu
endscript

script thugpro_bankdrops_parse
    if ( ( ( <msg> = "!BANKDROPS" ) or ( <msg> = " !BANKDROPS" ) ) or ( ( <msg> = "!BANKDROP" ) or ( <msg> = " !BANKDROP" ) ) )
        return bd = 2
    endif
    if ( ( ( <msg> = "!BANKDROPS ON" ) or ( <msg> = " !BANKDROPS ON" ) ) or ( ( <msg> = "!BANKDROP ON" ) or ( <msg> = " !BANKDROP ON" ) ) )
        return bd = 1
    endif
    if ( ( ( <msg> = "!BANKDROPS OFF" ) or ( <msg> = " !BANKDROPS OFF" ) ) or ( ( <msg> = "!BANKDROP OFF" ) or ( <msg> = " !BANKDROP OFF" ) ) )
        return bd = 0
    endif
endscript

script thugpro_bankdrops_local
    if not GotParam msg
        return
    endif
    if not GotParam name
        return
    endif
    if not InNetGame
        return
    endif
    GetUpperCaseString <msg>
    thugpro_bankdrops_parse msg = <UpperCaseString>
    if not GotParam bd
        return
    endif
    if not THUGRECOMP_IsLocalPlayerName name = <name>
        return
    endif
    if ( <bd> = 2 )
        if THUGRECOMP_BankDropsOn
            bd = 0
        else
            bd = 1
        endif
    endif
    THUGRECOMP_BankDropsSet on = <bd>
    if THUGRECOMP_BankDropsOn
        text = "Bank drops: ON (just in your game)"
    else
        text = "Bank drops: OFF (just in your game)"
    endif
    THUGRECOMP_Log text = <text>
    KillSpawnedScript Name = thugpro_bankdrops_confirm
    SpawnScript thugpro_bankdrops_confirm params = { name = <name> text = <text> } NotSessionSpecific = 1
endscript

script thugpro_bankdrops_confirm
    wait 1.5 seconds
    thugpro_say_to name = <name> text = <text>
endscript

script thugpro_bankdrops_chat
    thugpro_bankdrops_parse msg = <msg>
    if not GotParam bd
        return
    endif
    if not THUGRECOMP_IsLocalPlayerName name = <name>
        thugpro_say_to name = <name> text = "!bankdrops needs the dadmod DLL: bank drops are part of your own game's physics"
    endif
    return handled = 1
endscript

script dadmod_chatkeep_save
    if ObjectExists id = keyboard_anchor
        if keyboard_anchor : GetSingleTag no_buttons
            if ObjectExists id = keyboard_current_string
                GetTextElementString id = keyboard_current_string
                if GotParam String
                    KillSpawnedScript Name = dadmod_chatkeep_restore
                    SpawnScript dadmod_chatkeep_restore params = { text = <String> }
                endif
            endif
        endif
    endif
endscript

script dadmod_chatkeep_restore
    tries = 0
    begin
        wait 5 gameframes
        if ObjectExists id = keyboard_anchor
            return
        endif
        blocked = 0
        if ObjectExists id = ped_speech_dialog
            blocked = 1
        endif
        if ObjectExists id = goal_start_dialog
            blocked = 1
        endif
        if ObjectExists id = goal_description_anchor
            blocked = 1
        endif
        if ObjectExists id = dialog_box_anchor
            blocked = 1
        endif
        if ( <blocked> = 0 )
            break
        endif
        tries = ( <tries> + 1 )
        if ( <tries> > 36 )
            return
        endif
    repeat
    DestroyIfObjectExist id = current_menu_anchor
    DestroyIfObjectExist id = bg_container
    create_onscreen_keyboard {
    allow_cancel no_buttons text_block
    Pos = (3.2e+02,2.6e+02)
    keyboard_cancel_script = cancel_enter_chat_menu
    keyboard_done_script = entered_chat_message
    display_text = "Enter message"
    keyboard_title = "Enter message"
    min_length = 1
    max_length = 75
    display_text_scale = 0.5
    text = <text>
    }
    if ObjectExists id = keyboard_display_string
        FormatText TextName = shown "%s_" s = <text>
        SetScreenElementProps id = keyboard_display_string text = <shown>
    endif
endscript

dadmod_titlefx_block = "Menu UI Title effect (Noah, 2026-11-03). Lives in ButtonScripts.q because procrastination.qb is at its 512 KB limit"

script dadmod_ui_title_rgb lmode = 0
    RemoveParameter dadmod_txt
    menu_title_text : GetTags
    if GotParam dadmod_txt
        if not GotParam tt
            tt = <tr>
        endif
        codes = ( ( dadmod_ui_themes [ ( dadmod_ui_rb_theme ) ] ) . codes )
        trig = ( dadmod_ui_trig [ ( dadmod_ui_rb_angle ) ] )
        GetScreenElementPosition id = menu_title_text
        THUGRECOMP_ScanText text = <dadmod_txt> mode = <lmode> codes = <codes> item = 0 t = <tt> x = ( <ScreenElementPos> . (1.0,0.0) ) y = ( <ScreenElementPos> . (0.0,1.0) ) c = ( <trig> . c ) s = ( <trig> . s ) center = 0
        v = ( 128 * ( dadmod_ui_bright ) )
        dadmod_ui_clamp v = <v>
        gray = [ 128 128 128 128 ]
        SetArrayElement arrayname = gray index = 0 newvalue = <v>
        SetArrayElement arrayname = gray index = 1 newvalue = <v>
        SetArrayElement arrayname = gray index = 2 newvalue = <v>
        SetScreenElementProps id = menu_title_text text = <text> rgba = <gray>
    endif
endscript

script dadmod_ui_title_fx
    if (<e> < 1)
        return
    endif
    if (<e> < 6)
        dadmod_ui_bar_fx id = menu_title_text e = ( <e> + 1 ) t = <t> base = ( dadmod_ui_title_rgba ) other = ( dadmod_ui_focus_rgba ) slow = 4
        return
    endif
    switch <e>
    case 6
        dadmod_ui_title_rgb lmode = 0 tt = <tr>
    case 7
        dadmod_ui_title_rgb lmode = 1 tt = <tr>
    case 8
        dadmod_ui_title_rgb lmode = 2 tt = 0
    case 9
        dadmod_ui_title_rgb lmode = 3 tt = ( <tr> * 3 )
    case 10
        dadmod_ui_title_decode t = <t>
    case 11
        dadmod_ui_title_rgb lmode = 0 tt = 0
    endswitch
endscript

script dadmod_ui_title_decode
    RemoveParameter dadmod_txt
    RemoveParameter dadmod_trev
    menu_title_text : GetTags
    if not GotParam dadmod_txt
        return
    endif
    rev = 0.0
    if GotParam dadmod_trev
        rev = <dadmod_trev>
    endif
    if (<rev> > 1.5)
        return
    endif
    if (<rev> > 1.0)
        SetScreenElementProps id = menu_title_text text = <dadmod_txt> rgba = ( dadmod_ui_title_rgba ) tags = { dadmod_trev = 2.0 }
        return
    endif
    tick = ( <t> / 100 )
    CastToInteger tick
    THUGRECOMP_ScanText text = <dadmod_txt> mode = 4 codes = "c" item = 0 t = <tick> reveal = <rev>
    SetScreenElementProps id = menu_title_text text = <text> rgba = [ 128 128 128 128 ] tags = { dadmod_trev = ( <rev> + 0.07 ) }
endscript

script dadmod_ui_title_match
    dadmod_ui_get key = "ui_rainbow" def = 0
    switch <value>
    case 1
        return e = 8
    case 2
        return e = 8
    case 3
        return e = 7
    case 4
        return e = 3
    case 5
        return e = 6
    case 6
        return e = 7
    case 7
        return e = 8
    case 8
        return e = 9
    endswitch
    dadmod_ui_get key = "ui_colortheme" def = 0
    if (<value> > 0)
        dadmod_ui_get key = "ui_theme_mode" def = 0
        switch <value>
        case 2
            return e = 11
        case 3
            return e = 3
        case 4
            return e = 6
        case 5
            return e = 7
        endswitch
    endif
    return e = 0
endscript

script dadmod_tod_client_allowed
    return allowed = 1
endscript

dadmod_tod_kali_seen = 0

dadmod_tod_kali_saved = 0

dadmod_tod_kali_m = { none = 0 }

dadmod_tod_kali_a = { none = 0 }

dadmod_tod_kali_e = { none = 0 }

dadmod_tod_kali_n = { none = 0 }

script dadmod_tod_kali_state
    if not StructureContains structure = ( tod_manager_default_morning ) sun_phi
        return kali = 0
    endif
    if not StructureContains structure = ( tod_manager_default_afternoon ) sun_phi
        return kali = 0
    endif
    if not StructureContains structure = ( tod_manager_default_evening ) sun_phi
        return kali = 0
    endif
    if not StructureContains structure = ( tod_manager_default_night ) sun_phi
        return kali = 0
    endif
    pm = ( ( tod_manager_default_morning ) . sun_phi )
    pa = ( ( tod_manager_default_afternoon ) . sun_phi )
    pe = ( ( tod_manager_default_evening ) . sun_phi )
    pn = ( ( tod_manager_default_night ) . sun_phi )
    if not (<pm> = <pa>)
        return kali = 0
    endif
    if not (<pm> = <pe>)
        return kali = 0
    endif
    if not (<pm> = <pn>)
        return kali = 0
    endif
    k = 4
    if (<pm> < 190)
        k = 3
    endif
    if (<pm> < 100)
        k = 2
    endif
    if (<pm> < 0)
        k = 1
    endif
    return kali = <k>
endscript

script dadmod_tod_kali_snapshot
    if (dadmod_tod_kali_saved = 1)
        return
    endif
    dadmod_tod_kali_state
    if (<kali> > 0)
        return
    endif
    if not StructureContains structure = ( tod_manager_default_morning ) sun_phi
        return
    endif
    Change dadmod_tod_kali_m = ( tod_manager_default_morning )
    Change dadmod_tod_kali_a = ( tod_manager_default_afternoon )
    Change dadmod_tod_kali_e = ( tod_manager_default_evening )
    Change dadmod_tod_kali_n = ( tod_manager_default_night )
    Change dadmod_tod_kali_saved = 1
endscript

script dadmod_tod_kali_watch
    dadmod_tod_kali_snapshot
    dadmod_tod_kali_state
    dadmod_tod_client_allowed
    if (<allowed> = 0)
        if (<kali> > 0)
            dadmod_tod_kali_follow tod = 0
        endif
        return
    endif
    if (<kali> = dadmod_tod_kali_seen)
        return
    endif
    Change dadmod_tod_kali_seen = <kali>
    if (<kali> = 0)
        return
    endif
    THUGRECOMP_SettingSave key = "gfx_tod" value = <kali>
    FormatText TextName = msg "tod: Kali time of day picked, dadmod Time of day = %a" a = <kali>
    THUGRECOMP_Log text = <msg>
endscript

script dadmod_tod_kali_follow
    dadmod_tod_client_allowed
    if (<allowed> = 0)
        tod = 0
    endif
    dadmod_tod_kali_state
    if (<kali> = 0)
        return
    endif
    if (<tod> = 1)
        if ScriptExists #"0x1343061c"
            Change dadmod_tod_kali_seen = 1
            #"0x1343061c"
            return
        endif
    endif
    if (<tod> = 2)
        if ScriptExists #"0xa4ea632e"
            Change dadmod_tod_kali_seen = 2
            #"0xa4ea632e"
            return
        endif
    endif
    if (<tod> = 3)
        if ScriptExists #"0xd6b550ba"
            Change dadmod_tod_kali_seen = 3
            #"0xd6b550ba"
            return
        endif
    endif
    if (<tod> = 4)
        if ScriptExists #"0xbc4c779a"
            Change dadmod_tod_kali_seen = 4
            #"0xbc4c779a"
            return
        endif
    endif
    if not (dadmod_tod_kali_saved = 1)
        return
    endif
    Change tod_manager_default_morning = ( dadmod_tod_kali_m )
    Change tod_manager_default_afternoon = ( dadmod_tod_kali_a )
    Change tod_manager_default_evening = ( dadmod_tod_kali_e )
    Change tod_manager_default_night = ( dadmod_tod_kali_n )
    Change dadmod_tod_kali_seen = 0
    tod_manager_set_default_params
    Change dadmod_tod_custom = 0
    THUGRECOMP_Log text = "tod: Kali time of day override taken off"
endscript

script dadmod_pad_popup
    SpawnScript dadmod_pad_popup_show params = { text = <text> } NotSessionSpecific = 1
endscript

script dadmod_pad_popup_show
    create_panel_message id = dadmod_pad_popup_msg text = <text> Pos = (632,8) just = [ right top ] scale = 0.55 font_face = small rgba = [ 128 128 128 100 ] z_priority = 100 shadow style = dadmod_pad_popup_style
endscript

script dadmod_pad_popup_style
    wait 2600
    DoMorph alpha = 0 time = 0.4
    wait 400
    Die
endscript

dadmod_binds_dev = 0

dadmod_binds_from = 0

script dadmod_binds_kb_open
    dadmod_binds_menu dev = 0 from = 0
endscript

script dadmod_binds_pad_open
    dadmod_binds_menu dev = 1 from = 0
endscript

script dadmod_binds_menu
    if GotParam dev
        Change dadmod_binds_dev = <dev>
    endif
    if GotParam from
        Change dadmod_binds_from = <from>
    endif
    if ( ( dadmod_binds_from ) = 1 )
        dialog_box_exit
        generic_menu_cleanup
    else
        default_skateshop_menu_cleanup
    endif
    if ( ( dadmod_binds_dev ) = 1 )
        title = "controller"
        desc = "Press accept, then the button you want for this action. A button already used elsewhere swaps over. Waits 6 seconds."
        rows = [ { slot = 8 label = "Ollie" } { slot = 9 label = "Grab" } { slot = 10 label = "Flip" } { slot = 11 label = "Grind" } { slot = 12 label = "Pause" } { slot = 13 label = "Camera toggle" } { slot = 14 label = "L1 (rotate left)" } { slot = 15 label = "R1 (rotate right)" } { slot = 16 label = "L2 (nollie)" } { slot = 17 label = "R2 (revert)" } { slot = 18 label = "L3 (focus)" } { slot = 19 label = "R3 (swivel lock)" } ]
    else
        title = "keyboard"
        desc = "Press Enter, then the key you want for this action. A key already used elsewhere swaps over. Esc cancels."
        rows = [ { slot = 0 label = "Forward" } { slot = 1 label = "Backward" } { slot = 2 label = "Turn left" } { slot = 3 label = "Turn right" } { slot = 4 label = "Camera up" } { slot = 5 label = "Camera down" } { slot = 6 label = "Camera left" } { slot = 7 label = "Camera right" } { slot = 8 label = "Ollie" } { slot = 9 label = "Grab" } { slot = 10 label = "Flip" } { slot = 11 label = "Grind" } { slot = 13 label = "Camera toggle" } { slot = 14 label = "L1 (rotate left)" } { slot = 15 label = "R1 (rotate right)" } { slot = 16 label = "L2 (nollie)" } { slot = 17 label = "R2 (revert)" } { slot = 18 label = "L3 (focus)" } { slot = 19 label = "R3 (swivel lock)" } { slot = 20 label = "Item up" } { slot = 21 label = "Item down" } { slot = 22 label = "Item left" } { slot = 23 label = "Item right" } ]
    endif
    thugpro_menu_create {
    menu_name = dadmod_binds
    scrolling
    num_items_to_show = 13
    menu_title = <title>
    menu_style = MENU_STYLE_LEFT
    pad_back_script = dadmod_binds_back
    helper_text = generic_helper_text
    show_description_panel
    show_gradient
    boxed
    }
    ForEachIn <rows> Do = dadmod_binds_row params = { desc = <desc> }
    make_thugpro_menu_item {
    text = "Reset to default"
    id = dadmod_bind_reset_item
    description_text = "Puts every binding on this page back to the default layout (the launcher keys, or the controller layout picked above)."
    pad_choose_script = dadmod_binds_reset
    }
    if GotParam focus_id
        thugpro_menu_finalize focus_target = <focus_id> no_animate
    else
        thugpro_menu_finalize
    endif
endscript

script dadmod_binds_row
    FormatText ChecksumName = row_id "dadmod_bind_row_%d" d = <slot>
    THUGRECOMP_BindName dev = ( dadmod_binds_dev ) slot = <slot>
    make_thugpro_menu_item {
    text = <label>
    extra_text = <text>
    id = <row_id>
    description_text = <desc>
    pad_choose_script = dadmod_binds_pick
    pad_choose_params = { slot = <slot> row_id = <row_id> }
    }
endscript

script dadmod_binds_pick
    if THUGRECOMP_BindCapture dev = ( dadmod_binds_dev ) slot = <slot>
        if ( ( dadmod_binds_dev ) = 1 )
            thugpro_menu_item_update_extra_text id = <row_id> text = "Press a button..."
        else
            thugpro_menu_item_update_extra_text id = <row_id> text = "Press a key..."
        endif
        SpawnScript dadmod_binds_wait params = { row_id = <row_id> } NotSessionSpecific = 1
    endif
endscript

script dadmod_binds_wait
    begin
        if not THUGRECOMP_BindPoll
            break
        endif
        wait 1 gameframe
    repeat
    if ScreenElementExists id = <row_id>
        dadmod_binds_menu focus_id = <row_id>
    endif
endscript

script dadmod_binds_reset
    THUGRECOMP_BindReset dev = ( dadmod_binds_dev )
    dadmod_binds_menu focus_id = dadmod_bind_reset_item
endscript

script dadmod_binds_back
    if THUGRECOMP_BindPoll
        return
    endif
    generic_menu_pad_back_sound
    if ( ( dadmod_binds_from ) = 1 )
        if ( ( dadmod_binds_dev ) = 1 )
            dadmod_pause_controls_menu focus_id = dadmod_pause_bindpad
        else
            dadmod_pause_controls_menu focus_id = dadmod_pause_bindkb
        endif
    else
        if ( ( dadmod_layout_node ) > -1 )
            dadmod_layout_open node = ( dadmod_layout_node )
        else
            create_dadmod_setup_menu
        endif
    endif
endscript

dadmod_cg_layout = -1

script dadmod_char_guide_tick
    if not ScreenElementExists id = char_guide_l2
        Change dadmod_cg_layout = -1
        return
    endif
    cg_lay = 1
    if ( ( GLOBAL_CtrlLayout ) = 0 )
        cg_lay = 0
    endif
    if (<cg_lay> = ( dadmod_cg_layout ))
        return
    endif
    Change dadmod_cg_layout = <cg_lay>
    dadmod_kb_label row = keyboard_row_4 idx = 6 lay = <cg_lay> glyph = '\\m9' scale = (0.85,0.75) small = (0.68,0.75) shrink = 0.8
    dadmod_kb_label row = keyboard_row_5 idx = 2 lay = <cg_lay> glyph = '\\m8'
    dadmod_kb_label row = keyboard_row_6 idx = 1 lay = <cg_lay> glyph = '\\m1'
    if (<cg_lay> = 0)
        SetScreenElementProps id = char_guide_l2 text = ""
        if ScreenElementExists id = char_guide_r2
            SetScreenElementProps id = char_guide_r2 text = ""
        endif
    else
        SetScreenElementProps id = char_guide_l2 text = '\\mf'
        if ScreenElementExists id = char_guide_r2
            SetScreenElementProps id = char_guide_r2 text = '\\mg'
        endif
    endif
endscript

script dadmod_kb_label
    if not ScreenElementExists id = { <row> child = { <idx> child = 31 } }
        return
    endif
    if not ScreenElementExists id = { <row> child = { <idx> child = 30 } }
        return
    endif
    if (<lay> = 0)
        SetScreenElementProps id = { <row> child = { <idx> child = 30 } } text = ""
        mm_kw = 40.0
        GetScreenElementDims id = { <row> child = { <idx> child = 31 } }
        mm_kw = <width>
        if GotParam small
            DoScreenElementMorph id = { <row> child = { <idx> child = 31 } } scale = <small> time = 0
            mm_kw = ( <mm_kw> * <shrink> )
        endif
        mm_kx = ( 62.0 - ( <mm_kw> / 2.0 ) )
        SetScreenElementProps id = { <row> child = { <idx> child = 31 } } pos = ( (1.0,0.0) * <mm_kx> + (0.0,10.0) )
    else
        SetScreenElementProps id = { <row> child = { <idx> child = 30 } } text = <glyph>
        if GotParam scale
            DoScreenElementMorph id = { <row> child = { <idx> child = 31 } } scale = <scale> time = 0
        endif
        SpawnScript dadmod_kb_label_place params = { row = <row> idx = <idx> }
    endif
endscript

script dadmod_kb_label_place
    wait 1 gameframe
    if not ScreenElementExists id = { <row> child = { <idx> child = 31 } }
        return
    endif
    if not ScreenElementExists id = { <row> child = { <idx> child = 30 } }
        return
    endif
    GetStackedScreenElementPos x id = { <row> child = { <idx> child = 30 } } offset = (3.0,0.0)
    SetScreenElementProps id = { <row> child = { <idx> child = 31 } } pos = <pos>
endscript

dadmod_mouse_last = none

dadmod_mouse_pxu = 0.0

dadmod_mouse_pyu = 0.0

dadmod_mouse_back_hl = -1

dadmod_mouse_next_hl = -1

script dadmod_mouse_rpause
    rp_ok = 0
    if not LevelIs Load_MainMenu
        if ObjectExists id = skater
            rp_ok = 1
        endif
    endif
    if (<rp_ok> = 1)
        if ScreenElementExists id = current_menu_anchor
            rp_ok = 0
        endif
        if ScreenElementExists id = current_menu
            rp_ok = 0
        endif
        if ScreenElementExists id = dialog_box_anchor
            rp_ok = 0
        endif
        if ScreenElementExists id = keyboard_anchor
            rp_ok = 0
        endif
        if IsTrue view_mode
            rp_ok = 0
        endif
    endif
    THUGRECOMP_MouseRightPause ok = <rp_ok>
endscript

script dadmod_mouse_tick
    dadmod_mouse_rpause
    if ScreenElementExists id = keyboard_anchor
        if ScreenElementExists id = keyboard_vmenu
            dadmod_mouse_kb_tick
            return
        endif
    endif
    Change dadmod_mouse_kb_row = none
    mm_menu = 0
    mm_mid = current_menu
    mm_dialog = 0
    if ScreenElementExists id = dialog_box_vmenu
        mm_menu = 1
        mm_mid = dialog_box_vmenu
        mm_dialog = 1
    else
        if ScreenElementExists id = <mm_mid>
            mm_menu = 1
        endif
    endif
    if ScreenElementExists id = keyboard_anchor
        mm_menu = 0
    endif
    mm_screen = <mm_menu>
    if ScreenElementExists id = helper_text_anchor
        if LevelIs Load_MainMenu
            mm_screen = 1
        endif
    endif
    mm_accept = 0
    if (<mm_dialog> = 0)
        if ScreenElementExists id = select_skater_anchor
            mm_accept = 1
            mm_screen = 1
        endif
    endif
    if ScreenElementExists id = keyboard_anchor
        mm_screen = 0
    endif
    mm_lvl = 0
    if (<mm_dialog> = 0)
        if ScreenElementExists id = level_select_logo
            mm_lvl = 1
        endif
        if ScreenElementExists id = level_select_panel_container
            mm_lvl = 1
        endif
    endif
    mm_nocam = <mm_accept>
    mm_hc = <mm_screen>
    if (<mm_screen> = 0)
        if (<mm_menu> = 0)
            if ScreenElementExists id = root_window
                if root_window : GetSingleTag dadmod_walkcam_ok
                    if (<dadmod_walkcam_ok> = 1)
                        mm_hc = 2
                    endif
                endif
            endif
        endif
    endif
    if (<mm_dialog> = 1)
        mm_nocam = 1
    endif
    if (<mm_lvl> = 1)
        mm_nocam = 1
    endif
    if (<mm_menu> = 1)
        THUGRECOMP_MouseMenu id = <mm_mid> root = root_window nocam = <mm_nocam> hidecur = <mm_screen> nodrag = <mm_lvl>
    else
        THUGRECOMP_MouseMenu id = dadmod_mouse_no_menu root = root_window nocam = <mm_nocam> hidecur = <mm_hc>
    endif
    if (<mm_screen> = 0)
        ms_active = 0
    endif
    if (<ms_active> = 0)
        dadmod_mouse_hide
        Change dadmod_mouse_last = none
        return
    endif
    if not (<ms_px_unit> = ( dadmod_mouse_pxu ))
        dadmod_mouse_hide
    endif
    if not (<ms_px_unit_y> = ( dadmod_mouse_pyu ))
        dadmod_mouse_hide
    endif
    Change dadmod_mouse_pxu = <ms_px_unit>
    Change dadmod_mouse_pyu = <ms_px_unit_y>
    dadmod_mouse_pointer
    if ScreenElementExists id = startup_menu
        ms_over_back = 0
        if ScreenElementExists id = dadmod_mouse_back
            DestroyScreenElement id = dadmod_mouse_back
        endif
    else
        dadmod_mouse_back_button x = <ms_corner_x> y = <ms_corner_y> mm_hl = <ms_over_back>
    endif
    mm_next = 0
    mm_side_l = 0
    mm_side_r = 0
    mm_over_sel = 0
    mm_over_load = 0
    if (<mm_accept> = 1)
        ms_hit = -1
        mm_next = 1
        dadmod_mouse_ss_arrows x = <ms_x> y = <ms_y>
        dadmod_mouse_ss_buttons x = <ms_x> y = <ms_y> cx = <ms_corner_x> cy = <ms_corner_y>
        dadmod_mouse_skin_pill x = <ms_x> y = <ms_y>
    else
        dadmod_mouse_ss_off
    endif
    if (<mm_menu> = 0)
        mm_next = 1
    else
        if (<ms_rows> = 0)
            mm_next = 1
        endif
    endif
    if (<mm_accept> = 1)
        mm_next_btn = 0
    else
        mm_next_btn = <mm_next>
    endif
    if (<mm_next_btn> = 1)
        dadmod_mouse_next_button x = <ms_next_x> y = <ms_corner_y> mm_hl = <ms_over_next>
    else
        ms_over_next = 0
        if ScreenElementExists id = dadmod_mouse_next
            DestroyScreenElement id = dadmod_mouse_next
        endif
        Change dadmod_mouse_next_hl = -1
    endif
    mm_scroll = <ms_hover_edge>
    dadmod_mouse_hover_bar_off
    if (<ms_hit> > -1)
        if not (<ms_hit_id> = ( dadmod_mouse_last ))
            mm_hov = 0
            if (<ms_click> > 0)
                mm_hov = 1
            endif
            if (<ms_moved> = 1)
                if (<mm_scroll> = 0)
                    mm_hov = 1
                endif
            endif
            if (<mm_hov> = 1)
                if ScreenElementExists id = <ms_hit_id>
                    FireEvent type = unfocus target = <mm_mid>
                    FireEvent type = focus target = <mm_mid> data = { child_id = <ms_hit_id> }
                    Change dadmod_mouse_last = <ms_hit_id>
                    Change dadmod_mouse_tagside = 0
                endif
            endif
        endif
        if (<ms_moved> = 1)
            if (<ms_hit_id> = ( dadmod_mouse_last ))
                dadmod_mouse_tag_hover id = <ms_hit_id> x = <ms_x> y = <ms_y>
            endif
        endif
    endif
    mm_lv_l = 0
    mm_lv_r = 0
    if (<mm_lvl> = 1)
        if (<ms_box> = 1)
            dadmod_mouse_lvl_arrows x = <ms_x> y = <ms_y> bx0 = <ms_bx0> by0 = <ms_by0> bx1 = <ms_bx1> by1 = <ms_by1> cx = <ms_corner_x> rx = ( <ms_next_x> + ( 34.0 * <ms_px_unit> ) )
        endif
    else
        dadmod_mouse_lvl_off
    endif
    if (<ms_click> > 0)
        if (<ms_over_back> = 1)
            dadmod_mouse_back_press
            return
        endif
        if (<mm_lv_l> = 1)
            SpawnScript dadmod_mouse_kick params = { id = { dadmod_mouse_ll child = arr_c } x = 28.0 y = 28.0 dx = -8.0 }
            if ScreenElementExists id = current_menu
                FireEvent type = pad_left target = current_menu
            endif
            return
        endif
        if (<mm_lv_r> = 1)
            SpawnScript dadmod_mouse_kick params = { id = { dadmod_mouse_lr child = arr_c } x = 28.0 y = 28.0 dx = 8.0 }
            if ScreenElementExists id = current_menu
                FireEvent type = pad_right target = current_menu
            endif
            return
        endif
        if (<mm_over_load> = 1)
            SpawnScript dadmod_mouse_press params = { id = { dadmod_mouse_ssb child = load_box } flash = { dadmod_mouse_ssb child = { load_box child = load_bg } } fill = [ 50 50 50 128 ] }
            Change dadmod_mouse_last = none
            generic_menu_pad_choose_sound
            ss_overwrite_warning
            return
        endif
        if GotParam mm_skin_l
            if (<mm_skin_l> = 1)
                SpawnScript dadmod_mouse_kick params = { id = { dadmod_mouse_skin child = skin_l } x = -94.0 y = 0.0 dx = -6.0 }
                if ScreenElementExists id = <mm_skin_item>
                    FireEvent type = pad_up target = <mm_skin_item>
                endif
                return
            endif
            if (<mm_skin_r> = 1)
                SpawnScript dadmod_mouse_kick params = { id = { dadmod_mouse_skin child = skin_r } x = 94.0 y = 0.0 dx = 6.0 }
                if ScreenElementExists id = <mm_skin_item>
                    FireEvent type = pad_down target = <mm_skin_item>
                endif
                return
            endif
        endif
        if (<mm_side_l> = 1)
            SpawnScript dadmod_mouse_kick params = { id = { dadmod_mouse_sl child = arr_c } x = 28.0 y = 28.0 dx = -8.0 }
            if ScreenElementExists id = <mm_mid>
                FireEvent type = pad_left target = <mm_mid>
            endif
            return
        endif
        if (<mm_side_r> = 1)
            SpawnScript dadmod_mouse_kick params = { id = { dadmod_mouse_sr child = arr_c } x = 28.0 y = 28.0 dx = 8.0 }
            if ScreenElementExists id = <mm_mid>
                FireEvent type = pad_right target = <mm_mid>
            endif
            return
        endif
        if (<mm_next> = 1)
            if (<mm_over_sel> = 1)
                SpawnScript dadmod_mouse_press params = { id = { dadmod_mouse_ssb child = sel_box } flash = { dadmod_mouse_ssb child = { sel_box child = sel_bg } } fill = [ 60 60 60 128 ] }
                mm_kx = ( ( ( dadmod_mouse_selw ) / 2.0 ) - 30.0 )
                SpawnScript dadmod_mouse_kick params = { id = { dadmod_mouse_ssb child = { sel_box child = sel_chev } } x = <mm_kx> y = 0.0 dx = 8.0 }
            endif
            Change dadmod_mouse_last = none
            THUGRECOMP_MouseNext
            return
        endif
        if (<ms_hit> > -1)
            dadmod_mouse_click id = <ms_hit_id> x = <ms_x> y = <ms_y>
            return
        endif
    endif
    if (<ms_rclick> > 0)
        dadmod_mouse_back_press
        return
    endif
    if (<mm_accept> = 1)
        if (<ms_wheel> > 0)
            begin
                if ScreenElementExists id = <mm_mid>
                    FireEvent type = pad_left target = <mm_mid>
                endif
            repeat <ms_wheel>
        endif
        if (<ms_wheel> < 0)
            n = (0 - <ms_wheel>)
            begin
                if ScreenElementExists id = <mm_mid>
                    FireEvent type = pad_right target = <mm_mid>
                endif
            repeat <n>
        endif
        return
    endif
    if (<ms_wheel> > 0)
        Change dadmod_mouse_last = none
        begin
            if ScreenElementExists id = <mm_mid>
                FireEvent type = pad_up target = <mm_mid>
            endif
        repeat <ms_wheel>
    endif
    if (<ms_wheel> < 0)
        Change dadmod_mouse_last = none
        n = (0 - <ms_wheel>)
        begin
            if ScreenElementExists id = <mm_mid>
                FireEvent type = pad_down target = <mm_mid>
            endif
        repeat <n>
    endif
endscript

dadmod_mouse_kb_row = none

script dadmod_mouse_kb_tick
    THUGRECOMP_MouseMenu id = keyboard_vmenu grid = 1 hidecur = 1
    if (<ms_active> = 0)
        dadmod_mouse_hide
        Change dadmod_mouse_last = none
        Change dadmod_mouse_kb_row = none
        return
    endif
    if not (<ms_px_unit> = ( dadmod_mouse_pxu ))
        dadmod_mouse_hide
    endif
    if not (<ms_px_unit_y> = ( dadmod_mouse_pyu ))
        dadmod_mouse_hide
    endif
    Change dadmod_mouse_pxu = <ms_px_unit>
    Change dadmod_mouse_pyu = <ms_px_unit_y>
    dadmod_mouse_pointer
    if ScreenElementExists id = dadmod_mouse_next
        DestroyScreenElement id = dadmod_mouse_next
    endif
    Change dadmod_mouse_next_hl = -1
    dadmod_mouse_back_button x = <ms_corner_x> y = <ms_corner_y> mm_hl = <ms_over_back>
    if (<ms_hit> > -1)
        if GotParam ms_hit_row
            if not (<ms_hit_id> = ( dadmod_mouse_last ))
                if ( (<ms_moved> = 1) or (<ms_click> > 0) )
                    if ScreenElementExists id = <ms_hit_row>
                        if ScreenElementExists id = <ms_hit_id>
                            if not (<ms_hit_row> = ( dadmod_mouse_kb_row ))
                                FireEvent type = unfocus target = keyboard_vmenu
                                FireEvent type = focus target = keyboard_vmenu data = { child_id = <ms_hit_row> }
                                Change dadmod_mouse_kb_row = <ms_hit_row>
                            endif
                            FireEvent type = unfocus target = <ms_hit_row>
                            FireEvent type = focus target = <ms_hit_row> data = { child_id = <ms_hit_id> }
                            Change dadmod_mouse_last = <ms_hit_id>
                        endif
                    endif
                endif
            endif
        endif
    endif
    if (<ms_click> > 0)
        if (<ms_over_back> = 1)
            dadmod_mouse_back_press
            return
        endif
        if THUGRECOMP_MouseOver id = char_guide_left_arrow x = <ms_x> y = <ms_y> pad = 8.0
            FireEvent type = pad_l1 target = keyboard_vmenu
            return
        endif
        if THUGRECOMP_MouseOver id = char_guide_right_arrow x = <ms_x> y = <ms_y> pad = 8.0
            FireEvent type = pad_r1 target = keyboard_vmenu
            return
        endif
        if (<ms_hit> > -1)
            if ScreenElementExists id = <ms_hit_id>
                SpawnScript dadmod_kb_click_anim params = { id = <ms_hit_id> }
                FireEvent type = pad_choose target = <ms_hit_id>
            endif
            return
        endif
    endif
    if (<ms_rclick> > 0)
        dadmod_mouse_back_press
    endif
endscript

script dadmod_mouse_click
    if not ScreenElementExists id = <id>
        return
    endif
    if THUGRECOMP_MouseArrows row = <id> left = { <id> child = left_arrow } right = { <id> child = right_arrow } tag1 = { <id> child = dadmod_tag } tag1a = { <id> child = dadmod_tag_arrow } tag2 = { <id> child = dadmod_tag2 } tag2a = { <id> child = dadmod_tag2_arrow } x = <x> y = <y>
        if (<ms_tag> > 0)
            dadmod_mouse_es_tag id = <id> n = <ms_tag>
            return
        endif
        if (<ms_arrow> = 0)
            FireEvent type = pad_left target = <id>
            return
        endif
        if (<ms_arrow> = 1)
            FireEvent type = pad_right target = <id>
            return
        endif
    endif
    if not LevelIs Load_MainMenu
        if ScreenElementExists id = root_window
            if root_window : GetSingleTag pause_controller
                FireEvent type = pad_choose target = <id> data = { device_num = <pause_controller> }
                return
            endif
        endif
    endif
    FireEvent type = pad_choose target = <id>
endscript

dadmod_mouse_tagside = 0

script dadmod_mouse_tag_hover
    if not ScreenElementExists id = { <id> child = dadmod_tag }
        return
    endif
    mm_want = 0
    if THUGRECOMP_MouseArrows row = <id> tag1 = { <id> child = dadmod_tag } tag1a = { <id> child = dadmod_tag_arrow } tag2 = { <id> child = dadmod_tag2 } tag2a = { <id> child = dadmod_tag2_arrow } x = <x> y = <y>
        mm_want = <ms_tag>
    endif
    if (<mm_want> = ( dadmod_mouse_tagside ))
        return
    endif
    Change dadmod_mouse_tagside = <mm_want>
    if (<mm_want> = 0)
        SetScreenElementProps id = <id> tags = { dadmod_side = 1 }
        FireEvent type = pad_left target = <id>
        return
    endif
    SetScreenElementProps id = <id> tags = { dadmod_side = 0 }
    FireEvent type = pad_right target = <id>
    if (<mm_want> = 2)
        if ScreenElementExists id = <id>
            FireEvent type = pad_right target = <id>
        endif
    endif
endscript

script dadmod_mouse_es_tag
    if not ScreenElementExists id = <id>
        return
    endif
    SetScreenElementProps id = <id> tags = { dadmod_side = 0 }
    FireEvent type = pad_right target = <id>
    if (<n> = 2)
        FireEvent type = pad_right target = <id>
    endif
    Change dadmod_mouse_tagside = <n>
    if ScreenElementExists id = <id>
        FireEvent type = pad_choose target = <id>
    endif
endscript

script dadmod_mouse_back_press
    Change dadmod_mouse_last = none
    if ScreenElementExists id = startup_menu
        return
    endif
    THUGRECOMP_MouseBack
endscript

script dadmod_mouse_hide
    if ScreenElementExists id = dadmod_mouse_ptr
        DestroyScreenElement id = dadmod_mouse_ptr
    endif
    if ScreenElementExists id = dadmod_mouse_back
        DestroyScreenElement id = dadmod_mouse_back
    endif
    if ScreenElementExists id = dadmod_mouse_next
        DestroyScreenElement id = dadmod_mouse_next
    endif
    Change dadmod_mouse_back_hl = -1
    Change dadmod_mouse_next_hl = -1
    dadmod_mouse_ss_off
    dadmod_mouse_lvl_off
    dadmod_mouse_hover_bar_off
endscript

script dadmod_mouse_px parent = dadmod_mouse_ptr x = 0 y = 0 w = 1 h = 1 rgba = [ 128 128 128 128 ] z = 9000 a = 1.0
    if GotParam lid
        CreateScreenElement {
        type = SpriteElement
        parent = <parent>
        local_id = <lid>
        texture = white
        just = [ left top ]
        pos = ( (1.0,0.0) * ( <x> * ( dadmod_mouse_pxu ) ) + (0.0,1.0) * ( <y> * ( dadmod_mouse_pyu ) ) )
        scale = ( (1.0,0.0) * ( <w> * ( dadmod_mouse_pxu ) / 4.0 ) + (0.0,1.0) * ( <h> * ( dadmod_mouse_pyu ) / 4.0 ) )
        rgba = <rgba>
        alpha = <a>
        z_priority = <z>
        }
        return
    endif
    CreateScreenElement {
    type = SpriteElement
    parent = <parent>
    texture = white
    just = [ left top ]
    pos = ( (1.0,0.0) * ( <x> * ( dadmod_mouse_pxu ) ) + (0.0,1.0) * ( <y> * ( dadmod_mouse_pyu ) ) )
    scale = ( (1.0,0.0) * ( <w> * ( dadmod_mouse_pxu ) / 4.0 ) + (0.0,1.0) * ( <h> * ( dadmod_mouse_pyu ) / 4.0 ) )
    rgba = <rgba>
    alpha = <a>
    z_priority = <z>
    }
endscript

script dadmod_mouse_pointer
    if ScreenElementExists id = dadmod_mouse_ptr
        DestroyScreenElement id = dadmod_mouse_ptr
    endif
endscript

dadmod_mouse_sl_hl = -1

dadmod_mouse_sr_hl = -1

script dadmod_mouse_tri parent = dadmod_mouse_sl x = 0 y = 0 n = 14 dir = 0 rgba = [ 128 128 128 128 ] z = 8993 sh = 1
    mm_ti = 0
    begin
        if (<dir> = 0)
            mm_tx = ( <x> + <mm_ti> )
        else
            mm_tx = ( <x> + <n> - 1 - <mm_ti> )
        endif
        if (<sh> = 1)
            dadmod_mouse_px parent = <parent> x = ( <mm_tx> + 2 ) y = ( <y> - <mm_ti> + 2 ) w = 1 h = ( 2 * <mm_ti> + 1 ) rgba = [ 0 0 0 128 ] a = 0.35 z = ( <z> - 1 )
        endif
        dadmod_mouse_px parent = <parent> x = <mm_tx> y = ( <y> - <mm_ti> ) w = 1 h = ( 2 * <mm_ti> + 1 ) rgba = <rgba> z = <z>
        dadmod_mouse_px parent = <parent> x = <mm_tx> y = ( <y> - <mm_ti> - 1 ) w = 1 h = 1 rgba = <rgba> a = 0.45 z = <z>
        dadmod_mouse_px parent = <parent> x = <mm_tx> y = ( <y> + <mm_ti> + 1 ) w = 1 h = 1 rgba = <rgba> a = 0.45 z = <z>
        mm_ti = ( <mm_ti> + 1 )
    repeat <n>
endscript

script dadmod_mouse_frame parent = dadmod_mouse_ssb x = 0 y = 0 w = 100 h = 30 th = 2 rgba = [ 128 128 128 128 ] fill = [ 0 0 0 128 ] fa = 0.8 z = 8992 lid = none
    dadmod_mouse_px parent = <parent> x = ( <x> + 4 ) y = ( <y> + 4 ) w = <w> h = <h> rgba = [ 0 0 0 128 ] a = 0.3 z = ( <z> - 2 )
    if (<lid> = none)
        dadmod_mouse_px parent = <parent> x = ( <x> + 1 ) y = ( <y> + 1 ) w = ( <w> - 2 ) h = ( <h> - 2 ) rgba = <fill> a = <fa> z = ( <z> - 1 )
    else
        dadmod_mouse_px parent = <parent> lid = <lid> x = ( <x> + 1 ) y = ( <y> + 1 ) w = ( <w> - 2 ) h = ( <h> - 2 ) rgba = <fill> a = <fa> z = ( <z> - 1 )
    endif
    dadmod_mouse_px parent = <parent> x = ( <x> + 2 ) y = <y> w = ( <w> - 4 ) h = <th> rgba = <rgba> z = <z>
    dadmod_mouse_px parent = <parent> x = ( <x> + 2 ) y = ( <y> + <h> - <th> ) w = ( <w> - 4 ) h = <th> rgba = <rgba> z = <z>
    dadmod_mouse_px parent = <parent> x = <x> y = ( <y> + 2 ) w = <th> h = ( <h> - 4 ) rgba = <rgba> z = <z>
    dadmod_mouse_px parent = <parent> x = ( <x> + <w> - <th> ) y = ( <y> + 2 ) w = <th> h = ( <h> - 4 ) rgba = <rgba> z = <z>
    dadmod_mouse_px parent = <parent> x = ( <x> + 1 ) y = ( <y> + 1 ) w = 1 h = 1 rgba = <rgba> a = 0.6 z = <z>
    dadmod_mouse_px parent = <parent> x = ( <x> + <w> - 2 ) y = ( <y> + 1 ) w = 1 h = 1 rgba = <rgba> a = 0.6 z = <z>
    dadmod_mouse_px parent = <parent> x = ( <x> + 1 ) y = ( <y> + <h> - 2 ) w = 1 h = 1 rgba = <rgba> a = 0.6 z = <z>
    dadmod_mouse_px parent = <parent> x = ( <x> + <w> - 2 ) y = ( <y> + <h> - 2 ) w = 1 h = 1 rgba = <rgba> a = 0.6 z = <z>
endscript

script dadmod_mouse_arrow_build bid = dadmod_mouse_sl x = 0.0 y = 0.0 mm_hl = 0 dir = 0 phl = 0
    if ScreenElementExists id = <bid>
        DestroyScreenElement id = <bid>
    endif
    if not ScreenElementExists id = root_window
        return
    endif
    CreateScreenElement {
    type = ContainerElement
    parent = root_window
    id = <bid>
    pos = ( (1.0,0.0) * <x> + (0.0,1.0) * <y> )
    just = [ left top ]
    z_priority = 8990
    }
    dadmod_mouse_px parent = <bid> x = 0 y = 0 w = 56 h = 56 rgba = [ 0 0 0 0 ] z = 8991
    mm_s0 = 1.0
    if (<phl> = 1)
        mm_s0 = 1.1
    endif
    dadmod_mouse_box parent = <bid> lid = arr_c x = 28.0 y = 28.0 sc = <mm_s0>
    mm_col = [ 128 128 128 128 ]
    if (<mm_hl> = 1)
        mm_col = ( ( THUGPRO_GlobalThemeInfo ) . HIGHLIGHTED_TEXT_COLOR )
    endif
    dadmod_mouse_tri parent = { <bid> child = arr_c } x = -8 y = 0 n = 16 dir = <dir> rgba = <mm_col> z = 8993
    mm_dx = -4.0
    if (<dir> = 1)
        mm_dx = 4.0
    endif
    if (<mm_hl> = 1)
        DoScreenElementMorph id = { <bid> child = arr_c } scale = 1.1 time = 0.12
        SpawnScript dadmod_mouse_nudge params = { id = { <bid> child = arr_c } x = 28.0 y = 28.0 dx = <mm_dx> }
    else
        if (<phl> = 1)
            DoScreenElementMorph id = { <bid> child = arr_c } scale = 1.0 time = 0.12
        endif
    endif
endscript

script dadmod_mouse_ss_arrows
    mm_size = ( 56.0 * ( dadmod_mouse_pxu ) )
    mm_sizey = ( 56.0 * ( dadmod_mouse_pyu ) )
    mm_ly = ( 205.0 - ( <mm_sizey> / 2.0 ) )
    mm_lx = ( 74.0 - <mm_size> )
    mm_rx = 230.0
    mm_l = 0
    mm_r = 0
    if ScreenElementExists id = { dadmod_mouse_sl child = 0 }
        if THUGRECOMP_MouseOver id = { dadmod_mouse_sl child = 0 } x = <x> y = <y> pad = 0.0
            mm_l = 1
        endif
    endif
    if ScreenElementExists id = { dadmod_mouse_sr child = 0 }
        if THUGRECOMP_MouseOver id = { dadmod_mouse_sr child = 0 } x = <x> y = <y> pad = 0.0
            mm_r = 1
        endif
    endif
    if not ScreenElementExists id = dadmod_mouse_sl
        Change dadmod_mouse_sl_hl = -1
    endif
    if not ScreenElementExists id = dadmod_mouse_sr
        Change dadmod_mouse_sr_hl = -1
    endif
    if not (<mm_l> = ( dadmod_mouse_sl_hl ))
        FormatText TextName = mm_msg "mouse: skater arrows hover left %a right %b" a = <mm_l> b = <mm_r>
        THUGRECOMP_Log text = <mm_msg>
        mm_p = 0
        if (( dadmod_mouse_sl_hl ) = 1)
            mm_p = 1
        endif
        if (<mm_l> = 1)
            generic_menu_up_or_down_sound
        endif
        Change dadmod_mouse_sl_hl = <mm_l>
        dadmod_mouse_arrow_build bid = dadmod_mouse_sl x = <mm_lx> y = <mm_ly> mm_hl = <mm_l> dir = 0 phl = <mm_p>
    endif
    if not (<mm_r> = ( dadmod_mouse_sr_hl ))
        mm_p = 0
        if (( dadmod_mouse_sr_hl ) = 1)
            mm_p = 1
        endif
        if (<mm_r> = 1)
            generic_menu_up_or_down_sound
        endif
        Change dadmod_mouse_sr_hl = <mm_r>
        dadmod_mouse_arrow_build bid = dadmod_mouse_sr x = <mm_rx> y = <mm_ly> mm_hl = <mm_r> dir = 1 phl = <mm_p>
    endif
    return mm_side_l = <mm_l> mm_side_r = <mm_r>
endscript

dadmod_mouse_sel_hl = -1

dadmod_mouse_load_hl = -1

script dadmod_mouse_txt parent = dadmod_mouse_ssb x = 0 y = 0 text = "" font = crillee scale = 0.2 rgba = [ 128 128 128 128 ] z = 8995 lid = dadmod_t
    CreateScreenElement {
    type = TextElement
    parent = <parent>
    local_id = <lid>
    font = <font>
    text = <text>
    just = [ left center ]
    pos = ( (1.0,0.0) * ( <x> * ( dadmod_mouse_pxu ) ) + (0.0,1.0) * ( <y> * ( dadmod_mouse_pyu ) ) )
    scale = <scale>
    rgba = <rgba>
    z_priority = <z>
    }
endscript

script dadmod_mouse_box parent = dadmod_mouse_ssb lid = sel_box x = 0.0 y = 0.0 sc = 1.0
    CreateScreenElement {
    type = ContainerElement
    parent = <parent>
    local_id = <lid>
    pos = ( (1.0,0.0) * ( <x> * ( dadmod_mouse_pxu ) ) + (0.0,1.0) * ( <y> * ( dadmod_mouse_pyu ) ) )
    just = [ left top ]
    scale = <sc>
    }
endscript

script dadmod_mouse_measure parent = dadmod_mouse_ssb text = "" scale = 0.2
    dadmod_mouse_txt parent = <parent> lid = dadmod_measure text = <text> font = crillee scale = <scale> rgba = [ 0 0 0 0 ]
    mm_w = 100.0
    if ScreenElementExists id = { <parent> child = dadmod_measure }
        GetScreenElementDims id = { <parent> child = dadmod_measure }
        mm_w = ( <width> / ( dadmod_mouse_pxu ) )
        DestroyScreenElement id = { <parent> child = dadmod_measure }
    endif
    return mm_w = <mm_w>
endscript

script dadmod_mouse_ss_build bid = dadmod_mouse_ssb x = 0.0 y = 0.0 sel = 0 load = 0 psel = 0 pload = 0
    if ScreenElementExists id = <bid>
        DestroyScreenElement id = <bid>
    endif
    if not ScreenElementExists id = root_window
        return
    endif
    CreateScreenElement {
    type = ContainerElement
    parent = root_window
    id = <bid>
    pos = ( (1.0,0.0) * <x> + (0.0,1.0) * <y> )
    just = [ left top ]
    z_priority = 8990
    }
    dadmod_mouse_measure parent = <bid> text = "SELECT SKATER" scale = 0.2
    mm_selw = ( <mm_w> + 76.0 )
    dadmod_mouse_measure parent = <bid> text = "LOAD SKATER" scale = 0.125
    mm_loadw = ( <mm_w> + 30.0 )
    Change dadmod_mouse_selw = <mm_selw>
    Change dadmod_mouse_loadw = <mm_loadw>
    mm_line = [ 128 128 128 128 ]
    mm_seltxt = ( ( THUGPRO_GlobalThemeInfo ) . MENU_TITLE_COLOR )
    mm_selfill = [ 0 0 0 128 ]
    mm_selfa = 0.78
    if (<sel> = 1)
        mm_line = ( ( THUGPRO_GlobalThemeInfo ) . HIGHLIGHTED_TEXT_COLOR )
        mm_seltxt = ( ( THUGPRO_GlobalThemeInfo ) . HIGHLIGHTED_TEXT_COLOR )
        mm_selfill = [ 60 60 60 128 ]
        mm_selfa = 0.88
    endif
    mm_gray = [ 90 90 90 100 ]
    mm_loadtxt = ( ( THUGPRO_GlobalThemeInfo ) . UNHIGHLIGHTED_TEXT_COLOR )
    mm_loadfill = [ 0 0 0 128 ]
    mm_loadfa = 0.6
    if (<load> = 1)
        mm_gray = ( ( THUGPRO_GlobalThemeInfo ) . HIGHLIGHTED_TEXT_COLOR )
        mm_loadtxt = ( ( THUGPRO_GlobalThemeInfo ) . HIGHLIGHTED_TEXT_COLOR )
        mm_loadfill = [ 50 50 50 128 ]
        mm_loadfa = 0.8
    endif
    mm_scx = ( 78.0 + ( <mm_selw> / 2.0 ) )
    mm_s0 = 1.0
    if (<psel> = 1)
        mm_s0 = 1.04
    endif
    dadmod_mouse_box parent = <bid> lid = sel_box x = <mm_scx> y = 198.0 sc = <mm_s0>
    mm_sb = { <bid> child = sel_box }
    mm_hx = ( 0.0 - ( <mm_selw> / 2.0 ) )
    dadmod_mouse_frame parent = <mm_sb> lid = sel_bg x = <mm_hx> y = -32 w = <mm_selw> h = 64 th = 2 rgba = <mm_line> fill = <mm_selfill> fa = <mm_selfa> z = 8992
    dadmod_mouse_px parent = <mm_sb> x = ( <mm_hx> + 10 ) y = -22 w = 6 h = 44 rgba = ( ( THUGPRO_GlobalThemeInfo ) . MENU_TITLE_COLOR ) z = 8993
    dadmod_mouse_txt parent = <mm_sb> lid = sel_text x = ( <mm_hx> + 28 ) y = 0 text = "SELECT SKATER" font = crillee scale = 0.2 rgba = <mm_seltxt> z = 8995
    mm_chx = ( ( <mm_selw> / 2.0 ) - 30.0 )
    dadmod_mouse_box parent = <mm_sb> lid = sel_chev x = <mm_chx> y = 0.0
    if (<sel> = 1)
        dadmod_mouse_tri parent = { <bid> child = { sel_box child = sel_chev } } x = 2 y = 0 n = 11 dir = 1 rgba = <mm_line> z = 8996 sh = 0
    else
        dadmod_mouse_tri parent = { <bid> child = { sel_box child = sel_chev } } x = 0 y = 0 n = 9 dir = 1 rgba = <mm_line> z = 8996 sh = 0
    endif
    mm_lcx = ( 78.0 + ( <mm_loadw> / 2.0 ) )
    mm_l0 = 1.0
    if (<pload> = 1)
        mm_l0 = 1.04
    endif
    dadmod_mouse_box parent = <bid> lid = load_box x = <mm_lcx> y = 259.0 sc = <mm_l0>
    mm_lb = { <bid> child = load_box }
    mm_lhx = ( 0.0 - ( <mm_loadw> / 2.0 ) )
    dadmod_mouse_frame parent = <mm_lb> lid = load_bg x = <mm_lhx> y = -17 w = <mm_loadw> h = 34 th = 1 rgba = <mm_gray> fill = <mm_loadfill> fa = <mm_loadfa> z = 8992
    dadmod_mouse_txt parent = <mm_lb> lid = load_text x = ( <mm_lhx> + 14 ) y = 0 text = "LOAD SKATER" font = crillee scale = 0.125 rgba = <mm_loadtxt> z = 8995
    if (<sel> = 1)
        DoScreenElementMorph id = <mm_sb> scale = 1.04 time = 0.12
        SpawnScript dadmod_mouse_pulse params = { id = <mm_sb> }
        SpawnScript dadmod_mouse_nudge params = { id = { <bid> child = { sel_box child = sel_chev } } x = <mm_chx> dx = 4.0 }
    else
        if (<psel> = 1)
            DoScreenElementMorph id = <mm_sb> scale = 1.0 time = 0.12
        endif
    endif
    if (<load> = 1)
        DoScreenElementMorph id = <mm_lb> scale = 1.04 time = 0.12
        SpawnScript dadmod_mouse_pulse params = { id = <mm_lb> }
    else
        if (<pload> = 1)
            DoScreenElementMorph id = <mm_lb> scale = 1.0 time = 0.12
        endif
    endif
endscript

script dadmod_mouse_pulse
    wait 0.15 seconds
    begin
        if not ScreenElementExists id = <id>
            return
        endif
        DoScreenElementMorph id = <id> alpha = 0.8 time = 0.5
        wait 0.5 seconds
        if not ScreenElementExists id = <id>
            return
        endif
        DoScreenElementMorph id = <id> alpha = 1.0 time = 0.5
        wait 0.5 seconds
    repeat
endscript

script dadmod_mouse_nudge x = 0.0 y = 0.0 dx = 4.0
    begin
        if not ScreenElementExists id = <id>
            return
        endif
        DoScreenElementMorph id = <id> pos = ( (1.0,0.0) * ( ( <x> + <dx> ) * ( dadmod_mouse_pxu ) ) + (0.0,1.0) * ( <y> * ( dadmod_mouse_pyu ) ) ) time = 0.3
        wait 0.3 seconds
        if not ScreenElementExists id = <id>
            return
        endif
        DoScreenElementMorph id = <id> pos = ( (1.0,0.0) * ( <x> * ( dadmod_mouse_pxu ) ) + (0.0,1.0) * ( <y> * ( dadmod_mouse_pyu ) ) ) time = 0.3
        wait 0.3 seconds
    repeat
endscript

script dadmod_mouse_press scale = 1.04
    if not ScreenElementExists id = <id>
        return
    endif
    DoScreenElementMorph id = <id> scale = 0.94 time = 0.06
    if GotParam flash
        if ScreenElementExists id = <flash>
            DoScreenElementMorph id = <flash> rgba = [ 128 128 128 128 ] time = 0
            DoScreenElementMorph id = <flash> rgba = <fill> time = 0.15
        endif
    endif
    wait 0.06 seconds
    if ScreenElementExists id = <id>
        DoScreenElementMorph id = <id> scale = <scale> time = 0.09
    endif
endscript

script dadmod_mouse_kick x = 0.0 y = 0.0 dx = 8.0
    if not ScreenElementExists id = <id>
        return
    endif
    DoScreenElementMorph id = <id> pos = ( (1.0,0.0) * ( ( <x> + <dx> ) * ( dadmod_mouse_pxu ) ) + (0.0,1.0) * ( <y> * ( dadmod_mouse_pyu ) ) ) time = 0.06
    wait 0.06 seconds
    if ScreenElementExists id = <id>
        DoScreenElementMorph id = <id> pos = ( (1.0,0.0) * ( <x> * ( dadmod_mouse_pxu ) ) + (0.0,1.0) * ( <y> * ( dadmod_mouse_pyu ) ) ) time = 0.12
    endif
endscript

dadmod_mouse_selw = 300.0

dadmod_mouse_loadw = 150.0

script dadmod_mouse_ss_buttons x = 0.0 y = 0.0 cx = 0.0 cy = 0.0
    mm_px = ( ( <x> - <cx> ) / ( dadmod_mouse_pxu ) )
    mm_py = ( ( <y> - <cy> ) / ( dadmod_mouse_pyu ) )
    mm_sel = 0
    mm_load = 0
    if (<mm_px> > 77.0)
        if (<mm_px> < ( 78.0 + ( dadmod_mouse_selw ) ))
            if (<mm_py> > 165.0)
                if (<mm_py> < 230.0)
                    mm_sel = 1
                endif
            endif
        endif
        if (<mm_px> < ( 78.0 + ( dadmod_mouse_loadw ) ))
            if (<mm_py> > 241.0)
                if (<mm_py> < 276.0)
                    mm_load = 1
                endif
            endif
        endif
    endif
    if not ScreenElementExists id = dadmod_mouse_ssb
        Change dadmod_mouse_sel_hl = -1
    endif
    mm_redo = 0
    if not (<mm_sel> = ( dadmod_mouse_sel_hl ))
        mm_redo = 1
    endif
    if not (<mm_load> = ( dadmod_mouse_load_hl ))
        mm_redo = 1
    endif
    if (<mm_redo> = 1)
        FormatText TextName = mm_msg "mouse: skater select hover sel %a load %b (pointer px %c,%d, select width %e)" a = <mm_sel> b = <mm_load> c = <mm_px> d = <mm_py> e = ( dadmod_mouse_selw )
        THUGRECOMP_Log text = <mm_msg>
        mm_psel = 0
        if (( dadmod_mouse_sel_hl ) = 1)
            mm_psel = 1
        endif
        mm_pload = 0
        if (( dadmod_mouse_load_hl ) = 1)
            mm_pload = 1
        endif
        if ( (<mm_sel> = 1) or (<mm_load> = 1) )
            if ( (<mm_psel> = 0) and (<mm_pload> = 0) )
                generic_menu_up_or_down_sound
            endif
        endif
        Change dadmod_mouse_sel_hl = <mm_sel>
        Change dadmod_mouse_load_hl = <mm_load>
        dadmod_mouse_ss_build x = <cx> y = <cy> sel = <mm_sel> load = <mm_load> psel = <mm_psel> pload = <mm_pload>
    endif
    return mm_over_sel = <mm_sel> mm_over_load = <mm_load>
endscript

dadmod_skin_state = -1

script dadmod_mouse_skin_off
    if ScreenElementExists id = dadmod_mouse_skin
        DestroyScreenElement id = dadmod_mouse_skin
    endif
    Change dadmod_skin_state = -1
endscript

script dadmod_mouse_skin_pill x = 0.0 y = 0.0
    mm_item = ( LAST_SELECTED_SKATER_MENU_ID )
    mm_n = 0
    mm_i = 0
    if ScreenElementExists id = <mm_item>
        if <mm_item> : GetSingleTag number_of_skins
            mm_n = <number_of_skins>
        endif
        if <mm_item> : GetSingleTag selected_skin_index
            mm_i = <selected_skin_index>
        endif
    endif
    if (<mm_n> < 2)
        dadmod_mouse_skin_off
        return mm_skin_l = 0 mm_skin_r = 0
    endif
    mm_cx = 156.0
    mm_cy = 382.0
    mm_px = ( ( <x> - <mm_cx> ) / ( dadmod_mouse_pxu ) )
    mm_py = ( ( <y> - <mm_cy> ) / ( dadmod_mouse_pyu ) )
    mm_l = 0
    mm_r = 0
    if (<mm_py> > -18.0)
        if (<mm_py> < 18.0)
            if (<mm_px> > -115.0)
                if (<mm_px> < -55.0)
                    mm_l = 1
                endif
            endif
            if (<mm_px> > 55.0)
                if (<mm_px> < 115.0)
                    mm_r = 1
                endif
            endif
        endif
    endif
    mm_state = ( ( <mm_n> * 10000 ) + ( <mm_i> * 10 ) + <mm_l> + ( 2 * <mm_r> ) )
    if not ScreenElementExists id = dadmod_mouse_skin
        Change dadmod_skin_state = -1
    endif
    if not (<mm_state> = ( dadmod_skin_state ))
        Change dadmod_skin_state = <mm_state>
        dadmod_mouse_skin_build cx = <mm_cx> cy = <mm_cy> n = <mm_n> i = <mm_i> l = <mm_l> r = <mm_r>
    endif
    return mm_skin_l = <mm_l> mm_skin_r = <mm_r> mm_skin_item = <mm_item>
endscript

script dadmod_mouse_skin_build cx = 0.0 cy = 0.0 n = 1 i = 0 l = 0 r = 0
    if ScreenElementExists id = dadmod_mouse_skin
        DestroyScreenElement id = dadmod_mouse_skin
    endif
    if not ScreenElementExists id = root_window
        return
    endif
    CreateScreenElement {
    type = ContainerElement
    parent = root_window
    id = dadmod_mouse_skin
    pos = ( (1.0,0.0) * <cx> + (0.0,1.0) * <cy> )
    just = [ left top ]
