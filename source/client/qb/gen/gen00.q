script UserSelectSelect
    MORTEN_DUMP_OBSERVE_MODE_DATA
    if IsTrue __ANIM_IS_PLAYING
        return
    endif
    if not IsTrue exit_pause_menu_ready
        return
    endif
    if LevelIs load_sk5ed
        if CustomParkMode editing
            if ( ( thugpro_userselect_action ) = thugpro_userselect_case_viewer )
                UserSelectX
                return
            endif
        endif
    endif
    if LevelIs Load_MainMenu
        return
    endif
    if ScreenElementExists id = current_menu_anchor
        return
    endif
    if ScreenElementExists id = root_window
        if root_window : GetSingleTag menu_state
            if ( <menu_state> = on )
                return
            endif
        endif
    endif
    if IsTrue view_mode
        if not InNetGame
            if not ( ( thugpro_userselect_action ) = thugpro_userselect_case_viewer )
                SpawnScript thugpro_freecam_quick_menu
                return
            endif
        endif
    endif
    KillSpawnedScript Name = quick_menu_input_checker
    SpawnScript quick_menu_input_checker
endscript

script ToggleViewMode
    <can_use_viewer> = 1
    if InNetGame
        if IsObserving
            <can_use_viewer> = 1
        else
            if not IsTrue THUGPRO_ObserveOn
                <can_use_viewer> = 0
                if IsSurveying
                    <can_use_viewer> = 1
                endif
            endif
            if Skater : Skating
                if not Skater : OnGround
                    <can_use_viewer> = 0
                endif
            else
                if Skater : walking
                    if Skater : Walk_Air
                        <can_use_viewer> = 0
                    endif
                endif
            endif
        endif
    endif
    if ScreenElementExists id = current_menu_anchor
        <can_use_viewer> = 0
    endif
    if ScreenElementExists id = cat_menu_anchor
        <can_use_viewer> = 0
    endif
    if ScreenElementExists id = dialog_box_anchor
        <can_use_viewer> = 0
    endif
    if LevelIs load_sk5ed
        <can_use_viewer> = 1
        if IsTrue PARKED_NO_VIEWERCAM
            <can_use_viewer> = 0
        endif
    endif
    if LevelIs Load_MainMenu
        <can_use_viewer> = 0
    endif
    if IsTrue view_mode
        Change view_mode = 0
        SetViewMode 0
        if CustomParkMode editing
            if IsTrue RAILTOOL_IS_ACTIVE
                raileditor : Unsuspend
                SetActiveCamera id = raileditor
            else
                SetActiveCamera id = parked_cam
            endif
            SetParkEditorPauseMode unpause
        else
            if not IsObserving
                GoalManager_ShowPoints
                unpause_trick_text
            endif
            if InNetGame
            else
                UnPauseSkaters
                MakeSkaterGoto THUGPRO_EnablePlayerInput
                if Skater : walking
                    ResetPhysics Walk
                else
                    ResetPhysics
                endif
            endif
        endif
    else
        if IsTrue observe_overview_cam_state
            <can_use_viewer> = 0
        endif
        if ( <can_use_viewer> = 1 )
            Change view_mode = 1
            SetViewMode 1
            KillSpawnedScript Name = thugpro_freecam_track
            SpawnScript thugpro_freecam_track
            if CustomParkMode editing
                raileditor : suspend
                SetParkEditorPauseMode pause
            else
                if not IsObserving
                    GoalManager_HidePoints
                    pause_trick_text
                endif
                if not InNetGame
                    PauseSkaters
                    MakeSkaterGoto thugpro_DisablePlayerInput
                endif
            endif
        endif
    endif
endscript

script dadmod_noclip_boot
    KillSpawnedScript Name = dadmod_noclip_watch
    SpawnScript dadmod_noclip_watch NotSessionSpecific = 1
endscript

script dadmod_noclip_watch
    dadmod_nc_combo_was = 1
    begin
        wait 1 gameframe
        if not ScreenElementExists id = dadmod_hasmod
            if ScreenElementExists id = root_window
                CreateScreenElement type = ContainerElement parent = root_window id = dadmod_hasmod Pos = (0.0,0.0)
            endif
        endif
        dadmod_homelevel_tick
        if THUGRECOMP_KeyPressed key = "F6"
            dadmod_noclip_toggle
        endif
        dadmod_nc_combo = 0
        if THUGRECOMP_PadHeld button = "leftshoulder"
            if THUGRECOMP_PadHeld button = "lefttrigger"
                if THUGRECOMP_PadHeld button = "rightshoulder"
                    if THUGRECOMP_PadHeld button = "righttrigger"
                        dadmod_nc_combo = 1
                    endif
                endif
            endif
        endif
        if (<dadmod_nc_combo> = 1)
            if (<dadmod_nc_combo_was> = 0)
                dadmod_noclip_toggle
            endif
        endif
        dadmod_nc_combo_was = <dadmod_nc_combo>
        dadmod_nc_count = 0
        if ScreenElementExists id = root_window
            dadmod_nc_count = 1
            if root_window : GetSingleTag menu_state
                if (<menu_state> = on)
                    dadmod_nc_count = 0
                endif
            endif
        endif
        if ScreenElementExists id = current_menu_anchor
            dadmod_nc_count = 0
        endif
        if (<dadmod_nc_count> = 1)
            if root_window : GetSingleTag dadmod_noclip
                if (<dadmod_noclip> > 0)
                    dadmod_nc_left = ( <dadmod_noclip> - 1 )
                    root_window : SetTags dadmod_noclip = <dadmod_nc_left>
                    if (<dadmod_nc_left> = 0)
                        dadmod_noclip_lost
                    endif
                endif
            endif
        endif
    repeat
endscript

script dadmod_noclip_lost
    GetSkaterId
    if ObjectExists id = <objID>
        <objID> : UnpausePhysics
    endif
endscript

script dadmod_noclip_is_on
    dadmod_nc_on = 0
    if ScreenElementExists id = root_window
        if root_window : GetSingleTag dadmod_noclip
            if (<dadmod_noclip> > 0)
                dadmod_nc_on = 1
            endif
        endif
    endif
    return dadmod_nc_on = <dadmod_nc_on>
endscript

script dadmod_noclip_allowed
    dadmod_nc_ok = 0
    dadmod_nc_why = "not in a game"
    dadmod_nc_mode = 0
    if InNetGame
        dadmod_nc_mode = 1
    else
        if GameModeEquals is_singlesession
            dadmod_nc_mode = 1
        endif
        if GameModeEquals is_freeskate
            dadmod_nc_mode = 1
        endif
    endif
    if (<dadmod_nc_mode> = 1)
        dadmod_nc_ok = 1
    endif
    if LevelIs Load_MainMenu
        dadmod_nc_ok = 0
    endif
    if LevelIs load_sk5ed
        dadmod_nc_ok = 0
    endif
    if ScreenElementExists id = startup_menu
        dadmod_nc_ok = 0
    endif
    if ScreenElementExists id = current_menu_anchor
        dadmod_nc_ok = 0
    endif
    if ScreenElementExists id = root_window
        if root_window : GetSingleTag menu_state
            if (<menu_state> = on)
                dadmod_nc_ok = 0
            endif
        endif
    else
        dadmod_nc_ok = 0
    endif
    if IsTrue view_mode
        dadmod_nc_ok = 0
    endif
    if (<dadmod_nc_ok> = 0)
        dadmod_nc_why = "menu, level or view mode"
    endif
    dadmod_noclip_after_zero
    dadmod_noclip_postgame
    if (<dadmod_nc_az> = 0)
        if (<dadmod_nc_pg> = 0)
            if IsObserving
                dadmod_nc_ok = 0
                dadmod_nc_why = "observing"
            endif
        endif
    endif
    if IsTrue THUGPRO_HostAsObserver
        dadmod_nc_ok = 0
        dadmod_nc_why = "host as observer"
    endif
    if IsTrue JoinedAsObserver
        dadmod_nc_ok = 0
        dadmod_nc_why = "joined as observer"
    endif
    if (<dadmod_nc_ok> = 1)
        GetSkaterId
        if ObjectExists id = <objID>
            if <objID> : Driving
                dadmod_nc_ok = 0
                dadmod_nc_why = "driving"
            endif
        else
            dadmod_nc_ok = 0
            dadmod_nc_why = "no skater"
        endif
    endif
    if (<dadmod_nc_ok> = 0)
        THUGRECOMP_TextSave key = "noclip_refused" value = <dadmod_nc_why>
    endif
    return dadmod_nc_ok = <dadmod_nc_ok>
endscript

script dadmod_noclip_toggle
    dadmod_noclip_is_on
    if (<dadmod_nc_on> = 1)
        root_window : SetTags dadmod_noclip = 0
        dadmod_noclip_msg text = "Noclip off"
        return
    endif
    dadmod_noclip_allowed
    if (<dadmod_nc_ok> = 0)
        return
    endif
    root_window : SetTags dadmod_noclip = 30
    GetSkaterId
    <objID> : Obj_GetPosition
    root_window : SetTags dadmod_noclip_home = <Pos>
    dadmod_nc_foot = 0
    GetSkaterId
    if <objID> : walking
        dadmod_nc_foot = 1
    endif
    root_window : SetTags dadmod_noclip_foot = <dadmod_nc_foot>
    dadmod_noclip_after_zero
    dadmod_noclip_postgame
    if ( (<dadmod_nc_az> = 1) or (<dadmod_nc_pg> = 1) )
        thugpro_observe_self
        dadmod_noclip_hide_observe
    endif
    MakeSkaterGoto dadmod_noclip_state
    dadmod_noclip_msg text = "Noclip on"
endscript

script dadmod_noclip_after_zero
    dadmod_nc_az = 0
    if InNetGame
        if not GameModeEquals is_lobby
            if not GameModeEquals is_horse
                if not GameIsOver
                    GoalManager_GetTimeLeftInNetGame
                    if (<time_left> < 1)
                        dadmod_nc_az = 1
                    endif
                endif
            endif
        endif
    endif
    return dadmod_nc_az = <dadmod_nc_az>
endscript

script dadmod_noclip_postgame
    dadmod_nc_pg = 0
    if InNetGame
        if not GameModeEquals is_lobby
            if GameIsOver
                dadmod_nc_pg = 1
            endif
        endif
    endif
    return dadmod_nc_pg = <dadmod_nc_pg>
endscript

script dadmod_noclip_hide_observe
    if ScreenElementExists id = observe_input_handler
        DestroyScreenElement id = observe_input_handler
    endif
endscript

script dadmod_noclip_quick
    exit_quick_menu
    KillSpawnedScript Name = dadmod_noclip_quick_later
    SpawnScript dadmod_noclip_quick_later
endscript

script dadmod_noclip_quick_later
    begin
        wait 1 gameframe
        if not ScreenElementExists id = current_menu_anchor
            break
        endif
    repeat 60
    wait 2 gameframes
    dadmod_noclip_toggle
endscript

script dadmod_noclip_msg
    KillSpawnedScript Name = dadmod_noclip_msg_show
    SpawnScript dadmod_noclip_msg_show params = { text = <text> }
endscript

script dadmod_noclip_msg_show
    if ScreenElementExists id = dadmod_noclip_text
        DestroyScreenElement id = dadmod_noclip_text
    endif
    if not ScreenElementExists id = root_window
        return
    endif
    dadmod_nc_msg = <text>
    CreateScreenElement {
    Type = TextElement
    parent = root_window
    id = dadmod_noclip_text
    font = crillee
    text = " "
    Pos = (2.4e+01,2.2e+01)
    just = [ left top ]
    scale = 0.3
    rgba = [ 20 200 20 128 ]
    z_priority = 1000
    shadow
    shadow_rgba = [ 0 0 0 70 ]
    shadow_offs = (2.0,2.0)
    }
    if not ScreenElementExists id = dadmod_noclip_text
        return
    endif
    RunScriptOnScreenElement id = dadmod_noclip_text dadmod_noclip_text_style
    dadmod_nc_t = 0.0
    begin
        if not ScreenElementExists id = dadmod_noclip_text
            break
        endif
        if ( <dadmod_nc_t> > 3.4 )
            break
        endif
        if ( <dadmod_nc_t> > 2.9 )
            THUGRECOMP_ScanText text = <dadmod_nc_msg> mode = 4 t = ( <dadmod_nc_t> * 30.0 ) reveal = 0.0
            SetScreenElementProps id = dadmod_noclip_text text = <text>
        else
            if ( <dadmod_nc_t> > 0.9 )
                SetScreenElementProps id = dadmod_noclip_text text = <dadmod_nc_msg>
            else
                THUGRECOMP_ScanText text = <dadmod_nc_msg> mode = 4 t = ( <dadmod_nc_t> * 30.0 ) reveal = ( <dadmod_nc_t> / 0.9 )
                SetScreenElementProps id = dadmod_noclip_text text = <text>
            endif
        endif
        dadmod_nc_t = ( <dadmod_nc_t> + 0.0167 )
        wait 1 gameframe
    repeat
    if ScreenElementExists id = dadmod_noclip_text
        DestroyScreenElement id = dadmod_noclip_text
    endif
endscript

script dadmod_noclip_text_style
    DoMorph time = 0 alpha = 0
    DoMorph time = 0.15 alpha = 1
    DoMorph time = 0.75 alpha = 1
    DoMorph time = 2.0 alpha = 1
    DoMorph time = 0.5 alpha = 0
endscript

script dadmod_noclip_idle_anim
    if (<dadmod_nc_walk> = 1)
        PlayWalkAnim anim = JumpAir Cycle NoRestart BlendPeriod = 0.2
    else
        PlayAnim anim = AirIdle Cycle NoRestart BlendPeriod = 0.2
    endif
endscript

script dadmod_noclip_state
    dadmod_nc_walk = 0
    if walking
        dadmod_nc_walk = 1
    endif
    if root_window : GetSingleTag dadmod_noclip_foot
        dadmod_nc_walk = <dadmod_noclip_foot>
    endif
    if not walking
        SwitchOnBoard
        SwitchToWalkingPhysics
    endif
    dadmod_nc_trig_was = 0
    dadmod_nc_dirty = 0
    dadmod_nc_hold = 0
    dadmod_nc_saw_l1 = 0
    dadmod_nc_saw_r1 = 0
    dadmod_nc_tri = 0
    ClearExceptions
    ClearEventHandlerGroup WalkingEvents
    ClearExceptionGroup WalkingStateExceptions
    ClearTrickQueue
    ClearEventBuffer
    KillExtraTricks
    StopBalanceTrick
    SetQueueTricks NoTricks
    SetManualTricks NoTricks
    SetSpeed 0
    PausePhysics
    EnablePlayerInput
    dadmod_nc_done = 0
    dadmod_nc_tick = 0
    dadmod_noclip_after_zero
    if (<dadmod_nc_az> = 1)
        THUGPRO_NetEndRun
        dadmod_nc_done = 1
    endif
    dadmod_nc_anim_on = 0
    if GotParam play_anim
        dadmod_nc_anim_on = 1
        if (<dadmod_nc_walk> = 1)
            if GotParam play_loop
                PlayWalkAnim anim = <play_anim> Cycle BlendPeriod = 0.2
            else
                PlayWalkAnim anim = <play_anim> BlendPeriod = 0.2
            endif
        else
            if GotParam play_loop
                PlayAnim anim = <play_anim> Cycle BlendPeriod = 0.3
            else
                PlayAnim anim = <play_anim> BlendPeriod = 0.3
            endif
        endif
        if GotParam play_loop
            dadmod_nc_anim_on = 0
        endif
    else
        dadmod_noclip_idle_anim dadmod_nc_walk = <dadmod_nc_walk>
    endif
    Obj_GetPosition
    dadmod_nc_pos = <Pos>
    Obj_GetOrientation
    dadmod_nc_fx = <x>
    dadmod_nc_fz = <z>
    if ( ( <dadmod_nc_fx> * <dadmod_nc_fx> + <dadmod_nc_fz> * <dadmod_nc_fz> ) < 0.01 )
        dadmod_nc_fx = 0.0
        dadmod_nc_fz = 1.0
    endif
    dadmod_nc_dir = ( <dadmod_nc_fx> * (1.0,0.0,0.0) + <dadmod_nc_fz> * (0.0,0.0,1.0) )
    NormalizeVector <dadmod_nc_dir>
    dadmod_nc_dir = <norm>
    dadmod_nc_ysign = -1.0
    dadmod_nc_xsign = 1.0
    dadmod_nc_xcnt = 0
    dadmod_nc_ycnt = 0
    dadmod_nc_vel = (0.0,0.0,0.0)
    dadmod_nc_camf = <dadmod_nc_dir>
    dadmod_nc_diag = 0
    begin
        dadmod_nc_live = 0
        if ScreenElementExists id = root_window
            if root_window : GetSingleTag dadmod_noclip
                if (<dadmod_noclip> > 0)
                    dadmod_nc_live = 1
                endif
            endif
        endif
        if (<dadmod_nc_live> = 0)
            break
        endif
        root_window : SetTags dadmod_noclip = 30
        dadmod_noclip_hide_observe
        dadmod_nc_tick = ( <dadmod_nc_tick> + 1 )
        if (<dadmod_nc_tick> > 30)
            dadmod_nc_tick = 0
            if (<dadmod_nc_done> = 0)
                dadmod_noclip_after_zero
                if (<dadmod_nc_az> = 1)
                    THUGPRO_NetEndRun
                    dadmod_nc_done = 1
                endif
            endif
        endif
        if (<dadmod_nc_anim_on> = 1)
            if AnimFinished
                dadmod_nc_anim_on = 0
                dadmod_noclip_idle_anim dadmod_nc_walk = <dadmod_nc_walk>
            endif
        endif
        ClearEventHandlerGroup WalkingEvents
        ClearExceptionGroup WalkingStateExceptions
        dadmod_nc_menu = 0
        if ScreenElementExists id = current_menu_anchor
            dadmod_nc_menu = 1
        endif
        if root_window : GetSingleTag menu_state
            if (<menu_state> = on)
                dadmod_nc_menu = 1
            endif
        endif
        if (<dadmod_nc_menu> = 1)
            dadmod_nc_tri = 0
        endif
        if (<dadmod_nc_menu> = 0)
            dadmod_nc_step = 9.0
            if Held circle
                dadmod_nc_step = 30.0
            endif
            if Held triangle
                dadmod_nc_step = 3.0
                dadmod_nc_tri = ( <dadmod_nc_tri> + 1 )
            else
                if (<dadmod_nc_tri> > 0)
                    if (<dadmod_nc_tri> < 15)
                        dadmod_anim_tri
                    endif
                    dadmod_nc_tri = 0
                endif
            endif
            dadmod_nc_up = 0
            dadmod_nc_dn = 0
            dadmod_nc_lt = 0
            dadmod_nc_rt = 0
            if Held up
                dadmod_nc_up = 1
            endif
            if Held down
                dadmod_nc_dn = 1
            endif
            if Held left
                dadmod_nc_lt = 1
            endif
            if Held right
                dadmod_nc_rt = 1
            endif
            dadmod_nc_sx = 0.0
            dadmod_nc_sy = 0.0
            leftx = 0.0
            lefty = 0.0
            if GetAnalogueInfo controller = 0
                if ( ( <leftx> > 1.5 ) or ( <leftx> < -1.5 ) or ( <lefty> > 1.5 ) or ( <lefty> < -1.5 ) )
                    leftx = ( <leftx> / 128.0 )
                    lefty = ( <lefty> / 128.0 )
                endif
                dadmod_nc_yw = 0.0
                if (<dadmod_nc_up> = 1)
                    if (<dadmod_nc_dn> = 0)
                        if (<lefty> < -0.5)
                            dadmod_nc_yw = -1.0
                        endif
                        if (<lefty> > 0.5)
                            dadmod_nc_yw = 1.0
                        endif
                    endif
                endif
                if (<dadmod_nc_dn> = 1)
                    if (<dadmod_nc_up> = 0)
                        if (<lefty> > 0.5)
                            dadmod_nc_yw = -1.0
                        endif
                        if (<lefty> < -0.5)
                            dadmod_nc_yw = 1.0
                        endif
                    endif
                endif
                if (<dadmod_nc_yw> = 0.0)
                    dadmod_nc_ycnt = 0
                else
                    if (<dadmod_nc_yw> = <dadmod_nc_ysign>)
                        dadmod_nc_ycnt = 0
                    else
                        dadmod_nc_ycnt = ( <dadmod_nc_ycnt> + 1 )
                        if (<dadmod_nc_ycnt> > 9)
                            dadmod_nc_ysign = <dadmod_nc_yw>
                            dadmod_nc_ycnt = 0
                        endif
                    endif
                endif
                dadmod_nc_xw = 0.0
                if (<dadmod_nc_rt> = 1)
                    if (<dadmod_nc_lt> = 0)
                        if (<leftx> > 0.5)
                            dadmod_nc_xw = 1.0
                        endif
                        if (<leftx> < -0.5)
                            dadmod_nc_xw = -1.0
                        endif
                    endif
                endif
                if (<dadmod_nc_lt> = 1)
                    if (<dadmod_nc_rt> = 0)
                        if (<leftx> < -0.5)
                            dadmod_nc_xw = 1.0
                        endif
                        if (<leftx> > 0.5)
                            dadmod_nc_xw = -1.0
                        endif
                    endif
                endif
                if (<dadmod_nc_xw> = 0.0)
                    dadmod_nc_xcnt = 0
                else
                    if (<dadmod_nc_xw> = <dadmod_nc_xsign>)
                        dadmod_nc_xcnt = 0
                    else
                        dadmod_nc_xcnt = ( <dadmod_nc_xcnt> + 1 )
                        if (<dadmod_nc_xcnt> > 9)
                            dadmod_nc_xsign = <dadmod_nc_xw>
                            dadmod_nc_xcnt = 0
                        endif
                    endif
                endif
                dadmod_nc_sx = ( <leftx> * <dadmod_nc_xsign> )
                dadmod_nc_sy = ( <lefty> * <dadmod_nc_ysign> )
                if (<dadmod_nc_sx> > 1.0)
                    dadmod_nc_sx = 1.0
                endif
                if (<dadmod_nc_sx> < -1.0)
                    dadmod_nc_sx = -1.0
                endif
                if (<dadmod_nc_sy> > 1.0)
                    dadmod_nc_sy = 1.0
                endif
                if (<dadmod_nc_sy> < -1.0)
                    dadmod_nc_sy = -1.0
                endif
                if ( ( <dadmod_nc_sx> * <dadmod_nc_sx> + <dadmod_nc_sy> * <dadmod_nc_sy> ) < 0.05 )
                    dadmod_nc_sx = 0.0
                    dadmod_nc_sy = 0.0
                endif
            endif
            if ( ( <dadmod_nc_sx> = 0.0 ) and ( <dadmod_nc_sy> = 0.0 ) )
                if (<dadmod_nc_up> = 1)
                    dadmod_nc_sy = 1.0
                endif
                if (<dadmod_nc_dn> = 1)
                    dadmod_nc_sy = -1.0
                endif
                if (<dadmod_nc_lt> = 1)
                    dadmod_nc_sx = -1.0
                endif
                if (<dadmod_nc_rt> = 1)
                    dadmod_nc_sx = 1.0
                endif
                if not (<dadmod_nc_sx> = 0.0)
                    if not (<dadmod_nc_sy> = 0.0)
                        dadmod_nc_sx = ( <dadmod_nc_sx> * 0.707 )
                        dadmod_nc_sy = ( <dadmod_nc_sy> * 0.707 )
                    endif
                endif
            endif
            dadmod_nc_cf = <dadmod_nc_dir>
            dadmod_nc_camid = none
            GetCameraId
            if GotParam CameraId
                dadmod_nc_camid = <CameraId>
            endif
            if root_window : GetSingleTag dadmod_walkcam_live
                if (<dadmod_walkcam_live> = 1)
                    if ObjectExists id = dadmod_orbit_cam
                        dadmod_nc_camid = dadmod_orbit_cam
                    endif
                endif
            endif
            if not (<dadmod_nc_camid> = none)
                if ObjectExists id = <dadmod_nc_camid>
                    <dadmod_nc_camid> : Obj_GetPosition
                    dadmod_nc_cx = ( ( <dadmod_nc_pos> . (1.0,0.0,0.0) ) - ( <Pos> . (1.0,0.0,0.0) ) )
                    dadmod_nc_cz = ( ( <dadmod_nc_pos> . (0.0,0.0,1.0) ) - ( <Pos> . (0.0,0.0,1.0) ) )
                    if ( ( <dadmod_nc_cx> * <dadmod_nc_cx> + <dadmod_nc_cz> * <dadmod_nc_cz> ) > 1.0 )
                        dadmod_nc_cf = ( <dadmod_nc_cx> * (1.0,0.0,0.0) + <dadmod_nc_cz> * (0.0,0.0,1.0) )
                        NormalizeVector <dadmod_nc_cf>
                        dadmod_nc_cf = <norm>
                    endif
                endif
            endif
            if ( ( ( <dadmod_nc_camf> . (1.0,0.0,0.0) ) * ( <dadmod_nc_cf> . (1.0,0.0,0.0) ) + ( <dadmod_nc_camf> . (0.0,0.0,1.0) ) * ( <dadmod_nc_cf> . (0.0,0.0,1.0) ) ) < -0.5 )
                dadmod_nc_camf = <dadmod_nc_cf>
            endif
            dadmod_nc_camn = ( <dadmod_nc_camf> + 0.15 * <dadmod_nc_cf> )
            NormalizeVector <dadmod_nc_camn>
            dadmod_nc_camf = <norm>
            dadmod_nc_fx = ( <dadmod_nc_camf> . (1.0,0.0,0.0) )
            dadmod_nc_fz = ( <dadmod_nc_camf> . (0.0,0.0,1.0) )
            dadmod_nc_move = ( ( <dadmod_nc_sy> * <dadmod_nc_fx> - <dadmod_nc_sx> * <dadmod_nc_fz> ) * (1.0,0.0,0.0) + ( <dadmod_nc_sy> * <dadmod_nc_fz> + <dadmod_nc_sx> * <dadmod_nc_fx> ) * (0.0,0.0,1.0) )
            if ( ( <dadmod_nc_sx> * <dadmod_nc_sx> + <dadmod_nc_sy> * <dadmod_nc_sy> ) > 0.04 )
                dadmod_nc_turnto = <dadmod_nc_move>
                NormalizeVector <dadmod_nc_turnto>
                dadmod_nc_want = <norm>
                dadmod_nc_dot = ( ( <dadmod_nc_dir> . (1.0,0.0,0.0) ) * ( <dadmod_nc_want> . (1.0,0.0,0.0) ) + ( <dadmod_nc_dir> . (0.0,0.0,1.0) ) * ( <dadmod_nc_want> . (0.0,0.0,1.0) ) )
                if (<dadmod_nc_dot> < -0.9)
                    dadmod_nc_fx = ( <dadmod_nc_dir> . (1.0,0.0,0.0) )
                    dadmod_nc_fz = ( <dadmod_nc_dir> . (0.0,0.0,1.0) )
                    dadmod_nc_want = ( <dadmod_nc_want> + 0.5 * ( <dadmod_nc_fz> * (1.0,0.0,0.0) - <dadmod_nc_fx> * (0.0,0.0,1.0) ) )
                endif
                dadmod_nc_turnto = ( <dadmod_nc_dir> + 0.2 * <dadmod_nc_want> )
                NormalizeVector <dadmod_nc_turnto>
                dadmod_nc_dir = <norm>
            endif
            dadmod_nc_l1 = 0
            dadmod_nc_r1 = 0
            if Held L1
                dadmod_nc_l1 = 1
            endif
            if Held R1
                dadmod_nc_r1 = 1
            endif
            dadmod_nc_bl1 = 1
            dadmod_nc_br1 = 1
            dadmod_nc_both = 0
            if (sc_button = L1)
                dadmod_nc_br1 = 0
            endif
            if (sc_button = R1)
                dadmod_nc_bl1 = 0
            endif
            if (sc_button = L1_R1)
                dadmod_nc_both = 1
            endif
            dadmod_nc_trig = 0
            if (<dadmod_nc_bl1> = 1)
                if (<dadmod_nc_l1> = 1)
                    dadmod_nc_trig = 1
                    dadmod_nc_saw_l1 = 1
                endif
            endif
            if (<dadmod_nc_br1> = 1)
                if (<dadmod_nc_r1> = 1)
                    dadmod_nc_trig = 1
                    dadmod_nc_saw_r1 = 1
                endif
            endif
            if (<dadmod_nc_trig> = 1)
                dadmod_nc_hold = ( <dadmod_nc_hold> + 1 )
                if Held L2
                    dadmod_nc_dirty = 1
                endif
                if Held R2
                    dadmod_nc_dirty = 1
                endif
            else
                if (<dadmod_nc_trig_was> = 1)
                    dadmod_nc_go = 0
                    if (<dadmod_nc_dirty> = 0)
                        if (<dadmod_nc_hold> < 13)
                            dadmod_nc_go = 1
                            if (<dadmod_nc_both> = 1)
                                if not ( (<dadmod_nc_saw_l1> = 1) and (<dadmod_nc_saw_r1> = 1) )
                                    dadmod_nc_go = 0
                                endif
                            endif
                        endif
                    endif
                    if (<dadmod_nc_go> = 1)
                        dadmod_nc_walk = ( 1 - <dadmod_nc_walk> )
                        root_window : SetTags dadmod_noclip_foot = <dadmod_nc_walk>
                        dadmod_nc_anim_on = 0
                        dadmod_noclip_idle_anim dadmod_nc_walk = <dadmod_nc_walk>
                    endif
                endif
                dadmod_nc_dirty = 0
                dadmod_nc_hold = 0
                dadmod_nc_saw_l1 = 0
                dadmod_nc_saw_r1 = 0
            endif
            dadmod_nc_trig_was = <dadmod_nc_trig>
            dadmod_nc_yaw = 0.0
            if (<dadmod_nc_l1> = 1)
                if ( (<dadmod_nc_bl1> = 0) or (<dadmod_nc_hold> > 8) )
                    dadmod_nc_yaw = 0.06
                endif
            endif
            if (<dadmod_nc_r1> = 1)
                if ( (<dadmod_nc_br1> = 0) or (<dadmod_nc_hold> > 8) )
                    dadmod_nc_yaw = ( <dadmod_nc_yaw> - 0.06 )
                endif
            endif
            if not (<dadmod_nc_yaw> = 0.0)
                dadmod_nc_fx = ( <dadmod_nc_dir> . (1.0,0.0,0.0) )
                dadmod_nc_fz = ( <dadmod_nc_dir> . (0.0,0.0,1.0) )
                dadmod_nc_turnto = ( ( <dadmod_nc_fx> + <dadmod_nc_fz> * <dadmod_nc_yaw> ) * (1.0,0.0,0.0) + ( <dadmod_nc_fz> - <dadmod_nc_fx> * <dadmod_nc_yaw> ) * (0.0,0.0,1.0) )
                NormalizeVector <dadmod_nc_turnto>
                dadmod_nc_dir = <norm>
            endif
            dadmod_nc_rise = 0.0
            if Held x
                dadmod_nc_rise = 1.0
            endif
            if Held square
                dadmod_nc_rise = -1.0
            endif
            dadmod_nc_vel = ( <dadmod_nc_vel> + 0.25 * ( <dadmod_nc_step> * <dadmod_nc_move> + ( <dadmod_nc_rise> * <dadmod_nc_step> ) * (0.0,1.0,0.0) - <dadmod_nc_vel> ) )
            dadmod_nc_pos = ( <dadmod_nc_pos> + <dadmod_nc_vel> )
            dadmod_nc_diag = ( <dadmod_nc_diag> + 1 )
            if (<dadmod_nc_diag> > 90)
                dadmod_nc_diag = 0
                if ( ( <dadmod_nc_sx> * <dadmod_nc_sx> + <dadmod_nc_sy> * <dadmod_nc_sy> ) > 0.04 )
                    FormatText TextName = dadmod_nc_t "lx %a ly %b sx %c sy %d" a = <leftx> b = <lefty> c = <dadmod_nc_sx> d = <dadmod_nc_sy>
                    THUGRECOMP_TextSave key = "noclip_stick" value = <dadmod_nc_t>
                endif
            endif
        endif
        Obj_SetPosition position = <dadmod_nc_pos>
        Obj_SetOrientation dir = <dadmod_nc_dir>
        wait 1 gameframe
    repeat
    root_window : SetTags dadmod_noclip = 0
    UnpausePhysics
    SetSpeed 0
    KillSpawnedScript Name = dadmod_noclip_void_watch
    SpawnScript dadmod_noclip_void_watch
    ClearEventBuffer
    if (<dadmod_nc_walk> = 0)
        SwitchToSkatingPhysics
    endif
    dadmod_noclip_after_zero
    if (<dadmod_nc_az> = 1)
        if (<dadmod_nc_walk> = 1)
            SetEventHandler ex = Trigger_L2 scr = CameraFlushButton Group = WalkingEvents
            SetEventHandler ex = Release_X scr = JumpButton Group = WalkingEvents
        endif
        goto EndOfRun params = { instant }
    endif
    if (<dadmod_nc_done> = 1)
        Change AlreadyEndedRun = 0
    endif
    if (<dadmod_nc_walk> = 1)
        SetEventHandler ex = Trigger_L2 scr = CameraFlushButton Group = WalkingEvents
        SetEventHandler ex = Release_X scr = JumpButton Group = WalkingEvents
        wait 1 gameframe
        if Walk_Ground
            goto StandState
        endif
        goto AirState
    endif
    SetState AIR
    goto GroundGone
endscript

script dadmod_noclip_void_watch
    wait 2 gameframes
    GetSkaterId
    if not ObjectExists id = <objID>
        return
    endif
    if not root_window : GetSingleTag dadmod_noclip_home
        return
    endif
    <objID> : Obj_GetPosition
    dadmod_nc_top = ( <Pos> . (0.0,1.0,0.0) )
    dadmod_nc_last = <Pos>
    dadmod_nc_still = 0
    dadmod_nc_void = 0
    dadmod_nc_ground = 0
    dadmod_nc_gstill = 0
    begin
        wait 1 gameframe
        if not ObjectExists id = <objID>
            return
        endif
        if root_window : GetSingleTag dadmod_noclip
            if (<dadmod_noclip> > 0)
                return
            endif
        endif
        <objID> : Obj_GetPosition
        dadmod_nc_d = ( <Pos> - <dadmod_nc_last> )
        dadmod_nc_moved = 0
        if ( ( <dadmod_nc_d> . <dadmod_nc_d> ) > 100.0 )
            dadmod_nc_moved = 1
            dadmod_nc_last = <Pos>
        endif
        if <objID> : InAir
            dadmod_nc_ground = 0
            if (<dadmod_nc_moved> = 0)
                dadmod_nc_still = ( <dadmod_nc_still> + 1 )
            else
                dadmod_nc_still = 0
            endif
        else
            dadmod_nc_ground = ( <dadmod_nc_ground> + 1 )
            if (<dadmod_nc_ground> > 30)
                return
            endif
            if (<dadmod_nc_moved> = 1)
                dadmod_nc_gstill = 0
            else
                dadmod_nc_gstill = ( <dadmod_nc_gstill> + 1 )
            endif
            if (<dadmod_nc_gstill> = 12)
                if <objID> : Walking
                    dadmod_nc_probe = ( <Pos> + (0.0,6.0,0.0) )
                    <objID> : Obj_SetPosition position = <dadmod_nc_probe>
                    wait 8 gameframes
                    if not ObjectExists id = <objID>
                        return
                    endif
                    <objID> : Obj_GetPosition
                    dadmod_nc_pd = ( <Pos> - <dadmod_nc_probe> )
                    if ( ( <dadmod_nc_pd> . <dadmod_nc_pd> ) < 1.0 )
                        dadmod_nc_void = 1
                        break
                    endif
                    return
                endif
            endif
            dadmod_nc_still = 0
        endif
        if (<dadmod_nc_still> > 30)
            dadmod_nc_void = 1
            break
        endif
        if ( ( <dadmod_nc_top> - ( <Pos> . (0.0,1.0,0.0) ) ) > 4000.0 )
            dadmod_nc_void = 1
            break
        endif
    repeat 600
    if (<dadmod_nc_void> = 1)
        <objID> : Obj_SetPosition position = <dadmod_noclip_home>
        <objID> : SetSpeed 0
        dadmod_noclip_msg text = "Back where noclip started"
    endif
endscript

script dadmod_homelevel_tick
    if THUGRECOMP_KeyPressed key = "Home"
        if not LevelIs Load_MainMenu
            KillSpawnedScript Name = dadmod_homelevel_open
            SpawnScript dadmod_homelevel_open NotSessionSpecific = 1
        endif
    endif
endscript

script dadmod_homelevel_open
    if ( is_changing_levels = 1 )
        return
    endif
    if InNetGame
        if not IsHost
            return
        endif
    endif
    if ScreenElementExists id = keyboard_anchor
        return
    endif
    if ScreenElementExists id = dialog_box_anchor
        return
    endif
    if ScreenElementExists id = level_select_panel_container
        return
    endif
    root_window : GetSingleTag menu_state
    if ( <menu_state> = on )
        return
    endif
    if ScreenElementExists id = current_menu_anchor
        return
    endif
    handle_start_pressed device_num = 0
    wait 8 gameframes
    root_window : GetSingleTag menu_state
    if not ( <menu_state> = on )
        return
    endif
    if not ScreenElementExists id = current_menu_anchor
        return
    endif
    if InNetGame
        launch_level_select_menu show_warning
    else
        launch_level_select_menu
    endif
endscript

script dadmod_speed_boot
    KillSpawnedScript Name = dadmod_speed_watch
    SpawnScript dadmod_speed_watch NotSessionSpecific = 1
endscript

script dadmod_speed_watch
    n = 0
    begin
        wait 10 gameframes
        n = ( <n> + 1 )
        if ( <n> > 5 )
            n = 0
            dadmod_speed_tick phys
        else
            dadmod_speed_tick
        endif
    repeat
endscript

script dadmod_speed_get
    lvl = 5
    if THUGRECOMP_SettingLoad key = "player_speed"
        lvl = <value>
    endif
    if ( <lvl> < 1 )
        lvl = 5
    endif
    if ( <lvl> > 10 )
        lvl = 5
    endif
    switch <lvl>
    case 1
        mult = 0.25
    case 2
        mult = 0.4
    case 3
        mult = 0.6
    case 4
        mult = 0.8
    case 6
        mult = 1.25
    case 7
        mult = 1.5
    case 8
        mult = 1.75
    case 9
        mult = 2.0
    case 10
        mult = 2.5
    default
        mult = 1.0
    endswitch
    return lvl = <lvl> mult = <mult>
endscript

script dadmod_speed_text
    dadmod_speed_get
    switch <lvl>
    case 1
        t = "1 (Slow Mo)"
    case 2
        t = "2"
    case 3
        t = "3"
    case 4
        t = "4"
    case 6
        t = "6"
    case 7
        t = "7"
    case 8
        t = "8"
    case 9
        t = "9"
    case 10
        t = "10 (Super Speed)"
    default
        t = "5 (Normal)"
    endswitch
    return speed_text = <t>
endscript

script dadmod_speed_apply
    dadmod_speed_get
    if ( <lvl> > 5 )
        mult = 1.0
        dadmod_speed_phys
    else
        dadmod_speed_stock
    endif
    Change storedslomo = <mult>
    if InNetGame
        SetSlomo <mult>
    else
        if ( <lvl> > 4 )
            SetSlomo 1
        endif
    endif
endscript

script dadmod_speed_stock
    Change skater_physics = ( skater_physics + { Skater_Max_Standing_Kick_Speed_Stat = { (394.0,496.0) STATS_SPEED #"switch" = (0.8,1.0) limit = 900 } Skater_Max_Crouched_Kick_Speed_Stat = { (532.0,675.0) STATS_SPEED #"switch" = (0.8,1.0) limit = 900 } Physics_Standing_Acceleration_Stat = { (629.0,700.0) STATS_SPEED #"switch" = standard_switch } Physics_Crouching_Acceleration_stat = { (1057.0,1200.0) STATS_SPEED #"switch" = standard_switch } Skater_Max_Speed_Stat = { (757.0,900.0) STATS_SPEED #"switch" = no_switch } Skater_Max_Max_Speed_Stat = { (957.0,1100.0) STATS_SPEED #"switch" = no_switch } } )
    Change Rail_Speed_Boost = 150
    Change Point_Rail_Speed_Boost = 125
endscript

script dadmod_speed_phys
    dadmod_speed_get
    switch <lvl>
    case 6
        Change skater_physics = ( skater_physics + { Skater_Max_Standing_Kick_Speed_Stat = { (453.0,570.0) STATS_SPEED #"switch" = (0.8,1.0) limit = 1035 } Skater_Max_Crouched_Kick_Speed_Stat = { (612.0,776.0) STATS_SPEED #"switch" = (0.8,1.0) limit = 1035 } Physics_Standing_Acceleration_Stat = { (660.0,735.0) STATS_SPEED #"switch" = standard_switch } Physics_Crouching_Acceleration_stat = { (1110.0,1260.0) STATS_SPEED #"switch" = standard_switch } Skater_Max_Speed_Stat = { (984.0,1170.0) STATS_SPEED #"switch" = no_switch } Skater_Max_Max_Speed_Stat = { (1244.0,1430.0) STATS_SPEED #"switch" = no_switch } } )
        Change Rail_Speed_Boost = 180
        Change Point_Rail_Speed_Boost = 150
