{ name = "mmopt_scene" b = 0 p = { id = mmopt_scene key = "menu_scene" label = "Menu scene" desc = "The stock Skate Shop (normal or Halloween), your custom menu, or Starred: each start shows one of the menus you starred in Custom menus. Loads right away" } }
{ name = "mmopt_saved" b = 0 p = { id = mmopt_saved key = "saved_menu" label = "Custom menus" desc = "Main menus you saved while skating (Quick Menu > Set Main Menu Here). Pick one to load it. Right stars menus for Menu scene Starred. F8 (or X / Square on a controller) twice deletes one" } }
{ name = "mmopt_camctl" b = 0 p = { id = mmopt_camctl key = "camera_control" label = "Camera control" desc = "Menu: the cameras below move by themselves. You: the stick turns the camera around your skater" } }
{ name = "mmopt_theme" b = 0 p = { id = mmopt_theme key = "shop_theme" label = "Skate shop theme" desc = "Halloween or normal look for the Skate Shop scene. Auto turns Halloween on in October" } }
{ name = "mmopt_deck" b = 0 p = { id = mmopt_deck key = "deck" label = "Deck graphic" desc = "The big deck picture behind the menu. Off shows the whole scene" } }
{ name = "mmopt_framing" b = 0 p = { id = mmopt_framing key = "framing" label = "Skater on screen" desc = "Which side of the screen your skater stands on. Left keeps them clear of the menu" } }
{ name = "mmopt_cams" b = 0 p = { id = mmopt_cams key = "cameras" label = "Camera mode" desc = "Static keeps one shot. Cycle switches shots on a timer" } }
{ name = "mmopt_campick" b = 0 p = { id = mmopt_campick key = "camera_pick" label = "Camera shot" desc = "The shot to use when Camera mode is Static. The Static shot is one still view with no orbit or movement" } }
{ name = "mmopt_ccam" b = 0 p = { id = mmopt_ccam key = "custom_cam_menu" label = "Custom camera" desc = "Use one of the cameras you saved on this map (Reposition camera saves them)" } }
{ name = "mmopt_camsec" b = 0 p = { id = mmopt_camsec key = "camera_seconds" label = "Shot time" desc = "How long each shot stays up when Camera mode is Cycle" } }
{ name = "mmopt_spots" b = 0 p = { id = mmopt_spots key = "spots" label = "Spot mode" desc = "Static keeps one spot. Cycle picks another of this level's spots each time the menu loads" } }
{ name = "mmopt_pmode" b = 0 p = { id = mmopt_pmode key = "pose_mode" label = "Pose mode" desc = "Default: the idle loops. Single Animation: one you pick. Cycle Animations: the ones you pick, in turn. Random: anything" } }
{ name = "mmopt_anims" b = 0 p = { id = mmopt_anims key = "anim_browse" label = "Animations" desc = "Opens the animation picker" } }
{ name = "mmopt_pone" b = 0 p = { id = mmopt_pone key = "pose_one" label = "Favorite" desc = "The favorite used by One favorite. Star favorites in pause > dadmod > Animations" } }
{ name = "mmopt_ambient" b = 0 p = { id = mmopt_ambient key = "ambient_people" label = "Ambient life" desc = "People, or people and traffic like free skate, on custom menu maps that have them (Hollywood, Beverly Hills)" } }
{ name = "mmopt_ptime" b = 0 p = { id = mmopt_ptime key = "pose_seconds" label = "Time per animation" desc = "How long each animation plays before blending into the next" } }
{ name = "mmopt_order" b = 0 p = { id = mmopt_order key = "order" label = "Cycle order" desc = "Random or in order, for everything that cycles: Starred menus, camera shots, poses and spots" } }
{ name = "mmopt_ce_reposition" b = 0 p = { id = mmopt_ce_reposition key = "cam_reposition" label = "Reposition camera" desc = "Fly a free camera to frame a shot. Saves it as a custom camera for this map" } }
{ name = "mmopt_ce_radius" b = 0 p = { id = mmopt_ce_radius key = "cam_radius" label = "Distance" desc = "How far the camera is from your skater" } }
{ name = "mmopt_ce_height" b = 0 p = { id = mmopt_ce_height key = "cam_height" label = "Height" desc = "How high the camera is above your skater's feet" } }
{ name = "mmopt_ce_look" b = 0 p = { id = mmopt_ce_look key = "cam_look" label = "Aim height" desc = "Where the camera aims: low for the feet, about 60 for the face" } }
{ name = "mmopt_ce_start" b = 0 p = { id = mmopt_ce_start key = "cam_start" label = "Angle" desc = "Where the camera sits around your skater: 0 is their front, 180 is behind" } }
{ name = "mmopt_ce_speed" b = 0 p = { id = mmopt_ce_speed key = "cam_speed" label = "Orbit speed" desc = "How fast the camera moves around your skater. Still stops it" } }
{ name = "mmopt_ce_range" b = 0 p = { id = mmopt_ce_range key = "cam_range" label = "Orbit range" desc = "Full circle, or sweep back and forth in front. 180 never goes behind them" } }
