script dadmod_added_level_creator
    GetArraySize dadmod_added_levels
    <i> = 0
    begin
        if ( ( dadmod_added_levels [ <i> ] ) = <level> )
            return creator = ( dadmod_added_level_creators [ <i> ] )
        endif
        <i> = ( <i> + 1 )
    repeat <array_size>
endscript

