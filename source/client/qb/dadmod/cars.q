script thugpro_slaphit_obj
    switch <id>
    case 0
        return o = #"0x00000000"
    case 1
        return o = #"0x00000001"
    case 2
        return o = #"0x00000002"
    case 3
        return o = #"0x00000003"
    case 4
        return o = #"0x00000004"
    case 5
        return o = #"0x00000005"
    case 6
        return o = #"0x00000006"
    case 7
        return o = #"0x00000007"
    case 8
        return o = #"0x00000008"
    case 9
        return o = #"0x00000009"
    case 10
        return o = #"0x0000000a"
    case 11
        return o = #"0x0000000b"
    case 12
        return o = #"0x0000000c"
    case 13
        return o = #"0x0000000d"
    case 14
        return o = #"0x0000000e"
    case 15
        return o = #"0x0000000f"
    endswitch
    return o = none
endscript
