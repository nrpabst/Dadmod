script themes_menu_edit_custom
    thugpro_menu_create {
    menu_name = custom_theme_options
    menu_title = "Edit theme"
    menu_style = MENU_STYLE_RIGHT
    pad_back_script = dadmod_theme_edit_back
    helper_text = generic_helper_text
    scrolling
    boxed
    }
    dadmod_theme_preview_hide
    refresh_edit_theme_preveiw_specialmeter
    refresh_edit_theme_preveiw_balancemeter
    make_thugpro_menu_item { id = dadmod_theme_random_item text = "Random Theme" pad_choose_script = dadmod_theme_random }
    make_thugpro_menu_item { id = dadmod_theme_saved_item text = "Saved Themes" pad_choose_script = dadmod_theme_open_slots }
    make_thugpro_menu_item { id = dadmod_theme_default_item text = "Default Theme" pad_choose_script = dadmod_theme_default }
    ForEachIn ( THUGPRO_custom_theme_options ) Do = add_edit_theme_menu_item params = { }
    if GotParam from_theme_menu
        Change edit_theme_menu_last_selected_item = first
        thugpro_menu_finalize <...>
    else
        thugpro_menu_finalize <...> focus_target = ( edit_theme_menu_last_selected_item )
    endif
endscript

script create_edit_theme_color_menu
    Change edit_theme_menu_last_selected_item = <container_id>
    thugpro_menu_create {
    menu_name = color_selection
    menu_title = "Color selection"
    menu_style = MENU_STYLE_RIGHT
    pad_back_script = themes_menu_edit_custom
    helper_text = generic_helper_text
    scrolling
    boxed
    }
    FormatText ChecksumName = key_name_checksum "%a" a = <key_name>
    GetArraySize THUGPRO_THEME_COLOR_ARRAY
    index = 0
    begin
        FormatText ChecksumName = menu_item_id "menu_color_item_%r_%g_%b_%a" r = ( ( THUGPRO_THEME_COLOR_ARRAY [ <index> ] ) [ 0 ] ) g = ( ( THUGPRO_THEME_COLOR_ARRAY [ <index> ] ) [ 1 ] ) b = ( ( THUGPRO_THEME_COLOR_ARRAY [ <index> ] ) [ 2 ] ) a = ( ( THUGPRO_THEME_COLOR_ARRAY [ <index> ] ) [ 3 ] )
        edit_theme_add_color_item {
        id = <menu_item_id>
        rgba = ( THUGPRO_THEME_COLOR_ARRAY [ <index> ] )
        load_func = <load_func>
        pad_choose_params = {
        key_name_checksum = <key_name_checksum>
        key_name = <key_name>
        rgba_index = <index>
        }
        focus_params = {
        preview_item_id = <preview_item_id>
        preview_rgba = ( THUGPRO_THEME_COLOR_ARRAY [ <index> ] )
        dadmod_preview_key = <key_name>
        }
        }
        <index> = ( <index> + 1 )
    repeat <array_size>
    dadmod_theme_preview_show key_name = <key_name>
    FormatText ChecksumName = last_selected_item "menu_color_item_%r_%g_%b_%a" r = ( ( <preview_rgba> ) [ 0 ] ) g = ( ( <preview_rgba> ) [ 1 ] ) b = ( ( <preview_rgba> ) [ 2 ] ) a = ( ( <preview_rgba> ) [ 3 ] )
    thugpro_menu_finalize <...> focus_target = <last_selected_item>
endscript

script edit_theme_color_item_focus
    GetTags
    if GotParam dadmod_preview_key
        dadmod_theme_preview_show key_name = <dadmod_preview_key> rgba = <preview_rgba>
    endif
    if GotParam preview_item_id
        if not ScreenElementExists id = <preview_item_id>
            RemoveParameter preview_item_id
        endif
    endif
    if GotParam preview_item_id
        DoScreenElementMorph {
        id = <preview_item_id>
        rgba = <preview_rgba>
        }
    endif
endscript

script dadmod_theme_open
    if ScreenElementExists id = root_window
        root_window : SetTags dadmod_theme_back = 1
    endif
    if RegKeyExist key = "BASE_THEME_NAME" theme
        thugpro_change_theme theme = custom
        refresh_edit_theme_preveiw_specialmeter force_create
        refresh_edit_theme_preveiw_balancemeter force_create
        themes_menu_edit_custom from_theme_menu
    else
        swap_themes_menu reset_theme_select initialize_custom_theme
    endif
endscript

script dadmod_theme_clear_back
    if ScreenElementExists id = root_window
        root_window : SetTags dadmod_theme_back = 0
    endif
endscript

script dadmod_theme_edit_back
    <back_to_ui> = 0
    if ScreenElementExists id = root_window
        if root_window : GetSingleTag dadmod_theme_back
            <back_to_ui> = <dadmod_theme_back>
        endif
    endif
    if ( <back_to_ui> = 1 )
        dadmod_theme_clear_back
        destroy_edit_theme_preveiw_specialmeter
        destroy_edit_theme_preveiw_balancemeter
        generic_menu_pad_back_sound
        create_dadmod_ui_menu
    else
        custom_theme_selection_menu
    endif
endscript

script dadmod_theme_random
    if not RegKeyExist key = "BASE_THEME_NAME" theme
        SetRegKeyValue key = "BASE_THEME_NAME" Type = IntOrChecksum value = thugpro theme
    endif
    ForEachIn ( THUGPRO_custom_theme_options ) Do = dadmod_theme_random_key params = { }
    thugpro_change_theme theme = custom
    Change edit_theme_menu_last_selected_item = dadmod_theme_random_item
    themes_menu_edit_custom
endscript

script dadmod_theme_random_key
    if not GotParam NO_MENU_ITEM
        if GotParam color_options
            GetArraySize THUGPRO_THEME_COLOR_ARRAY
            GetRandomValue Name = dadmod_pick a = 0 b = ( <array_size> - 1 ) Integer
            SetRegKeyValue key = <key_name> Type = IntOrChecksum value = <dadmod_pick> theme
        else
            if GotParam option_array
                GetArraySize <option_array>
                GetRandomValue Name = dadmod_pick a = 0 b = ( <array_size> - 1 ) Integer
                SetRegKeyValue key = <key_name> Type = IntOrChecksum value = ( ( <option_array> [ <dadmod_pick> ] ) . value ) theme
            endif
        endif
    endif
endscript

script dadmod_theme_open_slots
    Change edit_theme_menu_last_selected_item = dadmod_theme_saved_item
    dadmod_theme_slots_menu
endscript

script dadmod_theme_slot_used
    FormatText TextName = mark_key "DADMOD_THEME%s_SAVED" s = <slot>
    if RegKeyExist key = <mark_key> theme
        if GetRegKeyValue key = <mark_key> Type = IntOrChecksum theme
            if ( <value_int> = 1 )
                return slot_used = 1
            endif
        endif
    endif
    return slot_used = 0
endscript

script dadmod_theme_slots_menu
    thugpro_menu_create {
    menu_name = dadmod_theme_slots
    menu_title = "Saved Themes"
    menu_style = MENU_STYLE_RIGHT
    pad_back_script = themes_menu_edit_custom
    helper_text = generic_helper_text
    boxed
    }
    <slot> = 1
    begin
        dadmod_theme_slot_used slot = <slot>
        if ( <slot_used> = 1 )
            <slot_state> = "Saved"
        else
            <slot_state> = "Empty"
        endif
        FormatText TextName = slot_text "Theme %s" s = <slot>
        FormatText ChecksumName = slot_id "dadmod_theme_slot_%s" s = <slot>
        make_thugpro_menu_item {
        id = <slot_id>
        text = <slot_text>
        extra_text = <slot_state>
        pad_choose_script = dadmod_theme_slot_options
        pad_choose_params = { slot = <slot> }
        }
        <slot> = ( <slot> + 1 )
    repeat 5
    if GotParam focus_slot
        FormatText ChecksumName = focus_id "dadmod_theme_slot_%s" s = <focus_slot>
        thugpro_menu_finalize focus_target = <focus_id>
    else
        thugpro_menu_finalize
    endif
endscript

script dadmod_theme_slot_options
    dadmod_theme_slot_used slot = <slot>
    FormatText TextName = slot_title "Theme %s" s = <slot>
    thugpro_menu_create {
    menu_name = dadmod_theme_slot
    menu_title = <slot_title>
    menu_style = MENU_STYLE_RIGHT
    pad_back_script = generic_menu_pad_back
    pad_back_params = { callback = dadmod_theme_slots_menu focus_slot = <slot> }
    helper_text = generic_helper_text
    boxed
    }
    if ( <slot_used> = 1 )
        make_thugpro_menu_item {
        text = "Load This Theme"
        pad_choose_script = dadmod_theme_slot_load
        pad_choose_params = { slot = <slot> }
        }
    else
        make_thugpro_menu_item {
        text = "Load This Theme"
        not_focusable
        }
    endif
    make_thugpro_menu_item {
    text = "Save Current Theme Here"
    pad_choose_script = dadmod_theme_slot_save
    pad_choose_params = { slot = <slot> }
    }
    if ( <slot_used> = 1 )
        make_thugpro_menu_item {
        text = "Delete"
        pad_choose_script = dadmod_theme_slot_delete
        pad_choose_params = { slot = <slot> }
        }
    else
        make_thugpro_menu_item {
        text = "Delete"
        not_focusable
        }
    endif
    thugpro_menu_finalize
endscript

script dadmod_theme_copy_key
    if GotParam key_name
        FormatText TextName = slot_key "DADMOD_THEME%s_%k" s = <slot> k = <key_name>
        if GotParam to_slot
            <from_key> = <key_name>
            <to_key> = <slot_key>
        else
            <from_key> = <slot_key>
            <to_key> = <key_name>
        endif
        if RegKeyExist key = <from_key> theme
            if GetRegKeyValue key = <from_key> Type = IntOrChecksum theme
                if GotParam color_options
                    SetRegKeyValue key = <to_key> Type = IntOrChecksum value = <value_int> theme
                else
                    SetRegKeyValue key = <to_key> Type = IntOrChecksum value = <value_checksum> theme
                endif
            endif
        endif
    endif
endscript

script dadmod_theme_slot_store
    ForEachIn ( THUGPRO_custom_theme_options ) Do = dadmod_theme_copy_key params = { slot = <slot> to_slot }
    FormatText TextName = cur_key "DADMOD_THEME%s_CURRENT" s = <slot>
    SetRegKeyValue key = <cur_key> Type = IntOrChecksum value = ( THUGPRO_CurrentThemeName ) theme
    FormatText TextName = mark_key "DADMOD_THEME%s_SAVED" s = <slot>
    SetRegKeyValue key = <mark_key> Type = IntOrChecksum value = 1 theme
endscript

script dadmod_theme_slot_save
    dadmod_theme_slot_store slot = <slot>
    dadmod_theme_slots_menu focus_slot = <slot>
endscript

script dadmod_theme_first_save
    if not RegKeyExist key = "DADMOD_THEME1_SAVED" theme
        dadmod_theme_slot_store slot = 1
    endif
endscript

script dadmod_theme_slot_load
    dadmod_theme_slot_used slot = <slot>
    if ( <slot_used> = 1 )
        ForEachIn ( THUGPRO_custom_theme_options ) Do = dadmod_theme_copy_key params = { slot = <slot> }
        <load_theme> = custom
        FormatText TextName = cur_key "DADMOD_THEME%s_CURRENT" s = <slot>
        if RegKeyExist key = <cur_key> theme
            if GetRegKeyValue key = <cur_key> Type = IntOrChecksum theme
                <load_theme> = <value_checksum>
            endif
        endif
        thugpro_change_theme theme = <load_theme>
    endif
    dadmod_theme_slots_menu focus_slot = <slot>
endscript

script dadmod_theme_slot_delete
    FormatText TextName = mark_key "DADMOD_THEME%s_SAVED" s = <slot>
    SetRegKeyValue key = <mark_key> Type = IntOrChecksum value = 0 theme
    dadmod_theme_slots_menu focus_slot = <slot>
endscript

script dadmod_theme_preview_hide
    if ScreenElementExists id = dadmod_theme_preview
        DestroyScreenElement id = dadmod_theme_preview
    endif
    if ScreenElementExists id = edit_theme_preview_container_special
        DoScreenElementMorph id = edit_theme_preview_container_special alpha = 1.0
    endif
    if ScreenElementExists id = edit_theme_preview_container_balance
        DoScreenElementMorph id = edit_theme_preview_container_balance alpha = 1.0
    endif
endscript

script dadmod_theme_preview_show
    if ScreenElementExists id = dadmod_theme_preview
        DestroyScreenElement id = dadmod_theme_preview
    endif
    FormatText ChecksumName = k "%a" a = <key_name>
    if not GotParam rgba
        rgba = ( ( THUGPRO_GlobalThemeInfo ) . ( <k> ) )
    endif
    caption = ""
    switch <k>
    case BG_PARTS_COLOR
        caption = "Dialog boxes and menu arrows"
    case KEY_COLOR
        caption = "Keyboard keys and menu backdrop"
    case SPEECH_BOX_COLOR
        caption = "Goal and NPC speech bubbles"
    case ICON_ON_VALUE
        caption = "High Scores icons"
    case ALT_COLOR
        caption = "Nothing in the game uses this color"
    case MENU_TITLE_COLOR
        caption = "Menu titles"
    case HIGHLIGHTED_TEXT_COLOR
        caption = "The option you are on"
    case UNHIGHLIGHTED_TEXT_COLOR
        caption = "The other options"
    case HIGHLIGHT_BAR_COLOR
        caption = "The bar behind the option you are on"
    default
        return
    endswitch
    if ScreenElementExists id = edit_theme_preview_container_special
        DoScreenElementMorph id = edit_theme_preview_container_special alpha = 0.0
    endif
    if ScreenElementExists id = edit_theme_preview_container_balance
        DoScreenElementMorph id = edit_theme_preview_container_balance alpha = 0.0
    endif
    CreateScreenElement {
    Type = ContainerElement
    parent = root_window
    id = dadmod_theme_preview
    Pos = (1.7e+02,2.4e+02)
    dims = (2.6e+02,2e+02)
    just = [ center center ]
    z_priority = 50
    }
    CreateScreenElement {
    Type = textElement
    parent = dadmod_theme_preview
    font = dialog
    text = <caption>
    scale = 0.75
    Pos = (1.3e+02,10.0)
    just = [ center top ]
    rgba = [ 128 128 128 128 ]
    shadow
    }
    switch <k>
    case BG_PARTS_COLOR
        CreateScreenElement { Type = SpriteElement parent = dadmod_theme_preview texture = tp_snaz_M_M Pos = (1.3e+02,1.1e+02) just = [ center center ] scale = (4.0,4.0) rgba = <rgba> z_priority = 1 }
        CreateScreenElement { Type = SpriteElement parent = dadmod_theme_preview texture = up_arrow Pos = (1.3e+02,55.0) just = [ center center ] rgba = <rgba> z_priority = 1 }
        CreateScreenElement { Type = SpriteElement parent = dadmod_theme_preview texture = down_arrow Pos = (1.3e+02,1.65e+02) just = [ center center ] rgba = <rgba> z_priority = 1 }
    case KEY_COLOR
        x = 30.0
        begin
            CreateScreenElement { Type = SpriteElement parent = dadmod_theme_preview texture = generic_key Pos = ( (1.0,0.0) * <x> + (0.0,1.1e+02) ) just = [ center center ] scale = (2.4,3.8) rgba = <rgba> z_priority = 1 }
            x = ( <x> + 50.0 )
        repeat 5
    case SPEECH_BOX_COLOR
        CreateScreenElement { Type = SpriteElement parent = dadmod_theme_preview texture = tp_dialog_frame Pos = (1.3e+02,70.0) just = [ center bottom ] scale = (1.12,1.0) rgba = <rgba> z_priority = 1 }
        CreateScreenElement { Type = SpriteElement parent = dadmod_theme_preview texture = tp_dialog_middle Pos = (1.3e+02,1.3e+02) just = [ center bottom ] scale = (1.12,3.75) rgba = <rgba> z_priority = 1 }
        CreateScreenElement { Type = SpriteElement parent = dadmod_theme_preview texture = tp_dialog_frame_b Pos = (1.3e+02,1.46e+02) just = [ center bottom ] scale = (1.12,1.0) rgba = <rgba> z_priority = 1 }
        CreateScreenElement { Type = textElement parent = dadmod_theme_preview font = dialog text = "Land a 50,000 point combo!" scale = 0.7 Pos = (1.3e+02,1e+02) just = [ center center ] rgba = [ 128 128 128 128 ] z_priority = 100 }
    case ICON_ON_VALUE
        CreateScreenElement { Type = SpriteElement parent = dadmod_theme_preview texture = stat_scores Pos = (85.0,1.1e+02) just = [ center center ] scale = (1.52,1.2) rgba = <rgba> z_priority = 1 }
        CreateScreenElement { Type = SpriteElement parent = dadmod_theme_preview texture = stat_combos Pos = (1.75e+02,1.1e+02) just = [ center center ] scale = (1.52,1.2) rgba = <rgba> z_priority = 1 }
    case MENU_TITLE_COLOR
        CreateScreenElement { Type = textElement parent = dadmod_theme_preview font = crillee text = "MENU TITLE" scale = 0.9 Pos = (1.3e+02,1.1e+02) just = [ center center ] rgba = <rgba> z_priority = 100 }
    case HIGHLIGHTED_TEXT_COLOR
        CreateScreenElement { Type = textElement parent = dadmod_theme_preview font = dialog text = "Option you are on" scale = 1.0 Pos = (1.3e+02,1.1e+02) just = [ center center ] rgba = <rgba> z_priority = 100 }
    case UNHIGHLIGHTED_TEXT_COLOR
        CreateScreenElement { Type = textElement parent = dadmod_theme_preview font = dialog text = "Other option" scale = 1.0 Pos = (1.3e+02,95.0) just = [ center center ] rgba = <rgba> z_priority = 100 }
        CreateScreenElement { Type = textElement parent = dadmod_theme_preview font = dialog text = "Another option" scale = 1.0 Pos = (1.3e+02,1.25e+02) just = [ center center ] rgba = <rgba> z_priority = 100 }
    case HIGHLIGHT_BAR_COLOR
        CreateScreenElement { Type = SpriteElement parent = dadmod_theme_preview texture = new_menu_bar Pos = (1.3e+02,1.1e+02) just = [ center center ] scale = (0.32,0.24) rgba = <rgba> z_priority = 1 }
        CreateScreenElement { Type = textElement parent = dadmod_theme_preview font = dialog text = "Option you are on" scale = 1.0 Pos = (1.3e+02,1.1e+02) just = [ center center ] rgba = [ 128 128 128 128 ] z_priority = 100 }
    endswitch
endscript

script dadmod_theme_default
    reset_theme_keys
    SetRegKeyValue key = "BASE_THEME_NAME" Type = IntOrChecksum value = thugpro theme
    thugpro_change_theme theme = custom
    Change edit_theme_menu_last_selected_item = dadmod_theme_default_item
    themes_menu_edit_custom
endscript

script choose_selected_server
    console_hide
    KillSpawnedScript Name = dadmod_join_fade
    SpawnScript dadmod_join_fade NotSessionSpecific = 1
    ChooseServer <...>
    DestroyScreenElement id = current_menu_anchor
endscript

script net_chosen_join_server
    printf "******* In net_chosen_join_server *******"
    UnSetGlobalFlag flag = 577
    UnSetGlobalFlag flag = 578
    KillSpawnedScript Name = dadmod_join_fade
    SpawnScript dadmod_join_fade NotSessionSpecific = 1
    LeaveServer
    setservermode off
    if GotParam cookie
        if ObjectExists id = current_menu_anchor
            DestroyScreenElement id = current_menu_anchor
        endif
        show_nat_start_dialog
        Change nat_neg_fallback = 0
        printf "Spawn NatNegotiateFallbackTimer"
        SpawnScript NatNegotiateFallbackTimer
        if not StartNatNegotiation <...>
            if ( nat_neg_fallback = 0 )
                create_join_failed_dialog
            endif
        endif
        printf "After StartNatNegotiation"
    else
        Change THUGPRO_IsJoiningServer = 1
        JoinServer <...>
    endif
    PlaySkaterCamAnim Name = skateshop_board_select_cam play_hold
    kill_start_key_binding
    if ObjectExists id = current_menu_anchor
        DestroyScreenElement id = current_menu_anchor
    endif
    Change check_for_unplugged_controllers = 0
endscript

script create_joining_lobby_dialog
    PlaySkaterCamAnim Skater = 0 Name = skateshop_board_select_cam play_hold
    create_dialog_box { title = net_status_msg
    text = "Joining lobby..."
    no_bg
    Pos = (237.0,2.5e+02)
    buttons = [
    { text = "cancel" pad_choose_script = cancel_lobby_ }
    ]
    no_animate
    delay_input
    }
    if ScreenElementExists id = dialog_box_anchor
        CreateScreenElement {
        Type = ContainerElement
        parent = dialog_box_anchor
        id = dadmod_lobby_wait
        Pos = (0.0,0.0)
        }
    endif
endscript

script StartingNewNetGame
    dadmod_chatkeep_save
    destroy_edit_theme_preveiw_specialmeter
    destroy_edit_theme_preveiw_balancemeter
    sound_options_exit just_remove
    edit_tricks_menu_exit just_remove
    kill_all_panel_messages
    if not IsObserving
        Skater : RunStarted
    endif
    ClearPowerups
    if not IsObserving
        ExitSurveyorMode
    endif
    if ScreenElementExists id = screenflash
        FadeToBlack off time = <FadeOffTime> id = screenflash
    endif
    if ObjectExists id = killskater_cam
        SetActiveCamera id = skatercam0
        killskater_cam : Die
    endif
endscript

script Taunt
    dadmod_noclip_is_on
    if ( <dadmod_nc_on> = 1 )
        goto dadmod_noclip_state params = { play_anim = <anim> }
    endif
    LandSkaterTricks
    ClearException Ollied
    PlayAnim anim = <anim> BlendPeriod = 0.3
    if InNetGame
        SendTauntMessage string_id = <string_id>
    endif
    wait 10 game frame
    OnGroundExceptions
    if SpeedLessThan 1
        SetRollingFriction 100
        WaitAnimWhilstChecking AndManuals
        goto HandBrake
    else
        WaitAnimWhilstChecking AndManuals
        goto OnGroundAi
    endif
endscript

script walk_maybe_throw_projectile2
    if AnimFinished
        return
    endif
    if not walking
        goto throw_while_skating
    endif
    MakeSkaterGoto throw_while_walking params = { standing = 1 }
    GetAmmo
    ammo = ( <ammo> - 1 )
    SetAmmo <ammo>
    Obj_KillSpawnedScript Name = ammo_meter_change
    Obj_SpawnScript ammo_meter_change params = { count = -1 }
    if ( <ammo> = 0 )
        text = "You're out of ammo!"
        SpawnSound SK6_SFX_OutOfAmmoBuzzer
        BroadcastEvent Type = SkaterOutOfAmmo
        create_console_message text = <text> rgba = [ 70 0 0 70 ] wait_and_die = 1 time = 3
    endif
endscript

script PlayWalkAnim
    if GotParam anim
        if ( <anim> = WalkingSlap )
            GetAmmo
            if ( <ammo> > 0 )
                return
            endif
        endif
    endif
    if not IsBoardMissing
        PlayAnim <...>
    else
        if IsForceWalkOn
            PlayAnim <...>
        else
            AppendSuffixToChecksum base = <anim> SuffixString = "_Partial"
            if AnimExists <appended_id>
                if not Obj_AnimSubsetExists SubsetId = WalkOnly
                    Obj_AddAnimSubset SubsetId = WalkOnly
                    Obj_SetAnimSubsetWeight SubsetId = WalkOnly BlendWeight = 1
                    if Obj_AnimationFlipped
                        Obj_Flip SubsetId = WalkOnly
                    endif
                endif
                PlayAnim <...>
                PlayAnim <...> anim = <appended_id> SubsetId = WalkOnly
            else
                PlayAnim <...>
            endif
        endif
    endif
endscript

