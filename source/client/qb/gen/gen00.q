script dadmod_free_cam
    exit_quick_menu
    SpawnScript dadmod_free_cam_on
endscript

script dadmod_free_cam_on
    wait 2 gameframes
    if IsTrue view_mode
        if InNetGame
            ToggleViewMode
        endif
    endif
    if not IsTrue view_mode
        ToggleViewMode
    endif
endscript

script thugpro_mark_save
    index = 0
    mark_level = "east_la"
    GetLevelStructureName
    if StructureContains structure = ( <level_structure_name> ) level
        mark_level = ( <level_structure_name> . level )
    endif
    THUGRECOMP_MenuMark {
    kind = <kind>
    level = <mark_level>
    px = ( <Pos> . (1.0,0.0,0.0) )
    py = ( <Pos> . (0.0,1.0,0.0) )
    pz = ( <Pos> . (0.0,0.0,1.0) )
    dx = ( <dir> . (1.0,0.0,0.0) )
    dy = ( <dir> . (0.0,1.0,0.0) )
    dz = ( <dir> . (0.0,0.0,1.0) )
    }
    thugpro_mark_vec_text v = <Pos>
    if (<index> = 0)
        FormatText TextName = text "%w NOT SAVED  pos %p" w = <what> p = <vec_text>
    else
        FormatText TextName = text "%w saved as %k %i in mainmenu.ini  pos %p" w = <what> k = <kind> i = <index> p = <vec_text>
    endif
    KillSpawnedScript Name = thugpro_mark_show
    SpawnScript thugpro_mark_show params = { text = <text> }
endscript

